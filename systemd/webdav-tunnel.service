[Unit]
Description=WebDAV Tunnel (TCP over WebDAV - selfhosted relay)
Documentation=https://github.com/spkprsnts/webdav-tunnel
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=wdavtunnel
Group=wdavtunnel
EnvironmentFile=-/etc/webdav-tunnel/config.env

# Применить iptables-правила ДО старта туннеля (с правами root через +)
ExecStartPre=+/usr/local/bin/webdav-tunnel-routing.sh up

# Запуск в selfhosted-режиме через runner-скрипт
ExecStart=/usr/local/bin/webdav-tunnel-runner.sh

# Убрать правила при остановке
ExecStopPost=+/usr/local/bin/webdav-tunnel-routing.sh down

Restart=on-failure
RestartSec=5s
LimitNOFILE=65536

# Изолированное пространство имён
PrivateTmp=true
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/etc/webdav-tunnel /var/lib/webdav-tunnel /var/log/webdav-tunnel

[Install]
WantedBy=multi-user.target
