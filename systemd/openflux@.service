[Unit]
Description=OpenFlux Exit-Node Service (Channel %i • L4 Mode)
After=network.target network-online.target xray.service
Wants=network-online.target
StartLimitIntervalSec=0

[Service]
Environment="GOMEMLIMIT=150MiB"
Environment="GODEBUG=madvdontneed=1"
Type=simple
User=openflux
Group=openflux
LimitNOFILE=65535
ExecStartPre=+/usr/local/bin/openflux-routing.sh
ExecStart=/usr/local/bin/openflux-runner.sh %i
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
