    printf "  ${YELLOW}[3]${NC}  %-22s %-32s %-18b %s\n" "Quad9" "9.9.9.9 / 149.112.112.112" "$(format_dns_ping "$p3")" "(Защита от malware / фишинга)"
    printf "  ${YELLOW}[4]${NC}  %-22s %-32s %-18b %s\n" "Control D" "76.76.2.0 / 76.76.10.0" "$(format_dns_ping "$p4")" "(Без фильтрации, Anycast)"
    printf "  ${YELLOW}[5]${NC}  %-22s %-32s %-18b %s\n" "AdGuard Non-filtering" "94.140.14.140 / 94.140.14.141" "$(format_dns_ping "$p5")" "(Без фильтрации рекламы)"
    printf "  ${YELLOW}[6]${NC}  %-22s %-32s %-18b %s\n" "OpenDNS" "208.67.222.222 / 208.67.220.220" "$(format_dns_ping "$p6")" "(Защитные функции Cisco)"
