    local tmpdir=$(mktemp -d /tmp/x_dns_ping.XXXXXX)
    ping_dns_target "1.1.1.1" "$tmpdir/p1" &
    ping_dns_target "8.8.8.8" "$tmpdir/p2" &
    ping_dns_target "9.9.9.9" "$tmpdir/p3" &
    ping_dns_target "76.76.2.0" "$tmpdir/p4" &
    ping_dns_target "94.140.14.140" "$tmpdir/p5" &
