        echo -e "  ${YELLOW}[7]${NC} 📱 Конфигурация для NekoBox+ / Surge (Параметры, Ссылка, QR)"
        echo -e "  ${YELLOW}[8]${NC} 📜 Живые логи службы (journalctl)"
        echo -e "  ${YELLOW}[9]${NC} 🔄 Перезапустить службу snell"
        echo -e "  ${YELLOW}[10]${NC} 🔒 ${BOLD}Управление доступом в фаерволе${NC} ($(get_snell_fw_status))"
        echo -e "  ${YELLOW}[0]${NC} ⬅️  Назад в Главное Меню"
        echo ""
        read -p "Выберите пункт [0-10]: " s_choice
        case "$s_choice" in
            1)
                show_snell_header
                systemctl status snell --no-pager
                echo ""
                ss -tulpn | grep snell || echo "Сокеты не найдены"
                echo ""
                read -p "Нажмите Enter..."
                ;;
            2) snell_manage_routing ;;
            3) snell_manage_obfs ;;
            4) snell_change_tag ;;
            5) snell_change_psk ;;
            6) snell_change_port ;;
            7) snell_export_links ;;
            8) journalctl -u snell -f -n 50 ;;
            9) restart_snell_and_verify; sleep 2 ;;
            10) toggle_snell_fw ;;
            0) return ;;
            *) echo "Неверный выбор"; sleep 1 ;;
        esac
    done
}

# ==============================================================================
# РАЗДЕЛ 3: УПРАВЛЕНИЕ WDTT / QWDTT (VPN-СЕРВЕР)
# ==============================================================================
show_wdtt_header() {
    clear
    local peer_p=$(get_wdtt_peer_port)
    local prof_name=$(get_wdtt_profile_name)
    echo -e "${CYAN}╔══════════════════════════════════════════════════════════════════════╗${NC}"
    echo -e "${CYAN}║${BOLD}             РАЗДЕЛ: УПРАВЛЕНИЕ WDTT / QWDTT (VPN-СЕРВЕР)             ${CYAN}║${NC}"
    echo -e "${CYAN}╠══════════════════════════════════════════════════════════════════════╣${NC}"
    echo -e "${CYAN}║${NC}  Сервер:   ${BOLD}${SERVER_IP}${NC}  |  Служба: $(get_wdtt_status)"
    echo -e "${CYAN}║${NC}  Порты:    ${BOLD}:${peer_p}/UDP (VPN) | 56002 (Direct) | 56003 (Raw) | 56001 (WG)${NC}"
    echo -e "${CYAN}║${NC}  Фаервол:  $(get_wdtt_fw_status)  |  Профиль: ${BOLD}${prof_name}${NC}"
    echo -e "${CYAN}║${NC}  Маршрут:  $(get_wdtt_routing)  |  Пароль: ${GREEN}$(get_wdtt_password)${NC}"
    echo -e "${CYAN}╚══════════════════════════════════════════════════════════════════════╝${NC}"
    echo ""
}

wdtt_manage_routing() {
    show_wdtt_header
    echo -e "${BOLD}--- Настройка маршрутизации WDTT (qwdtt) ---${NC}"
    echo -e "Текущий режим: $(get_wdtt_routing)"
    echo ""
    echo -e "  ${YELLOW}[1]${NC} 🌐 Маршрутизация Xray"
    echo -e "  ${YELLOW}[2]${NC} ⚡ Прямой выход"
    echo ""
    echo -e "  ${YELLOW}[0]${NC} Назад"
    echo ""
    read -p "Выберите режим [0-2]: " w_rt_choice
    case "$w_rt_choice" in
        1)
            /usr/local/bin/wdtt-tproxy.sh
            systemctl enable wdtt-tproxy 2>/dev/null || true
            systemctl restart wdtt-tproxy 2>/dev/null || true
            while iptables -t nat -D POSTROUTING -s 10.66.0.0/16 -j MASQUERADE 2>/dev/null; do :; done
            while iptables -t nat -D POSTROUTING -s 10.66.0.0/16 -o "$WAN_IF" -j MASQUERADE 2>/dev/null; do :; done
            while iptables -t nat -D POSTROUTING -s 10.66.0.0/16 -o "$WAN_IF" -m comment --comment WDTT_MANAGED -j MASQUERADE 2>/dev/null; do :; done
            while iptables -t nat -D POSTROUTING -s 10.70.0.0/16 -j MASQUERADE 2>/dev/null; do :; done
            while iptables -t nat -D POSTROUTING -s 10.70.0.0/16 -o "$WAN_IF" -j MASQUERADE 2>/dev/null; do :; done
            while iptables -t nat -D POSTROUTING -s 10.70.0.0/16 -o "$WAN_IF" -m comment --comment WDTT_RAW_MANAGED -j MASQUERADE 2>/dev/null; do :; done
            echo -e "${GREEN}✓ Маршрутизация WDTT: Xray (TPROXY)${NC}"
            sleep 2
            ;;
        2)
            iptables -t mangle -D PREROUTING -i wdtt0 -j WDTT_TPROXY 2>/dev/null || true
            iptables -t mangle -D PREROUTING -i wdttraw0 -j WDTT_TPROXY 2>/dev/null || true
            systemctl stop wdtt-tproxy 2>/dev/null || true
            systemctl disable wdtt-tproxy 2>/dev/null || true
            iptables -t nat -C POSTROUTING -s 10.66.0.0/16 -o "$WAN_IF" -m comment --comment WDTT_MANAGED -j MASQUERADE 2>/dev/null || iptables -t nat -A POSTROUTING -s 10.66.0.0/16 -o "$WAN_IF" -m comment --comment WDTT_MANAGED -j MASQUERADE
            iptables -t nat -C POSTROUTING -s 10.70.0.0/16 -o "$WAN_IF" -m comment --comment WDTT_RAW_MANAGED -j MASQUERADE 2>/dev/null || iptables -t nat -A POSTROUTING -s 10.70.0.0/16 -o "$WAN_IF" -m comment --comment WDTT_RAW_MANAGED -j MASQUERADE
            echo -e "${GREEN}✓ Маршрутизация WDTT: Прямой выход (NAT MASQUERADE)${NC}"
            sleep 2
            ;;
        0) return ;;
    esac
}

wdtt_view_devices() {
    show_wdtt_header
    echo -e "${BOLD}--- Активные устройства и клиенты WDTT ---${NC}"
    if [ -f "$WDTT_DB_FILE" ]; then
        jq -r '.devices // empty | to_entries[] | "  Устройство ID: \(.value.device_id) | IP: \(.value.ip // "N/A") | Вх: \((.value.down_bytes // 0) / 1048576 | floor) МБ | Исх: \((.value.up_bytes // 0) / 1048576 | floor) МБ"' "$WDTT_DB_FILE" 2>/dev/null || echo "  Нет подключенных устройств"
    else
        echo "  Файл базы устройств не найден"
    fi
    echo ""
    read -p "Нажмите Enter для возврата..."
}

show_qwdtt_link() {
    clear
    local peer_p=$(get_wdtt_peer_port)
    local pass=$(get_wdtt_password)
    local name=$(get_wdtt_profile_name)

    local qwdtt_url=$(python3 -c "
import urllib.parse, sys
name, ip, port, password = sys.argv[1], sys.argv[2], sys.argv[3], sys.argv[4]
name_enc = urllib.parse.quote_plus(name)
peer_enc = f'{ip}%3A{port}'
pass_enc = urllib.parse.quote_plus(password)
print(f'qwdtt://config?name={name_enc}&peer={peer_enc}&hashes=&workers=18&port=9000&pass={pass_enc}')
" "$name" "$SERVER_IP" "$peer_p" "$pass" 2>/dev/null || echo "")

    echo -e "${CYAN}╔══════════════════════════════════════════════════════════════════════╗${NC}"
    echo -e "${CYAN}║${BOLD}          ССЫЛКА ПОДКЛЮЧЕНИЯ И QR-КОД QWDTT (WDTT VPN)                ${CYAN}║${NC}"
    echo -e "${CYAN}╚══════════════════════════════════════════════════════════════════════╝${NC}"
    echo ""
    echo -e "${BOLD}Параметры подключения:${NC}"
    echo -e "  • Название профиля:    ${GREEN}${name}${NC}"
    echo -e "  • Сервер (IP:Порт):    ${CYAN}${SERVER_IP}:${peer_p}${NC}"
    echo -e "  • Внутренний порт:     ${CYAN}9000${NC}"
    echo -e "  • Количество воркеров: ${CYAN}18${NC}"
    echo -e "  • Пароль подключения:  ${GREEN}${pass}${NC}"
    echo -e "  • Режим маршрута:      $(get_wdtt_routing)"
    echo ""
    echo -e "${BOLD}Ссылка конфигурации (qwdtt://):${NC}"
    echo -e "${YELLOW}${qwdtt_url}${NC}"
    echo ""
    echo -e "${BOLD}QR-код для импорта в клиент QWDTT:${NC}"
    echo ""
    qrencode -t ANSI256 "$qwdtt_url" 2>/dev/null || qrencode -t UTF8 "$qwdtt_url" 2>/dev/null || echo "qrencode не установлен или не смог отрендерить QR"
    echo ""
    echo -e "${CYAN}────────────────────────────────────────────────────────────────────────${NC}"
    echo -e "Скопируйте ссылку выше или отсканируйте QR-код в мобильном клиенте ${BOLD}qwdtt${NC}."
    echo -e "${CYAN}────────────────────────────────────────────────────────────────────────${NC}"
    echo ""
    read -p "Нажмите Enter для возврата в меню..."
}

menu_wdtt() {
    if ! is_wdtt_installed; then
        clear
        echo -e "${YELLOW}╔══════════════════════════════════════════════════════════════════════╗${NC}"
        echo -e "${YELLOW}║${BOLD}                     WDTT НЕ ОБНАРУЖЕН                                ${YELLOW}║${NC}"
        echo -e "${YELLOW}╚══════════════════════════════════════════════════════════════════════╝${NC}"
        echo ""
        echo -e "${RED}Служба wdtt или исполняемый файл wdtt не найдены на данном сервере.${NC}"
        echo ""
        read -p "Нажмите Enter для возврата..."
        return
    fi
    while true; do
        show_wdtt_header
        echo -e "  ${YELLOW}[1]${NC} 📊 Статус службы WDTT и активные сокеты"
        echo -e "  ${YELLOW}[2]${NC} 🌐 Маршрутизация трафика (Xray / Прямой выход)"
        echo -e "  ${YELLOW}[3]${NC} 👥 Просмотр подключенных устройств и трафика"
        echo -e "  ${YELLOW}[4]${NC} 🔗 ${BOLD}Показать ссылку подключения qwdtt:// и QR-код${NC}"
        echo -e "  ${YELLOW}[5]${NC} ✏️  ${BOLD}Изменить название подключения (name)${NC}"
        echo -e "  ${YELLOW}[6]${NC} 📜 Живые логи службы WDTT (journalctl)"
        echo -e "  ${YELLOW}[7]${NC} 🔄 Перезапустить службу wdtt"
        echo -e "  ${YELLOW}[8]${NC} 🔒 ${BOLD}Управление доступом в фаерволе${NC} ($(get_wdtt_fw_status))"
        echo -e "  ${YELLOW}[0]${NC} ⬅️  Назад в Главное Меню"
        echo ""
        read -p "Выберите пункт [0-8]: " w_choice
        case "$w_choice" in
            1)
                show_wdtt_header
                systemctl status wdtt --no-pager
                echo ""
                ss -tulpn 2>/dev/null | grep wdtt || echo "Сокеты не найдены"
                echo ""
                read -p "Нажмите Enter..."
                ;;
            2) wdtt_manage_routing ;;
            3) wdtt_view_devices ;;
            4) show_qwdtt_link ;;
            5) wdtt_change_profile_name ;;
            6) journalctl -u wdtt -f -n 50 ;;
            7) restart_wdtt_and_verify; sleep 2 ;;
            8) toggle_wdtt_fw ;;
            0) return ;;
            *) echo "Неверный выбор"; sleep 1 ;;
        esac
    done
}

# ==============================================================================
# РАЗДЕЛ 4: CSQTT (VPN SERVER & WEB PANEL)
# ==============================================================================
is_csqtt_installed() {
    if command -v csqtt >/dev/null 2>&1 || [ -f "$CSQTT_SERVICE_FILE" ] || [ -d "$CSQTT_DIR" ]; then
        return 0
    fi
    return 1
}

get_csqtt_status() {
    if ! is_csqtt_installed; then
        echo -e "${RED}НЕ УСТАНОВЛЕН${NC}"
        return
    fi
    if systemctl is-active --quiet csqtt 2>/dev/null; then
        echo -e "${GREEN}АКТИВЕН (В РАБОТЕ)${NC}"
    elif systemctl is-enabled --quiet csqtt 2>/dev/null; then
        echo -e "${YELLOW}ОСТАНОВЛЕН (ВКЛЮЧЕН)${NC}"
    else
        echo -e "${RED}ОСТАНОВЛЕН${NC}"
    fi
}

get_csqtt_web_port() {
    local port=""
    if [ -f "$CSQTT_SERVICE_FILE" ]; then
        port=$(grep -oP -- '--web-port\s+\K[0-9]+' "$CSQTT_SERVICE_FILE" 2>/dev/null || true)
    fi
    if [ -z "$port" ] && [ -f "$CSQTT_NET_UP" ]; then
        port=$(grep -oP 'WEB_PORT="\K[0-9]+' "$CSQTT_NET_UP" 2>/dev/null || true)
    fi
    if [ -z "$port" ]; then
        port=$(ss -tlpn 2>/dev/null | grep 'csqtt' | awk '{print $4}' | awk -F: '{print $NF}' | grep -v '46004' | head -n 1 || true)
    fi
    if [ -z "$port" ]; then
        port="37002"
    fi
    echo "$port"
}

get_csqtt_peer_port() {
    local port=""
    if [ -f "$CSQTT_SERVICE_FILE" ]; then
        port=$(grep -oP -- '--listen\s+0\.0\.0\.0:\K[0-9]+' "$CSQTT_SERVICE_FILE" 2>/dev/null || true)
    fi
    if [ -z "$port" ] && [ -f "$CSQTT_NET_UP" ]; then
        port=$(grep -oP 'PEER_PORT="\K[0-9]+' "$CSQTT_NET_UP" 2>/dev/null || true)
    fi
    if [ -z "$port" ]; then
        port=$(ss -ulpn 2>/dev/null | grep 'csqtt' | awk '{print $4}' | awk -F: '{print $NF}' | head -n 1 || true)
    fi
    if [ -z "$port" ]; then
        port="37000"
    fi
    echo "$port"
}

get_ssh_port() {
    local p=$(ss -tlnp 2>/dev/null | grep sshd | awk '{print $4}' | awk -F: '{print $NF}' | head -n 1)
    if [ -z "$p" ]; then
        p=$(grep -iE '^Port\s+' /etc/ssh/sshd_config /etc/ssh/sshd_config.d/*.conf 2>/dev/null | awk '{print $2}' | head -n 1)
    fi
    [ -z "$p" ] && p="22"
    echo "$p"
}

get_csqtt_user() {
    if [ -f "$CSQTT_ENV_FILE" ]; then
        local u=$(grep -oP '^CSQTT_WEB_USER="\K[^"]+' "$CSQTT_ENV_FILE" 2>/dev/null || true)
        [ -z "$u" ] && u=$(grep -oP '^CSQTT_WEB_USERNAME="\K[^"]+' "$CSQTT_ENV_FILE" 2>/dev/null || true)
        [ -n "$u" ] && echo "$u" && return
    fi
    echo "N/A"
}

get_csqtt_pass() {
    if [ -f "$CSQTT_ENV_FILE" ]; then
        local p=$(grep -oP '^CSQTT_WEB_PASS="\K[^"]+' "$CSQTT_ENV_FILE" 2>/dev/null || true)
        [ -z "$p" ] && p=$(grep -oP '^CSQTT_WEB_PASSWORD="\K[^"]+' "$CSQTT_ENV_FILE" 2>/dev/null || true)
        [ -n "$p" ] && echo "$p" && return
    fi
    echo "N/A"
}

update_csqtt_credentials() {
    local new_u="$1"
    local new_p="$2"
    [ -z "$new_u" ] || [ -z "$new_p" ] && return 1
    mkdir -p "$(dirname "$CSQTT_ENV_FILE")"
    touch "$CSQTT_ENV_FILE"

    sed -i -E '/^CSQTT_WEB_USER=/d' "$CSQTT_ENV_FILE" 2>/dev/null || true
    sed -i -E '/^CSQTT_WEB_USERNAME=/d' "$CSQTT_ENV_FILE" 2>/dev/null || true
    sed -i -E '/^CSQTT_WEB_PASS=/d' "$CSQTT_ENV_FILE" 2>/dev/null || true
    sed -i -E '/^CSQTT_WEB_PASSWORD=/d' "$CSQTT_ENV_FILE" 2>/dev/null || true

    cat << EOF >> "$CSQTT_ENV_FILE"
CSQTT_WEB_USER="${new_u}"
CSQTT_WEB_USERNAME="${new_u}"
CSQTT_WEB_PASS="${new_p}"
CSQTT_WEB_PASSWORD="${new_p}"
EOF
    chmod 600 "$CSQTT_ENV_FILE"
}

get_csqtt_tunnel_pass() {
    local db="/etc/csqtt/csqtt.db"
    if [ -f "$db" ]; then
        local p=$(python3 -c "import sqlite3; conn=sqlite3.connect('$db'); r=conn.execute(\"SELECT value FROM meta WHERE key='main_password'\").fetchone(); print(r[0] if r else '')" 2>/dev/null || true)
        [ -n "$p" ] && echo "$p" && return
    fi
    echo "N/A"
}

get_csqtt_connection_name() {
    if [ -f "$CSQTT_PROFILE_FILE" ]; then
        cat "$CSQTT_PROFILE_FILE" | tr -d '\r\n'
    else
        echo "CSQTT-${SERVER_IP}"
    fi
}

set_csqtt_connection_name() {
    local new_name="$1"
    mkdir -p "$CSQTT_DIR"
    echo -n "$new_name" > "$CSQTT_PROFILE_FILE"
}

csqtt_change_connection_name() {
    show_csqtt_header
    local cur_name=$(get_csqtt_connection_name)
    echo -e "${BOLD}--- Смена имени подключения CSQTT ---${NC}"
    echo -e "Текущее имя подключения: ${CYAN}${cur_name}${NC}"
    echo ""
    read -p "Введите новое имя подключения CSQTT (например: CSQTT-Home, MyCSQTT): " new_n
    new_n=$(echo "$new_n" | sed -e 's/^[[:space:]]*//' -e 's/[[:space:]]*$//')
    if [ -n "$new_n" ]; then
        set_csqtt_connection_name "$new_n"
        echo -e "${GREEN}✓ Имя подключения CSQTT успешно изменено на: ${BOLD}${new_n}${NC}"
    else
        echo -e "${YELLOW}Изменения отменены (пустое имя).${NC}"
    fi
    sleep 2
}

get_csqtt_link() {
    local port=$(get_csqtt_peer_port)
    local pass=$(get_csqtt_tunnel_pass)
    local name=$(get_csqtt_connection_name)
    if [ -n "$port" ] && [ -n "$pass" ] && [ "$pass" != "N/A" ]; then
        echo "csqtt://${pass}@${SERVER_IP}:${port}#${name}"
    fi
}

show_csqtt_client_link() {
    clear
    local link=$(get_csqtt_link)
    local name=$(get_csqtt_connection_name)
    echo -e "${CYAN}╔══════════════════════════════════════════════════════════════════════╗${NC}"
    echo -e "${CYAN}║${BOLD}          КЛИЕНТСКАЯ ССЫЛКА И QR-КОД CSQTT VPN                       ${CYAN}║${NC}"
    echo -e "${CYAN}╚══════════════════════════════════════════════════════════════════════╝${NC}"
    echo ""
    echo -e "  • Имя подключения: ${GREEN}${BOLD}${name}${NC}"
    if [ -n "$link" ]; then
        echo -e "  • Ссылка CSQTT:    ${CYAN}${BOLD}${link}${NC}"
        echo ""
        echo -e "${BOLD}QR-код для импорта в клиент CSQTT / TUNA:${NC}"
        qrencode -t ANSI256 "$link" 2>/dev/null || qrencode -t UTF8 "$link" 2>/dev/null || true
    else
        echo -e "${RED}Не удалось сформировать ссылку: проверьте пароль и порт CSQTT.${NC}"
    fi
    echo ""
    read -p "Нажмите Enter для возврата..."
}

is_csqtt_web_protected() {
    local port=$(get_csqtt_web_port)
    if [ -f "$CSQTT_LOCK_FILE" ]; then
        return 0
    fi
    if iptables -C INPUT ! -i lo -p tcp --dport "$port" -m comment --comment "CSQTT_SSH_ONLY" -j DROP 2>/dev/null; then
        return 0
    fi
    if iptables -S INPUT 2>/dev/null | grep -E -- "-A INPUT.*-p tcp.*--dport ${port}.*-j DROP" >/dev/null 2>&1; then
        return 0
    fi
    return 1
}

get_csqtt_protect_status() {
    if ! is_csqtt_installed; then
        echo -e "${RED}Не установлен${NC}"
        return
    fi
    if is_csqtt_web_protected; then
        echo -e "${GREEN}🔒 ЗАЩИЩЕНА (Только SSH-туннель)${NC}"
    else
        echo -e "${RED}⚠️ ОТКРЫТА (Прямой доступ из WAN)${NC}"
    fi
}

csqtt_patch_network_up() {
    [ -f "$CSQTT_NET_UP" ] || return 0
    if grep -q "CSQTT_SSH_ONLY" "$CSQTT_NET_UP" 2>/dev/null; then
        return 0
    fi
    python3 - << 'PYEOF' 2>/dev/null || true
path = "/usr/local/lib/csqtt/network-up.sh"
try:
    with open(path, "r", encoding="utf-8") as f:
        content = f.read()
    
    target = 'ipt -C INPUT -p tcp --dport "$WEB_PORT" -m comment --comment "$IPT_COMMENT" -j ACCEPT 2>/dev/null || ipt -I INPUT -p tcp --dport "$WEB_PORT" -m comment --comment "$IPT_COMMENT" -j ACCEPT'
    replacement = '''if [ -f "/etc/csqtt/ssh_only.lock" ]; then
    ipt -D INPUT -p tcp --dport "$WEB_PORT" -m comment --comment "$IPT_COMMENT" -j ACCEPT 2>/dev/null || true
    ipt -C INPUT ! -i lo -p tcp --dport "$WEB_PORT" -m comment --comment "CSQTT_SSH_ONLY" -j DROP 2>/dev/null || ipt -I INPUT 1 ! -i lo -p tcp --dport "$WEB_PORT" -m comment --comment "CSQTT_SSH_ONLY" -j DROP
else
    ipt -D INPUT ! -i lo -p tcp --dport "$WEB_PORT" -m comment --comment "CSQTT_SSH_ONLY" -j DROP 2>/dev/null || true
    ipt -C INPUT -p tcp --dport "$WEB_PORT" -m comment --comment "$IPT_COMMENT" -j ACCEPT 2>/dev/null || ipt -I INPUT -p tcp --dport "$WEB_PORT" -m comment --comment "$IPT_COMMENT" -j ACCEPT
fi'''
    if target in content:
        content = content.replace(target, replacement, 1)
        with open(path, "w", encoding="utf-8") as f:
            f.write(content)
except Exception:
    pass
PYEOF
}

csqtt_protect_web() {
    local port=$(get_csqtt_web_port)
    echo ""
    echo -e "${YELLOW}Активация режима изоляции веб-панели CSQTT...${NC}"
    mkdir -p "$CSQTT_DIR"
    touch "$CSQTT_LOCK_FILE"

    # Удаляем открытое правило ACCEPT
    iptables -D INPUT -p tcp --dport "$port" -m comment --comment "CSQTT_MANAGED" -j ACCEPT 2>/dev/null || true
    iptables -D INPUT -p tcp --dport "$port" -j ACCEPT 2>/dev/null || true

    # Устанавливаем DROP в начало цепочки INPUT для всех интерфейсов кроме lo
    iptables -D INPUT ! -i lo -p tcp --dport "$port" -m comment --comment "CSQTT_SSH_ONLY" -j DROP 2>/dev/null || true
    iptables -I INPUT 1 ! -i lo -p tcp --dport "$port" -m comment --comment "CSQTT_SSH_ONLY" -j DROP

    # Интегрируем проверку в network-up.sh для сохранения режима при рестартах
    csqtt_patch_network_up

    echo -e "${GREEN}✓ Защита веб-панели CSQTT успешно активирована!${NC}"
    echo -e "  Порт ${BOLD}${port}/TCP${NC} теперь полностью закрыт от доступа из интернета."
    echo -e "  Доступ открыт ${BOLD}только локально (127.0.0.1) через защищенный SSH-туннель${NC}."
    echo ""
}

csqtt_unprotect_web() {
    local port=$(get_csqtt_web_port)
    echo ""
    echo -e "${YELLOW}Открытие прямого доступа к веб-панели CSQTT...${NC}"
    rm -f "$CSQTT_LOCK_FILE"

    # Удаляем блокирующее правило DROP
    iptables -D INPUT ! -i lo -p tcp --dport "$port" -m comment --comment "CSQTT_SSH_ONLY" -j DROP 2>/dev/null || true
    iptables -D INPUT -i "$WAN_IF" -p tcp --dport "$port" -j DROP 2>/dev/null || true

    # Восстанавливаем ACCEPT правило CSQTT_MANAGED
    iptables -C INPUT -p tcp --dport "$port" -m comment --comment "CSQTT_MANAGED" -j ACCEPT 2>/dev/null || iptables -I INPUT -p tcp --dport "$port" -m comment --comment "CSQTT_MANAGED" -j ACCEPT

    # Интегрируем проверку в network-up.sh
    csqtt_patch_network_up

    echo -e "${GREEN}✓ Прямой доступ к веб-панели открыт.${NC}"
    echo -e "  Адрес для входа из интернета: ${CYAN}https://${SERVER_IP}:${port}${NC}"
    echo ""
}

show_csqtt_tunnel_card() {
    local port=$(get_csqtt_web_port)
    local peer_p=$(get_csqtt_peer_port)
    local ssh_p=$(get_ssh_port)
    local u=$(get_csqtt_user)
    local p=$(get_csqtt_pass)
    local tp=$(get_csqtt_tunnel_pass)

    clear
    echo -e "${CYAN}╔══════════════════════════════════════════════════════════════════════╗${NC}"
    echo -e "${CYAN}║${BOLD}          БЕЗОПАСНЫЙ ДОСТУП К ВЕБ-ПАНЕЛИ CSQTT ЧЕРЕЗ SSH             ${CYAN}║${NC}"
    echo -e "${CYAN}╚══════════════════════════════════════════════════════════════════════╝${NC}"
    echo ""
    echo -e "${BOLD}Параметры сервера и панели:${NC}"
    echo -e "  • IP сервера:       ${CYAN}${SERVER_IP}${NC}"
    echo -e "  • SSH порт:         ${CYAN}${ssh_p}${NC}"
    echo -e "  • Порт веб-панели:  ${CYAN}${port}/TCP${NC}"
    echo -e "  • VPN порт туннеля: ${CYAN}${peer_p}/UDP${NC}"
    echo -e "  • Пароль туннеля:   ${GREEN}${tp}${NC}"
    echo -e "  • Текущий статус:   $(get_csqtt_protect_status)"
    echo ""
    echo -e "${BOLD}Учетные данные для авторизации в панели:${NC}"
    echo -e "  • Логин:            ${GREEN}${u}${NC}"
    echo -e "  • Пароль:           ${GREEN}${p}${NC}"
    echo ""
    echo -e "${CYAN}────────────────────────────────────────────────────────────────────────${NC}"
    echo -e "${YELLOW}${BOLD}ШАГ 1: Запустите SSH-туннель на вашем ПК (в PowerShell или Терминале):${NC}"
    echo ""
    echo -e "  ${GREEN}${BOLD}ssh -N -L ${port}:127.0.0.1:${port} root@${SERVER_IP} -p ${ssh_p}${NC}"
    echo ""
    echo -e "  ${NC}💡 ${YELLOW}Что делают флаги:${NC}"
    echo -e "     ${BOLD}-N${NC} : режим туннелирования (не открывать командную строку сервера)"
    echo -e "     ${BOLD}-L ${port}:127.0.0.1:${port}${NC} : пробросить порт ${port} вашего ПК на порт панели сервера"
    echo -e "     ${BOLD}-p ${ssh_p}${NC} : активный порт SSH на сервере"
    echo ""
    echo -e "${CYAN}────────────────────────────────────────────────────────────────────────${NC}"
    echo -e "${YELLOW}${BOLD}ШАГ 2: Откройте браузер на вашем ПК и перейдите по адресу:${NC}"
    echo ""
    echo -e "  👉 ${CYAN}${BOLD}https://127.0.0.1:${port}${NC}"
    echo ""
    echo -e "  ${NC}⚠️ ${YELLOW}Важно при первом входе:${NC}"
    echo -e "     Панель использует HTTPS с самоподписанным TLS-сертификатом."
    echo -e "     Браузер выдаст предупреждение «Подключение не защищено»."
    echo -e "     Нажмите кнопку «Дополнительно» -> «Перейти на 127.0.0.1 (небезопасно)»."
    echo -e "${CYAN}────────────────────────────────────────────────────────────────────────${NC}"
    echo ""
    read -p "Нажмите Enter для возврата в меню..."
}

show_csqtt_credentials() {
    clear
    local port=$(get_csqtt_web_port)
    local peer_p=$(get_csqtt_peer_port)
    local ssh_p=$(get_ssh_port)
    local u=$(get_csqtt_user)
    local p=$(get_csqtt_pass)
    local tp=$(get_csqtt_tunnel_pass)
    local c_name=$(get_csqtt_connection_name)
    local c_link=$(get_csqtt_link)

    echo -e "${CYAN}╔══════════════════════════════════════════════════════════════════════╗${NC}"
    echo -e "${CYAN}║${BOLD}              РЕКВИЗИТЫ ДОСТУПА И ПАРОЛИ CSQTT                       ${CYAN}║${NC}"
    echo -e "${CYAN}╚══════════════════════════════════════════════════════════════════════╝${NC}"
    echo ""
    echo -e "${BOLD}🔐 Авторизация в Веб-Панели CSQTT:${NC}"
    echo -e "  • Прямой URL:            ${CYAN}https://${SERVER_IP}:${port}${NC}"
    echo -e "  • URL через SSH-туннель: ${CYAN}https://127.0.0.1:${port}${NC}"
    echo -e "  • Логин администратора:  ${GREEN}${BOLD}${u}${NC}"
    echo -e "  • Пароль администратора: ${GREEN}${BOLD}${p}${NC}"
    echo ""
    echo -e "${BOLD}🛡️ Параметры VPN Туннеля:${NC}"
    echo -e "  • IP сервера:            ${CYAN}${SERVER_IP}${NC}"
    echo -e "  • Порт туннеля (UDP):    ${CYAN}${peer_p}/UDP${NC}"
    echo -e "  • Имя подключения:       ${GREEN}${BOLD}${c_name}${NC}"
    echo -e "  • Пароль туннеля:        ${GREEN}${BOLD}${tp}${NC}"
    if [ -n "$c_link" ]; then
        echo -e "  • Клиентская ссылка:     ${CYAN}${BOLD}${c_link}${NC}"
    fi
    echo ""
    echo -e "${BOLD}ℹ️  Защита веб-панели:${NC} $(get_csqtt_protect_status)"
    echo ""
    echo -e "${CYAN}────────────────────────────────────────────────────────────────────────${NC}"
    echo -e "${YELLOW}Примечание:${NC} Реквизиты извлечены из ${BOLD}/etc/csqtt/csqtt.env${NC} и базы ${BOLD}csqtt.db${NC}."
    echo -e "Отображаются в режиме чтения (без изменений)."
    echo -e "${CYAN}────────────────────────────────────────────────────────────────────────${NC}"
    echo ""
    read -p "Нажмите Enter для возврата в меню..."
}

show_csqtt_header() {
    clear
    local port=$(get_csqtt_web_port)
    local peer_p=$(get_csqtt_peer_port)
    local u=$(get_csqtt_user)
    local p=$(get_csqtt_pass)
    local tp=$(get_csqtt_tunnel_pass)
    local c_name=$(get_csqtt_connection_name)
    echo -e "${CYAN}╔══════════════════════════════════════════════════════════════════════╗${NC}"
    echo -e "${CYAN}║${BOLD}          УПРАВЛЕНИЕ СЛУЖБОЙ CSQTT И ЗАЩИТОЙ ВЕБ-ПАНЕЛИ             ${CYAN}║${NC}"
    echo -e "${CYAN}╠══════════════════════════════════════════════════════════════════════╣${NC}"
    echo -e "${CYAN}║${NC}  Сервер:     ${BOLD}${SERVER_IP}${NC}  |  Статус: $(get_csqtt_status)"
    echo -e "${CYAN}║${NC}  VPN туннель: :${peer_p}/UDP  |  Фаервол: $(get_csqtt_tunnel_status)"
    echo -e "${CYAN}║${NC}  Имя подключения: ${GREEN}${BOLD}${c_name}${NC}"
    echo -e "${CYAN}║${NC}  Веб-панель:  :${port}/TCP    |  Защита: $(get_csqtt_protect_status)"
    echo -e "${CYAN}║${NC}  Вход в панель: Логин: ${GREEN}${u}${NC}  |  Пароль: ${GREEN}${p}${NC}  |  Пароль VPN: ${GREEN}${tp}${NC}"
    echo -e "${CYAN}╚══════════════════════════════════════════════════════════════════════╝${NC}"
    echo ""
}

menu_csqtt() {
    if ! is_csqtt_installed; then
        clear
        echo -e "${YELLOW}╔══════════════════════════════════════════════════════════════════════╗${NC}"
        echo -e "${YELLOW}║${BOLD}                     CSQTT НЕ ОБНАРУЖЕН                               ${YELLOW}║${NC}"
        echo -e "${YELLOW}╚══════════════════════════════════════════════════════════════════════╝${NC}"
        echo ""
        echo -e "${RED}Служба csqtt или исполняемый файл csqtt не найдены на данном сервере.${NC}"
        echo ""
        echo -e "Если вы установите CSQTT на этот сервер, данный раздел"
        echo -e "активируется автоматически при следующем запуске x-manager."
        echo ""
        read -p "Нажмите Enter для возврата..."
        return
    fi

    while true; do
        show_csqtt_header
        echo -e "  ${YELLOW}[1]${NC} 📊 Статус службы csqtt и активные сокеты"
        echo -e "  ${YELLOW}[2]${NC} 🔒 ${BOLD}Включить защиту веб-панели${NC} (Доступ ТОЛЬКО через SSH-туннель)"
        echo -e "  ${YELLOW}[3]${NC} 🔓 ${BOLD}Открыть прямой доступ к веб-панели из интернета${NC}"
        echo -e "  ${YELLOW}[4]${NC} 🛡️  ${BOLD}Включить / Выключить VPN-туннель в фаерволе${NC} ($(get_csqtt_tunnel_status))"
        echo -e "  ${YELLOW}[5]${NC} 🔑 ${BOLD}Команда SSH-туннеля и инструкция для ПК${NC}"
        echo -e "  ${YELLOW}[6]${NC} 📋 ${BOLD}Показать все реквизиты CSQTT${NC} (Логин, пароль панели и пароль туннеля)"
        echo -e "  ${YELLOW}[7]${NC} 📜 Живые логи службы csqtt (journalctl)"
        echo -e "  ${YELLOW}[8]${NC} 🔄 Перезапустить службу csqtt"
        echo -e "  ${YELLOW}[9]${NC} 🔑 ${BOLD}Сменить логин и пароль веб-панели CSQTT${NC}"
        echo -e "  ${YELLOW}[10]${NC} 🏷️  ${BOLD}Задать / изменить имя подключения CSQTT${NC} (сейчас: $(get_csqtt_connection_name))"
        echo -e "  ${YELLOW}[11]${NC} 🔗 ${BOLD}Показать клиентскую ссылку (csqtt://) и QR-код${NC}"
        echo -e "  ${YELLOW}[0]${NC} ⬅️  Назад в Главное Меню"
        echo ""
        read -p "Выберите пункт [0-11]: " c_choice
        case "$c_choice" in
            1)
                show_csqtt_header
                systemctl status csqtt --no-pager
                echo ""
                ss -tulpn | grep csqtt || echo "Сокеты csqtt не найдены"
                echo ""
                read -p "Нажмите Enter..."
                ;;
            2)
                csqtt_protect_web
                sleep 1
                show_csqtt_tunnel_card
                ;;
            3)
                csqtt_unprotect_web
                sleep 2
                ;;
            4)
                toggle_csqtt_tunnel_fw
                ;;
            5)
                show_csqtt_tunnel_card
                ;;
            6)
                show_csqtt_credentials
                ;;
            7)
                journalctl -u csqtt -f -n 50
                ;;
            8)
                echo -e "${YELLOW}Перезапуск службы csqtt...${NC}"
                systemctl restart csqtt
                sleep 2
                echo -e "${GREEN}✓ Служба csqtt перезапущена${NC}"
                sleep 1
                ;;
            9)
                echo ""
                read -p "Введите новый логин веб-панели CSQTT [Enter оставить текущий]: " new_c_u
                read -s -p "Введите новый пароль веб-панели CSQTT: " new_c_p
                echo ""
                [ -z "$new_c_u" ] && new_c_u=$(get_csqtt_user)
                [ "$new_c_u" = "N/A" ] && new_c_u="admin"
                if [ -n "$new_c_p" ]; then
                    update_csqtt_credentials "$new_c_u" "$new_c_p"
                    systemctl restart csqtt 2>/dev/null || true
                    echo -e "${GREEN}✓ Реквизиты сохранены в $CSQTT_ENV_FILE и служба перезапущена!${NC}"
                else
                    echo -e "${YELLOW}Пароль не может быть пустым.${NC}"
                fi
                sleep 2
                ;;
            10)
                csqtt_change_connection_name
                ;;
            11)
                show_csqtt_client_link
                ;;
            0) return ;;
            *) echo "Неверный выбор"; sleep 1 ;;
        esac
    done
}

# ==============================================================================

# ==============================================================================
# РАЗДЕЛ 5: DNS-ТУННЕЛИ (COTTENDNS / MASTERDNSVPN)
# ==============================================================================

get_active_dns_engine() {
    if systemctl is-active --quiet "$MASTERDNS_SERVICE" 2>/dev/null; then
        echo "masterdns"
    elif systemctl is-active --quiet "$COTTEN_SERVICE" 2>/dev/null; then
        echo "cottendns"
    elif is_masterdns_installed; then
        echo "masterdns"
    else
        echo "cottendns"
    fi
}

get_dns_engine_name() {
    local eng=$(get_active_dns_engine)
    if [ "$eng" = "masterdns" ]; then
        echo "MasterDnsVPN (Основной движок)"
    else
        echo "CottenDNS (Альтернативный WhiteDNS)"
    fi
}

get_dns_status() {
    if ! is_dns_installed; then
        echo -e "${RED}НЕ УСТАНОВЛЕН${NC}"
        return
    fi
    local eng=$(get_active_dns_engine)
    local s_name="MasterDnsVPN"
    [ "$eng" = "cottendns" ] && s_name="CottenDNS"

    if systemctl is-active --quiet "$eng" 2>/dev/null; then
        echo -e "${GREEN}АКТИВЕН (${s_name})${NC}"
    elif systemctl is-enabled --quiet "$eng" 2>/dev/null; then
        echo -e "${YELLOW}ОСТАНОВЛЕН (${s_name})${NC}"
    else
        echo -e "${RED}ОСТАНОВЛЕН (${s_name})${NC}"
    fi
}

# ==============================================================================
# SSL & СЕРТИФИКАТЫ: ACME, CLOUDFLARE WILDCARD, HTTP-01, ДЕТЕКЦИЯ СТАТУСА
# ==============================================================================
CF_ENV_FILE="/etc/x-manager/cloudflare.env"
[ ! -f "$CF_ENV_FILE" ] && [ -f "/etc/tuna-vpn/cloudflare.env" ] && CF_ENV_FILE="/etc/tuna-vpn/cloudflare.env"

# Обнаружение основного активного сертификата по всем стандартным путям:
# /etc/x-manager/ (cloudflare.env), /root/cert/, /etc/x-ui/, /etc/letsencrypt/, /etc/ssl/, /root/.acme.sh/
# Возвращает строку: "CERT_PATH|KEY_PATH|DOMAIN|EXPIRY_DATE"
detect_primary_ssl_cert() {
    local candidates=()

    # 1. Проверяем cloudflare.env
    for cf_env in "/etc/x-manager/cloudflare.env" "/etc/tuna-vpn/cloudflare.env"; do
        if [ -f "$cf_env" ]; then
            local c_f=$(grep -oP '^CERT_FILE="\K[^"]+' "$cf_env" 2>/dev/null || grep -oP '^CERT_FILE=\K.*' "$cf_env" 2>/dev/null | tr -d '"')
            local k_f=$(grep -oP '^KEY_FILE="\K[^"]+' "$cf_env" 2>/dev/null || grep -oP '^KEY_FILE=\K.*' "$cf_env" 2>/dev/null | tr -d '"')
            local d_m=$(grep -oP '^DOMAIN="\K[^"]+' "$cf_env" 2>/dev/null || grep -oP '^DOMAIN=\K.*' "$cf_env" 2>/dev/null | tr -d '"')
            if [ -f "$c_f" ] && [ -f "$k_f" ]; then
                candidates+=("${c_f}|${k_f}|${d_m}")
            fi
        fi
    done

    # 2. /root/cert/<domain>/
    if [ -d "/root/cert" ]; then
        for dir in /root/cert/*; do
            [ -d "$dir" ] || continue
            local d_name=$(basename "$dir")
            local c="" k=""
            [ -f "${dir}/fullchain.pem" ] && c="${dir}/fullchain.pem"
            [ -z "$c" ] && [ -f "${dir}/fullchain.cer" ] && c="${dir}/fullchain.cer"
            [ -z "$c" ] && [ -f "${dir}/cert.pem" ] && c="${dir}/cert.pem"
            [ -z "$c" ] && [ -f "${dir}/cert.crt" ] && c="${dir}/cert.crt"

            [ -f "${dir}/privkey.pem" ] && k="${dir}/privkey.pem"
            [ -z "$k" ] && [ -f "${dir}/privkey.key" ] && k="${dir}/privkey.key"
            [ -z "$k" ] && [ -f "${dir}/key.pem" ] && k="${dir}/key.pem"
            [ -z "$k" ] && [ -f "${dir}/private.key" ] && k="${dir}/private.key"

            if [ -n "$c" ] && [ -n "$k" ]; then
                candidates+=("${c}|${k}|${d_name}")
            fi
        done
        if [ -f "/root/cert/fullchain.pem" ] && [ -f "/root/cert/privkey.pem" ]; then
            candidates+=("/root/cert/fullchain.pem|/root/cert/privkey.pem|cert")
        fi
    fi

    # 3. /etc/x-ui/
    if [ -f "/etc/x-ui/server.crt" ] && [ -f "/etc/x-ui/server.key" ]; then
        candidates+=("/etc/x-ui/server.crt|/etc/x-ui/server.key|3x-ui")
    fi
    if [ -f "/etc/x-ui/cert.pem" ] && [ -f "/etc/x-ui/key.pem" ]; then
        candidates+=("/etc/x-ui/cert.pem|/etc/x-ui/key.pem|3x-ui")
    fi

    # 4. /etc/letsencrypt/live/<domain>/
    if [ -d "/etc/letsencrypt/live" ]; then
        for dir in /etc/letsencrypt/live/*; do
            [ -d "$dir" ] || continue
            local d_name=$(basename "$dir")
            [ "$d_name" = "README" ] && continue
            if [ -f "${dir}/fullchain.pem" ] && [ -f "${dir}/privkey.pem" ]; then
                candidates+=("${dir}/fullchain.pem|${dir}/privkey.pem|${d_name}")
            fi
        done
    fi

    # 5. /etc/ssl/ (tuna-vpn или вложенные папки)
    if [ -d "/etc/ssl" ]; then
        for dir in /etc/ssl/tuna-vpn/* /etc/ssl/*; do
            [ -d "$dir" ] || continue
            local d_name=$(basename "$dir")
            [ "$d_name" = "certs" ] || [ "$d_name" = "private" ] && continue
            local c="" k=""
            [ -f "${dir}/fullchain.cer" ] && c="${dir}/fullchain.cer"
            [ -z "$c" ] && [ -f "${dir}/fullchain.pem" ] && c="${dir}/fullchain.pem"
            [ -f "${dir}/privkey.key" ] && k="${dir}/privkey.key"
            [ -z "$k" ] && [ -f "${dir}/privkey.pem" ] && k="${dir}/privkey.pem"
            if [ -n "$c" ] && [ -n "$k" ]; then
                candidates+=("${c}|${k}|${d_name}")
            fi
        done
    fi

    # 6. /root/.acme.sh/
    if [ -d "/root/.acme.sh" ]; then
        for dir in /root/.acme.sh/*_ecc /root/.acme.sh/*; do
            [ -d "$dir" ] || continue
            local bname=$(basename "$dir")
            local d_clean=$(echo "$bname" | sed 's/_ecc$//')
            if [ -f "${dir}/fullchain.cer" ] && [ -f "${dir}/${d_clean}.key" ]; then
                candidates+=("${dir}/fullchain.cer|${dir}/${d_clean}.key|${d_clean}")
            fi
        done
    fi

    # Проверяем кандидатов: сначала ищем действующий (не просроченный)
    local fallback=""
    for cand in "${candidates[@]}"; do
        local c_path=$(echo "$cand" | cut -d'|' -f1)
        local k_path=$(echo "$cand" | cut -d'|' -f2)
        local d_label=$(echo "$cand" | cut -d'|' -f3)

        if [ -f "$c_path" ] && [ -f "$k_path" ]; then
            local exp=$(openssl x509 -enddate -noout -in "$c_path" 2>/dev/null | cut -d= -f2 || true)
            # Извлекаем реальное имя домена из CN/SAN если метка техническая
            if [ -z "$d_label" ] || [ "$d_label" = "3x-ui" ] || [ "$d_label" = "cert" ]; then
                local cn=$(openssl x509 -subject -noout -in "$c_path" 2>/dev/null | grep -oP 'CN\s*=\s*\K[^,\/]+' || true)
                [ -n "$cn" ] && d_label="$cn"
            fi
            # Проверка срока действия (redirect stdout and stderr to prevent text leak)
            if openssl x509 -in "$c_path" -noout -checkend 0 >/dev/null 2>&1; then
                echo "${c_path}|${k_path}|${d_label}|${exp}"
                return 0
            else
                [ -z "$fallback" ] && fallback="${c_path}|${k_path}|${d_label}|${exp} (ИСТЕК)"
            fi
        fi
    done

    if [ -n "$fallback" ]; then
        echo "$fallback"
        return 1
    fi

    return 2
}

get_ssl_short_status() {
    local cert_info=$(detect_primary_ssl_cert 2>/dev/null | tail -n 1 || true)
    if [ -n "$cert_info" ]; then
        local d_label=$(echo "$cert_info" | cut -d'|' -f3 | tr -d '\r\n')
        local exp=$(echo "$cert_info" | cut -d'|' -f4 | tr -d '\r\n')
        if echo "$exp" | grep -qi "ИСТЕК"; then
            echo -e "${RED}ИСТЕК (${d_label})${NC}"
        else
            echo -e "${GREEN}АКТИВЕН (${d_label})${NC}"
        fi
    else
        echo -e "${YELLOW}НЕ НАСТРОЕН${NC}"
    fi
}

sync_ssl_to_xui() {
    local c_file="$1"
    local k_file="$2"
    if [ -z "$c_file" ] || [ -z "$k_file" ]; then
        local primary=$(detect_primary_ssl_cert 2>/dev/null || true)
        if [ -n "$primary" ]; then
            c_file=$(echo "$primary" | cut -d'|' -f1)
            k_file=$(echo "$primary" | cut -d'|' -f2)
        fi
    fi

    if [ -n "$c_file" ] && [ -f "$c_file" ] && [ -n "$k_file" ] && [ -f "$k_file" ]; then
        if [ -d "/etc/x-ui" ]; then
            cp -f "$c_file" /etc/x-ui/server.crt 2>/dev/null || true
            cp -f "$k_file" /etc/x-ui/server.key 2>/dev/null || true
            chmod 600 /etc/x-ui/server.key 2>/dev/null || true
            systemctl restart x-ui 2>/dev/null || true
            echo -e "  ${GREEN}✓ Сертификаты синхронизированы в /etc/x-ui/ (server.crt, server.key)${NC}"
        else
            echo -e "  ${YELLOW}Директория /etc/x-ui не найдена на сервере.${NC}"
        fi
    else
        echo -e "  ${RED}Файлы сертификата не найдены для синхронизации.${NC}"
    fi
}

menu_ssl() {
    while true; do
        clear
        local p_cert=$(detect_primary_ssl_cert 2>/dev/null || true)
        local c_path="Не обнаружен"
        local k_path="Не обнаружен"
        local d_label="—"
        local exp="—"
        local is_ok=false

        if [ -n "$p_cert" ]; then
            c_path=$(echo "$p_cert" | cut -d'|' -f1)
            k_path=$(echo "$p_cert" | cut -d'|' -f2)
            d_label=$(echo "$p_cert" | cut -d'|' -f3)
            exp=$(echo "$p_cert" | cut -d'|' -f4)
            if ! echo "$exp" | grep -qi "ИСТЕК"; then
                is_ok=true
            fi
        fi

        echo -e "${CYAN}╔══════════════════════════════════════════════════════════════════════╗${NC}"
        echo -e "${CYAN}║${BOLD}          ЦЕНТР УПРАВЛЕНИЯ И СТАТУСА SSL-СЕРТИФИКАТОВ                 ${CYAN}║${NC}"
        echo -e "${CYAN}╠══════════════════════════════════════════════════════════════════════╣${NC}"
        echo -e "${CYAN}║${NC}  Статус SSL:    $(get_ssl_short_status)"
        echo -e "${CYAN}║${NC}  Домен:         ${BOLD}${d_label}${NC}"
        echo -e "${CYAN}║${NC}  Срок действия: ${BOLD}${exp}${NC}"
        echo -e "${CYAN}║${NC}  Файл fullchain: ${c_path}"
        echo -e "${CYAN}║${NC}  Файл privkey:   ${k_path}"
        echo -e "${CYAN}╚══════════════════════════════════════════════════════════════════════╝${NC}"
        echo ""
        echo -e "  ${YELLOW}[1]${NC} 🔍 ${BOLD}Детальный скан всех путей сертификатов${NC} (/etc/x-ui, /root/cert, letsencrypt...)"
        echo -e "  ${YELLOW}[2]${NC} 📥 ${BOLD}Синхронизировать сертификат в 3X-UI${NC} (/etc/x-ui/server.crt)"
        echo -e "  ${YELLOW}[3]${NC} 🔄 ${BOLD}Проверить срок годности сертификата через OpenSSL${NC}"
        echo -e "  ${YELLOW}[4]${NC} 💡 ${BOLD}Памятка по управлению SSL через веб-панель 3X-UI${NC}"
        echo -e "  ${YELLOW}[0]${NC} ⬅️  Назад в Главное Меню"
        echo ""
        read -p "Выберите действие [0-4]: " ssl_act
        case "$ssl_act" in
            1)
                clear
                echo -e "${CYAN}=== СКАНИРОВАНИЕ СЕРТИФИКАТОВ НА СЕРВЕРЕ ===${NC}\n"
                for path in "/etc/x-ui" "/root/cert" "/etc/letsencrypt/live" "/etc/ssl" "/root/.acme.sh" "/etc/x-manager/cloudflare.env"; do
                    echo -e "${BOLD}Проверка пути:${NC} ${CYAN}${path}${NC}"
                    if [ -e "$path" ]; then
                        echo -e "  ${GREEN}[✓] Путь существует${NC}"
                    else
                        echo -e "  ${YELLOW}[-] Не найден${NC}"
                    fi
                done
                echo ""
                echo -e "${BOLD}Обнаруженный рабочий сертификат:${NC}"
                if [ -n "$p_cert" ]; then
                    echo -e "  • Домен:   ${GREEN}${d_label}${NC}"
                    echo -e "  • Cert:    ${CYAN}${c_path}${NC}"
                    echo -e "  • Key:     ${CYAN}${k_path}${NC}"
                    echo -e "  • Истекает: ${YELLOW}${exp}${NC}"
                else
                    echo -e "  ${RED}Действующие сертификаты не обнаружены.${NC}"
                fi
                echo ""
                read -p "Нажмите Enter для возврата..."
                ;;
            2)
                echo ""
                sync_ssl_to_xui
                sleep 2
                ;;
            3)
                clear
                echo -e "${CYAN}=== ПРОВЕРКА СЕРТИФИКАТА ЧЕРЕЗ OPENSSL ===${NC}\n"
                if [ -f "$c_path" ]; then
                    openssl x509 -in "$c_path" -text -noout | grep -E "(Issuer:|Subject:|Not Before|Not After|DNS:)" || openssl x509 -in "$c_path" -noout -subject -dates
                else
                    echo -e "${YELLOW}Сертификат не найден.${NC}"
                fi
                echo ""
                read -p "Нажмите Enter для возврата..."
                ;;
            4)
                clear
                echo -e "${CYAN}╔══════════════════════════════════════════════════════════════════════╗${NC}"
                echo -e "${CYAN}║${BOLD}          УПРАВЛЕНИЕ SSL ЧЕРЕЗ ВЕБ-ПАНЕЛЬ 3X-UI                       ${CYAN}║${NC}"
                echo -e "${CYAN}╚══════════════════════════════════════════════════════════════════════╝${NC}"
                echo ""
                echo -e "Выпуск и продление SSL сертификатов (Cloudflare DNS-01 API / HTTP-01)"
                echo -e "штатно выполняются в веб-интерфейсе 3X-UI:"
                echo ""
                echo -e "  1. Откройте веб-панель 3X-UI в браузере."
                echo -e "  2. Перейдите в раздел ${BOLD}«Настройки панели»${NC} -> ${BOLD}«Сертификат SSL»${NC}."
                echo -e "  3. Выберите выпуск через Cloudflare DNS API (введите токен) или Let's Encrypt."
                echo -e "  4. Панель автоматически сохранит сертификат в ${CYAN}/etc/x-ui/server.crt${NC}."
                echo -e "  5. ${BOLD}x-manager${NC} моментально подхватывает этот сертификат для DNS-туннелей и служб."
                echo ""
                read -p "Нажмите Enter для возврата..."
                ;;
            0) return ;;
            *) echo "Неверный выбор"; sleep 1 ;;
        esac
    done
}

detect_base_domain() {
    local d=""
    # 0. Check detected primary SSL certificate
    local primary_cert=$(detect_primary_ssl_cert 2>/dev/null || true)
    if [ -n "$primary_cert" ]; then
        d=$(echo "$primary_cert" | cut -d'|' -f3)
    fi
    # 1. Check cert dirs in /root/cert
    if [ -z "$d" ] && [ -d "/root/cert" ]; then
        d=$(find /root/cert -mindepth 1 -maxdepth 1 -type d -printf '%f\n' 2>/dev/null | grep -v '^\.' | head -n 1)
    fi
    # 2. Check acme.sh ecc dirs
    if [ -z "$d" ] && [ -d "/root/.acme.sh" ]; then
        d=$(find /root/.acme.sh -mindepth 1 -maxdepth 1 -type d -name '*_ecc' -printf '%f\n' 2>/dev/null | sed 's/_ecc$//' | head -n 1)
    fi
    # 3. Check 3x-ui / xray config
    if [ -z "$d" ]; then
        d=$(grep -oP '"serverName":\s*"\K[^"]+' /usr/local/x-ui/bin/config.json /etc/xray/config.json 2>/dev/null | grep -v '127.0.0.1' | head -n 1)
    fi
    # 4. Check caddy
    if [ -z "$d" ] && [ -f "/etc/caddy/Caddyfile" ]; then
        d=$(grep -oP '^[a-zA-Z0-9.-]+\.[a-zA-Z]{2,}' /etc/caddy/Caddyfile 2>/dev/null | head -n 1)
    fi
    # 5. Check hostname if it is a valid domain
    if [ -z "$d" ]; then
        local hn=$(hostname -f 2>/dev/null)
        if echo "$hn" | grep -qE '\.[a-zA-Z]{2,}$'; then
            d="$hn"
        fi
    fi
    # Strip any wildcard (*.), d. or whitespace
    d=$(echo "$d" | sed -e 's/^\*\.//' -e 's/^d\.//' | tr -d '[:space:]')
    echo "$d"
}

get_dns_domain() {
    local conf="$MASTERDNS_CONFIG_FILE"
    [ -f "$conf" ] || conf="$COTTEN_CONFIG_FILE"
    local dom=""
    if [ -f "$conf" ]; then
        dom=$(grep -oP 'DOMAIN\s*=\s*\["\K[^"]+' "$conf" 2>/dev/null | head -n 1 || true)
    fi
    if [ -z "$dom" ]; then
        local base_d=$(detect_base_domain)
        if [ -n "$base_d" ]; then
            dom="d.${base_d}"
        else
            dom="d.lesovoi.pro"
        fi
    fi
    echo "$dom"
}

get_dns_key() {
    local kf="$MASTERDNS_KEY_FILE"
    [ -f "$kf" ] || kf="$COTTEN_KEY_FILE"
    local k=""
    [ -f "$kf" ] && k=$(cat "$kf" 2>/dev/null | tr -d '[:space:]' || true)
    [ -z "$k" ] && k="a7125b5f3cc23e525123c677bc6d202e"
    echo "$k"
}

get_dns_profile_name() {
    local pf="/etc/x-manager/dns_profile_name.txt"
    [ -f "$pf" ] || pf="/etc/masterdns/profile_name.txt"
    [ -f "$pf" ] || pf="/etc/cottendns/profile_name.txt"
    local pname=""
    [ -f "$pf" ] && pname=$(cat "$pf" 2>/dev/null | tr -d '\r\n' || true)
    [ -z "$pname" ] && pname="FP dns tunnel"
    echo "$pname"
}

get_dns_routing() {
    local conf="$MASTERDNS_CONFIG_FILE"
    [ -f "$conf" ] || conf="$COTTEN_CONFIG_FILE"
    if grep -qi "USE_EXTERNAL_SOCKS5\s*=\s*true" "$conf" 2>/dev/null; then
        echo -e "${GREEN}Маршрутизация Xray SOCKS5 (127.0.0.1:10808)${NC}"
    else
        echo -e "${YELLOW}Прямой выход (Direct)${NC}"
    fi
}

is_dns_wan_blocked() {
    [ -f "$DNS_WAN_LOCK" ] && return 0
    if iptables -C INPUT -i "$WAN_IF" -p udp --dport 53 -m comment --comment "DNS_WAN_BLOCK" -j DROP 2>/dev/null; then
        return 0
    fi
    if iptables -S INPUT 2>/dev/null | grep -E -- "-A INPUT.*-i (ens3|eth0|${WAN_IF}).*-p udp.*--dport 53.*-j DROP" >/dev/null 2>&1; then
        return 0
    fi
    return 1
}

get_dns_wan_status() {
    if ! is_dns_installed; then
        echo -e "${RED}Не установлен${NC}"
        return
    fi
    if is_dns_wan_blocked; then
        echo -e "${RED}🔒 БЛОКИРОВАН В WAN (Только локально)${NC}"
    else
        echo -e "${GREEN}🟢 ВКЛЮЧЕН (Открыт для интернета)${NC}"
    fi
}

toggle_dns_wan() {
    echo ""
    if is_dns_wan_blocked; then
        echo -e "${YELLOW}Открытие доступа к DNS-туннелю из внешнего интернета (WAN)...${NC}"
        iptables -D INPUT -i "$WAN_IF" -p udp --dport 53 -m comment --comment "DNS_WAN_BLOCK" -j DROP 2>/dev/null || true
        iptables -D INPUT -i "$WAN_IF" -p tcp --dport 53 -m comment --comment "DNS_WAN_BLOCK" -j DROP 2>/dev/null || true
        rm -f "$DNS_WAN_LOCK"
        echo -e "${GREEN}✓ Доступ из WAN успешно ОТКРЫТ! Порт 53 UDP/TCP принимает подключения.${NC}"
    else
        echo -e "${YELLOW}Блокировка доступа к DNS-туннелю из внешнего интернета (WAN)...${NC}"
        mkdir -p /etc/x-manager
        touch "$DNS_WAN_LOCK"
        iptables -D INPUT -i "$WAN_IF" -p udp --dport 53 -m comment --comment "DNS_WAN_BLOCK" -j DROP 2>/dev/null || true
        iptables -D INPUT -i "$WAN_IF" -p tcp --dport 53 -m comment --comment "DNS_WAN_BLOCK" -j DROP 2>/dev/null || true
        iptables -I INPUT 1 -i "$WAN_IF" -p udp --dport 53 -m comment --comment "DNS_WAN_BLOCK" -j DROP
        iptables -I INPUT 1 -i "$WAN_IF" -p tcp --dport 53 -m comment --comment "DNS_WAN_BLOCK" -j DROP
        echo -e "${GREEN}✓ Доступ из WAN успешно ЗАБЛОКИРОВАН! Трафик на порт 53 сбрасывается (DROP).${NC}"
    fi
    sleep 2
}

switch_dns_engine() {
    echo ""
    local active=$(get_active_dns_engine)
    if [ "$active" = "cottendns" ]; then
        if ! is_masterdns_installed; then
            echo -e "${YELLOW}MasterDnsVPN еще не установлен на сервере.${NC}"
            read -p "Желаете установить MasterDnsVPN прямо сейчас? [y/N]: " inst_ans
            if [[ "$inst_ans" =~ ^[yYдД] ]]; then
                install_masterdns
            fi
            return
        fi
        echo -e "${YELLOW}Переключение с CottenDNS на MasterDnsVPN...${NC}"
        systemctl stop cottendns 2>/dev/null || true
        systemctl disable cottendns 2>/dev/null || true
        systemctl enable masterdns 2>/dev/null || true
        systemctl restart masterdns
        sleep 2
        if systemctl is-active --quiet masterdns; then
            echo -e "${GREEN}✓ Успешно активирован MasterDnsVPN на порту 53!${NC}"
        else
            echo -e "${RED}✗ Ошибка запуска MasterDnsVPN!${NC}"
            journalctl -u masterdns -n 10 --no-pager
        fi
    else
        if ! is_cottendns_installed; then
            echo -e "${YELLOW}CottenDNS еще не установлен на сервере.${NC}"
            read -p "Желаете установить CottenDNS (WhiteDNS Engine) прямо сейчас? [y/N]: " inst_ans
            if [[ "$inst_ans" =~ ^[yYдД] ]]; then
                install_cottendns
            fi
            return
        fi
        echo -e "${YELLOW}Переключение с MasterDnsVPN на CottenDNS (WhiteDNS Engine)...${NC}"
        systemctl stop masterdns 2>/dev/null || true
        systemctl disable masterdns 2>/dev/null || true
        systemctl enable cottendns 2>/dev/null || true
        systemctl restart cottendns
        sleep 2
        if systemctl is-active --quiet cottendns; then
            echo -e "${GREEN}✓ Успешно активирован CottenDNS (WhiteDNS Engine) на порту 53!${NC}"
        else
            echo -e "${RED}✗ Ошибка запуска CottenDNS!${NC}"
            journalctl -u cottendns -n 10 --no-pager
        fi
    fi
    sleep 2
}

get_stormdns_link() {
    local p_type="$1"
    local p_domain="$2"
    local p_key="$3"
    local p_name="$4"
    [ -z "$p_domain" ] && p_domain=$(get_dns_domain)
    [ -z "$p_key" ] && p_key=$(get_dns_key)
    [ -z "$p_name" ] && p_name=$(get_dns_profile_name)
    python3 - << PYEOF
import json, base64

domain = "${p_domain}"
key = "${p_key}"
name = "${p_name}"
ptype = int("${p_type}")

resolvers = "1.1.1.1\n1.0.0.1\n8.8.8.8\n8.8.4.4\n9.9.9.9\n77.88.8.8\n77.88.8.1\n77.88.8.2\n77.88.8.3\n77.88.8.7\n77.88.8.88"

p = {
    "schema": "whitedns.profile",
    "version": 1,
    "profile": {
        "name": name,
        "server": {
            "domain": domain,
            "encryption_key": key,
            "encryption_method": 5
        },
        "resolvers": resolvers,
        "resolver_balancing_strategy": 2,
        "upload_compression_type": 0,
        "download_compression_type": 0,
        "rx_tx_workers": 4,
        "tunnel_process_workers": 0,
        "max_packets_per_batch": 8,
        "arq_window_size": 600,
        "arq_max_rto_seconds": 5
    }
}

if ptype == 1:
    p["profile"].update({
        "packet_duplication_count": 4,
        "setup_packet_duplication_count": 4,
        "base_encode_data": True,
        "min_upload_mtu": 28,
        "max_upload_mtu": 200,
        "min_download_mtu": 60,
        "max_download_mtu": 900,
        "arq_initial_rto_seconds": 2,
        "ping_aggressive_interval_seconds": 0.05,
        "ping_lazy_interval_seconds": 0.5,
        "ping_cooldown_interval_seconds": 2,
        "ping_cold_interval_seconds": 15
    })
elif ptype == 2:
    p["profile"].update({
        "packet_duplication_count": 2,
        "setup_packet_duplication_count": 2,
        "base_encode_data": False,
        "min_upload_mtu": 38,
        "max_upload_mtu": 150,
        "min_download_mtu": 100,
        "max_download_mtu": 500,
        "arq_initial_rto_seconds": 1,
        "ping_aggressive_interval_seconds": 0.1,
        "ping_lazy_interval_seconds": 0.75,
        "ping_cooldown_interval_seconds": 2,
        "ping_cold_interval_seconds": 15
    })
elif ptype == 3:
    p["profile"].update({
        "packet_duplication_count": 1,
        "setup_packet_duplication_count": 2,
        "base_encode_data": False,
        "min_upload_mtu": 38,
        "max_upload_mtu": 150,
        "min_download_mtu": 100,
        "max_download_mtu": 500,
        "arq_initial_rto_seconds": 1,
        "ping_aggressive_interval_seconds": 0.1,
        "ping_lazy_interval_seconds": 0.75,
        "ping_cooldown_interval_seconds": 4,
        "ping_cold_interval_seconds": 30
    })

raw = json.dumps(p, separators=(',', ':'))
print("stormdns://" + base64.b64encode(raw.encode('utf-8')).decode('utf-8'))
PYEOF
}

show_single_dns_profile() {
    local ptype="$1"
    local title="$2"
    local desc="$3"
    local tag="$4"
    local dom=$(get_dns_domain)
    local key=$(get_dns_key)
    local base_name=$(get_dns_profile_name)
    local pname="${base_name}"
    [ -n "$tag" ] && pname="${base_name} [${tag}]"
    local link=$(get_stormdns_link "$ptype" "$dom" "$key" "$pname")

    clear
    echo -e "${CYAN}╔══════════════════════════════════════════════════════════════════════╗${NC}"
    echo -e "${CYAN}║${BOLD}  $title  ${CYAN}║${NC}"
    echo -e "${CYAN}╚══════════════════════════════════════════════════════════════════════╝${NC}"
    echo ""
    echo -e "${BOLD}Параметры профиля:${NC}"
    echo -e "  • Имя профиля:   ${YELLOW}${pname}${NC}"
    echo -e "  • Домен зоны:    ${CYAN}${dom}${NC}"
    echo -e "  • Ключ:          ${GREEN}${key}${NC} (AES-256-GCM)"
    echo -e "  • Особенности:   ${YELLOW}${desc}${NC}"
    echo ""
    echo -e "${BOLD}--- QR-код для сканирования в приложении WhiteDNS / StormDNS ---${NC}"
    qrencode -t ANSI256 "$link" 2>/dev/null || qrencode -t UTF8 "$link" 2>/dev/null || echo "qrencode не смог отрендерить"
    echo ""
    echo -e "${BOLD}--- Ссылка для импорта (stormdns://) ---${NC}"
    echo -e "${CYAN}${link}${NC}"
    echo ""
    read -p "Нажмите Enter для возврата..."
}

show_dns_profiles() {
    local dom=$(get_dns_domain)
    local key=$(get_dns_key)

    while true; do
        clear
        local base_pname=$(get_dns_profile_name)
        echo -e "${CYAN}╔══════════════════════════════════════════════════════════════════════╗${NC}"
        echo -e "${CYAN}║${BOLD}          ПРОФИЛИ ПОДКЛЮЧЕНИЯ WHITEDNS / STORMDNS                     ${CYAN}║${NC}"
        echo -e "${CYAN}╠══════════════════════════════════════════════════════════════════════╣${NC}"
        echo -e "${CYAN}║${NC}  Имя базы: ${YELLOW}${BOLD}${base_pname}${NC}"
        echo -e "${CYAN}║${NC}  Домен:    ${BOLD}${dom}${NC}  |  Ключ: ${GREEN}${key:0:16}...${NC}  |  AES-256-GCM"
        echo -e "${CYAN}╚══════════════════════════════════════════════════════════════════════╝${NC}"
        echo ""
        echo -e "  ${YELLOW}[1]${NC} 🛡️  ${BOLD}Профиль 1: «Жесткая цензура»${NC}"
        echo "      (Дублирование x4, base32 кодирование, агрессивный пинг, безопасный MTU 28-200)"
        echo ""
        echo -e "  ${YELLOW}[2]${NC} ⚡ ${BOLD}Профиль 2: «Стандартный»${NC}"
        echo "      (Дублирование x2, оптимальная скорость и низкая задержка, MTU 38-150)"
        echo ""
        echo -e "  ${YELLOW}[3]${NC} 🚀 ${BOLD}Профиль 3: «Мобильный / Скоростной»${NC}"
        echo "      (Дублирование x1, энергосбережение батареи, увеличенные тайм-ауты ожидания)"
        echo ""
        echo -e "  ${YELLOW}[4]${NC} 📋 ${BOLD}Показать все 3 ссылки списком для копирования${NC}"
        echo -e "  ${YELLOW}[0]${NC} ⬅️  Назад в меню DNS-туннелей"
        echo ""
        read -p "Выберите профиль [0-4]: " prof_choice
        case "$prof_choice" in
            1)
                show_single_dns_profile 1 "ПРОФИЛЬ 1: ЖЕСТКАЯ ЦЕНЗУРА (MAX SURVIVAL)" "Дублирование x4, Base32, Пинг 50ms, MTU 28..200/60..900" "Жесткая цензура"
                ;;
            2)
                show_single_dns_profile 2 "ПРОФИЛЬ 2: СТАНДАРТНЫЙ (BALANCED SPEED)" "Дублирование x2, Пинг 100ms, MTU 38..150/100..500" "Стандартный"
                ;;
            3)
                show_single_dns_profile 3 "ПРОФИЛЬ 3: МОБИЛЬНЫЙ / СКОРОСТНОЙ (LOW BATTERY)" "Дублирование x1, Пинг 100ms, Cooldown 4s, MTU 38..150/100..500" "Скоростной"
                ;;
            4)
                clear
                echo -e "${CYAN}╔══════════════════════════════════════════════════════════════════════╗${NC}"
                echo -e "${CYAN}║${BOLD}          ВСЕ 3 ПРОФИЛЯ ПОДКЛЮЧЕНИЯ ДЛЯ КОПИРОВАНИЯ                   ${CYAN}║${NC}"
                echo -e "${CYAN}╚══════════════════════════════════════════════════════════════════════╝${NC}"
                echo ""
                echo -e "${YELLOW}${BOLD}1. Жесткая цензура (${base_pname} [Жесткая цензура]):${NC}"
                get_stormdns_link 1 "$dom" "$key" "${base_pname} [Жесткая цензура]"
                echo ""
                echo -e "${YELLOW}${BOLD}2. Стандартный (${base_pname} [Стандартный]):${NC}"
                get_stormdns_link 2 "$dom" "$key" "${base_pname} [Стандартный]"
                echo ""
                echo -e "${YELLOW}${BOLD}3. Мобильный / Скоростной (${base_pname} [Скоростной]):${NC}"
                get_stormdns_link 3 "$dom" "$key" "${base_pname} [Скоростной]"
                echo ""
                read -p "Нажмите Enter для возврата..."
                ;;
            0) return ;;
        esac
    done
}

dns_change_domain() {
    clear
    local cur_dom=$(get_dns_domain)
    local base_d=$(detect_base_domain)
    local suggest="d.${base_d}"
    [ -z "$base_d" ] && suggest="$cur_dom"
    echo -e "${BOLD}--- Смена домена DNS-зоны ---${NC}"
    echo -e "Текущий домен туннеля:   ${CYAN}${cur_dom}${NC}"
    [ -n "$base_d" ] && echo -e "Базовый домен сервера:    ${GREEN}${base_d}${NC} (предлагаемый: ${CYAN}${suggest}${NC})"
    echo ""
    read -p "Введите новый домен DNS-зоны [Enter для $suggest]: " new_dom
    new_dom=$(echo "$new_dom" | tr -d '[:space:]')
    [ -z "$new_dom" ] && new_dom="$suggest"
    [ -z "$new_dom" ] && return

    if [[ "$new_dom" != d.* ]]; then
        new_dom="d.${new_dom}"
        echo -e "${YELLOW}Автоматически добавлен префикс 'd.': ${new_dom}${NC}"
    fi

    if [ -f "$COTTEN_CONFIG_FILE" ]; then
        sed -i 's/^DOMAIN\s*=.*/DOMAIN = ["'"$new_dom"'"]/' "$COTTEN_CONFIG_FILE"
    fi
    if [ -f "$MASTERDNS_CONFIG_FILE" ]; then
        sed -i 's/^DOMAIN\s*=.*/DOMAIN = ["'"$new_dom"'"]/' "$MASTERDNS_CONFIG_FILE"
    fi

    local cur_s=$(get_active_dns_engine)
    systemctl restart "$cur_s" 2>/dev/null || true
    echo -e "${GREEN}✓ Домен зоны успешно изменен на: ${new_dom}!${NC}"
    sleep 2
}

dns_change_key() {
    clear
    local cur_key=$(get_dns_key)
    echo -e "${BOLD}--- Смена ключа шифрования (AES-256-GCM) ---${NC}"
    echo -e "Текущий ключ: ${GREEN}${cur_key}${NC}"
    echo ""
    echo -e "  ${YELLOW}[1]${NC} Сгенерировать новый случайный ключ (32 hex)"
    echo -e "  ${YELLOW}[2]${NC} Ввести свой 32-байтный hex-ключ"
    echo -e "  ${YELLOW}[0]${NC} Отмена"
    echo ""
    read -p "Выберите вариант [0-2]: " k_choice
    local new_key=""
    case "$k_choice" in
        1)
            new_key=$(openssl rand -hex 16 2>/dev/null || echo "a7125b5f3cc23e525123c677bc6d202e")
            ;;
        2)
            read -p "Введите hex ключ (32 символа): " custom_k
            new_key=$(echo "$custom_k" | tr -d '[:space:]')
            ;;
        *) return ;;
    esac

    [ -z "$new_key" ] && return
    mkdir -p "$COTTEN_DIR" "$MASTERDNS_DIR"
    echo -n "$new_key" > "$COTTEN_KEY_FILE"
    chmod 600 "$COTTEN_KEY_FILE"
    echo -n "$new_key" > "$MASTERDNS_KEY_FILE"
    chmod 600 "$MASTERDNS_KEY_FILE"

    local cur_s=$(get_active_dns_engine)
    systemctl restart "$cur_s" 2>/dev/null || true
    echo -e "${GREEN}✓ Ключ шифрования успешно обновлен: ${new_key}${NC}"
    sleep 2
}

dns_change_profile_name() {
    clear
    local cur_pname=$(get_dns_profile_name)
    echo -e "${BOLD}--- Смена имени профилей подключения DNS-туннеля ---${NC}"
    echo -e "Текущее базовое имя: ${CYAN}${cur_pname}${NC}\n"
    read -p "Введите новое базовое имя профиля [Enter для '$cur_pname']: " new_pname
    new_pname=$(echo "$new_pname" | sed -e 's/^[[:space:]]*//' -e 's/[[:space:]]*$//')
    [ -z "$new_pname" ] && return
    mkdir -p /etc/x-manager /etc/masterdns /etc/cottendns
    echo -n "$new_pname" > /etc/x-manager/dns_profile_name.txt
    echo -n "$new_pname" > /etc/masterdns/profile_name.txt 2>/dev/null || true
    echo -n "$new_pname" > /etc/cottendns/profile_name.txt 2>/dev/null || true
    echo -e "${GREEN}✓ Имя профилей подключения успешно изменено на: '${new_pname}'!${NC}"
    sleep 2
}

dns_change_routing() {
    clear
    echo -e "${BOLD}--- Настройка маршрутизации DNS-туннеля ---${NC}"
    echo -e "Текущий режим: $(get_dns_routing)"
    echo ""
    echo -e "  ${YELLOW}[1]${NC} 🌐 Маршрутизация Xray SOCKS5 (127.0.0.1:10808) ${GREEN}[Рекомендуется]${NC}"
    echo -e "  ${YELLOW}[2]${NC} ⚡ Прямой выход (Direct)"
    echo -e "  ${YELLOW}[0]${NC} Отмена"
    echo ""
    read -p "Выберите режим [0-2]: " r_choice
    case "$r_choice" in
        1)
            for f in "$COTTEN_CONFIG_FILE" "$MASTERDNS_CONFIG_FILE"; do
                if [ -f "$f" ]; then
                    sed -i 's/^USE_EXTERNAL_SOCKS5\s*=.*/USE_EXTERNAL_SOCKS5 = true/' "$f"
                    sed -i 's/^FORWARD_IP\s*=.*/FORWARD_IP = "127.0.0.1"/' "$f"
                    sed -i 's/^FORWARD_PORT\s*=.*/FORWARD_PORT = 10808/' "$f"
                fi
            done
            echo -e "${GREEN}✓ Маршрутизация установлена: Xray SOCKS5${NC}"
            ;;
        2)
            for f in "$COTTEN_CONFIG_FILE" "$MASTERDNS_CONFIG_FILE"; do
                if [ -f "$f" ]; then
                    sed -i 's/^USE_EXTERNAL_SOCKS5\s*=.*/USE_EXTERNAL_SOCKS5 = false/' "$f"
                fi
            done
            echo -e "${GREEN}✓ Маршрутизация установлена: Прямой выход (Direct)${NC}"
            ;;
        *) return ;;
    esac

    local cur_s=$(get_active_dns_engine)
    systemctl restart "$cur_s" 2>/dev/null || true
    sleep 2
}

menu_dns_settings() {
    while true; do
        clear
        echo -e "${CYAN}╔══════════════════════════════════════════════════════════════════════╗${NC}"
        echo -e "${CYAN}║${BOLD}                 НАСТРОЙКИ ПАРАМЕТРОВ DNS-ТУННЕЛЯ                      ${CYAN}║${NC}"
        echo -e "${CYAN}╠══════════════════════════════════════════════════════════════════════╣${NC}"
        echo -e "${CYAN}║${NC}  Домен зоны:  ${CYAN}${BOLD}$(get_dns_domain)${NC}"
        echo -e "${CYAN}║${NC}  Ключ шифр.:  ${GREEN}$(get_dns_key)${NC} (AES-256-GCM)"
        echo -e "${CYAN}║${NC}  Имя профиля: ${YELLOW}${BOLD}$(get_dns_profile_name)${NC}"
        echo -e "${CYAN}║${NC}  Маршрут:     $(get_dns_routing)"
        echo -e "${CYAN}╚══════════════════════════════════════════════════════════════════════╝${NC}"
        echo ""
        echo -e "  ${YELLOW}[1]${NC} 🌐 Сменить домен DNS-зоны"
        echo -e "  ${YELLOW}[2]${NC} 🔑 Сменить / сгенерировать ключ шифрования"
        echo -e "  ${YELLOW}[3]${NC} 🏷️  Сменить имя подключения (профилей в приложении)"
        echo -e "  ${YELLOW}[4]${NC} 🔀 Изменить маршрутизацию (Xray SOCKS5 / Direct)"
        echo -e "  ${YELLOW}[0]${NC} ⬅️  Назад"
        echo ""
        read -p "Выберите пункт [0-4]: " s_choice
        case "$s_choice" in
            1) dns_change_domain ;;
            2) dns_change_key ;;
            3) dns_change_profile_name ;;
            4) dns_change_routing ;;
            0) return ;;
        esac
    done
}

install_cottendns() {
    clear
    echo -e "${CYAN}╔══════════════════════════════════════════════════════════════════════╗${NC}"
    echo -e "${CYAN}║${BOLD}    УСТАНОВКА COTTENDNS (WHITEDNS HIGH-SPEED DNS TUNNEL ENGINE)        ${CYAN}║${NC}"
    echo -e "${CYAN}╚══════════════════════════════════════════════════════════════════════╝${NC}"
    echo ""
    local base_d=$(detect_base_domain)
    local cur_dom=$(get_dns_domain)
    if [ -z "$cur_dom" ] || [ "$cur_dom" = "d.lesovoi.pro" ]; then
        if [ -n "$base_d" ]; then
            cur_dom="d.${base_d}"
        else
            cur_dom="d.lesovoi.pro"
        fi
    fi
    [ -n "$base_d" ] && echo -e "  Базовый домен сервера: ${GREEN}${base_d}${NC}"
    read -p "Введите домен DNS-зоны [по умолчанию $cur_dom]: " user_dom
    user_dom=$(echo "$user_dom" | tr -d '[:space:]')
    [ -z "$user_dom" ] && user_dom="$cur_dom"
    if [[ "$user_dom" != d.* ]]; then
        user_dom="d.${user_dom}"
        echo -e "  ${YELLOW}Автоматически добавлен префикс 'd.': ${user_dom}${NC}"
    fi
    cur_dom="$user_dom"

    local cur_key=$(get_dns_key)
    [ -z "$cur_key" ] && cur_key=$(openssl rand -hex 16 2>/dev/null || echo "a7125b5f3cc23e525123c677bc6d202e")
    read -p "Ключ шифрования (AES-256-GCM, 32 hex символа) [Enter для $cur_key]: " user_key
    [ -n "$user_key" ] && cur_key="$user_key"

    local cur_pname=$(get_dns_profile_name)
    read -p "Имя профилей подключения в приложении [Enter для '$cur_pname']: " user_pname
    user_pname=$(echo "$user_pname" | sed -e 's/^[[:space:]]*//' -e 's/[[:space:]]*$//')
    [ -z "$user_pname" ] && user_pname="$cur_pname"
    mkdir -p /etc/x-manager /etc/cottendns /etc/masterdns
    echo -n "$user_pname" > /etc/x-manager/dns_profile_name.txt
    echo -n "$user_pname" > /etc/cottendns/profile_name.txt 2>/dev/null || true
    echo -n "$user_pname" > /etc/masterdns/profile_name.txt 2>/dev/null || true

    echo ""
    echo -e "${YELLOW}Скачивание и установка CottenDNS...${NC}"
    local arch=$(uname -m)
    local pkg_arch="AMD64"
    case "$arch" in
        x86_64) pkg_arch="AMD64" ;;
        aarch64|arm64) pkg_arch="ARM64" ;;
        *) echo -e "${RED}Архитектура $arch не поддерживается автоматически.${NC}"; sleep 2; return ;;
    esac

    local tmp_dir=$(mktemp -d)
    local dl_url="https://github.com/WhiteDNS/CottenDNS/releases/download/v2026.09.01.221444-530ffbf/CottenDns_Server_Linux_${pkg_arch}.tar.gz"
    if ! curl -sL "$dl_url" -o "$tmp_dir/cotten.tar.gz"; then
        echo -e "${RED}Ошибка скачивания с GitHub!${NC}"
        rm -rf "$tmp_dir"
        sleep 2
        return
    fi

    tar -xzf "$tmp_dir/cotten.tar.gz" -C "$tmp_dir"
    local bin_file=$(find "$tmp_dir" -type f -name "CottenDns_Server_Linux_*" | head -n 1)
    if [ -z "$bin_file" ] || [ ! -f "$bin_file" ]; then
        echo -e "${RED}Бинарник не найден в архиве!${NC}"
        rm -rf "$tmp_dir"
        sleep 2
        return
    fi

    mkdir -p /etc/cottendns /usr/local/bin
    cp "$bin_file" /usr/local/bin/cottendns-server
    chmod +x /usr/local/bin/cottendns-server
    echo -n "$cur_key" > /etc/cottendns/encrypt_key.txt
    chmod 600 /etc/cottendns/encrypt_key.txt

    cat << EOF > /etc/cottendns/server_config.toml
DOMAIN = ["${cur_dom}"]
PROTOCOL_TYPE = "SOCKS5"
SUPPORTED_UPLOAD_COMPRESSION_TYPES = [0, 1, 2, 3]
SUPPORTED_DOWNLOAD_COMPRESSION_TYPES = [0, 1, 2, 3]
UDP_HOST = "0.0.0.0"
UDP_PORT = 53
TCP_LISTENER_ENABLED = true
TCP_IPV6_ENABLED = false
TCP_MAX_CONNS = 2048
TCP_MAX_CONNS_PER_IP = 128
TCP_MAX_QUERIES_PER_CONN = 0
DOT_LISTENER_ENABLED = false
DOH_LISTENER_ENABLED = false
UDP_READERS = 4
DNS_REQUEST_WORKERS = 4
MAX_CONCURRENT_REQUESTS = 16384
SOCKET_BUFFER_SIZE = 8388608
MAX_PACKET_SIZE = 4096
DROP_LOG_INTERVAL_SECONDS = 2.0
DEFERRED_SESSION_WORKERS = 4
DEFERRED_SESSION_QUEUE_LIMIT = 4096
MAX_STREAMS_PER_SESSION = 4096
MAX_ACTIVE_SESSIONS = 2048
DNS_UPSTREAM_SERVERS = ["1.1.1.1:53", "8.8.8.8:53", "77.88.8.8:53"]
DNS_UPSTREAM_TIMEOUT = 4.0
DNS_CACHE_MAX_RECORDS = 50000
DNS_CACHE_TTL_SECONDS = 300.0
SOCKS_CONNECT_TIMEOUT = 120.0
USE_EXTERNAL_SOCKS5 = true
SOCKS5_AUTH = false
FORWARD_IP = "127.0.0.1"
FORWARD_PORT = 10808
DATA_ENCRYPTION_METHOD = 5
ENCRYPTION_AUTO_DETECT = true
ENCRYPTION_KEY_FILE = "/etc/cottendns/encrypt_key.txt"
LOG_LEVEL = "INFO"
CONFIG_VERSION = "14"
EOF

    cat << EOF > /etc/systemd/system/cottendns.service
[Unit]
Description=CottenDNS High-Speed DNS Tunnel Server (WhiteDNS Engine)
After=network.target xray.service
Wants=xray.service

[Service]
Type=simple
WorkingDirectory=/etc/cottendns
ExecStart=/usr/local/bin/cottendns-server -config /etc/cottendns/server_config.toml
Restart=always
RestartSec=3
LimitNOFILE=65535
CapabilityBoundingSet=CAP_NET_BIND_SERVICE CAP_NET_ADMIN
AmbientCapabilities=CAP_NET_BIND_SERVICE CAP_NET_ADMIN

[Install]
WantedBy=multi-user.target
EOF

    systemctl daemon-reload
    rm -rf "$tmp_dir"

    if systemctl is-active --quiet masterdns; then
        echo -e "${GREEN}✓ CottenDNS успешно установлен как альтернативный скоростной движок.${NC}"
        echo -e "  Так как сейчас активен MasterDnsVPN (основной), CottenDNS находится в резерве."
        echo -e "  Вы можете переключить активный движок в пункте [2] меню DNS."
    else
        systemctl enable cottendns
        systemctl restart cottendns
        sleep 2
        if systemctl is-active --quiet cottendns; then
            echo -e "${GREEN}✓ CottenDNS успешно установлен и запущен на порту UDP/TCP 53!${NC}"
        else
            echo -e "${RED}✗ Ошибка запуска CottenDNS! Проверьте логи journalctl -u cottendns${NC}"
        fi
    fi
    sleep 2
}

install_masterdns() {
    clear
    echo -e "${CYAN}╔══════════════════════════════════════════════════════════════════════╗${NC}"
    echo -e "${CYAN}║${BOLD}        УСТАНОВКА MASTERDNSVPN (ОСНОВНОЙ DNS-ТУННЕЛЬ)                  ${CYAN}║${NC}"
    echo -e "${CYAN}╚══════════════════════════════════════════════════════════════════════╝${NC}"
    echo ""
    local base_d=$(detect_base_domain)
    local cur_dom=$(get_dns_domain)
    if [ -z "$cur_dom" ] || [ "$cur_dom" = "d.lesovoi.pro" ]; then
        if [ -n "$base_d" ]; then
            cur_dom="d.${base_d}"
        else
            cur_dom="d.lesovoi.pro"
        fi
    fi
    [ -n "$base_d" ] && echo -e "  Базовый домен сервера: ${GREEN}${base_d}${NC}"
    read -p "Введите домен DNS-зоны [по умолчанию $cur_dom]: " user_dom
    user_dom=$(echo "$user_dom" | tr -d '[:space:]')
    [ -z "$user_dom" ] && user_dom="$cur_dom"
    if [[ "$user_dom" != d.* ]]; then
        user_dom="d.${user_dom}"
        echo -e "  ${YELLOW}Автоматически добавлен префикс 'd.': ${user_dom}${NC}"
    fi
    cur_dom="$user_dom"

    local cur_key=$(get_dns_key)
    [ -z "$cur_key" ] && cur_key=$(openssl rand -hex 16 2>/dev/null || echo "a7125b5f3cc23e525123c677bc6d202e")
    read -p "Ключ шифрования (AES-256-GCM, 32 hex символа) [Enter для $cur_key]: " user_key
    [ -n "$user_key" ] && cur_key="$user_key"

    local cur_pname=$(get_dns_profile_name)
    read -p "Имя профилей подключения в приложении [Enter для '$cur_pname']: " user_pname
    user_pname=$(echo "$user_pname" | sed -e 's/^[[:space:]]*//' -e 's/[[:space:]]*$//')
    [ -z "$user_pname" ] && user_pname="$cur_pname"
    mkdir -p /etc/x-manager /etc/masterdns /etc/cottendns
    echo -n "$user_pname" > /etc/x-manager/dns_profile_name.txt
    echo -n "$user_pname" > /etc/masterdns/profile_name.txt 2>/dev/null || true
    echo -n "$user_pname" > /etc/cottendns/profile_name.txt 2>/dev/null || true

    echo ""
    echo -e "${YELLOW}Скачивание и установка MasterDnsVPN...${NC}"
    local arch=$(uname -m)
    local pkg_arch="AMD64"
    case "$arch" in
        x86_64) pkg_arch="AMD64" ;;
        aarch64|arm64) pkg_arch="ARM64" ;;
        *) echo -e "${RED}Архитектура $arch не поддерживается автоматически.${NC}"; sleep 2; return ;;
    esac

    local tmp_dir=$(mktemp -d)
    local dl_url="https://github.com/masterking32/MasterDnsVPN/releases/download/v2026.06.13.234407-7de2476/MasterDnsVPN_Server_Linux_${pkg_arch}.tar.gz"
    if ! curl -sL "$dl_url" -o "$tmp_dir/master.tar.gz"; then
        echo -e "${RED}Ошибка скачивания с GitHub!${NC}"
        rm -rf "$tmp_dir"
        sleep 2
        return
    fi

    tar -xzf "$tmp_dir/master.tar.gz" -C "$tmp_dir"
    local bin_file=$(find "$tmp_dir" -type f -name "MasterDnsVPN_Server_Linux_*" | head -n 1)
    if [ -z "$bin_file" ] || [ ! -f "$bin_file" ]; then
        echo -e "${RED}Бинарник не найден в архиве!${NC}"
        rm -rf "$tmp_dir"
        sleep 2
        return
    fi

    mkdir -p /etc/masterdns /usr/local/bin
    cp "$bin_file" /usr/local/bin/masterdns-server
    chmod +x /usr/local/bin/masterdns-server
    echo -n "$cur_key" > /etc/masterdns/encrypt_key.txt
    chmod 600 /etc/masterdns/encrypt_key.txt

    cat << EOF > /etc/masterdns/server_config.toml
DOMAIN = ["${cur_dom}"]
PROTOCOL_TYPE = "SOCKS5"
UDP_HOST = "0.0.0.0"
UDP_PORT = 53
UDP_READERS = 4
DNS_REQUEST_WORKERS = 4
MAX_CONCURRENT_REQUESTS = 16384
SOCKET_BUFFER_SIZE = 8388608
MAX_PACKET_SIZE = 4096
DNS_UPSTREAM_SERVERS = ["1.1.1.1:53", "8.8.8.8:53"]
USE_EXTERNAL_SOCKS5 = true
SOCKS5_AUTH = false
FORWARD_IP = "127.0.0.1"
FORWARD_PORT = 10808
DATA_ENCRYPTION_METHOD = 5
ENCRYPTION_KEY_FILE = "/etc/masterdns/encrypt_key.txt"
LOG_LEVEL = "INFO"
EOF

    cat << EOF > /etc/systemd/system/masterdns.service
[Unit]
Description=MasterDnsVPN DNS Tunnel Server (Primary Engine)
After=network.target xray.service
Wants=xray.service

[Service]
Type=simple
WorkingDirectory=/etc/masterdns
ExecStart=/usr/local/bin/masterdns-server -config /etc/masterdns/server_config.toml
Restart=always
RestartSec=3
LimitNOFILE=65535
CapabilityBoundingSet=CAP_NET_BIND_SERVICE CAP_NET_ADMIN
AmbientCapabilities=CAP_NET_BIND_SERVICE CAP_NET_ADMIN

[Install]
WantedBy=multi-user.target
EOF

    systemctl daemon-reload
    rm -rf "$tmp_dir"

    # Stop CottenDNS if it was running to free port 53 for MasterDnsVPN
    systemctl stop cottendns 2>/dev/null || true
    systemctl disable cottendns 2>/dev/null || true

    systemctl enable masterdns
    systemctl restart masterdns
    sleep 2
    if systemctl is-active --quiet masterdns; then
        echo -e "${GREEN}✓ MasterDnsVPN успешно установлен и запущен как основной движок на порту UDP 53!${NC}"
    else
        echo -e "${RED}✗ Ошибка запуска MasterDnsVPN! Проверьте логи journalctl -u masterdns${NC}"
    fi
    sleep 2
}

uninstall_dns() {
    clear
    echo -e "${RED}╔══════════════════════════════════════════════════════════════════════╗${NC}"
    echo -e "${RED}║${BOLD}                     УДАЛЕНИЕ DNS-ТУННЕЛЯ                             ${RED}║${NC}"
    echo -e "${RED}╚══════════════════════════════════════════════════════════════════════╝${NC}"
    echo ""
    echo -e "  ${YELLOW}[1]${NC} Удалить только CottenDNS"
    echo -e "  ${YELLOW}[2]${NC} Удалить только MasterDnsVPN"
    echo -e "  ${YELLOW}[3]${NC} ${RED}${BOLD}Удалить ОБА сервиса и очистить конфигурации${NC}"
    echo -e "  ${YELLOW}[0]${NC} Отмена"
    echo ""
    read -p "Выберите вариант [0-3]: " u_choice
    case "$u_choice" in
        1)
            systemctl stop cottendns 2>/dev/null || true
            systemctl disable cottendns 2>/dev/null || true
            rm -f /etc/systemd/system/cottendns.service /usr/local/bin/cottendns-server
            rm -rf /etc/cottendns
            systemctl daemon-reload
            echo -e "${GREEN}✓ CottenDNS удален.${NC}"
            ;;
        2)
            systemctl stop masterdns 2>/dev/null || true
            systemctl disable masterdns 2>/dev/null || true
            rm -f /etc/systemd/system/masterdns.service /usr/local/bin/masterdns-server
            rm -rf /etc/masterdns
            systemctl daemon-reload
            echo -e "${GREEN}✓ MasterDnsVPN удален.${NC}"
            ;;
        3)
            systemctl stop cottendns masterdns 2>/dev/null || true
            systemctl disable cottendns masterdns 2>/dev/null || true
            rm -f /etc/systemd/system/cottendns.service /etc/systemd/system/masterdns.service
            rm -f /usr/local/bin/cottendns-server /usr/local/bin/masterdns-server
            rm -rf /etc/cottendns /etc/masterdns "$DNS_WAN_LOCK"
            iptables -D INPUT -i "$WAN_IF" -p udp --dport 53 -m comment --comment "DNS_WAN_BLOCK" -j DROP 2>/dev/null || true
            iptables -D INPUT -i "$WAN_IF" -p tcp --dport 53 -m comment --comment "DNS_WAN_BLOCK" -j DROP 2>/dev/null || true
            systemctl daemon-reload
            echo -e "${GREEN}✓ Все DNS-туннели удалены и настройки очищены.${NC}"
            ;;
        *) return ;;
    esac
    sleep 2
}

menu_dns_manage_engines() {
    clear
    echo -e "${CYAN}╔══════════════════════════════════════════════════════════════════════╗${NC}"
    echo -e "${CYAN}║${BOLD}          УПРАВЛЕНИЕ УСТАНОВКОЙ И УДАЛЕНИЕМ ДВИЖКОВ DNS               ${CYAN}║${NC}"
    echo -e "${CYAN}╚══════════════════════════════════════════════════════════════════════╝${NC}"
    echo ""
    echo -e "  Статус MasterDnsVPN: $([ -f "$MASTERDNS_BIN" ] && echo -e "${GREEN}Установлен${NC}" || echo -e "${RED}Не установлен${NC}")"
    echo -e "  Статус CottenDNS:    $([ -f "$COTTEN_BIN" ] && echo -e "${GREEN}Установлен${NC}" || echo -e "${RED}Не установлен${NC}")"
    echo ""
    echo -e "  ${YELLOW}[1]${NC} 🛡️  ${BOLD}Установить / Обновить MasterDnsVPN${NC} (Основной движок)"
    echo -e "  ${YELLOW}[2]${NC} 🚀 Установить / Обновить CottenDNS (Альтернативный WhiteDNS)"
    echo -e "  ${YELLOW}[3]${NC} 🗑️  Удалить DNS-сервисы"
    echo -e "  ${YELLOW}[0]${NC} ⬅️  Назад"
    echo ""
    read -p "Выберите вариант [0-3]: " eng_choice
    case "$eng_choice" in
        1) install_masterdns ;;
        2) install_cottendns ;;
        3) uninstall_dns ;;
        0) return ;;
    esac
}

show_dns_header() {
    clear
    local eng=$(get_active_dns_engine)
    local eng_name=$(get_dns_engine_name)
    local dom=$(get_dns_domain)
    local key=$(get_dns_key)
    local pname=$(get_dns_profile_name)
    echo -e "${CYAN}╔══════════════════════════════════════════════════════════════════════╗${NC}"
    echo -e "${CYAN}║${BOLD}          УПРАВЛЕНИЕ DNS-ТУННЕЛЯМИ (MASTERDNSVPN / COTTENDNS)         ${CYAN}║${NC}"
    echo -e "${CYAN}╠══════════════════════════════════════════════════════════════════════╣${NC}"
    echo -e "${CYAN}║${NC}  Сервер: ${BOLD}${SERVER_IP}${NC}  |  Статус: $(get_dns_status)"
    echo -e "${CYAN}║${NC}  Активный движок: ${BOLD}${eng_name}${NC}"
    echo -e "${CYAN}║${NC}  Домен:  ${CYAN}${BOLD}${dom}${NC}  |  Порт: ${BOLD}:53 (UDP/TCP)${NC}"
    echo -e "${CYAN}║${NC}  Имя:    ${YELLOW}${BOLD}${pname}${NC}  |  Доступ WAN: $(get_dns_wan_status)"
    echo -e "${CYAN}║${NC}  Ключ:   ${GREEN}${key:0:16}...${NC}  |  Маршрут: $(get_dns_routing)"
    echo -e "${CYAN}╚══════════════════════════════════════════════════════════════════════╝${NC}"
    echo ""
}

menu_dns() {
    if ! is_dns_installed; then
        clear
        echo -e "${YELLOW}╔══════════════════════════════════════════════════════════════════════╗${NC}"
        echo -e "${YELLOW}║${BOLD}                 DNS-ТУННЕЛИ НЕ ОБНАРУЖЕНЫ                            ${YELLOW}║${NC}"
        echo -e "${YELLOW}╚══════════════════════════════════════════════════════════════════════╝${NC}"
        echo ""
        echo -e "${RED}Ни MasterDnsVPN, ни CottenDNS не установлены на данном сервере.${NC}"
        echo ""
        echo -e "  ${YELLOW}[1]${NC} 🛡️  ${BOLD}Установить MasterDnsVPN${NC} (Основной движок по умолчанию - Рекомендуется)"
        echo -e "  ${YELLOW}[2]${NC} 🚀 ${BOLD}Установить CottenDNS${NC} (Альтернативный WhiteDNS Engine)"
        echo -e "  ${YELLOW}[0]${NC} ⬅️  Назад в Главное Меню"
        echo ""
        read -p "Выберите пункт [0-2]: " d_choice
        case "$d_choice" in
            1) install_masterdns ;;
            2) install_cottendns ;;
            *) return ;;
        esac
        return
    fi

    while true; do
        show_dns_header
        echo -e "  ${YELLOW}[1]${NC} 📱 ${BOLD}Показать 3 профиля подключения${NC} (stormdns:// ссылки + QR-коды)"
        echo -e "  ${YELLOW}[2]${NC} 🔄 ${BOLD}Переключить активный движок${NC} (CottenDNS <-> MasterDnsVPN)"
        echo -e "  ${YELLOW}[3]${NC} 🔒 ${BOLD}Включить / Выключить доступ из WAN${NC} (Блокировка порта 53 через iptables)"
        echo -e "  ${YELLOW}[4]${NC} ⚙️  ${BOLD}Настройки туннеля${NC} (Домен, Ключ, Маршрут Xray/Direct)"
        echo -e "  ${YELLOW}[5]${NC} 📜 Живые логи службы (journalctl)"
        echo -e "  ${YELLOW}[6]${NC} 🔄 Перезапустить DNS-службу"
        echo -e "  ${YELLOW}[7]${NC} ➕ Установить второй движок / Удалить DNS-туннель"
        echo -e "  ${YELLOW}[0]${NC} ⬅️  Назад в Главное Меню"
        echo ""
        read -p "Выберите пункт [0-7]: " top_d_choice
        case "$top_d_choice" in
            1) show_dns_profiles ;;
            2) switch_dns_engine ;;
            3) toggle_dns_wan ;;
            4) menu_dns_settings ;;
            5)
                local cur_s=$(get_active_dns_engine)
                journalctl -u "$cur_s" -f -n 50
                ;;
            6)
                local cur_s=$(get_active_dns_engine)
                echo -e "${YELLOW}Перезапуск службы $cur_s...${NC}"
                systemctl restart "$cur_s"
                sleep 2
                echo -e "${GREEN}✓ Служба $cur_s перезапущена${NC}"
                sleep 1
                ;;
            7) menu_dns_manage_engines ;;
            0) return ;;
        esac
    done
}

# ==============================================================================
# РАЗДЕЛ 5: ОБЩИЙ СТАТУС И ИНВЕНТАРИЗАЦИЯ ВСЕХ СЛУЖБ
# ==============================================================================
rescan_and_adopt_protocols() {
    clear
    echo -e "${CYAN}╔══════════════════════════════════════════════════════════════════════╗${NC}"
    echo -e "${CYAN}║${BOLD}      ИНВЕНТАРИЗАЦИЯ И ПОДХВАТ УСТАНОВЛЕННЫХ ПРОТОКОЛОВ               ${CYAN}║${NC}"
    echo -e "${CYAN}╚══════════════════════════════════════════════════════════════════════╝${NC}"
    echo ""
    echo -e "${YELLOW}Сканирование системы на наличие установленных протоколов и служб...${NC}"
    echo ""

    systemctl daemon-reload 2>/dev/null || true

    local count=0

    # Snell
    if is_snell_installed; then
        [ ! -L "/usr/local/bin/x-snell" ] && ln -sf /usr/local/bin/x-manager /usr/local/bin/x-snell 2>/dev/null || true
        echo -e "  ${GREEN}[✓] Snell v5${NC}:           Обнаружен! $(get_snell_status) | Порт: $(get_snell_port)"
        count=$((count + 1))
    else
        echo -e "  ${RED}[✗] Snell v5${NC}:           Не установлен"
    fi

    # Mieru
    if is_mieru_installed; then
        [ ! -L "/usr/local/bin/x-mieru" ] && ln -sf /usr/local/bin/x-manager /usr/local/bin/x-mieru 2>/dev/null || true
        echo -e "  ${GREEN}[✓] Mieru (mita)${NC}:       Обнаружен! $(get_mieru_status) | Порты: $(get_mieru_ports)"
        count=$((count + 1))
    else
        echo -e "  ${RED}[✗] Mieru (mita)${NC}:       Не установлен"
    fi

    # WDTT
    if is_wdtt_installed; then
        [ ! -L "/usr/local/bin/x-wdtt" ] && ln -sf /usr/local/bin/x-manager /usr/local/bin/x-wdtt 2>/dev/null || true
        [ ! -L "/usr/local/bin/x-qwdtt" ] && ln -sf /usr/local/bin/x-manager /usr/local/bin/x-qwdtt 2>/dev/null || true
        echo -e "  ${GREEN}[✓] WDTT / qwdtt${NC}:       Обнаружен! $(get_wdtt_status) | Порты: 56000-56003"
        count=$((count + 1))
    else
        echo -e "  ${RED}[✗] WDTT / qwdtt${NC}:       Не установлен"
    fi

    # CSQTT
    if is_csqtt_installed; then
        [ ! -L "/usr/local/bin/x-csqtt" ] && ln -sf /usr/local/bin/x-manager /usr/local/bin/x-csqtt 2>/dev/null || true
        echo -e "  ${GREEN}[✓] CSQTT${NC}:              Обнаружен! $(get_csqtt_status) | Панель: :$(get_csqtt_web_port)"
        count=$((count + 1))
    else
        echo -e "  ${RED}[✗] CSQTT${NC}:              Не установлен"
    fi

    # OpenFlux
    if is_openflux_installed; then
        [ ! -L "/usr/local/bin/x-openflux" ] && ln -sf /usr/local/bin/x-manager /usr/local/bin/x-openflux 2>/dev/null || true
        [ ! -L "/usr/local/bin/x-flux" ] && ln -sf /usr/local/bin/x-manager /usr/local/bin/x-flux 2>/dev/null || true
        echo -e "  ${GREEN}[✓] OpenFlux (L4)${NC}:        Обнаружен! $(get_openflux_status)"
        count=$((count + 1))
    else
        echo -e "  ${RED}[✗] OpenFlux (L4)${NC}:        Не установлен"
    fi

    # WebDAV Tunnel
    if is_webdav_tunnel_installed; then
        [ ! -L "/usr/local/bin/x-webdav" ] && ln -sf /usr/local/bin/x-manager /usr/local/bin/x-webdav 2>/dev/null || true
        [ ! -L "/usr/local/bin/x-wdav" ] && ln -sf /usr/local/bin/x-manager /usr/local/bin/x-wdav 2>/dev/null || true
        echo -e "  ${GREEN}[✓] WebDAV Tunnel${NC}:        Обнаружен! $(get_wdavtunnel_status) | Порт: :$(get_wdavtunnel_listen_port)/TCP"
        count=$((count + 1))
    else
        echo -e "  ${RED}[✗] WebDAV Tunnel${NC}:        Не установлен"
    fi

    # Firewall aliases
    [ ! -L "/usr/local/bin/x-fw" ] && ln -sf /usr/local/bin/x-manager /usr/local/bin/x-fw 2>/dev/null || true
    [ ! -L "/usr/local/bin/x-firewall" ] && ln -sf /usr/local/bin/x-manager /usr/local/bin/x-firewall 2>/dev/null || true

    # MasterDnsVPN adoption if binary is in /opt/masterdnsvpn
    if [ ! -f "$MASTERDNS_BIN" ] && [ -d "/opt/masterdnsvpn" ]; then
        local found_m=$(find /opt/masterdnsvpn -maxdepth 1 -type f -name "MasterDnsVPN_Server_Linux_*" 2>/dev/null | head -n 1)
        if [ -n "$found_m" ] && [ -f "$found_m" ]; then
            ln -sf "$found_m" "$MASTERDNS_BIN"
            chmod +x "$MASTERDNS_BIN"
            mkdir -p /etc/masterdns
            [ ! -f "$MASTERDNS_CONFIG_FILE" ] && [ -f "/opt/masterdnsvpn/server_config.toml" ] && cp /opt/masterdnsvpn/server_config.toml "$MASTERDNS_CONFIG_FILE"
            [ ! -f "$MASTERDNS_KEY_FILE" ] && [ -f "/opt/masterdnsvpn/encrypt_key.txt" ] && cp /opt/masterdnsvpn/encrypt_key.txt "$MASTERDNS_KEY_FILE"
        fi
    fi

    # CottenDNS
    if is_cottendns_installed; then
        [ ! -L "/usr/local/bin/x-dns" ] && ln -sf /usr/local/bin/x-manager /usr/local/bin/x-dns 2>/dev/null || true
        [ ! -L "/usr/local/bin/x-cottendns" ] && ln -sf /usr/local/bin/x-manager /usr/local/bin/x-cottendns 2>/dev/null || true
        local c_st="ОСТАНОВЛЕН"
        systemctl is-active --quiet cottendns 2>/dev/null && c_st="АКТИВЕН"
        echo -e "  ${GREEN}[✓] CottenDNS${NC}:          Обнаружен! ${c_st}"
        count=$((count + 1))
    else
        echo -e "  ${RED}[✗] CottenDNS${NC}:          Не установлен"
    fi

    # MasterDnsVPN
    if is_masterdns_installed; then
        [ ! -L "/usr/local/bin/x-dns" ] && ln -sf /usr/local/bin/x-manager /usr/local/bin/x-dns 2>/dev/null || true
        [ ! -L "/usr/local/bin/x-masterdns" ] && ln -sf /usr/local/bin/x-manager /usr/local/bin/x-masterdns 2>/dev/null || true
        local m_st="ОСТАНОВЛЕН (В РЕЗЕРВЕ)"
        systemctl is-active --quiet masterdns 2>/dev/null && m_st="АКТИВЕН"
        echo -e "  ${GREEN}[✓] MasterDnsVPN${NC}:       Обнаружен! ${m_st}"
        count=$((count + 1))
    else
        echo -e "  ${RED}[✗] MasterDnsVPN${NC}:       Не установлен"
    fi

    # Автоматическая синхронизация правил фаервола ACCEPT для активных протоколов
    sync_active_firewall_rules

    local base_d=$(detect_base_domain)
    echo ""
    echo -e "  ${BOLD}Базовый домен сервера:${NC} ${GREEN}${base_d:-не определен}${NC}"
    if [ -n "$base_d" ]; then
        echo -e "  ${BOLD}DNS-зона для туннелей:${NC} ${CYAN}d.${base_d}${NC}"
    fi

    echo ""
    echo -e "${GREEN}✓ Протоколы подхвачены и зарегистрированы в x-manager (всего: ${count})${NC}"
    echo -e "  Все статусы в Главном Меню синхронизированы."
    echo ""
    read -p "Нажмите Enter для возврата..."
}

view_global_status() {
    clear
    echo -e "${CYAN}╔══════════════════════════════════════════════════════════════════════╗${NC}"
    echo -e "${CYAN}║${BOLD}          СВОДНЫЙ СТАТУС ВСЕХ СЕТЕВЫХ СЛУЖБ И ШЛЮЗА                ${CYAN}║${NC}"
    echo -e "${CYAN}╠══════════════════════════════════════════════════════════════════════╣${NC}"
    echo -e "${CYAN}║${NC}  Сервер: ${BOLD}${SERVER_IP}${NC}"
    echo -e "${CYAN}╚══════════════════════════════════════════════════════════════════════╝${NC}"
    echo ""
    echo -e "${BOLD}--- Статус служб и маршрутизации ---${NC}"
    printf "  %-22s %-25b [Маршрут: %b]\n" "Mieru (mita):" "$(get_mieru_status)" "$(get_mieru_routing)"
    printf "  %-22s %-25b [Маршрут: %b]\n" "Snell (v5):" "$(get_snell_status)" "$(get_snell_routing)"
    printf "  %-22s %-25b [Маршрут: %b]\n" "WDTT (qwdtt):" "$(get_wdtt_status)" "$(get_wdtt_routing)"
    if is_csqtt_installed; then
        printf "  %-22s %-25b [Панель :%s | %b]\n" "CSQTT (VPN Server):" "$(get_csqtt_status)" "$(get_csqtt_web_port)" "$(get_csqtt_protect_status)"
    else
        printf "  %-22s %-25b\n" "CSQTT (VPN Server):" "$(get_csqtt_status)"
    fi
    if is_dns_installed; then
        printf "  %-22s %-25b [Зона: %s:53 | %b]\n" "DNS-Туннель:" "$(get_dns_status)" "$(get_dns_domain)" "$(get_dns_wan_status)"
    else
        printf "  %-22s %-25b\n" "DNS-Туннель:" "$(get_dns_status)"
    fi
    if is_openflux_installed; then
        local of_cnt=$(get_openflux_counts)
        local of_a=$(echo "$of_cnt" | cut -d':' -f1)
        printf "  %-22s %-25b [Активно: %s/8 | %b]\n" "OpenFlux (L4):" "$(get_openflux_status)" "$of_a" "$(get_openflux_routing)"
    else
        printf "  %-22s %-25b\n" "OpenFlux (L4):" "$(get_openflux_status)"
    fi
    if is_webdav_tunnel_installed; then
        local w_mode=$(get_wdavtunnel_prop "WEBDAV_MODE" "selfhosted")
        if [ "$w_mode" = "server" ] || [ "$w_mode" = "external" ]; then
            printf "  %-22s %-25b [Режим: Yandex/Cloud | %b]\n" "WebDAV Tunnel:" "$(get_wdavtunnel_status)" "$(get_wdavtunnel_routing)"
        else
            printf "  %-22s %-25b [Порт: :%s/TCP | %b]\n" "WebDAV Tunnel:" "$(get_wdavtunnel_status)" "$(get_wdavtunnel_listen_port)" "$(get_wdavtunnel_routing)"
        fi
    else
        printf "  %-22s %b\n" "WebDAV Tunnel:" "${RED}НЕ УСТАНОВЛЕН${NC}"
    fi
    local xray_st="inactive"
    if systemctl is-active --quiet xray 2>/dev/null; then
        xray_st="${GREEN}active (xray.service)${NC}"
    elif pgrep -x xray >/dev/null 2>&1; then
        xray_st="${GREEN}active (process: xray)${NC}"
    elif systemctl is-active --quiet x-ui 2>/dev/null; then
        xray_st="${GREEN}active${NC}"
    fi
    printf "  %-22s %b\n" "Xray Core:" "$xray_st"
    echo ""
    echo -e "${BOLD}--- Системные оптимизации и безопасность ---${NC}"
    printf "  %-22s %-25b\n" "Системный DNS:" "$(get_sys_dns_short)"
    printf "  %-22s %-25b\n" "TCP BBR & Очередь:" "$(get_bbr_short_status)"
    printf "  %-22s %-25b\n" "Файл подкачки (Swap):" "$(get_swap_short_status)"
    printf "  %-22s %-25b\n" "Fail2ban (Защита SSH):" "$(get_f2b_short_status)"
    echo ""
    echo -e "${BOLD}--- Внутренние шлюзы ядра Xray (Вход для прокси-служб) ---${NC}"
    echo -e "  • ${CYAN}TPROXY (прозрачный шлюз):${NC} 127.0.0.1:12345 (TCP/UDP) ${GREEN}[Локально / Извне ЗАКРЫТ 🔒]${NC}"
    echo -e "  • ${CYAN}SOCKS5 вход ядра:${NC}         127.0.0.1:10808 (TCP)     ${GREEN}[Локально / Извне ЗАКРЫТ 🔒]${NC}"
    echo -e "  • ${CYAN}Dokodemo REDIRECT:${NC}       127.0.0.1:12346 (TCP)     ${GREEN}[Локально / Вход для Snell 🔒]${NC}"
    echo ""
    echo -e "${BOLD}--- Открытые прослушиваемые порты ---${NC}"
    echo -e "${YELLOW}TCP порты:${NC}"
    ss -tlpn | grep -E 'mita|snell|xray|wdtt|csqtt|cottendns|masterdns|sshd' | awk '{printf "  %-6s %-22s %-25s\n", $1, $4, $NF}'
    echo ""
    echo -e "${YELLOW}UDP порты:${NC}"
    ss -ulpn | grep -E 'mita|snell|xray|wdtt|csqtt|cottendns|masterdns' | head -n 16 | awk '{printf "  %-6s %-22s %-25s\n", $1, $4, $NF}'
    echo ""
    read -p "Нажмите Enter для возврата..."
}

restart_all_services() {
    clear
    echo -e "${YELLOW}Перезапуск всех сетевых служб (Mieru, Snell, WDTT, CSQTT, DNS, OpenFlux, WebDAV Tunnel)...${NC}"
    systemctl restart mita 2>/dev/null || true
    systemctl restart snell 2>/dev/null || true
    systemctl restart wdtt 2>/dev/null || true
    if is_csqtt_installed; then
        systemctl restart csqtt 2>/dev/null || true
    fi
    if is_dns_installed; then
        local cur_dns=$(get_active_dns_engine)
        systemctl restart "$cur_dns" 2>/dev/null || true
    fi
    if is_openflux_installed; then
        for of_r in 1 2 3 4 5 6 7 8; do
            if [ -n "$(get_openflux_channel_prop "$of_r" "URL" "")" ]; then
                systemctl restart "openflux@$of_r" 2>/dev/null || true
            fi
        done
    fi
    if is_webdav_tunnel_installed; then
        systemctl restart "$WDAVTUNNEL_SERVICE" 2>/dev/null || true
    fi
    sleep 2
    echo -e "Mieru: $(get_mieru_status)"
    echo -e "Snell: $(get_snell_status)"
    echo -e "WDTT:  $(get_wdtt_status)"
    if is_csqtt_installed; then
        echo -e "CSQTT: $(get_csqtt_status)"
    fi
    if is_dns_installed; then
        echo -e "DNS:   $(get_dns_status)"
    fi
    if is_webdav_tunnel_installed; then
        echo -e "WebDAV Tunnel: $(get_wdavtunnel_status)"
    fi
    sync_active_firewall_rules
    sleep 2
}


# ==============================================================================
# ВСПОМОГАТЕЛЬНЫЕ ФУНКЦИИ: СИСТЕМНЫЙ СТАТУС (DNS, BBR, SWAP, FAIL2BAN)
# ==============================================================================
get_sys_dns_short() {
    local dns_list=$(grep -E "^nameserver" /etc/resolv.conf 2>/dev/null | awk '{print $2}' | tr '\n' ' ' | sed 's/ $//')
    [ -z "$dns_list" ] && dns_list="Не определен"
    echo "$dns_list"
}

get_bbr_short_status() {
    local cc=$(sysctl -n net.ipv4.tcp_congestion_control 2>/dev/null || echo "unknown")
    local qd=$(sysctl -n net.core.default_qdisc 2>/dev/null || echo "unknown")
    if [ "$cc" = "bbr" ]; then
        echo -e "${GREEN}BBR (${qd}+${cc})${NC}"
    else
        echo -e "${YELLOW}${cc} (Не оптим.)${NC}"
    fi
}

get_swap_short_status() {
    local sw_total=$(free -m 2>/dev/null | awk '/^Swap:/{print $2}')
    if [ -n "$sw_total" ] && [ "$sw_total" -gt 0 ]; then
        local sw_h=$(free -h 2>/dev/null | awk '/^Swap:/{print $2}')
        local sw_u=$(free -h 2>/dev/null | awk '/^Swap:/{print $3}')
        echo -e "${GREEN}${sw_h}${NC} (занято ${sw_u})"
    else
        echo -e "${YELLOW}НЕТ SWAP${NC}"
    fi
}

get_f2b_short_status() {
    if ! which fail2ban-client >/dev/null 2>&1; then
        echo -e "${RED}НЕ УСТАНОВЛЕН${NC}"
    elif systemctl is-active --quiet fail2ban; then
        local j_cnt=$(fail2ban-client status 2>/dev/null | grep -E "Number of jail:" | awk '{print $NF}')
        [ -z "$j_cnt" ] && j_cnt="0"
        echo -e "${GREEN}АКТИВЕН (${j_cnt} jails)${NC}"
    else
        echo -e "${YELLOW}ОСТАНОВЛЕН${NC}"
    fi
}

# ------------------------------------------------------------------------------
# СИСТЕМНЫЙ DNS: ПАРАЛЛЕЛЬНЫЙ ПИНГ И ПРИМЕНЕНИЕ
# ------------------------------------------------------------------------------
ping_dns_target() {
    local ip="$1"
    local outfile="$2"
    local rtt=$(ping -c 2 -i 0.2 -W 1 "$ip" 2>/dev/null | awk -F'/' '/avg|rtt/{printf "%.1f ms", $5}')
    if [ -n "$rtt" ]; then
        echo "$rtt" > "$outfile"
    else
        if nc -z -u -w 1 "$ip" 53 2>/dev/null || (timeout 1 bash -c "echo >/dev/tcp/$ip/53") 2>/dev/null; then
            echo "Port 53 OK" > "$outfile"
        else
            echo "Таймаут" > "$outfile"
        fi
    fi
}

format_dns_ping() {
    local ping_val="$1"
    if [[ "$ping_val" =~ "Таймаут" ]]; then
        echo -e "${RED}[ Таймаут ]${NC}"
    elif [[ "$ping_val" =~ "Port 53" ]]; then
        echo -e "${CYAN}[ Порт 53 OK ]${NC}"
    elif [ -n "$ping_val" ]; then
        local ms_num=$(echo "$ping_val" | awk '{print int($1)}')
        if [ "$ms_num" -lt 15 ]; then
            echo -e "${GREEN}[ ${ping_val} ]${NC}"
        elif [ "$ms_num" -lt 50 ]; then
            echo -e "${CYAN}[ ${ping_val} ]${NC}"
        elif [ "$ms_num" -lt 100 ]; then
            echo -e "${YELLOW}[ ${ping_val} ]${NC}"
        else
            echo -e "${PURPLE}[ ${ping_val} ]${NC}"
        fi
    else
        echo -e "${YELLOW}[ Замер... ]${NC}"
    fi
}

apply_system_dns() {
    local p_dns="$1"
    local s_dns="$2"
    local desc="$3"

    clear
    echo -e "${BOLD}--- Применение системного DNS ---${NC}"
    echo -e "Выбран DNS: ${GREEN}${desc}${NC}"
    echo -e "  • Основной (Primary):   ${CYAN}${p_dns}${NC}"
    [ -n "$s_dns" ] && echo -e "  • Резервный (Secondary): ${CYAN}${s_dns}${NC}"
    echo ""

    chattr -i /etc/resolv.conf 2>/dev/null || true

    if [ ! -f /etc/resolv.conf.x-bak ]; then
        cp /etc/resolv.conf /etc/resolv.conf.x-bak 2>/dev/null || true
    fi

    # 1. systemd-resolved
    if systemctl is-active --quiet systemd-resolved 2>/dev/null; then
        mkdir -p /etc/systemd/resolved.conf.d
        cat > /etc/systemd/resolved.conf.d/99-xmanager-dns.conf <<EOF
[Resolve]
DNS=${p_dns} ${s_dns}
FallbackDNS=1.1.1.1 8.8.8.8
Domains=~.
DNSSEC=allow-downgrade
DNSOverTLS=no
EOF
        systemctl restart systemd-resolved 2>/dev/null || true
        local def_if=$(ip route show default 2>/dev/null | awk '{print $5}' | head -n1)
        if [ -n "$def_if" ] && which resolvectl >/dev/null 2>&1; then
            resolvectl dns "$def_if" $p_dns $s_dns 2>/dev/null || true
            resolvectl default-route "$def_if" true 2>/dev/null || true
        fi
    fi

    # 2. Прямая запись в /etc/resolv.conf
    [ -L /etc/resolv.conf ] && rm -f /etc/resolv.conf
    cat > /etc/resolv.conf <<EOF
# Generated by x-manager system optimizer
nameserver ${p_dns}
EOF
    [ -n "$s_dns" ] && echo "nameserver ${s_dns}" >> /etc/resolv.conf
    cat >> /etc/resolv.conf <<EOF
options timeout:2 attempts:2
EOF

    # 3. Фиксация в dhclient.conf
    if [ -d /etc/dhcp ]; then
        local dh_conf="/etc/dhcp/dhclient.conf"
        [ -f "$dh_conf" ] && sed -i '/supersede domain-name-servers/d' "$dh_conf"
        if [ -n "$s_dns" ]; then
            echo "supersede domain-name-servers ${p_dns}, ${s_dns};" >> "$dh_conf" 2>/dev/null || true
        else
            echo "supersede domain-name-servers ${p_dns};" >> "$dh_conf" 2>/dev/null || true
        fi
    fi

    mkdir -p /etc/x-manager 2>/dev/null || true
    echo "${desc}|${p_dns}|${s_dns}" > /etc/x-manager/dns_profile.txt

    sleep 1
    echo -e "${YELLOW}Тестирование разрешения доменных имён...${NC}"
    local ya_ip=$(getent ahostsv4 ya.ru 2>/dev/null | awk '{print $1}' | head -n1)
    local goog_ip=$(getent ahostsv4 google.com 2>/dev/null | awk '{print $1}' | head -n1)

    if [ -n "$ya_ip" ] || [ -n "$goog_ip" ]; then
        echo -e "${GREEN}✓ Системный DNS успешно применён и работает!${NC}"
        [ -n "$ya_ip" ] && echo -e "  • ya.ru       -> ${GREEN}${ya_ip}${NC}"
        [ -n "$goog_ip" ] && echo -e "  • google.com  -> ${GREEN}${goog_ip}${NC}"
    else
        echo -e "${RED}⚠️ Внимание: доменные имена не разрешаются через выбранный DNS!${NC}"
        echo -e "${YELLOW}Возможно, провайдер или фаервол блокирует порт 53 UDP.${NC}"
    fi
    echo ""
    read -p "Нажмите Enter для продолжения..."
}

menu_dns_russian() {
    clear
    echo -e "${BOLD}--- Выбор системного DNS (Серверы в России) ---${NC}"
    echo -e "${YELLOW}⏳ Замер задержки (пинг) до российских DNS-серверов...${NC}"

    local tmpdir=$(mktemp -d /tmp/x_dns_ping.XXXXXX)
    ping_dns_target "77.88.8.8" "$tmpdir/p1" &
    ping_dns_target "77.88.8.88" "$tmpdir/p2" &
    ping_dns_target "77.88.8.7" "$tmpdir/p3" &
    ping_dns_target "193.58.251.251" "$tmpdir/p4" &
    ping_dns_target "83.220.169.155" "$tmpdir/p5" &
    ping_dns_target "195.34.32.116" "$tmpdir/p6" &
    wait

    local p1=$(cat "$tmpdir/p1" 2>/dev/null)
    local p2=$(cat "$tmpdir/p2" 2>/dev/null)
    local p3=$(cat "$tmpdir/p3" 2>/dev/null)
    local p4=$(cat "$tmpdir/p4" 2>/dev/null)
    local p5=$(cat "$tmpdir/p5" 2>/dev/null)
    local p6=$(cat "$tmpdir/p6" 2>/dev/null)
    rm -rf "$tmpdir"

    clear
    echo -e "${CYAN}╔══════════════════════════════════════════════════════════════════════╗${NC}"
    echo -e "${CYAN}║${BOLD}             РОССИЙСКИЕ СИСТЕМНЫЕ DNS-СЕРВЕРЫ (IPv4 :53)              ${CYAN}║${NC}"
    echo -e "${CYAN}╠══════════════════════════════════════════════════════════════════════╣${NC}"
    echo -e "${CYAN}║${NC}  Текущие DNS: ${GREEN}$(get_sys_dns_short)${NC}"
    echo -e "${CYAN}╚══════════════════════════════════════════════════════════════════════╝${NC}"
    echo ""
    printf "  ${YELLOW}[1]${NC} %-19s %-32s %-18b %s\n" "Yandex DNS" "77.88.8.8 / 77.88.8.1" "$(format_dns_ping "$p1")" "(Обычный, быстрый Anycast)"
    printf "  ${YELLOW}[2]${NC} %-19s %-32s %-18b %s\n" "Yandex DNS Safe" "77.88.8.88 / 77.88.8.2" "$(format_dns_ping "$p2")" "(Фильтрация опасных сайтов)"
    printf "  ${YELLOW}[3]${NC} %-19s %-32s %-18b %s\n" "Yandex Family" "77.88.8.7 / 77.88.8.3" "$(format_dns_ping "$p3")" "(Семейная фильтрация)"
    printf "  ${YELLOW}[4]${NC} %-19s %-32s %-18b %s\n" "SkyDNS" "193.58.251.251" "$(format_dns_ping "$p4")" "(Российский DNS, фильтрация)"
    printf "  ${YELLOW}[5]${NC} %-19s %-32s %-18b %s\n" "Comss.one DNS" "83.220.169.155 / 212.109.195.93" "$(format_dns_ping "$p5")" "(Узел в Москве + резерв)"
    printf "  ${YELLOW}[6]${NC} %-19s %-32s %-18b %s\n" "MTS DNS" "195.34.32.116 / 212.188.4.10" "$(format_dns_ping "$p6")" "(Операторский DNS МТС)"
    echo ""
    echo -e "  ${YELLOW}[0]${NC} Назад"
    echo ""
    read -p "Выберите DNS-сервер [0-6]: " ru_choice
    case "$ru_choice" in
        1) apply_system_dns "77.88.8.8" "77.88.8.1" "Yandex DNS" ;;
        2) apply_system_dns "77.88.8.88" "77.88.8.2" "Yandex DNS Safe" ;;
        3) apply_system_dns "77.88.8.7" "77.88.8.3" "Yandex Family" ;;
        4) apply_system_dns "193.58.251.251" "193.58.251.252" "SkyDNS" ;;
        5) apply_system_dns "83.220.169.155" "212.109.195.93" "Comss.one DNS" ;;
        6) apply_system_dns "195.34.32.116" "212.188.4.10" "MTS DNS" ;;
        0) return ;;
        *) echo "Неверный выбор"; sleep 1 ;;
    esac
}

