#!/usr/bin/env bash
# ==============================================================================
# x-manager: Единый центр управления всеми прокси и VPN службами
# Сервер: Gateway (89.19.223.185)
# Поддерживаемые сервисы:
#   1. Mieru (mita v3.37.0)
#   2. Snell (v5.0.1)
#   3. WDTT / qwdtt (VPN Server)
# ==============================================================================

set -e
clear() { command clear 2>/dev/null || true; }

# Цвета терминала
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
PURPLE='\033[0;35m'
CYAN='\033[0;36m'
BOLD='\033[1m'
NC='\033[0m'

# Пути к файлам конфигурации
MIERU_CONFIG_DIR="/etc/mita"
MIERU_CONFIG_FILE="/etc/mita/config.json"
MIERU_USER_STORE="/etc/mita/users_db.json"

SNELL_CONFIG_DIR="/etc/snell"
SNELL_CONFIG_FILE="/etc/snell/snell-server.conf"
SNELL_ROUTING_FILE="/etc/snell/routing.mode"

WDTT_DIR="/etc/wdtt"
WDTT_PASSWORD_FILE="/etc/wdtt/main.password"
WDTT_DB_FILE="/etc/wdtt/passwords.json"
WDTT_PROFILE_FILE="/etc/wdtt/profile_name.txt"
WDTT_SERVICE_FILE="/etc/systemd/system/wdtt.service"

CSQTT_DIR="/etc/csqtt"
CSQTT_ENV_FILE="/etc/csqtt/csqtt.env"
CSQTT_LOCK_FILE="/etc/csqtt/ssh_only.lock"
CSQTT_NET_UP="/usr/local/lib/csqtt/network-up.sh"
CSQTT_SERVICE_FILE="/etc/systemd/system/csqtt.service"
# Пути к файлам DNS-туннелей (CottenDNS / MasterDnsVPN)
COTTEN_DIR="/etc/cottendns"
COTTEN_BIN="/usr/local/bin/cottendns-server"
COTTEN_CONFIG_FILE="/etc/cottendns/server_config.toml"
COTTEN_KEY_FILE="/etc/cottendns/encrypt_key.txt"
COTTEN_SERVICE="cottendns"

MASTERDNS_DIR="/etc/masterdns"
MASTERDNS_BIN="/usr/local/bin/masterdns-server"
MASTERDNS_CONFIG_FILE="/etc/masterdns/server_config.toml"
MASTERDNS_KEY_FILE="/etc/masterdns/encrypt_key.txt"
MASTERDNS_SERVICE="masterdns"

DNS_WAN_LOCK="/etc/x-manager/dns_wan_blocked.lock"
MIERU_FW_LOCK="/etc/x-manager/mieru_fw_blocked.lock"
SNELL_FW_LOCK="/etc/x-manager/snell_fw_blocked.lock"
WDTT_FW_LOCK="/etc/x-manager/wdtt_fw_blocked.lock"
CSQTT_TUNNEL_LOCK="/etc/x-manager/csqtt_tunnel_blocked.lock"


WAN_IF=$(ip route show default 2>/dev/null | awk '{print $5}' | head -n 1)
[ -z "$WAN_IF" ] && WAN_IF="ens3"

IP_FILE="/etc/mita/server_ip.txt"


# ------------------------------------------------------------------------------
# Проверка наличия установленных сервисов (Dynamic Detection)
# ------------------------------------------------------------------------------
is_mieru_installed() {
    command -v mita >/dev/null 2>&1 || [ -f "$MIERU_CONFIG_FILE" ] || [ -f "/etc/systemd/system/mita.service" ]
}

is_snell_installed() {
    command -v snell-server >/dev/null 2>&1 || [ -f "$SNELL_CONFIG_FILE" ] || [ -f "/etc/systemd/system/snell.service" ]
}

is_wdtt_installed() {
    command -v wdtt >/dev/null 2>&1 || [ -f "/etc/systemd/system/wdtt.service" ] || [ -d "$WDTT_DIR" ]
}

is_csqtt_installed() {
    command -v csqtt >/dev/null 2>&1 || [ -f "$CSQTT_SERVICE_FILE" ] || [ -d "$CSQTT_DIR" ]
}

is_cottendns_installed() {
    [ -f "$COTTEN_BIN" ] || [ -f "/etc/systemd/system/${COTTEN_SERVICE}.service" ] || [ -d "$COTTEN_DIR" ]
}

is_masterdns_installed() {
    [ -f "$MASTERDNS_BIN" ] || [ -f "/etc/systemd/system/${MASTERDNS_SERVICE}.service" ] || [ -d "$MASTERDNS_DIR" ]
}

is_dns_installed() {
    is_cottendns_installed || is_masterdns_installed
}

get_server_ip() {
    if [ -f "$IP_FILE" ]; then
        cat "$IP_FILE"
    else
        local ip=$(curl -4 -s -m 3 https://api.ipify.org || curl -4 -s -m 3 https://ifconfig.me || ip route get 1.1.1.1 2>/dev/null | awk '{print $7}')
        [ -n "$ip" ] && echo "$ip" > "$IP_FILE"
        echo "$ip"
    fi
}

SERVER_IP=$(get_server_ip)

# ------------------------------------------------------------------------------
# Вспомогательные функции: MIERU
# ------------------------------------------------------------------------------
get_mieru_version() {
    if command -v mita &>/dev/null; then
        local v=$(mita version 2>/dev/null | head -n1 | tr -d 'v[:space:]')
        [ -n "$v" ] && echo "$v" || echo "3.37.0"
    else
        echo "3.37.0"
    fi
}

get_mieru_status() {
    if ! is_mieru_installed; then
        echo -e "${RED}НЕ УСТАНОВЛЕН${NC}"
        return
    fi
    if systemctl is-active --quiet mita; then
        local m_stat=$(mita status 2>/dev/null)
        if [[ "$m_stat" =~ "RUNNING" ]]; then
            echo -e "${GREEN}АКТИВЕН (В РАБОТЕ)${NC}"
        elif [[ "$m_stat" =~ "IDLE" ]]; then
            echo -e "${GREEN}АКТИВЕН (ОЖИДАНИЕ)${NC}"
        else
            echo -e "${GREEN}АКТИВЕН (ОНЛАЙН)${NC}"
        fi
    else
        echo -e "${RED}ОСТАНОВЛЕН${NC}"
    fi
}

get_mieru_ports() {
    if [ -f "$MIERU_CONFIG_FILE" ]; then
        local p=$(jq -r '.portBindings[0].portRange // .portBindings[0].port // "Не заданы"' "$MIERU_CONFIG_FILE" 2>/dev/null)
        local proto=$(jq -r '.portBindings[0].protocol // "TCP"' "$MIERU_CONFIG_FILE" 2>/dev/null)
        echo "${p}/${proto}"
    else
        echo "446-447/UDP"
    fi
}

get_mieru_preset() {
    if [ -f "$MIERU_CONFIG_FILE" ]; then
        local has_low=$(jq -r '.trafficPattern.lowEntropy.mode // empty' "$MIERU_CONFIG_FILE" 2>/dev/null)
        local has_rot=$(jq -r '.trafficPattern.lowEntropy.maskRotation // empty' "$MIERU_CONFIG_FILE" 2>/dev/null)
        local has_frag=$(jq -r '.trafficPattern.tcpFragment.enable // false' "$MIERU_CONFIG_FILE" 2>/dev/null)
        local has_nonce=$(jq -r '.trafficPattern.nonce.type // empty' "$MIERU_CONFIG_FILE" 2>/dev/null)
        
        if [ -n "$has_low" ] && [ "$has_low" != "LOW_ENTROPY_MODE_OFF" ]; then
            local short_mode=$(echo "$has_low" | sed 's/LOW_ENTROPY_MODE_//')
            local short_rot=$(echo "$has_rot" | sed 's/LOW_ENTROPY_MASK_//' | sed 's/ROTATE_RIGHT_/R-/' | sed 's/ROTATE_LEFT_/L-/')
            echo -e "${PURPLE}Low-Entropy ${short_mode} (${short_rot})${NC}"
        elif [ "$has_nonce" = "NONCE_TYPE_PRINTABLE" ]; then
            echo -e "${CYAN}Medium (Printable Nonce)${NC}"
        elif [ "$has_frag" = "true" ]; then
            echo -e "${BLUE}Basic (Фрагментация)${NC}"
        else
            echo -e "${YELLOW}Disabled (Без обфускации)${NC}"
        fi
    else
        echo "Не определен"
    fi
}

get_mieru_routing() {
    if [ -f "$MIERU_CONFIG_FILE" ]; then
        local p_name=$(jq -r '.egress.proxies[0].name // empty' "$MIERU_CONFIG_FILE" 2>/dev/null)
        local p_port=$(jq -r '.egress.proxies[0].port // empty' "$MIERU_CONFIG_FILE" 2>/dev/null)
        if [ "$p_name" = "xray_socks" ] && [ -n "$p_port" ]; then
            echo -e "${GREEN}Маршрутизация Xray${NC}"
        else
            echo -e "${YELLOW}Прямой выход${NC}"
        fi
    else
        echo "Прямой выход"
    fi
}

restart_mieru_and_verify() {
    mkdir -p "$MIERU_CONFIG_DIR"
    chown -R mita:mita "$MIERU_CONFIG_DIR"
    [ -f "$MIERU_CONFIG_FILE" ] && chmod 664 "$MIERU_CONFIG_FILE"
    systemctl daemon-reload
    systemctl restart mita
    sleep 2
    local m_stat=$(mita status 2>/dev/null)
    if [[ "$m_stat" =~ "RUNNING" ]] || [[ "$m_stat" =~ "IDLE" ]] || systemctl is-active --quiet mita; then
        echo -e "${GREEN}✓ Mieru успешно запущен и готов к работе (ONLINE)!${NC}"
    else
        echo -e "${RED}✗ Внимание: Mieru не смог запуститься!${NC}"
        journalctl -u mita -n 8 --no-pager
    fi
}

# ------------------------------------------------------------------------------
# Вспомогательные функции: SNELL (v5.0.1)
# ------------------------------------------------------------------------------
get_snell_status() {
    if ! is_snell_installed; then
        echo -e "${RED}НЕ УСТАНОВЛЕН${NC}"
        return
    fi
    if systemctl is-active --quiet snell; then
        echo -e "${GREEN}АКТИВЕН (RUNNING)${NC}"
    else
        echo -e "${RED}ОСТАНОВЛЕН${NC}"
    fi
}

get_snell_port() {
    if [ -f "$SNELL_CONFIG_FILE" ]; then
        grep -E "^listen" "$SNELL_CONFIG_FILE" | awk -F':' '{print $NF}' | tr -d ' '
    else
        echo "14880"
    fi
}

get_snell_psk() {
    if [ -f "$SNELL_CONFIG_FILE" ]; then
        grep -E "^psk" "$SNELL_CONFIG_FILE" | awk -F'=' '{print $2}' | tr -d ' '
    else
        echo "Не задан"
    fi
}

get_snell_obfs() {
    if [ -f "$SNELL_CONFIG_FILE" ]; then
        local obfs=$(grep -a -E "^obfs[[:space:]]*=" "$SNELL_CONFIG_FILE" | awk -F'=' '{print $2}' | tr -d ' ')
        local host=$(grep -a -E "^obfs-host[[:space:]]*=" "$SNELL_CONFIG_FILE" | awk -F'=' '{print $2}' | tr -d ' ')
        if [ -n "$obfs" ] && [ "$obfs" != "off" ]; then
            echo "${obfs} (${host})"
        else
            echo "Отключена (Чистый Snell v5)"
        fi
    else
        echo "Не настроен"
    fi
}

get_snell_tag() {
    if [ -f "/etc/snell/tag.txt" ]; then
        local t=$(cat "/etc/snell/tag.txt" | tr -d '[:space:]')
        [ -n "$t" ] && echo "$t" || echo "Snell-v5"
    else
        echo "Snell-v5"
    fi
}

snell_change_tag() {
    show_snell_header
    local cur_tag=$(get_snell_tag)
    echo -e "${BOLD}--- Настройка имени подключения Snell ---${NC}"
    echo -e "Текущее имя подключения: ${CYAN}${cur_tag}${NC}"
    echo ""
    read -p "Введите новое имя подключения (например, Snell-Home, Proxy-1): " new_tag
    if [ -n "$new_tag" ]; then
        new_tag=$(echo "$new_tag" | tr -d '#&/?')
        mkdir -p /etc/snell
        echo "$new_tag" > /etc/snell/tag.txt
        echo -e "${GREEN}✓ Имя подключения сохранено: ${new_tag}${NC}"
        sleep 2
    fi
}

get_mieru_tag() {
    if [ -f "/etc/mieru/tag.txt" ]; then
        local t=$(cat "/etc/mieru/tag.txt" | tr -d '[:space:]')
        [ -n "$t" ] && echo "$t" || echo "Mieru"
    else
        echo "Mieru"
    fi
}

mieru_change_tag() {
    show_mieru_header
    local cur_tag=$(get_mieru_tag)
    echo -e "${BOLD}--- Настройка имени подключения Mieru ---${NC}"
    echo -e "Текущее имя подключения: ${CYAN}${cur_tag}${NC}"
    echo ""
    read -p "Введите новое имя подключения (например, Mieru-Home): " new_tag
    if [ -n "$new_tag" ]; then
        new_tag=$(echo "$new_tag" | tr -d '#&/?')
        mkdir -p /etc/mieru
        echo "$new_tag" > /etc/mieru/tag.txt
        echo -e "${GREEN}✓ Имя подключения сохранено: ${new_tag}${NC}"
        sleep 2
    fi
}


get_snell_routing() {
    local mode="xray"
    [ -f "$SNELL_ROUTING_FILE" ] && mode=$(cat "$SNELL_ROUTING_FILE" | tr -d ' ')
    if [ "$mode" = "xray" ]; then
        echo -e "${GREEN}Маршрутизация Xray${NC}"
    else
        echo -e "${YELLOW}Прямой выход${NC}"
    fi
}

restart_snell_and_verify() {
    chown -R snell:snell "$SNELL_CONFIG_DIR"
    chmod 644 "$SNELL_CONFIG_FILE"
    systemctl daemon-reload
    systemctl restart snell
    sleep 2
    if systemctl is-active --quiet snell; then
        echo -e "${GREEN}✓ Snell v5 успешно перезапущен и работает (RUNNING)!${NC}"
    else
        echo -e "${RED}✗ Внимание: Snell не смог запуститься!${NC}"
        journalctl -u snell -n 8 --no-pager
    fi
}

# ------------------------------------------------------------------------------
# Вспомогательные функции: WDTT
# ------------------------------------------------------------------------------
get_wdtt_status() {
    if ! is_wdtt_installed; then
        echo -e "${RED}НЕ УСТАНОВЛЕН${NC}"
        return
    fi
    if systemctl is-active --quiet wdtt; then
        echo -e "${GREEN}АКТИВЕН (RUNNING)${NC}"
    else
        echo -e "${RED}ОСТАНОВЛЕН${NC}"
    fi
}

get_wdtt_password() {
    if [ -f "$WDTT_PASSWORD_FILE" ]; then
        cat "$WDTT_PASSWORD_FILE" | tr -d '\r\n'
    else
        echo "sad_534188_sad"
    fi
}

get_wdtt_peer_port() {
    local port=""
    if [ -f "$WDTT_SERVICE_FILE" ]; then
        port=$(grep -oP -- '(^|\s)-listen\s+[0-9.]+:\K[0-9]+' "$WDTT_SERVICE_FILE" 2>/dev/null | head -n 1 || true)
    fi
    if [ -z "$port" ]; then
        port=$(ss -ulpn 2>/dev/null | grep wdtt-server | awk '{print $4}' | awk -F: '{print $NF}' | grep -v '56001\|37001\|44001' | head -n 1 || true)
    fi
    if [ -z "$port" ]; then
        port="56000"
    fi
    echo "$port"
}

get_wdtt_profile_name() {
    if [ -f "$WDTT_PROFILE_FILE" ]; then
        cat "$WDTT_PROFILE_FILE" | tr -d '\r\n'
    else
        echo "WDTT-${SERVER_IP}"
    fi
}

wdtt_change_profile_name() {
    show_wdtt_header
    local cur_name=$(get_wdtt_profile_name)
    echo -e "${BOLD}--- Смена названия подключения WDTT (qwdtt) ---${NC}"
    echo -e "Текущее название: ${CYAN}${cur_name}${NC}"
    echo ""
    read -p "Введите новое название подключения (например: СПб обход бс): " new_name
    if [ -n "$new_name" ]; then
        mkdir -p "$WDTT_DIR"
        echo -n "$new_name" > "$WDTT_PROFILE_FILE"
        echo -e "${GREEN}✓ Название подключения обновлено: ${new_name}${NC}"
    else
        echo -e "${YELLOW}Изменения отменены (пустое значение).${NC}"
    fi
    sleep 1.5
}

get_wdtt_routing() {
    if iptables -t mangle -C PREROUTING -i wdtt0 -j WDTT_TPROXY 2>/dev/null; then
        echo -e "${GREEN}Маршрутизация Xray${NC}"
    else
        echo -e "${YELLOW}Прямой выход${NC}"
    fi
}

restart_wdtt_and_verify() {
    systemctl daemon-reload
    systemctl restart wdtt
    sleep 2
    if systemctl is-active --quiet wdtt; then
        echo -e "${GREEN}✓ WDTT успешно перезапущен и работает (RUNNING)!${NC}"
    else
        echo -e "${RED}✗ Внимание: WDTT не смог запуститься!${NC}"
        journalctl -u wdtt -n 8 --no-pager
    fi
}

# ------------------------------------------------------------------------------
# ВСПОМОГАТЕЛЬНЫЕ ФУНКЦИИ: ФАЕРВОЛ И БЛОКИРОВКА ПОРТОВ (IPTABLES)
# ------------------------------------------------------------------------------

# --- Mieru Firewall ---
is_mieru_fw_blocked() {
    [ -f "$MIERU_FW_LOCK" ] && return 0
    if iptables -S INPUT 2>/dev/null | grep -q -- "-m comment --comment \"MIERU_FW_BLOCK\" -j DROP"; then
        return 0
    fi
    return 1
}

get_mieru_fw_status() {
    if ! is_mieru_installed; then
        echo -e "${RED}Не установлен${NC}"
        return
    fi
    if is_mieru_fw_blocked; then
        echo -e "${RED}🔴 ЗАКРЫТ (DROP)${NC}"
    else
        echo -e "${GREEN}🟢 ОТКРЫТ (Прием трафика)${NC}"
    fi
}

toggle_mieru_fw() {
    local cur_ports_str=$(get_mieru_ports)
    local ports=$(echo "$cur_ports_str" | cut -d'/' -f1)
    local proto=$(echo "$cur_ports_str" | cut -d'/' -f2 | tr '[:upper:]' '[:lower:]')
    [ -z "$proto" ] && proto="tcp"
    [ -z "$ports" ] && ports="2020-2030"
    local ipt_ports="$ports"
    if [[ "$ports" =~ - ]]; then
        local p_start=$(echo "$ports" | cut -d'-' -f1)
        local p_end=$(echo "$ports" | cut -d'-' -f2)
        ipt_ports="${p_start}:${p_end}"
    fi

    echo ""
    if is_mieru_fw_blocked; then
        echo -e "${YELLOW}Открытие портов Mieru (${ports}/${proto}) в фаерволе...${NC}"
        while iptables -D INPUT -i "$WAN_IF" -p "$proto" --dport "$ipt_ports" -m comment --comment "MIERU_FW_BLOCK" -j DROP 2>/dev/null; do :; done
        while iptables -D INPUT -p "$proto" --dport "$ipt_ports" -m comment --comment "MIERU_FW_BLOCK" -j DROP 2>/dev/null; do :; done
        rm -f "$MIERU_FW_LOCK"
        iptables -C INPUT -p "$proto" --dport "$ipt_ports" -m comment --comment "MIERU_MANAGED" -j ACCEPT 2>/dev/null || iptables -I INPUT -p "$proto" --dport "$ipt_ports" -m comment --comment "MIERU_MANAGED" -j ACCEPT
        echo -e "${GREEN}✓ Порты Mieru (${ports}/${proto}) успешно ОТКРЫТЫ в фаерволе!${NC}"
    else
        echo -e "${YELLOW}Блокировка портов Mieru (${ports}/${proto}) в фаерволе...${NC}"
        mkdir -p /etc/x-manager
        touch "$MIERU_FW_LOCK"
        iptables -D INPUT -p "$proto" --dport "$ipt_ports" -m comment --comment "MIERU_MANAGED" -j ACCEPT 2>/dev/null || true
        iptables -D INPUT -p "$proto" --dport "$ipt_ports" -j ACCEPT 2>/dev/null || true
        while iptables -D INPUT -i "$WAN_IF" -p "$proto" --dport "$ipt_ports" -m comment --comment "MIERU_FW_BLOCK" -j DROP 2>/dev/null; do :; done
        iptables -I INPUT 1 -i "$WAN_IF" -p "$proto" --dport "$ipt_ports" -m comment --comment "MIERU_FW_BLOCK" -j DROP
        echo -e "${RED}✓ Порты Mieru (${ports}/${proto}) успешно ЗАБЛОКИРОВАНЫ в фаерволе (DROP)!${NC}"
    fi
    sleep 1.5
}

# --- Snell Firewall ---
is_snell_fw_blocked() {
    [ -f "$SNELL_FW_LOCK" ] && return 0
    if iptables -S INPUT 2>/dev/null | grep -q -- "-m comment --comment \"SNELL_FW_BLOCK\" -j DROP"; then
        return 0
    fi
    return 1
}

get_snell_fw_status() {
    if ! is_snell_installed; then
        echo -e "${RED}Не установлен${NC}"
        return
    fi
    if is_snell_fw_blocked; then
        echo -e "${RED}🔴 ЗАКРЫТ (DROP)${NC}"
    else
        echo -e "${GREEN}🟢 ОТКРЫТ (Прием трафика)${NC}"
    fi
}

toggle_snell_fw() {
    local port=$(get_snell_port)
    [ -z "$port" ] && port="1488"
    echo ""
    if is_snell_fw_blocked; then
        echo -e "${YELLOW}Открытие порта Snell v5 (:${port} TCP+UDP) в фаерволе...${NC}"
        while iptables -D INPUT -i "$WAN_IF" -p tcp --dport "$port" -m comment --comment "SNELL_FW_BLOCK" -j DROP 2>/dev/null; do :; done
        while iptables -D INPUT -i "$WAN_IF" -p udp --dport "$port" -m comment --comment "SNELL_FW_BLOCK" -j DROP 2>/dev/null; do :; done
        while iptables -D INPUT -p tcp --dport "$port" -m comment --comment "SNELL_FW_BLOCK" -j DROP 2>/dev/null; do :; done
        while iptables -D INPUT -p udp --dport "$port" -m comment --comment "SNELL_FW_BLOCK" -j DROP 2>/dev/null; do :; done
        rm -f "$SNELL_FW_LOCK"
        iptables -C INPUT -p tcp --dport "$port" -m comment --comment "SNELL_MANAGED" -j ACCEPT 2>/dev/null || iptables -I INPUT -p tcp --dport "$port" -m comment --comment "SNELL_MANAGED" -j ACCEPT
        iptables -C INPUT -p udp --dport "$port" -m comment --comment "SNELL_MANAGED" -j ACCEPT 2>/dev/null || iptables -I INPUT -p udp --dport "$port" -m comment --comment "SNELL_MANAGED" -j ACCEPT
        echo -e "${GREEN}✓ Порт Snell v5 (:${port} TCP+UDP) успешно ОТКРЫТ в фаерволе!${NC}"
    else
        echo -e "${YELLOW}Блокировка порта Snell v5 (:${port} TCP+UDP) в фаерволе...${NC}"
        mkdir -p /etc/x-manager
        touch "$SNELL_FW_LOCK"
        iptables -D INPUT -p tcp --dport "$port" -m comment --comment "SNELL_MANAGED" -j ACCEPT 2>/dev/null || true
        iptables -D INPUT -p udp --dport "$port" -m comment --comment "SNELL_MANAGED" -j ACCEPT 2>/dev/null || true
        iptables -D INPUT -p tcp --dport "$port" -j ACCEPT 2>/dev/null || true
        iptables -D INPUT -p udp --dport "$port" -j ACCEPT 2>/dev/null || true
        while iptables -D INPUT -i "$WAN_IF" -p tcp --dport "$port" -m comment --comment "SNELL_FW_BLOCK" -j DROP 2>/dev/null; do :; done
        while iptables -D INPUT -i "$WAN_IF" -p udp --dport "$port" -m comment --comment "SNELL_FW_BLOCK" -j DROP 2>/dev/null; do :; done
        iptables -I INPUT 1 -i "$WAN_IF" -p tcp --dport "$port" -m comment --comment "SNELL_FW_BLOCK" -j DROP
        iptables -I INPUT 1 -i "$WAN_IF" -p udp --dport "$port" -m comment --comment "SNELL_FW_BLOCK" -j DROP
        echo -e "${RED}✓ Порт Snell v5 (:${port} TCP+UDP) успешно ЗАБЛОКИРОВАН в фаерволе (DROP)!${NC}"
    fi
    sleep 1.5
}

# --- WDTT Firewall ---
is_wdtt_fw_blocked() {
    [ -f "$WDTT_FW_LOCK" ] && return 0
    if iptables -S INPUT 2>/dev/null | grep -q -- "-m comment --comment \"WDTT_FW_BLOCK\" -j DROP"; then
        return 0
    fi
    return 1
}

get_wdtt_fw_status() {
    if ! is_wdtt_installed; then
        echo -e "${RED}Не установлен${NC}"
        return
    fi
    if is_wdtt_fw_blocked; then
        echo -e "${RED}🔴 ЗАКРЫТ (DROP)${NC}"
    else
        echo -e "${GREEN}🟢 ОТКРЫТ (Прием трафика)${NC}"
    fi
}

toggle_wdtt_fw() {
    local peer_p=$(get_wdtt_peer_port)
    [ -z "$peer_p" ] && peer_p="56000"
    echo ""
    if is_wdtt_fw_blocked; then
        echo -e "${YELLOW}Открытие портов WDTT / qwdtt в фаерволе...${NC}"
        while iptables -D INPUT -i "$WAN_IF" -p udp --dport "$peer_p" -m comment --comment "WDTT_FW_BLOCK" -j DROP 2>/dev/null; do :; done
        while iptables -D INPUT -i "$WAN_IF" -p tcp --dport "$peer_p" -m comment --comment "WDTT_FW_BLOCK" -j DROP 2>/dev/null; do :; done
        while iptables -D INPUT -i "$WAN_IF" -p tcp --dport 56002 -m comment --comment "WDTT_FW_BLOCK" -j DROP 2>/dev/null; do :; done
        while iptables -D INPUT -i "$WAN_IF" -p udp --dport 56002 -m comment --comment "WDTT_FW_BLOCK" -j DROP 2>/dev/null; do :; done
        while iptables -D INPUT -i "$WAN_IF" -p udp --dport 56003 -m comment --comment "WDTT_FW_BLOCK" -j DROP 2>/dev/null; do :; done
        while iptables -D INPUT -p udp --dport "$peer_p" -m comment --comment "WDTT_FW_BLOCK" -j DROP 2>/dev/null; do :; done
        while iptables -D INPUT -p tcp --dport "$peer_p" -m comment --comment "WDTT_FW_BLOCK" -j DROP 2>/dev/null; do :; done
        rm -f "$WDTT_FW_LOCK"
        iptables -C INPUT -p udp --dport "$peer_p" -m comment --comment "WDTT_MANAGED" -j ACCEPT 2>/dev/null || iptables -I INPUT -p udp --dport "$peer_p" -m comment --comment "WDTT_MANAGED" -j ACCEPT
        iptables -C INPUT -p tcp --dport "$peer_p" -m comment --comment "WDTT_MANAGED" -j ACCEPT 2>/dev/null || iptables -I INPUT -p tcp --dport "$peer_p" -m comment --comment "WDTT_MANAGED" -j ACCEPT
        iptables -C INPUT -p tcp --dport 56002 -m comment --comment "WDTT_MANAGED" -j ACCEPT 2>/dev/null || iptables -I INPUT -p tcp --dport 56002 -m comment --comment "WDTT_MANAGED" -j ACCEPT
        iptables -C INPUT -p udp --dport 56002 -m comment --comment "WDTT_MANAGED" -j ACCEPT 2>/dev/null || iptables -I INPUT -p udp --dport 56002 -m comment --comment "WDTT_MANAGED" -j ACCEPT
        iptables -C INPUT -p udp --dport 56003 -m comment --comment "WDTT_MANAGED" -j ACCEPT 2>/dev/null || iptables -I INPUT -p udp --dport 56003 -m comment --comment "WDTT_MANAGED" -j ACCEPT
        echo -e "${GREEN}✓ Порты WDTT (VPN:${peer_p}, Direct:56002, Raw:56003) успешно ОТКРЫТЫ в фаерволе!${NC}"
    else
        echo -e "${YELLOW}Блокировка портов WDTT / qwdtt в фаерволе...${NC}"
        mkdir -p /etc/x-manager
        touch "$WDTT_FW_LOCK"
        iptables -D INPUT -p udp --dport "$peer_p" -m comment --comment "WDTT_MANAGED" -j ACCEPT 2>/dev/null || true
        iptables -D INPUT -p tcp --dport "$peer_p" -m comment --comment "WDTT_MANAGED" -j ACCEPT 2>/dev/null || true
        iptables -D INPUT -p tcp --dport 56002 -m comment --comment "WDTT_MANAGED" -j ACCEPT 2>/dev/null || true
        iptables -D INPUT -p udp --dport 56002 -m comment --comment "WDTT_MANAGED" -j ACCEPT 2>/dev/null || true
        iptables -D INPUT -p udp --dport 56003 -m comment --comment "WDTT_MANAGED" -j ACCEPT 2>/dev/null || true
        while iptables -D INPUT -i "$WAN_IF" -p udp --dport "$peer_p" -m comment --comment "WDTT_FW_BLOCK" -j DROP 2>/dev/null; do :; done
        while iptables -D INPUT -i "$WAN_IF" -p tcp --dport "$peer_p" -m comment --comment "WDTT_FW_BLOCK" -j DROP 2>/dev/null; do :; done
        while iptables -D INPUT -i "$WAN_IF" -p tcp --dport 56002 -m comment --comment "WDTT_FW_BLOCK" -j DROP 2>/dev/null; do :; done
        while iptables -D INPUT -i "$WAN_IF" -p udp --dport 56002 -m comment --comment "WDTT_FW_BLOCK" -j DROP 2>/dev/null; do :; done
        while iptables -D INPUT -i "$WAN_IF" -p udp --dport 56003 -m comment --comment "WDTT_FW_BLOCK" -j DROP 2>/dev/null; do :; done
        iptables -I INPUT 1 -i "$WAN_IF" -p udp --dport "$peer_p" -m comment --comment "WDTT_FW_BLOCK" -j DROP
        iptables -I INPUT 1 -i "$WAN_IF" -p tcp --dport "$peer_p" -m comment --comment "WDTT_FW_BLOCK" -j DROP
        iptables -I INPUT 1 -i "$WAN_IF" -p tcp --dport 56002 -m comment --comment "WDTT_FW_BLOCK" -j DROP
        iptables -I INPUT 1 -i "$WAN_IF" -p udp --dport 56002 -m comment --comment "WDTT_FW_BLOCK" -j DROP
        iptables -I INPUT 1 -i "$WAN_IF" -p udp --dport 56003 -m comment --comment "WDTT_FW_BLOCK" -j DROP
        echo -e "${RED}✓ Порты WDTT (VPN:${peer_p}, Direct:56002, Raw:56003) успешно ЗАБЛОКИРОВАНЫ в фаерволе (DROP)!${NC}"
    fi
    sleep 1.5
}

# --- CSQTT Tunnel Firewall ---
is_csqtt_tunnel_blocked() {
    [ -f "$CSQTT_TUNNEL_LOCK" ] && return 0
    if iptables -S INPUT 2>/dev/null | grep -q -- "-m comment --comment \"CSQTT_TUNNEL_BLOCK\" -j DROP"; then
        return 0
    fi
    return 1
}

get_csqtt_tunnel_status() {
    if ! is_csqtt_installed; then
        echo -e "${RED}Не установлен${NC}"
        return
    fi
    if is_csqtt_tunnel_blocked; then
        echo -e "${RED}🔴 ЗАКРЫТ (DROP)${NC}"
    else
        echo -e "${GREEN}🟢 ОТКРЫТ (Прием трафика)${NC}"
    fi
}

toggle_csqtt_tunnel_fw() {
    local peer_p=$(get_csqtt_peer_port)
    [ -z "$peer_p" ] && peer_p="37000"
    echo ""
    if is_csqtt_tunnel_blocked; then
        echo -e "${YELLOW}Открытие порта VPN-туннеля CSQTT (:${peer_p}/UDP) в фаерволе...${NC}"
        while iptables -D INPUT -i "$WAN_IF" -p udp --dport "$peer_p" -m comment --comment "CSQTT_TUNNEL_BLOCK" -j DROP 2>/dev/null; do :; done
        while iptables -D INPUT -p udp --dport "$peer_p" -m comment --comment "CSQTT_TUNNEL_BLOCK" -j DROP 2>/dev/null; do :; done
        rm -f "$CSQTT_TUNNEL_LOCK"
        iptables -C INPUT -p udp --dport "$peer_p" -m comment --comment "CSQTT_MANAGED" -j ACCEPT 2>/dev/null || iptables -I INPUT -p udp --dport "$peer_p" -m comment --comment "CSQTT_MANAGED" -j ACCEPT
        echo -e "${GREEN}✓ Порт VPN-туннеля CSQTT (:${peer_p}/UDP) успешно ОТКРЫТ в фаерволе!${NC}"
    else
        echo -e "${YELLOW}Блокировка порта VPN-туннеля CSQTT (:${peer_p}/UDP) в фаерволе...${NC}"
        mkdir -p /etc/x-manager
        touch "$CSQTT_TUNNEL_LOCK"
        iptables -D INPUT -p udp --dport "$peer_p" -m comment --comment "CSQTT_MANAGED" -j ACCEPT 2>/dev/null || true
        iptables -D INPUT -p udp --dport "$peer_p" -j ACCEPT 2>/dev/null || true
        while iptables -D INPUT -i "$WAN_IF" -p udp --dport "$peer_p" -m comment --comment "CSQTT_TUNNEL_BLOCK" -j DROP 2>/dev/null; do :; done
        iptables -I INPUT 1 -i "$WAN_IF" -p udp --dport "$peer_p" -m comment --comment "CSQTT_TUNNEL_BLOCK" -j DROP
        echo -e "${RED}✓ Порт VPN-туннеля CSQTT (:${peer_p}/UDP) успешно ЗАБЛОКИРОВАН в фаерволе (DROP)!${NC}"
    fi
    sleep 1.5
}

lock_all_protocols_fw() {
    echo ""
    echo -e "${RED}${BOLD}ВНИМАНИЕ: Блокировка портов всех протоколов в фаерволе (Panic Mode)...${NC}"
    is_mieru_installed && ! is_mieru_fw_blocked && toggle_mieru_fw
    is_snell_installed && ! is_snell_fw_blocked && toggle_snell_fw
    is_wdtt_installed && ! is_wdtt_fw_blocked && toggle_wdtt_fw
    is_csqtt_installed && ! is_csqtt_tunnel_blocked && toggle_csqtt_tunnel_fw
    is_dns_installed && ! is_dns_wan_blocked && toggle_dns_wan
    echo -e "${RED}${BOLD}✓ Все протоколы успешно заблокированы в фаерволе (порты закрыты)!${NC}"
    sleep 2
}

unlock_all_protocols_fw() {
    echo ""
    echo -e "${GREEN}${BOLD}Открытие портов всех установленных протоколов в фаерволе...${NC}"
    is_mieru_installed && is_mieru_fw_blocked && toggle_mieru_fw
    is_snell_installed && is_snell_fw_blocked && toggle_snell_fw
    is_wdtt_installed && is_wdtt_fw_blocked && toggle_wdtt_fw
    is_csqtt_installed && is_csqtt_tunnel_blocked && toggle_csqtt_tunnel_fw
    is_dns_installed && is_dns_wan_blocked && toggle_dns_wan
    echo -e "${GREEN}${BOLD}✓ Все протоколы успешно разблокированы в фаерволе (порты открыты)!${NC}"
    sleep 2
}

sync_active_firewall_rules() {
    if is_snell_installed && ! is_snell_fw_blocked; then
        local sp=$(get_snell_port)
        [ -n "$sp" ] && {
            iptables -C INPUT -p tcp --dport "$sp" -m comment --comment "SNELL_MANAGED" -j ACCEPT 2>/dev/null || iptables -I INPUT -p tcp --dport "$sp" -m comment --comment "SNELL_MANAGED" -j ACCEPT
            iptables -C INPUT -p udp --dport "$sp" -m comment --comment "SNELL_MANAGED" -j ACCEPT 2>/dev/null || iptables -I INPUT -p udp --dport "$sp" -m comment --comment "SNELL_MANAGED" -j ACCEPT
        }
    fi
    if is_mieru_installed && ! is_mieru_fw_blocked; then
        local mp_str=$(get_mieru_ports)
        local mp_val=$(echo "$mp_str" | cut -d'/' -f1)
        local mp_pr=$(echo "$mp_str" | cut -d'/' -f2 | tr '[:upper:]' '[:lower:]')
        [ -z "$mp_pr" ] && mp_pr="tcp"
        local ipt_p=$(echo "$mp_val" | tr '-' ':')
        if [ -n "$ipt_p" ]; then
            iptables -C INPUT -p "$mp_pr" --dport "$ipt_p" -m comment --comment "MIERU_MANAGED" -j ACCEPT 2>/dev/null || iptables -I INPUT -p "$mp_pr" --dport "$ipt_p" -m comment --comment "MIERU_MANAGED" -j ACCEPT
        fi
    fi
    if is_wdtt_installed && ! is_wdtt_fw_blocked; then
        local wp=$(get_wdtt_peer_port)
        [ -z "$wp" ] && wp="56000"
        iptables -C INPUT -p udp --dport "$wp" -m comment --comment "WDTT_MANAGED" -j ACCEPT 2>/dev/null || iptables -I INPUT -p udp --dport "$wp" -m comment --comment "WDTT_MANAGED" -j ACCEPT
        iptables -C INPUT -p tcp --dport "$wp" -m comment --comment "WDTT_MANAGED" -j ACCEPT 2>/dev/null || iptables -I INPUT -p tcp --dport "$wp" -m comment --comment "WDTT_MANAGED" -j ACCEPT
        iptables -C INPUT -p tcp --dport 56002 -m comment --comment "WDTT_MANAGED" -j ACCEPT 2>/dev/null || iptables -I INPUT -p tcp --dport 56002 -m comment --comment "WDTT_MANAGED" -j ACCEPT
        iptables -C INPUT -p udp --dport 56002 -m comment --comment "WDTT_MANAGED" -j ACCEPT 2>/dev/null || iptables -I INPUT -p udp --dport 56002 -m comment --comment "WDTT_MANAGED" -j ACCEPT
        iptables -C INPUT -p udp --dport 56003 -m comment --comment "WDTT_MANAGED" -j ACCEPT 2>/dev/null || iptables -I INPUT -p udp --dport 56003 -m comment --comment "WDTT_MANAGED" -j ACCEPT
    fi
    if is_csqtt_installed && ! is_csqtt_tunnel_blocked; then
        local cp=$(get_csqtt_peer_port)
        [ -z "$cp" ] && cp="37000"
        iptables -C INPUT -p udp --dport "$cp" -m comment --comment "CSQTT_MANAGED" -j ACCEPT 2>/dev/null || iptables -I INPUT -p udp --dport "$cp" -m comment --comment "CSQTT_MANAGED" -j ACCEPT
    fi
}

menu_firewall() {
    while true; do
        clear
        echo -e "${CYAN}╔══════════════════════════════════════════════════════════════════════╗${NC}"
        echo -e "${CYAN}║${BOLD}          ЦЕНТР УПРАВЛЕНИЯ ФАЕРВОЛОМ ПОРТОВ (IPTABLES)                ${CYAN}║${NC}"
        echo -e "${CYAN}╠══════════════════════════════════════════════════════════════════════╣${NC}"
        echo -e "${CYAN}║${NC}  Сервер:    ${BOLD}${SERVER_IP}${NC}  |  WAN Интерфейс: ${BOLD}${WAN_IF}${NC}"
        echo -e "${CYAN}║${NC}"
        if is_mieru_installed; then
            echo -e "${CYAN}║${NC}  [1] 🚀 Mieru (mita):         $(get_mieru_fw_status) [$(get_mieru_ports)]"
        fi
        if is_snell_installed; then
            echo -e "${CYAN}║${NC}  [2] ⚡ Snell v5:             $(get_snell_fw_status) [$(get_snell_port)/TCP+UDP]"
        fi
        if is_wdtt_installed; then
            echo -e "${CYAN}║${NC}  [3] 🛡️ WDTT / qwdtt:         $(get_wdtt_fw_status) [$(get_wdtt_peer_port)/UDP]"
        fi
        if is_csqtt_installed; then
            echo -e "${CYAN}║${NC}  [4] 🔒 CSQTT (VPN-туннель):   $(get_csqtt_tunnel_status) [$(get_csqtt_peer_port)/UDP]"
            echo -e "${CYAN}║${NC}  [5] 🌐 CSQTT (Веб-панель):   $(get_csqtt_protect_status) [$(get_csqtt_web_port)/TCP]"
        fi
        if is_dns_installed; then
            echo -e "${CYAN}║${NC}  [6] 🌐 DNS-туннель:          $(get_dns_wan_status) [:53 UDP/TCP]"
        fi
        echo -e "${CYAN}╚══════════════════════════════════════════════════════════════════════╝${NC}"
        echo ""
        echo -e "  ${BOLD}--- Переключение отдельных протоколов ---${NC}"
        is_mieru_installed && echo -e "  ${YELLOW}[1]${NC} 🚀 Переключить фаервол Mieru"
        is_snell_installed && echo -e "  ${YELLOW}[2]${NC} ⚡ Переключить фаервол Snell v5"
        is_wdtt_installed && echo -e "  ${YELLOW}[3]${NC} 🛡️  Переключить фаервол WDTT / qwdtt"
        if is_csqtt_installed; then
            echo -e "  ${YELLOW}[4]${NC} 🔒 Переключить фаервол VPN-туннеля CSQTT"
            echo -e "  ${YELLOW}[5]${NC} 🌐 Переключить защиту веб-панели CSQTT (SSH-туннель / Открыта)"
        fi
        is_dns_installed && echo -e "  ${YELLOW}[6]${NC} 🌐 Переключить фаервол DNS-туннеля (WAN :53)"
        echo ""
        echo -e "  ${BOLD}--- Групповые действия ---${NC}"
        echo -e "  ${RED}${BOLD}[7]${NC} ⛔ ${BOLD}ЗАБЛОКИРОВАТЬ ВСЕ ПРОТОКОЛЫ (Полный локдаун портов)${NC}"
        echo -e "  ${GREEN}${BOLD}[8]${NC} 🟢 ${BOLD}РАЗБЛОКИРОВАТЬ ВСЕ ПРОТОКОЛЫ (Открыть штатный доступ)${NC}"
        echo -e "  ${YELLOW}[0]${NC} ⬅️  Назад в Главное Меню"
        echo ""
        read -p "Выберите действие [0-8]: " fw_act
        case "$fw_act" in
            1) is_mieru_installed && toggle_mieru_fw ;;
            2) is_snell_installed && toggle_snell_fw ;;
            3) is_wdtt_installed && toggle_wdtt_fw ;;
            4) is_csqtt_installed && toggle_csqtt_tunnel_fw ;;
            5)
                if is_csqtt_installed; then
                    if is_csqtt_web_protected; then
                        csqtt_unprotect_web
                    else
                        csqtt_protect_web
                    fi
                    sleep 2
                fi
                ;;
            6) is_dns_installed && toggle_dns_wan ;;
            7) lock_all_protocols_fw ;;
            8) unlock_all_protocols_fw ;;
            0) return ;;
            *) echo "Неверный выбор"; sleep 1 ;;
        esac
    done
}

# ==============================================================================
# РАЗДЕЛ 1: УПРАВЛЕНИЕ MIERU
# ==============================================================================
show_mieru_header() {
    clear
    local m_ver=$(get_mieru_version)
    echo -e "${CYAN}╔══════════════════════════════════════════════════════════════════════╗${NC}"
    echo -e "${CYAN}║${BOLD}               РАЗДЕЛ: УПРАВЛЕНИЕ MIERU (mita v${m_ver})                 ${CYAN}║${NC}"
    echo -e "${CYAN}╠══════════════════════════════════════════════════════════════════════╣${NC}"
    echo -e "${CYAN}║${NC}  Сервер:     ${BOLD}${SERVER_IP}${NC}  |  Служба: $(get_mieru_status)"
    echo -e "${CYAN}║${NC}  Имя:        ${BOLD}$(get_mieru_tag)${NC}  |  Обфускация: $(get_mieru_preset)"
    echo -e "${CYAN}║${NC}  Порты:      ${BOLD}$(get_mieru_ports)${NC}  |  Фаервол: $(get_mieru_fw_status)"
    echo -e "${CYAN}║${NC}  Маршрут:    $(get_mieru_routing)"
    echo -e "${CYAN}╚══════════════════════════════════════════════════════════════════════╝${NC}"
    echo ""
}

mieru_manage_users() {
    while true; do
        show_mieru_header
        echo -e "${BOLD}--- Список зарегистрированных пользователей Mieru ---${NC}"
        jq -r '.users[] | "  Логин: \(.name)"' "$MIERU_CONFIG_FILE" 2>/dev/null || echo "  Нет пользователей"
        echo ""
        echo -e "${YELLOW}[1]${NC} Добавить пользователя"
        echo -e "${YELLOW}[2]${NC} Удалить пользователя"
        echo -e "${YELLOW}[3]${NC} Показать пароли пользователей"
        echo -e "${YELLOW}[0]${NC} Назад в меню Mieru"
        echo ""
        read -p "Выберите действие [0-3]: " u_act
        case "$u_act" in
            1)
                read -p "Введите логин пользователя: " u_name
                [ -z "$u_name" ] && continue
                read -p "Введите пароль (или Enter для автогенерации): " u_pass
                if [ -z "$u_pass" ]; then
                    u_pass=$(openssl rand -base64 12 | tr -dc 'a-zA-Z0-9' | head -c 16)
                    echo -e "Сгенерирован пароль: ${GREEN}${u_pass}${NC}"
                fi
                local tmp_cfg="/tmp/mita_usr_cfg.json"
                jq --arg n "$u_name" --arg p "$u_pass" \
                   '.users = ([.users[] | select(.name != $n)] + [{"name": $n, "password": $p, "allowPrivateIP": true, "allowLoopbackIP": true}])' \
                   "$MIERU_CONFIG_FILE" > "$tmp_cfg" && mv "$tmp_cfg" "$MIERU_CONFIG_FILE"
                local tmp_store="/tmp/users_db_tmp.json"
                cat "$MIERU_USER_STORE" | jq --arg u "$u_name" --arg p "$u_pass" '.[$u] = $p' > "$tmp_store" && mv "$tmp_store" "$MIERU_USER_STORE"
                restart_mieru_and_verify
                sleep 2
                ;;
            2)
                read -p "Введите имя пользователя для удаления: " del_name
                [ -z "$del_name" ] && continue
                local count_users=$(jq '.users | length' "$MIERU_CONFIG_FILE" 2>/dev/null || echo 0)
                if [ "$count_users" -le 1 ]; then
                    echo -e "${RED}Нельзя удалить единственного пользователя!${NC}"
                    sleep 2
                    continue
                fi
                local tmp_cfg="/tmp/mita_usr_cfg.json"
                jq --arg n "$del_name" '.users = [.users[] | select(.name != $n)]' "$MIERU_CONFIG_FILE" > "$tmp_cfg" && mv "$tmp_cfg" "$MIERU_CONFIG_FILE"
                local tmp_store="/tmp/users_db_tmp.json"
                cat "$MIERU_USER_STORE" | jq --arg u "$del_name" 'del(.[$u])' > "$tmp_store" && mv "$tmp_store" "$MIERU_USER_STORE"
                restart_mieru_and_verify
                sleep 2
                ;;
            3)
                show_mieru_header
                echo -e "${BOLD}--- Сохраненные пароли пользователей Mieru ---${NC}"
                cat "$MIERU_USER_STORE" | jq -r 'to_entries[] | "  Логин: \(.key) | Пароль: \(.value)"'
                echo ""
                read -p "Нажмите Enter для возврата..."
                ;;
            0) return ;;
        esac
    done
}

mieru_change_ports() { mieru_manage_ports "$@"; }

mieru_manage_ports() {
    show_mieru_header
    local cur_ports_str=$(get_mieru_ports)
    local old_ports=$(echo "$cur_ports_str" | cut -d'/' -f1)
    local old_proto=$(echo "$cur_ports_str" | cut -d'/' -f2 | tr '[:upper:]' '[:lower:]')

    echo -e "${BOLD}--- Настройка портов сервера Mieru ---${NC}"
    echo "Текущие порты: ${cur_ports_str}"
    echo ""
    echo "Примеры: диапазон 446-447, 2012-2022 или одиночный порт 2012 / 8443."
    echo ""
    read -p "Введите новый диапазон или порт: " new_ports
    new_ports=$(echo "$new_ports" | tr -d ' ')
    [ -z "$new_ports" ] && return

    echo "Выберите транспортный протокол:"
    echo -e "${YELLOW}[1]${NC} TCP (Рекомендуется)"
    echo -e "${YELLOW}[2]${NC} UDP"
    read -p "Выбор [1-2, по умолчанию 1]: " proto_choice
    local proto="TCP"
    [ "$proto_choice" = "2" ] && proto="UDP"

    local tmp_cfg="/tmp/mita_port_cfg.json"
    case "$new_ports" in
        *-*)
            local p_start=$(echo "$new_ports" | cut -d'-' -f1)
            local p_end=$(echo "$new_ports" | cut -d'-' -f2)
            if ! [[ "$p_start" =~ ^[0-9]+$ ]] || ! [[ "$p_end" =~ ^[0-9]+$ ]] || [ "$p_start" -lt 1 ] || [ "$p_end" -gt 65535 ] || [ "$p_start" -gt "$p_end" ]; then
                echo -e "${RED}Ошибка: некорректный диапазон '$new_ports'! Числа должны быть от 1 до 65535.${NC}"
                sleep 2
                return
            fi
            jq --arg r "$new_ports" --arg pr "$proto" \
               '.portBindings = [{"portRange": $r, "protocol": $pr}]' \
               "$MIERU_CONFIG_FILE" > "$tmp_cfg" && mv "$tmp_cfg" "$MIERU_CONFIG_FILE"
            local ipt_proto=$(echo "$proto" | tr '[:upper:]' '[:lower:]')
            iptables -I INPUT 1 -p "$ipt_proto" --dport ${p_start}:${p_end} -j ACCEPT 2>/dev/null || true
            ;;
        *)
            if ! [[ "$new_ports" =~ ^[0-9]+$ ]] || [ "$new_ports" -lt 1 ] || [ "$new_ports" -gt 65535 ]; then
                echo -e "${RED}Ошибка: некорректный порт '$new_ports'! Число должно быть от 1 до 65535.${NC}"
                sleep 2
                return
            fi
            jq --argjson p "$new_ports" --arg pr "$proto" \
               '.portBindings = [{"port": $p, "protocol": $pr}]' \
               "$MIERU_CONFIG_FILE" > "$tmp_cfg" && mv "$tmp_cfg" "$MIERU_CONFIG_FILE"
            local ipt_proto=$(echo "$proto" | tr '[:upper:]' '[:lower:]')
            iptables -I INPUT 1 -p "$ipt_proto" --dport "$new_ports" -j ACCEPT 2>/dev/null || true
            ;;
    esac

    # Удаляем старое правило из iptables (закрываем старый порт/диапазон)
    if [ -n "$old_ports" ] && [ "$old_ports" != "$new_ports" ]; then
        if [[ "$old_ports" =~ - ]]; then
            local o_s=$(echo "$old_ports" | cut -d'-' -f1)
            local o_e=$(echo "$old_ports" | cut -d'-' -f2)
            iptables -D INPUT -p "$old_proto" --dport ${o_s}:${o_e} -j ACCEPT 2>/dev/null || true
        else
            iptables -D INPUT -p "$old_proto" --dport "$old_ports" -j ACCEPT 2>/dev/null || true
        fi
    fi

    restart_mieru_and_verify
    echo -e "${GREEN}✓ Порты Mieru изменены на: ${new_ports} ($proto). Старый порт закрыт!${NC}"
    sleep 2
}

mieru_custom_entropy_builder() {
    show_mieru_header
    echo -e "${BOLD}--- Конструктор низкой энтропии и вращения маски Mieru ---${NC}"
    echo ""
    echo -e "${BOLD}Шаг 1: Выберите режим низкой энтропии (Low Entropy Mode):${NC}"
    echo -e "  ${YELLOW}[1]${NC} LOW_ENTROPY_MODE_32 (32 бит данных, оверхед 2.0x, макс. скрытность для РФ)"
    echo -e "  ${YELLOW}[2]${NC} LOW_ENTROPY_MODE_40 (40 бит данных, оверхед 1.6x)"
    echo -e "  ${YELLOW}[3]${NC} LOW_ENTROPY_MODE_48 (48 бит данных, оверхед 1.34x, сбалансированный)"
    echo -e "  ${YELLOW}[4]${NC} LOW_ENTROPY_MODE_56 (56 бит данных, оверхед 1.15x, легкий)"
    echo -e "  ${YELLOW}[5]${NC} LOW_ENTROPY_MODE_OFF (Отключить низкую энтропию)"
    echo -e "  ${YELLOW}[0]${NC} Отмена"
    echo ""
    read -p "Выберите режим [0-5]: " m_mode_choice

    local sel_mode=""
    case "$m_mode_choice" in
        1) sel_mode="LOW_ENTROPY_MODE_32" ;;
        2) sel_mode="LOW_ENTROPY_MODE_40" ;;
        3) sel_mode="LOW_ENTROPY_MODE_48" ;;
        4) sel_mode="LOW_ENTROPY_MODE_56" ;;
        5) sel_mode="LOW_ENTROPY_MODE_OFF" ;;
        0) return ;;
        *) echo "Неверный выбор"; sleep 1; return ;;
    esac

    local sel_rot="LOW_ENTROPY_MASK_NO_ROTATION"
    if [ "$sel_mode" != "LOW_ENTROPY_MODE_OFF" ]; then
        echo ""
        echo -e "${BOLD}Шаг 2: Выберите вращение маски (Low Entropy Mask Rotation):${NC}"
        echo -e "  ${YELLOW}[1]${NC} LOW_ENTROPY_MASK_ROTATE_RIGHT_7 ${GREEN}[Рекомендуемый для 64-бит]${NC}"
        echo -e "  ${YELLOW}[2]${NC} LOW_ENTROPY_MASK_ROTATE_RIGHT_3"
        echo -e "  ${YELLOW}[3]${NC} LOW_ENTROPY_MASK_ROTATE_RIGHT_1"
        echo -e "  ${YELLOW}[4]${NC} LOW_ENTROPY_MASK_ROTATE_RIGHT_5"
        echo -e "  ${YELLOW}[5]${NC} LOW_ENTROPY_MASK_ROTATE_LEFT_7"
        echo -e "  ${YELLOW}[6]${NC} LOW_ENTROPY_MASK_NO_ROTATION (Без вращения)"
        echo -e "  ${YELLOW}[7]${NC} Ввести своё значение вручную"
        echo ""
        read -p "Выберите вращение [1-7, по умолчанию 1]: " m_rot_choice
        case "$m_rot_choice" in
            1|"") sel_rot="LOW_ENTROPY_MASK_ROTATE_RIGHT_7" ;;
            2) sel_rot="LOW_ENTROPY_MASK_ROTATE_RIGHT_3" ;;
            3) sel_rot="LOW_ENTROPY_MASK_ROTATE_RIGHT_1" ;;
            4) sel_rot="LOW_ENTROPY_MASK_ROTATE_RIGHT_5" ;;
            5) sel_rot="LOW_ENTROPY_MASK_ROTATE_LEFT_7" ;;
            6) sel_rot="LOW_ENTROPY_MASK_NO_ROTATION" ;;
            7)
                read -p "Введите вращение (например, ROTATE_RIGHT_2): " custom_rot
                if [[ "$custom_rot" =~ ^LOW_ENTROPY_MASK_ ]]; then
                    sel_rot="$custom_rot"
                elif [ -n "$custom_rot" ]; then
                    sel_rot="LOW_ENTROPY_MASK_${custom_rot}"
                fi
                ;;
            *) sel_rot="LOW_ENTROPY_MASK_ROTATE_RIGHT_7" ;;
        esac
    fi

    local tmp_cfg="/tmp/mita_custom_entropy.json"
    jq --arg mode "$sel_mode" --arg rot "$sel_rot" \
       '.trafficPattern.lowEntropy = {"mode": $mode, "maskRotation": $rot} |
        .trafficPattern.unlockAll = true |
        .trafficPattern.tcpFragment = {"enable": true, "maxSleepMs": 15} |
        .trafficPattern.nonce = {"type": "NONCE_TYPE_PRINTABLE", "applyToAllUDPPacket": true, "minLen": 6, "maxLen": 8} |
        .trafficPattern.padding = {"maxMiddlePaddingLen": 64, "maxEndPaddingLen": 128}' \
       "$MIERU_CONFIG_FILE" > "$tmp_cfg" && mv "$tmp_cfg" "$MIERU_CONFIG_FILE"

    restart_mieru_and_verify
    echo -e "${GREEN}✓ Применена конфигурация: ${sel_mode} + ${sel_rot}${NC}"
    sleep 2
}

mieru_manage_presets() {
    while true; do
        show_mieru_header
        echo -e "${BOLD}--- Настройка обфускации трафика Mieru ---${NC}"
        echo -e "Текущий профиль: $(get_mieru_preset)"
        echo ""
        echo -e "${BOLD}Оптимальные готовые профили (Пресеты):${NC}"
        echo -e "  ${YELLOW}[1]${NC} 🚀 Anti-TSPU Max (Low-Entropy 32-bit + Rotate Right 7) ${GREEN}[Макс. скрытность для РФ]${NC}"
        echo "      • 32 бита данных + 32 бита паддинга (оверхед 2.0x), TCP-фрагментация 20ms, нонсы"
        echo ""
        echo -e "  ${YELLOW}[2]${NC} 🛡️ Anti-TSPU Balanced (Low-Entropy 48-bit + Rotate Right 7) ${CYAN}[Сбалансированный]${NC}"
        echo "      • 48 бит данных + 16 бит паддинга (оверхед 1.34x), TCP-фрагментация 15ms, нонсы"
        echo ""
        echo -e "  ${YELLOW}[3]${NC} ⚡ Anti-TSPU Light (Low-Entropy 56-bit + Rotate Right 3) ${YELLOW}[Экономия трафика]${NC}"
        echo "      • 56 бит данных + 8 бит паддинга (оверхед 1.15x), TCP-фрагментация 10ms, нонсы"
        echo ""
        echo -e "  ${YELLOW}[4]${NC} 🔒 Basic / Medium (Фрагментация + ASCII нонсы, без низкой энтропии)"
        echo ""
        echo -e "  ${YELLOW}[5]${NC} 🔓 Отключить обфускацию (Чистый Mieru, максимальная скорость)"
        echo ""
        echo -e "${BOLD}Ручной конструктор (Своя комбинация режима и маски):${NC}"
        echo -e "  ${YELLOW}[6]${NC} 🛠️ Настроить вручную (Выбор любого режима энтропии и маски)"
        echo ""
        echo -e "  ${YELLOW}[0]${NC} ⬅️ Назад в меню Mieru"
        echo ""
        read -p "Выберите вариант [0-6]: " p_choice

        local tmp_cfg="/tmp/mita_preset_cfg.json"
        case "$p_choice" in
            1)
                jq '.trafficPattern = {
                    "unlockAll": true,
                    "tcpFragment": {"enable": true, "maxSleepMs": 20},
                    "nonce": {"type": "NONCE_TYPE_PRINTABLE", "applyToAllUDPPacket": true, "minLen": 6, "maxLen": 8},
                    "padding": {"maxMiddlePaddingLen": 128, "maxEndPaddingLen": 255},
                    "lowEntropy": {"mode": "LOW_ENTROPY_MODE_32", "maskRotation": "LOW_ENTROPY_MASK_ROTATE_RIGHT_7"}
                }' "$MIERU_CONFIG_FILE" > "$tmp_cfg" && mv "$tmp_cfg" "$MIERU_CONFIG_FILE"
                restart_mieru_and_verify
                echo -e "${GREEN}✓ Установлен профиль Anti-TSPU Max (32-bit + Rotate Right 7)${NC}"
                sleep 2
                ;;
            2)
                jq '.trafficPattern = {
                    "unlockAll": true,
                    "tcpFragment": {"enable": true, "maxSleepMs": 15},
                    "nonce": {"type": "NONCE_TYPE_PRINTABLE", "applyToAllUDPPacket": true, "minLen": 6, "maxLen": 8},
                    "padding": {"maxMiddlePaddingLen": 64, "maxEndPaddingLen": 128},
                    "lowEntropy": {"mode": "LOW_ENTROPY_MODE_48", "maskRotation": "LOW_ENTROPY_MASK_ROTATE_RIGHT_7"}
                }' "$MIERU_CONFIG_FILE" > "$tmp_cfg" && mv "$tmp_cfg" "$MIERU_CONFIG_FILE"
                restart_mieru_and_verify
                echo -e "${GREEN}✓ Установлен профиль Anti-TSPU Balanced (48-bit + Rotate Right 7)${NC}"
                sleep 2
                ;;
            3)
                jq '.trafficPattern = {
                    "unlockAll": true,
                    "tcpFragment": {"enable": true, "maxSleepMs": 10},
                    "nonce": {"type": "NONCE_TYPE_PRINTABLE", "applyToAllUDPPacket": true, "minLen": 6, "maxLen": 8},
                    "padding": {"maxMiddlePaddingLen": 32, "maxEndPaddingLen": 64},
                    "lowEntropy": {"mode": "LOW_ENTROPY_MODE_56", "maskRotation": "LOW_ENTROPY_MASK_ROTATE_RIGHT_3"}
                }' "$MIERU_CONFIG_FILE" > "$tmp_cfg" && mv "$tmp_cfg" "$MIERU_CONFIG_FILE"
                restart_mieru_and_verify
                echo -e "${GREEN}✓ Установлен профиль Anti-TSPU Light (56-bit + Rotate Right 3)${NC}"
                sleep 2
                ;;
            4)
                jq '.trafficPattern = {
                    "unlockAll": false,
                    "tcpFragment": {"enable": true, "maxSleepMs": 10},
                    "nonce": {"type": "NONCE_TYPE_PRINTABLE", "applyToAllUDPPacket": true, "minLen": 6, "maxLen": 8},
                    "padding": {"maxMiddlePaddingLen": 64, "maxEndPaddingLen": 128},
                    "lowEntropy": {"mode": "LOW_ENTROPY_MODE_OFF", "maskRotation": "LOW_ENTROPY_MASK_NO_ROTATION"}
                }' "$MIERU_CONFIG_FILE" > "$tmp_cfg" && mv "$tmp_cfg" "$MIERU_CONFIG_FILE"
                restart_mieru_and_verify
                echo -e "${GREEN}✓ Установлен профиль Basic/Medium (без низкой энтропии)${NC}"
                sleep 2
                ;;
            5)
                jq '.trafficPattern = {
                    "unlockAll": false,
                    "tcpFragment": {"enable": false, "maxSleepMs": 0},
                    "padding": {"maxMiddlePaddingLen": 0, "maxEndPaddingLen": 0},
                    "lowEntropy": {"mode": "LOW_ENTROPY_MODE_OFF", "maskRotation": "LOW_ENTROPY_MASK_NO_ROTATION"}
                }' "$MIERU_CONFIG_FILE" > "$tmp_cfg" && mv "$tmp_cfg" "$MIERU_CONFIG_FILE"
                restart_mieru_and_verify
                echo -e "${GREEN}✓ Обфускация Mieru отключена${NC}"
                sleep 2
                ;;
            6)
                mieru_custom_entropy_builder
                ;;
            0) return ;;
            *) echo "Неверный выбор"; sleep 1 ;;
        esac
    done
}

mieru_manage_routing() {
    show_mieru_header
    echo -e "${BOLD}--- Настройка маршрутизации Mieru ---${NC}"
    echo -e "Текущий режим: $(get_mieru_routing)"
    echo ""
    echo -e "  ${YELLOW}[1]${NC} 🌐 Маршрутизация Xray"
    echo -e "  ${YELLOW}[2]${NC} ⚡ Прямой выход"
    echo ""
    echo -e "  ${YELLOW}[0]${NC} Назад"
    echo ""
    read -p "Выберите режим [0-2]: " r_choice
    case "$r_choice" in
        1)
            local tmp_cfg="/tmp/mita_egress_cfg.json"
            jq '.egress = {"proxies": [{"name": "xray_socks", "protocol": "SOCKS5_PROXY_PROTOCOL", "host": "127.0.0.1", "port": 10808}], "rules": [{"ipRanges": ["*"], "domainNames": ["*"], "action": "PROXY", "proxyNames": ["xray_socks"]}]}' \
               "$MIERU_CONFIG_FILE" > "$tmp_cfg" && mv "$tmp_cfg" "$MIERU_CONFIG_FILE"
            restart_mieru_and_verify
            echo -e "${GREEN}✓ Маршрутизация Mieru: Xray${NC}"
            sleep 2
            ;;
        2)
            local tmp_cfg="/tmp/mita_no_egress.json"
            jq 'del(.egress)' "$MIERU_CONFIG_FILE" > "$tmp_cfg" && mv "$tmp_cfg" "$MIERU_CONFIG_FILE"
            restart_mieru_and_verify
            echo -e "${GREEN}✓ Маршрутизация Mieru: Прямой выход${NC}"
            sleep 2
            ;;
        0) return ;;
    esac
}

mieru_export_links() {
    show_mieru_header
    echo -e "${BOLD}--- Выберите пользователя Mieru для экспорта конфига ---${NC}"
    local users=($(cat "$MIERU_USER_STORE" | jq -r 'keys[]'))
    if [ ${#users[@]} -eq 0 ]; then
        echo -e "${RED}Нет пользователей!${NC}"
        read -p "Нажмите Enter..."
        return
    fi

    for i in "${!users[@]}"; do
        echo -e "${YELLOW}[$((i+1))]${NC} ${users[$i]}"
    done
    echo ""
    read -p "Выберите номер пользователя [1-${#users[@]}]: " u_idx
    [ -z "$u_idx" ] && return
    local selected_user="${users[$((u_idx-1))]}"
    local selected_pass=$(cat "$MIERU_USER_STORE" | jq -r --arg u "$selected_user" '.[$u]')
    local ports_str=$(get_mieru_ports)
    local p_range=$(echo "$ports_str" | cut -d'/' -f1)
    local proto=$(echo "$ports_str" | cut -d'/' -f2)
    local pattern=$(mita export traffic-pattern 2>/dev/null)
    local low_mode=$(jq -r '.trafficPattern.lowEntropy.mode // "LOW_ENTROPY_MODE_OFF"' "$MIERU_CONFIG_FILE" 2>/dev/null)
    local mask_rot=$(jq -r '.trafficPattern.lowEntropy.maskRotation // "LOW_ENTROPY_MASK_NO_ROTATION"' "$MIERU_CONFIG_FILE" 2>/dev/null)
    local m_tag=$(get_mieru_tag)

    local mierus_url="mierus://${selected_user}:${selected_pass}@${SERVER_IP}/?profile=${m_tag}&port=${p_range}&protocol=${proto}&multiplexing=MULTIPLEXING_HIGH&traffic-pattern=${pattern}"
    if [ "$low_mode" != "LOW_ENTROPY_MODE_OFF" ] && [ -n "$low_mode" ]; then
        mierus_url="${mierus_url}&low-entropy-mode=${low_mode}&low-entropy-mask-rotation=${mask_rot}"
    fi

    show_mieru_header
    echo -e "${GREEN}${BOLD}=== ДАННЫЕ ПОДКЛЮЧЕНИЯ MIERU (NekoBox+ / Karing) ===${NC}"
    echo ""
    echo -e "  ${BOLD}Имя профиля (Tag):${NC}             ${CYAN}${m_tag}${NC}"
    echo -e "  ${BOLD}Сервер (IP):${NC}                   ${SERVER_IP}"
    echo -e "  ${BOLD}Порты:${NC}                         ${p_range}"
    echo -e "  ${BOLD}Протокол:${NC}                      ${proto}"
    echo -e "  ${BOLD}Имя пользователя:${NC}              ${selected_user}"
    echo -e "  ${BOLD}Пароль:${NC}                        ${selected_pass}"
    echo -e "  ${BOLD}Мультиплексирование:${NC}          HIGH"
    echo -e "  ${BOLD}Паттерн трафика:${NC}               ${pattern}"
    echo -e "  ${BOLD}Режим низкой энтропии:${NC}         ${PURPLE}${low_mode}${NC}"
    echo -e "  ${BOLD}Вращение маски низкой энтропии:${NC} ${PURPLE}${mask_rot}${NC}"
    echo -e "  ${BOLD}Маршрутизация:${NC}                 $(get_mieru_routing)"
    echo ""
    echo -e "${YELLOW}Настройка параметров низкой энтропии в NekoBox+:${NC}"
    echo -e "  1. При импорте ссылки или QR-кода поля 'Имя профиля' и 'Паттерн' заполняются автоматически."
    echo -e "  2. Для защиты ИСХОДЯЩЕГО трафика смартфона от ТСПУ выберите в профиле:"
    echo -e "     • Режим низкой энтропии:          ${CYAN}${low_mode}${NC}"
    echo -e "     • Вращение маски низкой энтропии: ${CYAN}${mask_rot}${NC}"
    echo ""
    echo -e "${BOLD}Ссылка mierus://${NC}"
    echo -e "${CYAN}${mierus_url}${NC}"
    echo ""
    echo -e "${BOLD}QR-код для сканирования камерой в NekoBox+:${NC}"
    qrencode -t ANSI256 "$mierus_url" 2>/dev/null || qrencode -t UTF8 "$mierus_url" 2>/dev/null || echo "qrencode не смог отрендерить"
    echo ""
    read -p "Нажмите Enter для возврата..."
}

mieru_check_update() {
    show_mieru_header
    echo -e "${BOLD}--- Проверка обновлений Mieru (mita) с GitHub ---${NC}"
    local cur_v=$(get_mieru_version)
    echo -e "Текущая установленная версия: ${CYAN}v${cur_v}${NC}"
    echo -e "${YELLOW}Опрос официального репозитория enfein/mieru...${NC}"
    local latest_v=$(curl -fsSL -I -o /dev/null -w '%{url_effective}' https://github.com/enfein/mieru/releases/latest 2>/dev/null | sed -e 's#.*/tag/##' -e 's#.*/tag/v##' -e 's#^v##')
    if [ -z "$latest_v" ] || [[ "$latest_v" =~ "github.com" ]]; then
        latest_v=$(curl -fsSL https://api.github.com/repos/enfein/mieru/releases/latest 2>/dev/null | grep -o '"tag_name": *"[^"]*' | sed -e 's/"tag_name": *"//' -e 's/^v//')
    fi
    [ -z "$latest_v" ] && latest_v="$cur_v"

    echo -e "Последняя версия на GitHub:   ${GREEN}v${latest_v}${NC}"
    echo ""
    if [ "$cur_v" = "$latest_v" ]; then
        echo -e "${GREEN}✓ У вас уже установлена самая последняя версия Mieru (v${cur_v})!${NC}"
        echo ""
        read -p "Нажмите Enter для возврата..."
        return
    fi

    read -p "Обновить Mieru с версии v${cur_v} до актуальной v${latest_v}? [Y/n]: " up_ch
    [[ "$up_ch" =~ ^[nN]$ ]] && return

    echo -e "${YELLOW}Скачивание и установка mita v${latest_v}...${NC}"
    local arch_deb="amd64"
    [ "$(uname -m)" = "aarch64" ] || [ "$(uname -m)" = "arm64" ] && arch_deb="arm64"
    if curl -fL --progress-bar -o /tmp/mita_new.deb "https://github.com/enfein/mieru/releases/download/v${latest_v}/mita_${latest_v}_${arch_deb}.deb"; then
        dpkg -i /tmp/mita_new.deb 2>/dev/null || apt-get install -f -y 2>/dev/null || true
        rm -f /tmp/mita_new.deb
    else
        curl -fL --progress-bar "https://github.com/enfein/mieru/releases/download/v${latest_v}/mita_${latest_v}_linux_${arch_deb}.tar.gz" | tar -xz -C /usr/local/bin/ mita 2>/dev/null || true
        chmod +x /usr/local/bin/mita 2>/dev/null || true
    fi
    restart_mieru_and_verify
    echo -e "${GREEN}✓ Mieru успешно обновлен до версии v$(get_mieru_version)!${NC}"
    sleep 2
}

menu_mieru() {
    if ! is_mieru_installed; then
        clear
        echo -e "${YELLOW}╔══════════════════════════════════════════════════════════════════════╗${NC}"
        echo -e "${YELLOW}║${BOLD}                     MIERU НЕ ОБНАРУЖЕН                               ${YELLOW}║${NC}"
        echo -e "${YELLOW}╚══════════════════════════════════════════════════════════════════════╝${NC}"
        echo ""
        echo -e "${RED}Служба mita или исполняемый файл mita не найдены на данном сервере.${NC}"
        echo ""
        read -p "Нажмите Enter для возврата..."
        return
    fi
    while true; do
        show_mieru_header
        echo -e "  ${YELLOW}[1]${NC} 📊 Статус службы Mita (Mieru) и сокеты"
        echo -e "  ${YELLOW}[2]${NC} 🌐 Маршрутизация трафика (Xray / Прямой выход)"
        echo -e "  ${YELLOW}[3]${NC} 🛡️  Настройка обфускации (Low-Entropy, Маска, Паттерн)"
        echo -e "  ${YELLOW}[4]${NC} 👥 Управление пользователями и паролями"
        echo -e "  ${YELLOW}[5]${NC} 🏷️  Сменить имя подключения (${CYAN}$(get_mieru_tag)${NC})"
        echo -e "  ${YELLOW}[6]${NC} ⚙️  Сменить порты подключения"
        echo -e "  ${YELLOW}[7]${NC} 📱 Экспорт конфигурации (Данные, Ссылка, QR-код)"
        echo -e "  ${YELLOW}[8]${NC} 📜 Живые логи службы (journalctl)"
        echo -e "  ${YELLOW}[9]${NC} 🔄 Перезапустить службу mita"
        echo -e "  ${YELLOW}[10]${NC} 🔒 ${BOLD}Управление доступом в фаерволе${NC} ($(get_mieru_fw_status))"
        echo -e "  ${GREEN}${BOLD}[11]${NC} 🔄 ${BOLD}Проверить и обновить Mieru до последней версии с GitHub${NC}"
        echo -e "  ${YELLOW}[0]${NC} ⬅️  Назад в Главное Меню"
        echo ""
        read -p "Выберите пункт [0-11]: " m_choice
        case "$m_choice" in
            1)
                show_mieru_header
                systemctl status mita --no-pager
                echo ""
                ss -tulpn | grep mita || echo "Сокеты не найдены"
                echo ""
                read -p "Нажмите Enter..."
                ;;
            2) mieru_manage_routing ;;
            3) mieru_manage_presets ;;
            4) mieru_manage_users ;;
            5) mieru_change_tag ;;
            6) mieru_manage_ports ;;
            7) mieru_export_links ;;
            8) journalctl -u mita -f -n 50 ;;
            9) restart_mieru_and_verify; sleep 2 ;;
            10) toggle_mieru_fw ;;
            11) mieru_check_update ;;
            0) return ;;
            *) echo "Неверный выбор"; sleep 1 ;;
        esac
    done
}

# ==============================================================================
# РАЗДЕЛ 2: УПРАВЛЕНИЕ SNELL (v5.0.1)
# ==============================================================================
show_snell_header() {
    clear
    echo -e "${CYAN}╔══════════════════════════════════════════════════════════════════════╗${NC}"
    echo -e "${CYAN}║${BOLD}            РАЗДЕЛ: УПРАВЛЕНИЕ SNELL v5                  ${CYAN}║${NC}"
    echo -e "${CYAN}╠══════════════════════════════════════════════════════════════════════╣${NC}"
    echo -e "${CYAN}║${NC}  Сервер:  ${BOLD}${SERVER_IP}${NC}  |  Служба: $(get_snell_status)"
    echo -e "${CYAN}║${NC}  Имя:     ${BOLD}$(get_snell_tag)${NC}  |  Протокол: ${BOLD}Snell v5.0.1${NC}"
    echo -e "${CYAN}║${NC}  Порт:    ${BOLD}$(get_snell_port)${NC} (TCP+UDP QUIC)  |  Фаервол: $(get_snell_fw_status)"
    echo -e "${CYAN}║${NC}  Маршрут: $(get_snell_routing)  |  Обфускация: $(get_snell_obfs)"
    echo -e "${CYAN}╚══════════════════════════════════════════════════════════════════════╝${NC}"
    echo ""
}

snell_manage_routing() {
    show_snell_header
    echo -e "${BOLD}--- Настройка маршрутизации Snell v5 ---${NC}"
    echo -e "Текущий режим: $(get_snell_routing)"
    echo ""
    echo -e "  ${YELLOW}[1]${NC} 🌐 Маршрутизация Xray"
    echo -e "  ${YELLOW}[2]${NC} ⚡ Прямой выход"
    echo ""
    echo -e "  ${YELLOW}[0]${NC} Назад"
    echo ""
    read -p "Выберите режим [0-2]: " s_rt_choice
    case "$s_rt_choice" in
        1)
            mkdir -p /etc/snell
            echo "xray" > /etc/snell/routing.mode
            /usr/local/bin/snell-routing.sh
            echo -e "${GREEN}✓ Маршрутизация Snell: Xray${NC}"
            sleep 2
            ;;
        2)
            mkdir -p /etc/snell
            echo "direct" > /etc/snell/routing.mode
            /usr/local/bin/snell-routing.sh
            echo -e "${GREEN}✓ Маршрутизация Snell: Прямой выход${NC}"
            sleep 2
            ;;
        0) return ;;
        *) echo "Неверный выбор"; sleep 1 ;;
    esac
}

snell_manage_obfs() {
    show_snell_header
    echo -e "${BOLD}--- Настройка обфускации Snell v5 ---${NC}"
    echo "Текущий режим: $(get_snell_obfs)"
    echo ""
    echo -e "  ${YELLOW}[1]${NC} 🌐 HTTP-обфускация с доменом-приманкой"
    echo "      (Введите любой домен для маскировки, например: ya.ru, vk.com, dzen.ru)"
    echo ""
    echo -e "  ${YELLOW}[2]${NC} ⚡ Отключить обфускацию (Чистый Snell v5, 0-RTT, минимум задержек)"
    echo "      (В NekoBox+ режим обфускации: none)"
    echo ""
    echo -e "  ${YELLOW}[0]${NC} Отмена"
    echo ""
    read -p "Выберите режим [0-2]: " ob_choice
    case "$ob_choice" in
        1)
            read -p "Введите домен для HTTP маскировки (например, ya.ru или vk.com): " custom_host
            [ -z "$custom_host" ] && return
            sed -i '/^obfs/d' "$SNELL_CONFIG_FILE"
            echo "obfs = http" >> "$SNELL_CONFIG_FILE"
            echo "obfs-host = ${custom_host}" >> "$SNELL_CONFIG_FILE"
            restart_snell_and_verify
            echo -e "${GREEN}✓ Установлена HTTP-обфускация: ${custom_host}${NC}"
            sleep 2
            ;;
        2)
            sed -i '/^obfs/d' "$SNELL_CONFIG_FILE"
            echo "obfs = off" >> "$SNELL_CONFIG_FILE"
            restart_snell_and_verify
            echo -e "${GREEN}✓ Обфускация отключена (Чистый Snell v5)${NC}"
            sleep 2
            ;;
        0) return ;;
        *) echo "Неверный выбор"; sleep 1 ;;
    esac
}


snell_change_psk() {
    show_snell_header
    local cur_psk=$(get_snell_psk)
    echo -e "${BOLD}--- Управление PSK ключом Snell v5 ---${NC}"
    echo -e "Текущий PSK: ${GREEN}${BOLD}${cur_psk}${NC}"
    echo ""
    echo -e "  ${YELLOW}[1]${NC} Ввести свой ключ вручную"
    echo -e "  ${YELLOW}[2]${NC} 🎲 Сгенерировать новый случайный ключ"
    echo -e "  ${YELLOW}[0]${NC} Назад"
    echo ""
    read -p "Выберите действие [0-2]: " psk_act
    local new_psk=""
    case "$psk_act" in
        1)
            read -p "Введите новый PSK ключ: " new_psk
            new_psk=$(echo "$new_psk" | tr -d '[:space:]')
            [ -z "$new_psk" ] && return
            ;;
        2)
            new_psk=$(openssl rand -base64 24 | tr -dc 'a-zA-Z0-9' | head -c 30)
            echo -e "Сгенерирован ключ: ${GREEN}${BOLD}${new_psk}${NC}"
            ;;
        0) return ;;
        *) echo "Неверный выбор"; sleep 1; return ;;
    esac

    sed -i '/^psk/d' "$SNELL_CONFIG_FILE"
    echo "psk = ${new_psk}" >> "$SNELL_CONFIG_FILE"
    restart_snell_and_verify
    echo -e "${GREEN}✓ PSK ключ Snell успешно обновлён!${NC}"
    sleep 2
}

snell_change_port() {
    show_snell_header
    local cur_port=$(get_snell_port)
    echo -e "${BOLD}--- Смена порта подключения Snell v5 (Гибридный TCP + UDP/QUIC) ---${NC}"
    echo -e "Текущий порт: ${CYAN}${BOLD}${cur_port}${NC} (TCP + UDP / QUIC)"
    echo ""
    read -p "Введите новый порт (1-65535): " new_port
    new_port=$(echo "$new_port" | tr -d '[:space:]')
    [ -z "$new_port" ] && return

    if ! [[ "$new_port" =~ ^[0-9]+$ ]] || [ "$new_port" -lt 1 ] || [ "$new_port" -gt 65535 ]; then
        echo -e "${RED}Ошибка: порт должен быть числом от 1 до 65535!${NC}"
        sleep 2
        return
    fi

    sed -i '/^listen/d' "$SNELL_CONFIG_FILE"
    sed -i "/^\[snell-server\]/a listen = 0.0.0.0:${new_port}" "$SNELL_CONFIG_FILE"

    iptables -I INPUT 1 -p tcp --dport "$new_port" -j ACCEPT 2>/dev/null || true
    iptables -I INPUT 1 -p udp --dport "$new_port" -j ACCEPT 2>/dev/null || true
    if [ "$cur_port" != "$new_port" ]; then
        iptables -D INPUT -p tcp --dport "$cur_port" -j ACCEPT 2>/dev/null || true
        iptables -D INPUT -p udp --dport "$cur_port" -j ACCEPT 2>/dev/null || true
    fi

    restart_snell_and_verify
    echo -e "${GREEN}✓ Порт Snell успешно изменён на: ${new_port} (TCP + UDP открыты)!${NC}"
    sleep 2
}

snell_export_links() {
    show_snell_header
    local s_port=$(get_snell_port)
    local s_psk=$(get_snell_psk)
    local obfs_mode=$(grep -a -E "^obfs[[:space:]]*=" "$SNELL_CONFIG_FILE" | awk -F'=' '{print $2}' | tr -d ' ')
    local obfs_host=$(grep -a -E "^obfs-host[[:space:]]*=" "$SNELL_CONFIG_FILE" | awk -F'=' '{print $2}' | tr -d ' ')

    [ -z "$obfs_mode" ] && obfs_mode="off"
    [ -z "$obfs_host" ] && obfs_host=""

    local client_obfs="none"
    [ "$obfs_mode" = "http" ] && client_obfs="http"
    [ "$obfs_mode" = "tls" ] && client_obfs="tls"

    local tag=$(get_snell_tag)
    local snell_url="snell://${s_psk}@${SERVER_IP}:${s_port}/?version=5"
    if [ "$obfs_mode" != "off" ] && [ -n "$obfs_mode" ]; then
        snell_url="${snell_url}&obfs-mode=${client_obfs}&obfs-host=${obfs_host}"
    fi
    snell_url="${snell_url}&reuse=true&tfo=true#${tag}"

    local surge_line="${tag} = snell, ${SERVER_IP}, ${s_port}, psk=${s_psk}, version=5"
    if [ "$obfs_mode" != "off" ] && [ -n "$obfs_mode" ]; then
        surge_line="${surge_line}, obfs=${obfs_mode}, obfs-host=${obfs_host}"
    fi
    surge_line="${surge_line}, reuse=true, tfo=true, udp-relay=true"

    echo -e "${GREEN}${BOLD}=== ДАННЫЕ ПОДКЛЮЧЕНИЯ SNELL v5 (NekoBox+ / Surge) ===${NC}"
    echo ""
    echo -e "${CYAN}${BOLD}--- ПАРАМЕТРЫ ПОДКЛЮЧЕНИЯ ---${NC}"
    echo -e "  • Протокол:              ${BOLD}Snell v5 (Гибридный: TCP + UDP / QUIC 0-RTT)${NC}"
    echo -e "  • Сервер (Адрес):        ${BOLD}${SERVER_IP}${NC}"
    echo -e "  • Порт:                  ${BOLD}${s_port}${NC}"
    echo -e "  • Пароль (PSK):          ${GREEN}${BOLD}${s_psk}${NC}"
    echo -e "  • Версия:                ${BOLD}5${NC}"
    echo -e "  • Ключ пользователя:     ${BOLD}(Оставить пустым)${NC}"
    echo -e "  • Режим обфускации:      ${BOLD}${client_obfs}${NC}"
    if [ "$client_obfs" != "none" ]; then
        echo -e "  • Хост обфускации:       ${BOLD}${obfs_host}${NC}"
    fi
    echo -e "  • Маршрутизация выхода:  $(get_snell_routing)"
    echo ""
    echo -e "${BOLD}--- Ссылка snell:// v5 для NekoBox+ / Surge ---${NC}"
    echo -e "${CYAN}${snell_url}${NC}"
    echo ""
    echo -e "${BOLD}--- Строка для Surge / Shadowrocket ---${NC}"
    echo -e "${YELLOW}${surge_line}${NC}"
    echo ""
    echo -e "${BOLD}--- QR-код для сканирования камерой в NekoBox+ ---${NC}"
    qrencode -t ANSI256 "$snell_url" 2>/dev/null || qrencode -t UTF8 "$snell_url" 2>/dev/null || echo "qrencode не смог отрендерить"
    echo ""
    read -p "Нажмите Enter для возврата..."
}

menu_snell() {
    if ! is_snell_installed; then
        clear
        echo -e "${YELLOW}╔══════════════════════════════════════════════════════════════════════╗${NC}"
        echo -e "${YELLOW}║${BOLD}                    SNELL v5 НЕ ОБНАРУЖЕН                             ${YELLOW}║${NC}"
        echo -e "${YELLOW}╚══════════════════════════════════════════════════════════════════════╝${NC}"
        echo ""
        echo -e "${RED}Служба snell или бинарник snell-server не найдены на данном сервере.${NC}"
        echo ""
        read -p "Нажмите Enter для возврата..."
        return
    fi
    while true; do
        show_snell_header
        echo -e "  ${YELLOW}[1]${NC} 📊 Статус службы Snell и сокеты"
        echo -e "  ${YELLOW}[2]${NC} 🌐 Маршрутизация трафика (Xray / Прямой выход)"
        echo -e "  ${YELLOW}[3]${NC} 🛡️  Настройка обфускации (HTTP / Отключена)"
        echo -e "  ${YELLOW}[4]${NC} 🏷️  Сменить имя подключения (${CYAN}$(get_snell_tag)${NC})"
        echo -e "  ${YELLOW}[5]${NC} 🔑 Управление PSK ключом (Показать / Сгенерировать новый)"
        echo -e "  ${YELLOW}[6]${NC} ⚙️  Сменить порт подключения"
        echo -e "  ${YELLOW}[7]${NC} 📱 Конфигурация для NekoBox+ / Surge (Параметры, Ссылка, QR)"
        echo -e "  ${YELLOW}[8]${NC} 📜 Живые логи службы (journalctl)"
        echo -e "  ${YELLOW}[9]${NC} 🔄 Перезапустить службу snell"
        echo -e "  ${YELLOW}[10]${NC} 🔒 ${BOLD}Управление доступом в фаерволе${NC} ($(get_snell_fw_status))"
        echo -e "  ${YELLOW}[0]${NC} ⬅️  Назад в Главное Меню"
        echo ""
        read -p "Выберите пункт [0-10]: " s_choice
        case "$s_choice" in
            1)
                show_snell_header
                systemctl status snell --no-pager
                echo ""
                ss -tulpn | grep snell || echo "Сокеты не найдены"
                echo ""
                read -p "Нажмите Enter..."
                ;;
            2) snell_manage_routing ;;
            3) snell_manage_obfs ;;
            4) snell_change_tag ;;
            5) snell_change_psk ;;
            6) snell_change_port ;;
            7) snell_export_links ;;
            8) journalctl -u snell -f -n 50 ;;
            9) restart_snell_and_verify; sleep 2 ;;
            10) toggle_snell_fw ;;
            0) return ;;
            *) echo "Неверный выбор"; sleep 1 ;;
        esac
    done
}

# ==============================================================================
# РАЗДЕЛ 3: УПРАВЛЕНИЕ WDTT / QWDTT (VPN-СЕРВЕР)
# ==============================================================================
show_wdtt_header() {
    clear
    local peer_p=$(get_wdtt_peer_port)
    local prof_name=$(get_wdtt_profile_name)
    echo -e "${CYAN}╔══════════════════════════════════════════════════════════════════════╗${NC}"
    echo -e "${CYAN}║${BOLD}             РАЗДЕЛ: УПРАВЛЕНИЕ WDTT / QWDTT (VPN-СЕРВЕР)             ${CYAN}║${NC}"
    echo -e "${CYAN}╠══════════════════════════════════════════════════════════════════════╣${NC}"
    echo -e "${CYAN}║${NC}  Сервер:   ${BOLD}${SERVER_IP}${NC}  |  Служба: $(get_wdtt_status)"
    echo -e "${CYAN}║${NC}  Порты:    ${BOLD}:${peer_p}/UDP (VPN) | 56002 (Direct) | 56003 (Raw) | 56001 (WG)${NC}"
    echo -e "${CYAN}║${NC}  Фаервол:  $(get_wdtt_fw_status)  |  Профиль: ${BOLD}${prof_name}${NC}"
    echo -e "${CYAN}║${NC}  Маршрут:  $(get_wdtt_routing)  |  Пароль: ${GREEN}$(get_wdtt_password)${NC}"
    echo -e "${CYAN}╚══════════════════════════════════════════════════════════════════════╝${NC}"
    echo ""
}

wdtt_manage_routing() {
    show_wdtt_header
    echo -e "${BOLD}--- Настройка маршрутизации WDTT (qwdtt) ---${NC}"
    echo -e "Текущий режим: $(get_wdtt_routing)"
    echo ""
    echo -e "  ${YELLOW}[1]${NC} 🌐 Маршрутизация Xray"
    echo -e "  ${YELLOW}[2]${NC} ⚡ Прямой выход"
    echo ""
    echo -e "  ${YELLOW}[0]${NC} Назад"
    echo ""
    read -p "Выберите режим [0-2]: " w_rt_choice
    case "$w_rt_choice" in
        1)
            /usr/local/bin/wdtt-tproxy.sh
            systemctl enable wdtt-tproxy 2>/dev/null || true
            systemctl restart wdtt-tproxy 2>/dev/null || true
            while iptables -t nat -D POSTROUTING -s 10.66.0.0/16 -j MASQUERADE 2>/dev/null; do :; done
            while iptables -t nat -D POSTROUTING -s 10.66.0.0/16 -o "$WAN_IF" -j MASQUERADE 2>/dev/null; do :; done
            while iptables -t nat -D POSTROUTING -s 10.66.0.0/16 -o "$WAN_IF" -m comment --comment WDTT_MANAGED -j MASQUERADE 2>/dev/null; do :; done
            while iptables -t nat -D POSTROUTING -s 10.70.0.0/16 -j MASQUERADE 2>/dev/null; do :; done
            while iptables -t nat -D POSTROUTING -s 10.70.0.0/16 -o "$WAN_IF" -j MASQUERADE 2>/dev/null; do :; done
            while iptables -t nat -D POSTROUTING -s 10.70.0.0/16 -o "$WAN_IF" -m comment --comment WDTT_RAW_MANAGED -j MASQUERADE 2>/dev/null; do :; done
            echo -e "${GREEN}✓ Маршрутизация WDTT: Xray (TPROXY)${NC}"
            sleep 2
            ;;
        2)
            iptables -t mangle -D PREROUTING -i wdtt0 -j WDTT_TPROXY 2>/dev/null || true
            iptables -t mangle -D PREROUTING -i wdttraw0 -j WDTT_TPROXY 2>/dev/null || true
            systemctl stop wdtt-tproxy 2>/dev/null || true
            systemctl disable wdtt-tproxy 2>/dev/null || true
            iptables -t nat -C POSTROUTING -s 10.66.0.0/16 -o "$WAN_IF" -m comment --comment WDTT_MANAGED -j MASQUERADE 2>/dev/null || iptables -t nat -A POSTROUTING -s 10.66.0.0/16 -o "$WAN_IF" -m comment --comment WDTT_MANAGED -j MASQUERADE
            iptables -t nat -C POSTROUTING -s 10.70.0.0/16 -o "$WAN_IF" -m comment --comment WDTT_RAW_MANAGED -j MASQUERADE 2>/dev/null || iptables -t nat -A POSTROUTING -s 10.70.0.0/16 -o "$WAN_IF" -m comment --comment WDTT_RAW_MANAGED -j MASQUERADE
            echo -e "${GREEN}✓ Маршрутизация WDTT: Прямой выход (NAT MASQUERADE)${NC}"
            sleep 2
            ;;
        0) return ;;
    esac
}

wdtt_view_devices() {
    show_wdtt_header
    echo -e "${BOLD}--- Активные устройства и клиенты WDTT ---${NC}"
    if [ -f "$WDTT_DB_FILE" ]; then
        jq -r '.devices // empty | to_entries[] | "  Устройство ID: \(.value.device_id) | IP: \(.value.ip // "N/A") | Вх: \((.value.down_bytes // 0) / 1048576 | floor) МБ | Исх: \((.value.up_bytes // 0) / 1048576 | floor) МБ"' "$WDTT_DB_FILE" 2>/dev/null || echo "  Нет подключенных устройств"
    else
        echo "  Файл базы устройств не найден"
    fi
    echo ""
    read -p "Нажмите Enter для возврата..."
}

show_qwdtt_link() {
    clear
    local peer_p=$(get_wdtt_peer_port)
    local pass=$(get_wdtt_password)
    local name=$(get_wdtt_profile_name)

    local qwdtt_url=$(python3 -c "
import urllib.parse, sys
name, ip, port, password = sys.argv[1], sys.argv[2], sys.argv[3], sys.argv[4]
name_enc = urllib.parse.quote_plus(name)
peer_enc = f'{ip}%3A{port}'
pass_enc = urllib.parse.quote_plus(password)
print(f'qwdtt://config?name={name_enc}&peer={peer_enc}&hashes=&workers=18&port=9000&pass={pass_enc}')
" "$name" "$SERVER_IP" "$peer_p" "$pass" 2>/dev/null || echo "")

    echo -e "${CYAN}╔══════════════════════════════════════════════════════════════════════╗${NC}"
    echo -e "${CYAN}║${BOLD}          ССЫЛКА ПОДКЛЮЧЕНИЯ И QR-КОД QWDTT (WDTT VPN)                ${CYAN}║${NC}"
    echo -e "${CYAN}╚══════════════════════════════════════════════════════════════════════╝${NC}"
    echo ""
    echo -e "${BOLD}Параметры подключения:${NC}"
    echo -e "  • Название профиля:    ${GREEN}${name}${NC}"
    echo -e "  • Сервер (IP:Порт):    ${CYAN}${SERVER_IP}:${peer_p}${NC}"
    echo -e "  • Внутренний порт:     ${CYAN}9000${NC}"
    echo -e "  • Количество воркеров: ${CYAN}18${NC}"
    echo -e "  • Пароль подключения:  ${GREEN}${pass}${NC}"
    echo -e "  • Режим маршрута:      $(get_wdtt_routing)"
    echo ""
    echo -e "${BOLD}Ссылка конфигурации (qwdtt://):${NC}"
    echo -e "${YELLOW}${qwdtt_url}${NC}"
    echo ""
    echo -e "${BOLD}QR-код для импорта в клиент QWDTT:${NC}"
    echo ""
    qrencode -t ANSI256 "$qwdtt_url" 2>/dev/null || qrencode -t UTF8 "$qwdtt_url" 2>/dev/null || echo "qrencode не установлен или не смог отрендерить QR"
    echo ""
    echo -e "${CYAN}────────────────────────────────────────────────────────────────────────${NC}"
    echo -e "Скопируйте ссылку выше или отсканируйте QR-код в мобильном клиенте ${BOLD}qwdtt${NC}."
    echo -e "${CYAN}────────────────────────────────────────────────────────────────────────${NC}"
    echo ""
    read -p "Нажмите Enter для возврата в меню..."
}

menu_wdtt() {
    if ! is_wdtt_installed; then
        clear
        echo -e "${YELLOW}╔══════════════════════════════════════════════════════════════════════╗${NC}"
        echo -e "${YELLOW}║${BOLD}                     WDTT НЕ ОБНАРУЖЕН                                ${YELLOW}║${NC}"
        echo -e "${YELLOW}╚══════════════════════════════════════════════════════════════════════╝${NC}"
        echo ""
        echo -e "${RED}Служба wdtt или исполняемый файл wdtt не найдены на данном сервере.${NC}"
        echo ""
        read -p "Нажмите Enter для возврата..."
        return
    fi
    while true; do
        show_wdtt_header
        echo -e "  ${YELLOW}[1]${NC} 📊 Статус службы WDTT и активные сокеты"
        echo -e "  ${YELLOW}[2]${NC} 🌐 Маршрутизация трафика (Xray / Прямой выход)"
        echo -e "  ${YELLOW}[3]${NC} 👥 Просмотр подключенных устройств и трафика"
        echo -e "  ${YELLOW}[4]${NC} 🔗 ${BOLD}Показать ссылку подключения qwdtt:// и QR-код${NC}"
        echo -e "  ${YELLOW}[5]${NC} ✏️  ${BOLD}Изменить название подключения (name)${NC}"
        echo -e "  ${YELLOW}[6]${NC} 📜 Живые логи службы WDTT (journalctl)"
        echo -e "  ${YELLOW}[7]${NC} 🔄 Перезапустить службу wdtt"
        echo -e "  ${YELLOW}[8]${NC} 🔒 ${BOLD}Управление доступом в фаерволе${NC} ($(get_wdtt_fw_status))"
        echo -e "  ${YELLOW}[0]${NC} ⬅️  Назад в Главное Меню"
        echo ""
        read -p "Выберите пункт [0-8]: " w_choice
        case "$w_choice" in
            1)
                show_wdtt_header
                systemctl status wdtt --no-pager
                echo ""
                ss -tulpn 2>/dev/null | grep wdtt || echo "Сокеты не найдены"
                echo ""
                read -p "Нажмите Enter..."
                ;;
            2) wdtt_manage_routing ;;
            3) wdtt_view_devices ;;
            4) show_qwdtt_link ;;
            5) wdtt_change_profile_name ;;
            6) journalctl -u wdtt -f -n 50 ;;
            7) restart_wdtt_and_verify; sleep 2 ;;
            8) toggle_wdtt_fw ;;
            0) return ;;
            *) echo "Неверный выбор"; sleep 1 ;;
        esac
    done
}

# ==============================================================================
# РАЗДЕЛ 4: CSQTT (VPN SERVER & WEB PANEL)
# ==============================================================================
is_csqtt_installed() {
    if command -v csqtt >/dev/null 2>&1 || [ -f "$CSQTT_SERVICE_FILE" ] || [ -d "$CSQTT_DIR" ]; then
        return 0
    fi
    return 1
}

get_csqtt_status() {
    if ! is_csqtt_installed; then
        echo -e "${RED}НЕ УСТАНОВЛЕН${NC}"
        return
    fi
    if systemctl is-active --quiet csqtt 2>/dev/null; then
        echo -e "${GREEN}АКТИВЕН (В РАБОТЕ)${NC}"
    elif systemctl is-enabled --quiet csqtt 2>/dev/null; then
        echo -e "${YELLOW}ОСТАНОВЛЕН (ВКЛЮЧЕН)${NC}"
    else
        echo -e "${RED}ОСТАНОВЛЕН${NC}"
    fi
}

get_csqtt_web_port() {
    local port=""
    if [ -f "$CSQTT_SERVICE_FILE" ]; then
        port=$(grep -oP -- '--web-port\s+\K[0-9]+' "$CSQTT_SERVICE_FILE" 2>/dev/null || true)
    fi
    if [ -z "$port" ] && [ -f "$CSQTT_NET_UP" ]; then
        port=$(grep -oP 'WEB_PORT="\K[0-9]+' "$CSQTT_NET_UP" 2>/dev/null || true)
    fi
    if [ -z "$port" ]; then
        port=$(ss -tlpn 2>/dev/null | grep 'csqtt' | awk '{print $4}' | awk -F: '{print $NF}' | grep -v '46004' | head -n 1 || true)
    fi
    if [ -z "$port" ]; then
        port="37002"
    fi
    echo "$port"
}

get_csqtt_peer_port() {
    local port=""
    if [ -f "$CSQTT_SERVICE_FILE" ]; then
        port=$(grep -oP -- '--listen\s+0\.0\.0\.0:\K[0-9]+' "$CSQTT_SERVICE_FILE" 2>/dev/null || true)
    fi
    if [ -z "$port" ] && [ -f "$CSQTT_NET_UP" ]; then
        port=$(grep -oP 'PEER_PORT="\K[0-9]+' "$CSQTT_NET_UP" 2>/dev/null || true)
    fi
    if [ -z "$port" ]; then
        port=$(ss -ulpn 2>/dev/null | grep 'csqtt' | awk '{print $4}' | awk -F: '{print $NF}' | head -n 1 || true)
    fi
    if [ -z "$port" ]; then
        port="37000"
    fi
    echo "$port"
}

get_ssh_port() {
    local p=$(ss -tlnp 2>/dev/null | grep sshd | awk '{print $4}' | awk -F: '{print $NF}' | head -n 1)
    if [ -z "$p" ]; then
        p=$(grep -iE '^Port\s+' /etc/ssh/sshd_config /etc/ssh/sshd_config.d/*.conf 2>/dev/null | awk '{print $2}' | head -n 1)
    fi
    [ -z "$p" ] && p="22"
    echo "$p"
}

get_csqtt_user() {
    if [ -f "$CSQTT_ENV_FILE" ]; then
        local u=$(grep -oP '^CSQTT_WEB_USER="\K[^"]+' "$CSQTT_ENV_FILE" 2>/dev/null || true)
        [ -z "$u" ] && u=$(grep -oP '^CSQTT_WEB_USERNAME="\K[^"]+' "$CSQTT_ENV_FILE" 2>/dev/null || true)
        [ -n "$u" ] && echo "$u" && return
    fi
    echo "N/A"
}

get_csqtt_pass() {
    if [ -f "$CSQTT_ENV_FILE" ]; then
        local p=$(grep -oP '^CSQTT_WEB_PASS="\K[^"]+' "$CSQTT_ENV_FILE" 2>/dev/null || true)
        [ -z "$p" ] && p=$(grep -oP '^CSQTT_WEB_PASSWORD="\K[^"]+' "$CSQTT_ENV_FILE" 2>/dev/null || true)
        [ -n "$p" ] && echo "$p" && return
    fi
    echo "N/A"
}

update_csqtt_credentials() {
    local new_u="$1"
    local new_p="$2"
    [ -z "$new_u" ] || [ -z "$new_p" ] && return 1
    mkdir -p "$(dirname "$CSQTT_ENV_FILE")"
    touch "$CSQTT_ENV_FILE"

    sed -i -E '/^CSQTT_WEB_USER=/d' "$CSQTT_ENV_FILE" 2>/dev/null || true
    sed -i -E '/^CSQTT_WEB_USERNAME=/d' "$CSQTT_ENV_FILE" 2>/dev/null || true
    sed -i -E '/^CSQTT_WEB_PASS=/d' "$CSQTT_ENV_FILE" 2>/dev/null || true
    sed -i -E '/^CSQTT_WEB_PASSWORD=/d' "$CSQTT_ENV_FILE" 2>/dev/null || true

    cat << EOF >> "$CSQTT_ENV_FILE"
CSQTT_WEB_USER="${new_u}"
CSQTT_WEB_USERNAME="${new_u}"
CSQTT_WEB_PASS="${new_p}"
CSQTT_WEB_PASSWORD="${new_p}"
EOF
    chmod 600 "$CSQTT_ENV_FILE"
}

get_csqtt_tunnel_pass() {
    local db="/etc/csqtt/csqtt.db"
    if [ -f "$db" ]; then
        local p=$(python3 -c "import sqlite3; conn=sqlite3.connect('$db'); r=conn.execute(\"SELECT value FROM meta WHERE key='main_password'\").fetchone(); print(r[0] if r else '')" 2>/dev/null || true)
        [ -n "$p" ] && echo "$p" && return
    fi
    echo "N/A"
}

is_csqtt_web_protected() {
    local port=$(get_csqtt_web_port)
    if [ -f "$CSQTT_LOCK_FILE" ]; then
        return 0
    fi
    if iptables -C INPUT ! -i lo -p tcp --dport "$port" -m comment --comment "CSQTT_SSH_ONLY" -j DROP 2>/dev/null; then
        return 0
    fi
    if iptables -S INPUT 2>/dev/null | grep -E -- "-A INPUT.*-p tcp.*--dport ${port}.*-j DROP" >/dev/null 2>&1; then
        return 0
    fi
    return 1
}

get_csqtt_protect_status() {
    if ! is_csqtt_installed; then
        echo -e "${RED}Не установлен${NC}"
        return
    fi
    if is_csqtt_web_protected; then
        echo -e "${GREEN}🔒 ЗАЩИЩЕНА (Только SSH-туннель)${NC}"
    else
        echo -e "${RED}⚠️ ОТКРЫТА (Прямой доступ из WAN)${NC}"
    fi
}

csqtt_patch_network_up() {
    [ -f "$CSQTT_NET_UP" ] || return 0
    if grep -q "CSQTT_SSH_ONLY" "$CSQTT_NET_UP" 2>/dev/null; then
        return 0
    fi
    python3 - << 'PYEOF' 2>/dev/null || true
path = "/usr/local/lib/csqtt/network-up.sh"
try:
    with open(path, "r", encoding="utf-8") as f:
        content = f.read()
    
    target = 'ipt -C INPUT -p tcp --dport "$WEB_PORT" -m comment --comment "$IPT_COMMENT" -j ACCEPT 2>/dev/null || ipt -I INPUT -p tcp --dport "$WEB_PORT" -m comment --comment "$IPT_COMMENT" -j ACCEPT'
    replacement = '''if [ -f "/etc/csqtt/ssh_only.lock" ]; then
    ipt -D INPUT -p tcp --dport "$WEB_PORT" -m comment --comment "$IPT_COMMENT" -j ACCEPT 2>/dev/null || true
    ipt -C INPUT ! -i lo -p tcp --dport "$WEB_PORT" -m comment --comment "CSQTT_SSH_ONLY" -j DROP 2>/dev/null || ipt -I INPUT 1 ! -i lo -p tcp --dport "$WEB_PORT" -m comment --comment "CSQTT_SSH_ONLY" -j DROP
else
    ipt -D INPUT ! -i lo -p tcp --dport "$WEB_PORT" -m comment --comment "CSQTT_SSH_ONLY" -j DROP 2>/dev/null || true
    ipt -C INPUT -p tcp --dport "$WEB_PORT" -m comment --comment "$IPT_COMMENT" -j ACCEPT 2>/dev/null || ipt -I INPUT -p tcp --dport "$WEB_PORT" -m comment --comment "$IPT_COMMENT" -j ACCEPT
fi'''
    if target in content:
        content = content.replace(target, replacement, 1)
        with open(path, "w", encoding="utf-8") as f:
            f.write(content)
except Exception:
    pass
PYEOF
}

csqtt_protect_web() {
    local port=$(get_csqtt_web_port)
    echo ""
    echo -e "${YELLOW}Активация режима изоляции веб-панели CSQTT...${NC}"
    mkdir -p "$CSQTT_DIR"
    touch "$CSQTT_LOCK_FILE"

    # Удаляем открытое правило ACCEPT
    iptables -D INPUT -p tcp --dport "$port" -m comment --comment "CSQTT_MANAGED" -j ACCEPT 2>/dev/null || true
    iptables -D INPUT -p tcp --dport "$port" -j ACCEPT 2>/dev/null || true

    # Устанавливаем DROP в начало цепочки INPUT для всех интерфейсов кроме lo
    iptables -D INPUT ! -i lo -p tcp --dport "$port" -m comment --comment "CSQTT_SSH_ONLY" -j DROP 2>/dev/null || true
    iptables -I INPUT 1 ! -i lo -p tcp --dport "$port" -m comment --comment "CSQTT_SSH_ONLY" -j DROP

    # Интегрируем проверку в network-up.sh для сохранения режима при рестартах
    csqtt_patch_network_up

    echo -e "${GREEN}✓ Защита веб-панели CSQTT успешно активирована!${NC}"
    echo -e "  Порт ${BOLD}${port}/TCP${NC} теперь полностью закрыт от доступа из интернета."
    echo -e "  Доступ открыт ${BOLD}только локально (127.0.0.1) через защищенный SSH-туннель${NC}."
    echo ""
}

csqtt_unprotect_web() {
    local port=$(get_csqtt_web_port)
    echo ""
    echo -e "${YELLOW}Открытие прямого доступа к веб-панели CSQTT...${NC}"
    rm -f "$CSQTT_LOCK_FILE"

    # Удаляем блокирующее правило DROP
    iptables -D INPUT ! -i lo -p tcp --dport "$port" -m comment --comment "CSQTT_SSH_ONLY" -j DROP 2>/dev/null || true
    iptables -D INPUT -i "$WAN_IF" -p tcp --dport "$port" -j DROP 2>/dev/null || true

    # Восстанавливаем ACCEPT правило CSQTT_MANAGED
    iptables -C INPUT -p tcp --dport "$port" -m comment --comment "CSQTT_MANAGED" -j ACCEPT 2>/dev/null || iptables -I INPUT -p tcp --dport "$port" -m comment --comment "CSQTT_MANAGED" -j ACCEPT

    # Интегрируем проверку в network-up.sh
    csqtt_patch_network_up

    echo -e "${GREEN}✓ Прямой доступ к веб-панели открыт.${NC}"
    echo -e "  Адрес для входа из интернета: ${CYAN}https://${SERVER_IP}:${port}${NC}"
    echo ""
}

show_csqtt_tunnel_card() {
    local port=$(get_csqtt_web_port)
    local peer_p=$(get_csqtt_peer_port)
    local ssh_p=$(get_ssh_port)
    local u=$(get_csqtt_user)
    local p=$(get_csqtt_pass)
    local tp=$(get_csqtt_tunnel_pass)

    clear
    echo -e "${CYAN}╔══════════════════════════════════════════════════════════════════════╗${NC}"
    echo -e "${CYAN}║${BOLD}          БЕЗОПАСНЫЙ ДОСТУП К ВЕБ-ПАНЕЛИ CSQTT ЧЕРЕЗ SSH             ${CYAN}║${NC}"
    echo -e "${CYAN}╚══════════════════════════════════════════════════════════════════════╝${NC}"
    echo ""
    echo -e "${BOLD}Параметры сервера и панели:${NC}"
    echo -e "  • IP сервера:       ${CYAN}${SERVER_IP}${NC}"
    echo -e "  • SSH порт:         ${CYAN}${ssh_p}${NC}"
    echo -e "  • Порт веб-панели:  ${CYAN}${port}/TCP${NC}"
    echo -e "  • VPN порт туннеля: ${CYAN}${peer_p}/UDP${NC}"
    echo -e "  • Пароль туннеля:   ${GREEN}${tp}${NC}"
    echo -e "  • Текущий статус:   $(get_csqtt_protect_status)"
    echo ""
    echo -e "${BOLD}Учетные данные для авторизации в панели:${NC}"
    echo -e "  • Логин:            ${GREEN}${u}${NC}"
    echo -e "  • Пароль:           ${GREEN}${p}${NC}"
    echo ""
    echo -e "${CYAN}────────────────────────────────────────────────────────────────────────${NC}"
    echo -e "${YELLOW}${BOLD}ШАГ 1: Запустите SSH-туннель на вашем ПК (в PowerShell или Терминале):${NC}"
    echo ""
    echo -e "  ${GREEN}${BOLD}ssh -N -L ${port}:127.0.0.1:${port} root@${SERVER_IP} -p ${ssh_p}${NC}"
    echo ""
    echo -e "  ${NC}💡 ${YELLOW}Что делают флаги:${NC}"
    echo -e "     ${BOLD}-N${NC} : режим туннелирования (не открывать командную строку сервера)"
    echo -e "     ${BOLD}-L ${port}:127.0.0.1:${port}${NC} : пробросить порт ${port} вашего ПК на порт панели сервера"
    echo -e "     ${BOLD}-p ${ssh_p}${NC} : активный порт SSH на сервере"
    echo ""
    echo -e "${CYAN}────────────────────────────────────────────────────────────────────────${NC}"
    echo -e "${YELLOW}${BOLD}ШАГ 2: Откройте браузер на вашем ПК и перейдите по адресу:${NC}"
    echo ""
    echo -e "  👉 ${CYAN}${BOLD}https://127.0.0.1:${port}${NC}"
    echo ""
    echo -e "  ${NC}⚠️ ${YELLOW}Важно при первом входе:${NC}"
    echo -e "     Панель использует HTTPS с самоподписанным TLS-сертификатом."
    echo -e "     Браузер выдаст предупреждение «Подключение не защищено»."
    echo -e "     Нажмите кнопку «Дополнительно» -> «Перейти на 127.0.0.1 (небезопасно)»."
    echo -e "${CYAN}────────────────────────────────────────────────────────────────────────${NC}"
    echo ""
    read -p "Нажмите Enter для возврата в меню..."
}

show_csqtt_credentials() {
    clear
    local port=$(get_csqtt_web_port)
    local peer_p=$(get_csqtt_peer_port)
    local ssh_p=$(get_ssh_port)
    local u=$(get_csqtt_user)
    local p=$(get_csqtt_pass)
    local tp=$(get_csqtt_tunnel_pass)

    echo -e "${CYAN}╔══════════════════════════════════════════════════════════════════════╗${NC}"
    echo -e "${CYAN}║${BOLD}              РЕКВИЗИТЫ ДОСТУПА И ПАРОЛИ CSQTT                       ${CYAN}║${NC}"
    echo -e "${CYAN}╚══════════════════════════════════════════════════════════════════════╝${NC}"
    echo ""
    echo -e "${BOLD}🔐 Авторизация в Веб-Панели CSQTT:${NC}"
    echo -e "  • Прямой URL:            ${CYAN}https://${SERVER_IP}:${port}${NC}"
    echo -e "  • URL через SSH-туннель: ${CYAN}https://127.0.0.1:${port}${NC}"
    echo -e "  • Логин администратора:  ${GREEN}${BOLD}${u}${NC}"
    echo -e "  • Пароль администратора: ${GREEN}${BOLD}${p}${NC}"
    echo ""
    echo -e "${BOLD}🛡️ Параметры VPN Туннеля:${NC}"
    echo -e "  • IP сервера:            ${CYAN}${SERVER_IP}${NC}"
    echo -e "  • Порт туннеля (UDP):    ${CYAN}${peer_p}/UDP${NC}"
    echo -e "  • Пароль туннеля:        ${GREEN}${BOLD}${tp}${NC}"
    echo ""
    echo -e "${BOLD}ℹ️  Защита веб-панели:${NC} $(get_csqtt_protect_status)"
    echo ""
    echo -e "${CYAN}────────────────────────────────────────────────────────────────────────${NC}"
    echo -e "${YELLOW}Примечание:${NC} Реквизиты извлечены из ${BOLD}/etc/csqtt/csqtt.env${NC} и базы ${BOLD}csqtt.db${NC}."
    echo -e "Отображаются в режиме чтения (без изменений)."
    echo -e "${CYAN}────────────────────────────────────────────────────────────────────────${NC}"
    echo ""
    read -p "Нажмите Enter для возврата в меню..."
}

show_csqtt_header() {
    clear
    local port=$(get_csqtt_web_port)
    local peer_p=$(get_csqtt_peer_port)
    local u=$(get_csqtt_user)
    local p=$(get_csqtt_pass)
    local tp=$(get_csqtt_tunnel_pass)
    echo -e "${CYAN}╔══════════════════════════════════════════════════════════════════════╗${NC}"
    echo -e "${CYAN}║${BOLD}          УПРАВЛЕНИЕ СЛУЖБОЙ CSQTT И ЗАЩИТОЙ ВЕБ-ПАНЕЛИ             ${CYAN}║${NC}"
    echo -e "${CYAN}╠══════════════════════════════════════════════════════════════════════╣${NC}"
    echo -e "${CYAN}║${NC}  Сервер:     ${BOLD}${SERVER_IP}${NC}  |  Статус: $(get_csqtt_status)"
    echo -e "${CYAN}║${NC}  VPN туннель: :${peer_p}/UDP  |  Фаервол: $(get_csqtt_tunnel_status)"
    echo -e "${CYAN}║${NC}  Веб-панель:  :${port}/TCP    |  Защита: $(get_csqtt_protect_status)"
    echo -e "${CYAN}║${NC}  Вход в панель: Логин: ${GREEN}${u}${NC}  |  Пароль: ${GREEN}${p}${NC}  |  Пароль VPN: ${GREEN}${tp}${NC}"
    echo -e "${CYAN}╚══════════════════════════════════════════════════════════════════════╝${NC}"
    echo ""
}

menu_csqtt() {
    if ! is_csqtt_installed; then
        clear
        echo -e "${YELLOW}╔══════════════════════════════════════════════════════════════════════╗${NC}"
        echo -e "${YELLOW}║${BOLD}                     CSQTT НЕ ОБНАРУЖЕН                               ${YELLOW}║${NC}"
        echo -e "${YELLOW}╚══════════════════════════════════════════════════════════════════════╝${NC}"
        echo ""
        echo -e "${RED}Служба csqtt или исполняемый файл csqtt не найдены на данном сервере.${NC}"
        echo ""
        echo -e "Если вы установите CSQTT на этот сервер, данный раздел"
        echo -e "активируется автоматически при следующем запуске x-manager."
        echo ""
        read -p "Нажмите Enter для возврата..."
        return
    fi

    while true; do
        show_csqtt_header
        echo -e "  ${YELLOW}[1]${NC} 📊 Статус службы csqtt и активные сокеты"
        echo -e "  ${YELLOW}[2]${NC} 🔒 ${BOLD}Включить защиту веб-панели${NC} (Доступ ТОЛЬКО через SSH-туннель)"
        echo -e "  ${YELLOW}[3]${NC} 🔓 ${BOLD}Открыть прямой доступ к веб-панели из интернета${NC}"
        echo -e "  ${YELLOW}[4]${NC} 🛡️  ${BOLD}Включить / Выключить VPN-туннель в фаерволе${NC} ($(get_csqtt_tunnel_status))"
        echo -e "  ${YELLOW}[5]${NC} 🔑 ${BOLD}Команда SSH-туннеля и инструкция для ПК${NC}"
        echo -e "  ${YELLOW}[6]${NC} 📋 ${BOLD}Показать все реквизиты CSQTT${NC} (Логин, пароль панели и пароль туннеля)"
        echo -e "  ${YELLOW}[7]${NC} 📜 Живые логи службы csqtt (journalctl)"
        echo -e "  ${YELLOW}[8]${NC} 🔄 Перезапустить службу csqtt"
        echo -e "  ${YELLOW}[9]${NC} 🔑 ${BOLD}Сменить логин и пароль веб-панели CSQTT${NC}"
        echo -e "  ${YELLOW}[0]${NC} ⬅️  Назад в Главное Меню"
        echo ""
        read -p "Выберите пункт [0-9]: " c_choice
        case "$c_choice" in
            1)
                show_csqtt_header
                systemctl status csqtt --no-pager
                echo ""
                ss -tulpn | grep csqtt || echo "Сокеты csqtt не найдены"
                echo ""
                read -p "Нажмите Enter..."
                ;;
            2)
                csqtt_protect_web
                sleep 1
                show_csqtt_tunnel_card
                ;;
            3)
                csqtt_unprotect_web
                sleep 2
                ;;
            4)
                toggle_csqtt_tunnel_fw
                ;;
            5)
                show_csqtt_tunnel_card
                ;;
            6)
                show_csqtt_credentials
                ;;
            7)
                journalctl -u csqtt -f -n 50
                ;;
            8)
                echo -e "${YELLOW}Перезапуск службы csqtt...${NC}"
                systemctl restart csqtt
                sleep 2
                echo -e "${GREEN}✓ Служба csqtt перезапущена${NC}"
                sleep 1
                ;;
            9)
                echo ""
                read -p "Введите новый логин веб-панели CSQTT [Enter оставить текущий]: " new_c_u
                read -s -p "Введите новый пароль веб-панели CSQTT: " new_c_p
                echo ""
                [ -z "$new_c_u" ] && new_c_u=$(get_csqtt_user)
                [ "$new_c_u" = "N/A" ] && new_c_u="admin"
                if [ -n "$new_c_p" ]; then
                    update_csqtt_credentials "$new_c_u" "$new_c_p"
                    systemctl restart csqtt 2>/dev/null || true
                    echo -e "${GREEN}✓ Реквизиты сохранены в $CSQTT_ENV_FILE и служба перезапущена!${NC}"
                else
                    echo -e "${YELLOW}Пароль не может быть пустым.${NC}"
                fi
                sleep 2
                ;;
            0) return ;;
            *) echo "Неверный выбор"; sleep 1 ;;
        esac
    done
}

# ==============================================================================

# ==============================================================================
# РАЗДЕЛ 5: DNS-ТУННЕЛИ (COTTENDNS / MASTERDNSVPN)
# ==============================================================================

get_active_dns_engine() {
    if systemctl is-active --quiet "$MASTERDNS_SERVICE" 2>/dev/null; then
        echo "masterdns"
    elif systemctl is-active --quiet "$COTTEN_SERVICE" 2>/dev/null; then
        echo "cottendns"
    elif is_masterdns_installed; then
        echo "masterdns"
    else
        echo "cottendns"
    fi
}

get_dns_engine_name() {
    local eng=$(get_active_dns_engine)
    if [ "$eng" = "masterdns" ]; then
        echo "MasterDnsVPN (Основной движок)"
    else
        echo "CottenDNS (Альтернативный WhiteDNS)"
    fi
}

get_dns_status() {
    if ! is_dns_installed; then
        echo -e "${RED}НЕ УСТАНОВЛЕН${NC}"
        return
    fi
    local eng=$(get_active_dns_engine)
    local s_name="MasterDnsVPN"
    [ "$eng" = "cottendns" ] && s_name="CottenDNS"

    if systemctl is-active --quiet "$eng" 2>/dev/null; then
        echo -e "${GREEN}АКТИВЕН (${s_name})${NC}"
    elif systemctl is-enabled --quiet "$eng" 2>/dev/null; then
        echo -e "${YELLOW}ОСТАНОВЛЕН (${s_name})${NC}"
    else
        echo -e "${RED}ОСТАНОВЛЕН (${s_name})${NC}"
    fi
}

# ==============================================================================
# SSL & СЕРТИФИКАТЫ: ACME, CLOUDFLARE WILDCARD, HTTP-01, ДЕТЕКЦИЯ СТАТУСА
# ==============================================================================
CF_ENV_FILE="/etc/x-manager/cloudflare.env"
[ ! -f "$CF_ENV_FILE" ] && [ -f "/etc/tuna-vpn/cloudflare.env" ] && CF_ENV_FILE="/etc/tuna-vpn/cloudflare.env"

# Обнаружение основного активного сертификата по всем стандартным путям:
# /etc/x-manager/ (cloudflare.env), /root/cert/, /etc/x-ui/, /etc/letsencrypt/, /etc/ssl/, /root/.acme.sh/
# Возвращает строку: "CERT_PATH|KEY_PATH|DOMAIN|EXPIRY_DATE"
detect_primary_ssl_cert() {
    local candidates=()

    # 1. Проверяем cloudflare.env
    for cf_env in "/etc/x-manager/cloudflare.env" "/etc/tuna-vpn/cloudflare.env"; do
        if [ -f "$cf_env" ]; then
            local c_f=$(grep -oP '^CERT_FILE="\K[^"]+' "$cf_env" 2>/dev/null || grep -oP '^CERT_FILE=\K.*' "$cf_env" 2>/dev/null | tr -d '"')
            local k_f=$(grep -oP '^KEY_FILE="\K[^"]+' "$cf_env" 2>/dev/null || grep -oP '^KEY_FILE=\K.*' "$cf_env" 2>/dev/null | tr -d '"')
            local d_m=$(grep -oP '^DOMAIN="\K[^"]+' "$cf_env" 2>/dev/null || grep -oP '^DOMAIN=\K.*' "$cf_env" 2>/dev/null | tr -d '"')
            if [ -f "$c_f" ] && [ -f "$k_f" ]; then
                candidates+=("${c_f}|${k_f}|${d_m}")
            fi
        fi
    done

    # 2. /root/cert/<domain>/
    if [ -d "/root/cert" ]; then
        for dir in /root/cert/*; do
            [ -d "$dir" ] || continue
            local d_name=$(basename "$dir")
            local c="" k=""
            [ -f "${dir}/fullchain.pem" ] && c="${dir}/fullchain.pem"
            [ -z "$c" ] && [ -f "${dir}/fullchain.cer" ] && c="${dir}/fullchain.cer"
            [ -z "$c" ] && [ -f "${dir}/cert.pem" ] && c="${dir}/cert.pem"
            [ -z "$c" ] && [ -f "${dir}/cert.crt" ] && c="${dir}/cert.crt"

            [ -f "${dir}/privkey.pem" ] && k="${dir}/privkey.pem"
            [ -z "$k" ] && [ -f "${dir}/privkey.key" ] && k="${dir}/privkey.key"
            [ -z "$k" ] && [ -f "${dir}/key.pem" ] && k="${dir}/key.pem"
            [ -z "$k" ] && [ -f "${dir}/private.key" ] && k="${dir}/private.key"

            if [ -n "$c" ] && [ -n "$k" ]; then
                candidates+=("${c}|${k}|${d_name}")
            fi
        done
        if [ -f "/root/cert/fullchain.pem" ] && [ -f "/root/cert/privkey.pem" ]; then
            candidates+=("/root/cert/fullchain.pem|/root/cert/privkey.pem|cert")
        fi
    fi

    # 3. /etc/x-ui/
    if [ -f "/etc/x-ui/server.crt" ] && [ -f "/etc/x-ui/server.key" ]; then
        candidates+=("/etc/x-ui/server.crt|/etc/x-ui/server.key|3x-ui")
    fi
    if [ -f "/etc/x-ui/cert.pem" ] && [ -f "/etc/x-ui/key.pem" ]; then
        candidates+=("/etc/x-ui/cert.pem|/etc/x-ui/key.pem|3x-ui")
    fi

    # 4. /etc/letsencrypt/live/<domain>/
    if [ -d "/etc/letsencrypt/live" ]; then
        for dir in /etc/letsencrypt/live/*; do
            [ -d "$dir" ] || continue
            local d_name=$(basename "$dir")
            [ "$d_name" = "README" ] && continue
            if [ -f "${dir}/fullchain.pem" ] && [ -f "${dir}/privkey.pem" ]; then
                candidates+=("${dir}/fullchain.pem|${dir}/privkey.pem|${d_name}")
            fi
        done
    fi

    # 5. /etc/ssl/ (tuna-vpn или вложенные папки)
    if [ -d "/etc/ssl" ]; then
        for dir in /etc/ssl/tuna-vpn/* /etc/ssl/*; do
            [ -d "$dir" ] || continue
            local d_name=$(basename "$dir")
            [ "$d_name" = "certs" ] || [ "$d_name" = "private" ] && continue
            local c="" k=""
            [ -f "${dir}/fullchain.cer" ] && c="${dir}/fullchain.cer"
            [ -z "$c" ] && [ -f "${dir}/fullchain.pem" ] && c="${dir}/fullchain.pem"
            [ -f "${dir}/privkey.key" ] && k="${dir}/privkey.key"
            [ -z "$k" ] && [ -f "${dir}/privkey.pem" ] && k="${dir}/privkey.pem"
            if [ -n "$c" ] && [ -n "$k" ]; then
                candidates+=("${c}|${k}|${d_name}")
            fi
        done
    fi

    # 6. /root/.acme.sh/
    if [ -d "/root/.acme.sh" ]; then
        for dir in /root/.acme.sh/*_ecc /root/.acme.sh/*; do
            [ -d "$dir" ] || continue
            local bname=$(basename "$dir")
            local d_clean=$(echo "$bname" | sed 's/_ecc$//')
            if [ -f "${dir}/fullchain.cer" ] && [ -f "${dir}/${d_clean}.key" ]; then
                candidates+=("${dir}/fullchain.cer|${dir}/${d_clean}.key|${d_clean}")
            fi
        done
    fi

    # Проверяем кандидатов: сначала ищем действующий (не просроченный)
    local fallback=""
    for cand in "${candidates[@]}"; do
        local c_path=$(echo "$cand" | cut -d'|' -f1)
        local k_path=$(echo "$cand" | cut -d'|' -f2)
        local d_label=$(echo "$cand" | cut -d'|' -f3)

        if [ -f "$c_path" ] && [ -f "$k_path" ]; then
            local exp=$(openssl x509 -enddate -noout -in "$c_path" 2>/dev/null | cut -d= -f2 || true)
            # Извлекаем реальное имя домена из CN/SAN если метка техническая
            if [ -z "$d_label" ] || [ "$d_label" = "3x-ui" ] || [ "$d_label" = "cert" ]; then
                local cn=$(openssl x509 -subject -noout -in "$c_path" 2>/dev/null | grep -oP 'CN\s*=\s*\K[^,\/]+' || true)
                [ -n "$cn" ] && d_label="$cn"
            fi
            # Проверка срока действия
            if openssl x509 -in "$c_path" -noout -checkend 0 2>/dev/null; then
                echo "${c_path}|${k_path}|${d_label}|${exp}"
                return 0
            else
                [ -z "$fallback" ] && fallback="${c_path}|${k_path}|${d_label}|${exp} (ИСТЕК)"
            fi
        fi
    done

    if [ -n "$fallback" ]; then
        echo "$fallback"
        return 1
    fi

    return 2
}

get_ssl_short_status() {
    local cert_info=$(detect_primary_ssl_cert 2>/dev/null || true)
    if [ -n "$cert_info" ]; then
        local d_label=$(echo "$cert_info" | cut -d'|' -f3)
        local exp=$(echo "$cert_info" | cut -d'|' -f4)
        if echo "$exp" | grep -qi "ИСТЕК"; then
            echo -e "${RED}ИСТЕК (${d_label})${NC}"
        else
            echo -e "${GREEN}АКТИВЕН (${d_label})${NC}"
        fi
    else
        echo -e "${YELLOW}НЕ НАСТРОЕН${NC}"
    fi
}

sync_ssl_to_xui() {
    local c_file="$1"
    local k_file="$2"
    if [ -z "$c_file" ] || [ -z "$k_file" ]; then
        local primary=$(detect_primary_ssl_cert 2>/dev/null || true)
        if [ -n "$primary" ]; then
            c_file=$(echo "$primary" | cut -d'|' -f1)
            k_file=$(echo "$primary" | cut -d'|' -f2)
        fi
    fi

    if [ -n "$c_file" ] && [ -f "$c_file" ] && [ -n "$k_file" ] && [ -f "$k_file" ]; then
        if [ -d "/etc/x-ui" ]; then
            cp -f "$c_file" /etc/x-ui/server.crt 2>/dev/null || true
            cp -f "$k_file" /etc/x-ui/server.key 2>/dev/null || true
            chmod 600 /etc/x-ui/server.key 2>/dev/null || true
            systemctl restart x-ui 2>/dev/null || true
            echo -e "  ${GREEN}✓ Сертификаты синхронизированы в /etc/x-ui/ (server.crt, server.key)${NC}"
        else
            echo -e "  ${YELLOW}Директория /etc/x-ui не найдена на сервере.${NC}"
        fi
    else
        echo -e "  ${RED}Файлы сертификата не найдены для синхронизации.${NC}"
    fi
}

menu_ssl() {
    while true; do
        clear
        local p_cert=$(detect_primary_ssl_cert 2>/dev/null || true)
        local c_path="Не обнаружен"
        local k_path="Не обнаружен"
        local d_label="—"
        local exp="—"
        local is_ok=false

        if [ -n "$p_cert" ]; then
            c_path=$(echo "$p_cert" | cut -d'|' -f1)
            k_path=$(echo "$p_cert" | cut -d'|' -f2)
            d_label=$(echo "$p_cert" | cut -d'|' -f3)
            exp=$(echo "$p_cert" | cut -d'|' -f4)
            if ! echo "$exp" | grep -qi "ИСТЕК"; then
                is_ok=true
            fi
        fi

        echo -e "${CYAN}╔══════════════════════════════════════════════════════════════════════╗${NC}"
        echo -e "${CYAN}║${BOLD}          ЦЕНТР УПРАВЛЕНИЯ И СТАТУСА SSL-СЕРТИФИКАТОВ                 ${CYAN}║${NC}"
        echo -e "${CYAN}╠══════════════════════════════════════════════════════════════════════╣${NC}"
        echo -e "${CYAN}║${NC}  Статус SSL:    $(get_ssl_short_status)"
        echo -e "${CYAN}║${NC}  Домен:         ${BOLD}${d_label}${NC}"
        echo -e "${CYAN}║${NC}  Срок действия: ${BOLD}${exp}${NC}"
        echo -e "${CYAN}║${NC}  Файл fullchain: ${c_path}"
        echo -e "${CYAN}║${NC}  Файл privkey:   ${k_path}"
        echo -e "${CYAN}╚══════════════════════════════════════════════════════════════════════╝${NC}"
        echo ""
        echo -e "  ${YELLOW}[1]${NC} 🔍 ${BOLD}Детальный скан всех путей сертификатов${NC} (/etc/x-ui, /root/cert, letsencrypt...)"
        echo -e "  ${YELLOW}[2]${NC} 📥 ${BOLD}Синхронизировать сертификат в 3X-UI${NC} (/etc/x-ui/server.crt)"
        echo -e "  ${YELLOW}[3]${NC} 🔄 ${BOLD}Проверить срок годности сертификата через OpenSSL${NC}"
        echo -e "  ${YELLOW}[4]${NC} 💡 ${BOLD}Памятка по управлению SSL через веб-панель 3X-UI${NC}"
        echo -e "  ${YELLOW}[0]${NC} ⬅️  Назад в Главное Меню"
        echo ""
        read -p "Выберите действие [0-4]: " ssl_act
        case "$ssl_act" in
            1)
                clear
                echo -e "${CYAN}=== СКАНИРОВАНИЕ СЕРТИФИКАТОВ НА СЕРВЕРЕ ===${NC}\n"
                for path in "/etc/x-ui" "/root/cert" "/etc/letsencrypt/live" "/etc/ssl" "/root/.acme.sh" "/etc/x-manager/cloudflare.env"; do
                    echo -e "${BOLD}Проверка пути:${NC} ${CYAN}${path}${NC}"
                    if [ -e "$path" ]; then
                        echo -e "  ${GREEN}[✓] Путь существует${NC}"
                    else
                        echo -e "  ${YELLOW}[-] Не найден${NC}"
                    fi
                done
                echo ""
                echo -e "${BOLD}Обнаруженный рабочий сертификат:${NC}"
                if [ -n "$p_cert" ]; then
                    echo -e "  • Домен:   ${GREEN}${d_label}${NC}"
                    echo -e "  • Cert:    ${CYAN}${c_path}${NC}"
                    echo -e "  • Key:     ${CYAN}${k_path}${NC}"
                    echo -e "  • Истекает: ${YELLOW}${exp}${NC}"
                else
                    echo -e "  ${RED}Действующие сертификаты не обнаружены.${NC}"
                fi
                echo ""
                read -p "Нажмите Enter для возврата..."
                ;;
            2)
                echo ""
                sync_ssl_to_xui
                sleep 2
                ;;
            3)
                clear
                echo -e "${CYAN}=== ПРОВЕРКА СЕРТИФИКАТА ЧЕРЕЗ OPENSSL ===${NC}\n"
                if [ -f "$c_path" ]; then
                    openssl x509 -in "$c_path" -text -noout | grep -E "(Issuer:|Subject:|Not Before|Not After|DNS:)" || openssl x509 -in "$c_path" -noout -subject -dates
                else
                    echo -e "${YELLOW}Сертификат не найден.${NC}"
                fi
                echo ""
                read -p "Нажмите Enter для возврата..."
                ;;
            4)
                clear
                echo -e "${CYAN}╔══════════════════════════════════════════════════════════════════════╗${NC}"
                echo -e "${CYAN}║${BOLD}          УПРАВЛЕНИЕ SSL ЧЕРЕЗ ВЕБ-ПАНЕЛЬ 3X-UI                       ${CYAN}║${NC}"
                echo -e "${CYAN}╚══════════════════════════════════════════════════════════════════════╝${NC}"
                echo ""
                echo -e "Выпуск и продление SSL сертификатов (Cloudflare DNS-01 API / HTTP-01)"
                echo -e "штатно выполняются в веб-интерфейсе 3X-UI:"
                echo ""
                echo -e "  1. Откройте веб-панель 3X-UI в браузере."
                echo -e "  2. Перейдите в раздел ${BOLD}«Настройки панели»${NC} -> ${BOLD}«Сертификат SSL»${NC}."
                echo -e "  3. Выберите выпуск через Cloudflare DNS API (введите токен) или Let's Encrypt."
                echo -e "  4. Панель автоматически сохранит сертификат в ${CYAN}/etc/x-ui/server.crt${NC}."
                echo -e "  5. ${BOLD}x-manager${NC} моментально подхватывает этот сертификат для DNS-туннелей и служб."
                echo ""
                read -p "Нажмите Enter для возврата..."
                ;;
            0) return ;;
            *) echo "Неверный выбор"; sleep 1 ;;
        esac
    done
}

detect_base_domain() {
    local d=""
    # 0. Check detected primary SSL certificate
    local primary_cert=$(detect_primary_ssl_cert 2>/dev/null || true)
    if [ -n "$primary_cert" ]; then
        d=$(echo "$primary_cert" | cut -d'|' -f3)
    fi
    # 1. Check cert dirs in /root/cert
    if [ -z "$d" ] && [ -d "/root/cert" ]; then
        d=$(find /root/cert -mindepth 1 -maxdepth 1 -type d -printf '%f\n' 2>/dev/null | grep -v '^\.' | head -n 1)
    fi
    # 2. Check acme.sh ecc dirs
    if [ -z "$d" ] && [ -d "/root/.acme.sh" ]; then
        d=$(find /root/.acme.sh -mindepth 1 -maxdepth 1 -type d -name '*_ecc' -printf '%f\n' 2>/dev/null | sed 's/_ecc$//' | head -n 1)
    fi
    # 3. Check 3x-ui / xray config
    if [ -z "$d" ]; then
        d=$(grep -oP '"serverName":\s*"\K[^"]+' /usr/local/x-ui/bin/config.json /etc/xray/config.json 2>/dev/null | grep -v '127.0.0.1' | head -n 1)
    fi
    # 4. Check caddy
    if [ -z "$d" ] && [ -f "/etc/caddy/Caddyfile" ]; then
        d=$(grep -oP '^[a-zA-Z0-9.-]+\.[a-zA-Z]{2,}' /etc/caddy/Caddyfile 2>/dev/null | head -n 1)
    fi
    # 5. Check hostname if it is a valid domain
    if [ -z "$d" ]; then
        local hn=$(hostname -f 2>/dev/null)
        if echo "$hn" | grep -qE '\.[a-zA-Z]{2,}$'; then
            d="$hn"
        fi
    fi
    # Strip any wildcard (*.), d. or whitespace
    d=$(echo "$d" | sed -e 's/^\*\.//' -e 's/^d\.//' | tr -d '[:space:]')
    echo "$d"
}

get_dns_domain() {
    local conf="$MASTERDNS_CONFIG_FILE"
    [ -f "$conf" ] || conf="$COTTEN_CONFIG_FILE"
    local dom=""
    if [ -f "$conf" ]; then
        dom=$(grep -oP 'DOMAIN\s*=\s*\["\K[^"]+' "$conf" 2>/dev/null | head -n 1 || true)
    fi
    if [ -z "$dom" ]; then
        local base_d=$(detect_base_domain)
        if [ -n "$base_d" ]; then
            dom="d.${base_d}"
        else
            dom="d.lesovoi.pro"
        fi
    fi
    echo "$dom"
}

get_dns_key() {
    local kf="$MASTERDNS_KEY_FILE"
    [ -f "$kf" ] || kf="$COTTEN_KEY_FILE"
    local k=""
    [ -f "$kf" ] && k=$(cat "$kf" 2>/dev/null | tr -d '[:space:]' || true)
    [ -z "$k" ] && k="a7125b5f3cc23e525123c677bc6d202e"
    echo "$k"
}

get_dns_profile_name() {
    local pf="/etc/x-manager/dns_profile_name.txt"
    [ -f "$pf" ] || pf="/etc/masterdns/profile_name.txt"
    [ -f "$pf" ] || pf="/etc/cottendns/profile_name.txt"
    local pname=""
    [ -f "$pf" ] && pname=$(cat "$pf" 2>/dev/null | tr -d '\r\n' || true)
    [ -z "$pname" ] && pname="FP dns tunnel"
    echo "$pname"
}

get_dns_routing() {
    local conf="$MASTERDNS_CONFIG_FILE"
    [ -f "$conf" ] || conf="$COTTEN_CONFIG_FILE"
    if grep -qi "USE_EXTERNAL_SOCKS5\s*=\s*true" "$conf" 2>/dev/null; then
        echo -e "${GREEN}Маршрутизация Xray SOCKS5 (127.0.0.1:10808)${NC}"
    else
        echo -e "${YELLOW}Прямой выход (Direct)${NC}"
    fi
}

is_dns_wan_blocked() {
    [ -f "$DNS_WAN_LOCK" ] && return 0
    if iptables -C INPUT -i "$WAN_IF" -p udp --dport 53 -m comment --comment "DNS_WAN_BLOCK" -j DROP 2>/dev/null; then
        return 0
    fi
    if iptables -S INPUT 2>/dev/null | grep -E -- "-A INPUT.*-i (ens3|eth0|${WAN_IF}).*-p udp.*--dport 53.*-j DROP" >/dev/null 2>&1; then
        return 0
    fi
    return 1
}

get_dns_wan_status() {
    if ! is_dns_installed; then
        echo -e "${RED}Не установлен${NC}"
        return
    fi
    if is_dns_wan_blocked; then
        echo -e "${RED}🔒 БЛОКИРОВАН В WAN (Только локально)${NC}"
    else
        echo -e "${GREEN}🟢 ВКЛЮЧЕН (Открыт для интернета)${NC}"
    fi
}

toggle_dns_wan() {
    echo ""
    if is_dns_wan_blocked; then
        echo -e "${YELLOW}Открытие доступа к DNS-туннелю из внешнего интернета (WAN)...${NC}"
        iptables -D INPUT -i "$WAN_IF" -p udp --dport 53 -m comment --comment "DNS_WAN_BLOCK" -j DROP 2>/dev/null || true
        iptables -D INPUT -i "$WAN_IF" -p tcp --dport 53 -m comment --comment "DNS_WAN_BLOCK" -j DROP 2>/dev/null || true
        rm -f "$DNS_WAN_LOCK"
        echo -e "${GREEN}✓ Доступ из WAN успешно ОТКРЫТ! Порт 53 UDP/TCP принимает подключения.${NC}"
    else
        echo -e "${YELLOW}Блокировка доступа к DNS-туннелю из внешнего интернета (WAN)...${NC}"
        mkdir -p /etc/x-manager
        touch "$DNS_WAN_LOCK"
        iptables -D INPUT -i "$WAN_IF" -p udp --dport 53 -m comment --comment "DNS_WAN_BLOCK" -j DROP 2>/dev/null || true
        iptables -D INPUT -i "$WAN_IF" -p tcp --dport 53 -m comment --comment "DNS_WAN_BLOCK" -j DROP 2>/dev/null || true
        iptables -I INPUT 1 -i "$WAN_IF" -p udp --dport 53 -m comment --comment "DNS_WAN_BLOCK" -j DROP
        iptables -I INPUT 1 -i "$WAN_IF" -p tcp --dport 53 -m comment --comment "DNS_WAN_BLOCK" -j DROP
        echo -e "${GREEN}✓ Доступ из WAN успешно ЗАБЛОКИРОВАН! Трафик на порт 53 сбрасывается (DROP).${NC}"
    fi
    sleep 2
}

switch_dns_engine() {
    echo ""
    local active=$(get_active_dns_engine)
    if [ "$active" = "cottendns" ]; then
        if ! is_masterdns_installed; then
            echo -e "${YELLOW}MasterDnsVPN еще не установлен на сервере.${NC}"
            read -p "Желаете установить MasterDnsVPN прямо сейчас? [y/N]: " inst_ans
            if [[ "$inst_ans" =~ ^[yYдД] ]]; then
                install_masterdns
            fi
            return
        fi
        echo -e "${YELLOW}Переключение с CottenDNS на MasterDnsVPN...${NC}"
        systemctl stop cottendns 2>/dev/null || true
        systemctl disable cottendns 2>/dev/null || true
        systemctl enable masterdns 2>/dev/null || true
        systemctl restart masterdns
        sleep 2
        if systemctl is-active --quiet masterdns; then
            echo -e "${GREEN}✓ Успешно активирован MasterDnsVPN на порту 53!${NC}"
        else
            echo -e "${RED}✗ Ошибка запуска MasterDnsVPN!${NC}"
            journalctl -u masterdns -n 10 --no-pager
        fi
    else
        if ! is_cottendns_installed; then
            echo -e "${YELLOW}CottenDNS еще не установлен на сервере.${NC}"
            read -p "Желаете установить CottenDNS (WhiteDNS Engine) прямо сейчас? [y/N]: " inst_ans
            if [[ "$inst_ans" =~ ^[yYдД] ]]; then
                install_cottendns
            fi
            return
        fi
        echo -e "${YELLOW}Переключение с MasterDnsVPN на CottenDNS (WhiteDNS Engine)...${NC}"
        systemctl stop masterdns 2>/dev/null || true
        systemctl disable masterdns 2>/dev/null || true
        systemctl enable cottendns 2>/dev/null || true
        systemctl restart cottendns
        sleep 2
        if systemctl is-active --quiet cottendns; then
            echo -e "${GREEN}✓ Успешно активирован CottenDNS (WhiteDNS Engine) на порту 53!${NC}"
        else
            echo -e "${RED}✗ Ошибка запуска CottenDNS!${NC}"
            journalctl -u cottendns -n 10 --no-pager
        fi
    fi
    sleep 2
}

get_stormdns_link() {
    local p_type="$1"
    local p_domain="$2"
    local p_key="$3"
    local p_name="$4"
    [ -z "$p_domain" ] && p_domain=$(get_dns_domain)
    [ -z "$p_key" ] && p_key=$(get_dns_key)
    [ -z "$p_name" ] && p_name=$(get_dns_profile_name)
    python3 - << PYEOF
import json, base64

domain = "${p_domain}"
key = "${p_key}"
name = "${p_name}"
ptype = int("${p_type}")

resolvers = "1.1.1.1\n1.0.0.1\n8.8.8.8\n8.8.4.4\n9.9.9.9\n77.88.8.8\n77.88.8.1\n77.88.8.2\n77.88.8.3\n77.88.8.7\n77.88.8.88"

p = {
    "schema": "whitedns.profile",
    "version": 1,
    "profile": {
        "name": name,
        "server": {
            "domain": domain,
            "encryption_key": key,
            "encryption_method": 5
        },
        "resolvers": resolvers,
        "resolver_balancing_strategy": 2,
        "upload_compression_type": 0,
        "download_compression_type": 0,
        "rx_tx_workers": 4,
        "tunnel_process_workers": 0,
        "max_packets_per_batch": 8,
        "arq_window_size": 600,
        "arq_max_rto_seconds": 5
    }
}

if ptype == 1:
    p["profile"].update({
        "packet_duplication_count": 4,
        "setup_packet_duplication_count": 4,
        "base_encode_data": True,
        "min_upload_mtu": 28,
        "max_upload_mtu": 200,
        "min_download_mtu": 60,
        "max_download_mtu": 900,
        "arq_initial_rto_seconds": 2,
        "ping_aggressive_interval_seconds": 0.05,
        "ping_lazy_interval_seconds": 0.5,
        "ping_cooldown_interval_seconds": 2,
        "ping_cold_interval_seconds": 15
    })
elif ptype == 2:
    p["profile"].update({
        "packet_duplication_count": 2,
        "setup_packet_duplication_count": 2,
        "base_encode_data": False,
        "min_upload_mtu": 38,
        "max_upload_mtu": 150,
        "min_download_mtu": 100,
        "max_download_mtu": 500,
        "arq_initial_rto_seconds": 1,
        "ping_aggressive_interval_seconds": 0.1,
        "ping_lazy_interval_seconds": 0.75,
        "ping_cooldown_interval_seconds": 2,
        "ping_cold_interval_seconds": 15
    })
elif ptype == 3:
    p["profile"].update({
        "packet_duplication_count": 1,
        "setup_packet_duplication_count": 2,
        "base_encode_data": False,
        "min_upload_mtu": 38,
        "max_upload_mtu": 150,
        "min_download_mtu": 100,
        "max_download_mtu": 500,
        "arq_initial_rto_seconds": 1,
        "ping_aggressive_interval_seconds": 0.1,
        "ping_lazy_interval_seconds": 0.75,
        "ping_cooldown_interval_seconds": 4,
        "ping_cold_interval_seconds": 30
    })

raw = json.dumps(p, separators=(',', ':'))
print("stormdns://" + base64.b64encode(raw.encode('utf-8')).decode('utf-8'))
PYEOF
}

show_single_dns_profile() {
    local ptype="$1"
    local title="$2"
    local desc="$3"
    local tag="$4"
    local dom=$(get_dns_domain)
    local key=$(get_dns_key)
    local base_name=$(get_dns_profile_name)
    local pname="${base_name}"
    [ -n "$tag" ] && pname="${base_name} [${tag}]"
    local link=$(get_stormdns_link "$ptype" "$dom" "$key" "$pname")

    clear
    echo -e "${CYAN}╔══════════════════════════════════════════════════════════════════════╗${NC}"
    echo -e "${CYAN}║${BOLD}  $title  ${CYAN}║${NC}"
    echo -e "${CYAN}╚══════════════════════════════════════════════════════════════════════╝${NC}"
    echo ""
    echo -e "${BOLD}Параметры профиля:${NC}"
    echo -e "  • Имя профиля:   ${YELLOW}${pname}${NC}"
    echo -e "  • Домен зоны:    ${CYAN}${dom}${NC}"
    echo -e "  • Ключ:          ${GREEN}${key}${NC} (AES-256-GCM)"
    echo -e "  • Особенности:   ${YELLOW}${desc}${NC}"
    echo ""
    echo -e "${BOLD}--- QR-код для сканирования в приложении WhiteDNS / StormDNS ---${NC}"
    qrencode -t ANSI256 "$link" 2>/dev/null || qrencode -t UTF8 "$link" 2>/dev/null || echo "qrencode не смог отрендерить"
    echo ""
    echo -e "${BOLD}--- Ссылка для импорта (stormdns://) ---${NC}"
    echo -e "${CYAN}${link}${NC}"
    echo ""
    read -p "Нажмите Enter для возврата..."
}

show_dns_profiles() {
    local dom=$(get_dns_domain)
    local key=$(get_dns_key)

    while true; do
        clear
        local base_pname=$(get_dns_profile_name)
        echo -e "${CYAN}╔══════════════════════════════════════════════════════════════════════╗${NC}"
        echo -e "${CYAN}║${BOLD}          ПРОФИЛИ ПОДКЛЮЧЕНИЯ WHITEDNS / STORMDNS                     ${CYAN}║${NC}"
        echo -e "${CYAN}╠══════════════════════════════════════════════════════════════════════╣${NC}"
        echo -e "${CYAN}║${NC}  Имя базы: ${YELLOW}${BOLD}${base_pname}${NC}"
        echo -e "${CYAN}║${NC}  Домен:    ${BOLD}${dom}${NC}  |  Ключ: ${GREEN}${key:0:16}...${NC}  |  AES-256-GCM"
        echo -e "${CYAN}╚══════════════════════════════════════════════════════════════════════╝${NC}"
        echo ""
        echo -e "  ${YELLOW}[1]${NC} 🛡️  ${BOLD}Профиль 1: «Жесткая цензура»${NC}"
        echo "      (Дублирование x4, base32 кодирование, агрессивный пинг, безопасный MTU 28-200)"
        echo ""
        echo -e "  ${YELLOW}[2]${NC} ⚡ ${BOLD}Профиль 2: «Стандартный»${NC}"
        echo "      (Дублирование x2, оптимальная скорость и низкая задержка, MTU 38-150)"
        echo ""
        echo -e "  ${YELLOW}[3]${NC} 🚀 ${BOLD}Профиль 3: «Мобильный / Скоростной»${NC}"
        echo "      (Дублирование x1, энергосбережение батареи, увеличенные тайм-ауты ожидания)"
        echo ""
        echo -e "  ${YELLOW}[4]${NC} 📋 ${BOLD}Показать все 3 ссылки списком для копирования${NC}"
        echo -e "  ${YELLOW}[0]${NC} ⬅️  Назад в меню DNS-туннелей"
        echo ""
        read -p "Выберите профиль [0-4]: " prof_choice
        case "$prof_choice" in
            1)
                show_single_dns_profile 1 "ПРОФИЛЬ 1: ЖЕСТКАЯ ЦЕНЗУРА (MAX SURVIVAL)" "Дублирование x4, Base32, Пинг 50ms, MTU 28..200/60..900" "Жесткая цензура"
                ;;
            2)
                show_single_dns_profile 2 "ПРОФИЛЬ 2: СТАНДАРТНЫЙ (BALANCED SPEED)" "Дублирование x2, Пинг 100ms, MTU 38..150/100..500" "Стандартный"
                ;;
            3)
                show_single_dns_profile 3 "ПРОФИЛЬ 3: МОБИЛЬНЫЙ / СКОРОСТНОЙ (LOW BATTERY)" "Дублирование x1, Пинг 100ms, Cooldown 4s, MTU 38..150/100..500" "Скоростной"
                ;;
            4)
                clear
                echo -e "${CYAN}╔══════════════════════════════════════════════════════════════════════╗${NC}"
                echo -e "${CYAN}║${BOLD}          ВСЕ 3 ПРОФИЛЯ ПОДКЛЮЧЕНИЯ ДЛЯ КОПИРОВАНИЯ                   ${CYAN}║${NC}"
                echo -e "${CYAN}╚══════════════════════════════════════════════════════════════════════╝${NC}"
                echo ""
                echo -e "${YELLOW}${BOLD}1. Жесткая цензура (${base_pname} [Жесткая цензура]):${NC}"
                get_stormdns_link 1 "$dom" "$key" "${base_pname} [Жесткая цензура]"
                echo ""
                echo -e "${YELLOW}${BOLD}2. Стандартный (${base_pname} [Стандартный]):${NC}"
                get_stormdns_link 2 "$dom" "$key" "${base_pname} [Стандартный]"
                echo ""
                echo -e "${YELLOW}${BOLD}3. Мобильный / Скоростной (${base_pname} [Скоростной]):${NC}"
                get_stormdns_link 3 "$dom" "$key" "${base_pname} [Скоростной]"
                echo ""
                read -p "Нажмите Enter для возврата..."
                ;;
            0) return ;;
        esac
    done
}

dns_change_domain() {
    clear
    local cur_dom=$(get_dns_domain)
    local base_d=$(detect_base_domain)
    local suggest="d.${base_d}"
    [ -z "$base_d" ] && suggest="$cur_dom"
    echo -e "${BOLD}--- Смена домена DNS-зоны ---${NC}"
    echo -e "Текущий домен туннеля:   ${CYAN}${cur_dom}${NC}"
    [ -n "$base_d" ] && echo -e "Базовый домен сервера:    ${GREEN}${base_d}${NC} (предлагаемый: ${CYAN}${suggest}${NC})"
    echo ""
    read -p "Введите новый домен DNS-зоны [Enter для $suggest]: " new_dom
    new_dom=$(echo "$new_dom" | tr -d '[:space:]')
    [ -z "$new_dom" ] && new_dom="$suggest"
    [ -z "$new_dom" ] && return

    if [[ "$new_dom" != d.* ]]; then
        new_dom="d.${new_dom}"
        echo -e "${YELLOW}Автоматически добавлен префикс 'd.': ${new_dom}${NC}"
    fi

    if [ -f "$COTTEN_CONFIG_FILE" ]; then
        sed -i 's/^DOMAIN\s*=.*/DOMAIN = ["'"$new_dom"'"]/' "$COTTEN_CONFIG_FILE"
    fi
    if [ -f "$MASTERDNS_CONFIG_FILE" ]; then
        sed -i 's/^DOMAIN\s*=.*/DOMAIN = ["'"$new_dom"'"]/' "$MASTERDNS_CONFIG_FILE"
    fi

    local cur_s=$(get_active_dns_engine)
    systemctl restart "$cur_s" 2>/dev/null || true
    echo -e "${GREEN}✓ Домен зоны успешно изменен на: ${new_dom}!${NC}"
    sleep 2
}

dns_change_key() {
    clear
    local cur_key=$(get_dns_key)
    echo -e "${BOLD}--- Смена ключа шифрования (AES-256-GCM) ---${NC}"
    echo -e "Текущий ключ: ${GREEN}${cur_key}${NC}"
    echo ""
    echo -e "  ${YELLOW}[1]${NC} Сгенерировать новый случайный ключ (32 hex)"
    echo -e "  ${YELLOW}[2]${NC} Ввести свой 32-байтный hex-ключ"
    echo -e "  ${YELLOW}[0]${NC} Отмена"
    echo ""
    read -p "Выберите вариант [0-2]: " k_choice
    local new_key=""
    case "$k_choice" in
        1)
            new_key=$(openssl rand -hex 16 2>/dev/null || echo "a7125b5f3cc23e525123c677bc6d202e")
            ;;
        2)
            read -p "Введите hex ключ (32 символа): " custom_k
            new_key=$(echo "$custom_k" | tr -d '[:space:]')
            ;;
        *) return ;;
    esac

    [ -z "$new_key" ] && return
    mkdir -p "$COTTEN_DIR" "$MASTERDNS_DIR"
    echo -n "$new_key" > "$COTTEN_KEY_FILE"
    chmod 600 "$COTTEN_KEY_FILE"
    echo -n "$new_key" > "$MASTERDNS_KEY_FILE"
    chmod 600 "$MASTERDNS_KEY_FILE"

    local cur_s=$(get_active_dns_engine)
    systemctl restart "$cur_s" 2>/dev/null || true
    echo -e "${GREEN}✓ Ключ шифрования успешно обновлен: ${new_key}${NC}"
    sleep 2
}

dns_change_profile_name() {
    clear
    local cur_pname=$(get_dns_profile_name)
    echo -e "${BOLD}--- Смена имени профилей подключения DNS-туннеля ---${NC}"
    echo -e "Текущее базовое имя: ${CYAN}${cur_pname}${NC}\n"
    read -p "Введите новое базовое имя профиля [Enter для '$cur_pname']: " new_pname
    new_pname=$(echo "$new_pname" | sed -e 's/^[[:space:]]*//' -e 's/[[:space:]]*$//')
    [ -z "$new_pname" ] && return
    mkdir -p /etc/x-manager /etc/masterdns /etc/cottendns
    echo -n "$new_pname" > /etc/x-manager/dns_profile_name.txt
    echo -n "$new_pname" > /etc/masterdns/profile_name.txt 2>/dev/null || true
    echo -n "$new_pname" > /etc/cottendns/profile_name.txt 2>/dev/null || true
    echo -e "${GREEN}✓ Имя профилей подключения успешно изменено на: '${new_pname}'!${NC}"
    sleep 2
}

dns_change_routing() {
    clear
    echo -e "${BOLD}--- Настройка маршрутизации DNS-туннеля ---${NC}"
    echo -e "Текущий режим: $(get_dns_routing)"
    echo ""
    echo -e "  ${YELLOW}[1]${NC} 🌐 Маршрутизация Xray SOCKS5 (127.0.0.1:10808) ${GREEN}[Рекомендуется]${NC}"
    echo -e "  ${YELLOW}[2]${NC} ⚡ Прямой выход (Direct)"
    echo -e "  ${YELLOW}[0]${NC} Отмена"
    echo ""
    read -p "Выберите режим [0-2]: " r_choice
    case "$r_choice" in
        1)
            for f in "$COTTEN_CONFIG_FILE" "$MASTERDNS_CONFIG_FILE"; do
                if [ -f "$f" ]; then
                    sed -i 's/^USE_EXTERNAL_SOCKS5\s*=.*/USE_EXTERNAL_SOCKS5 = true/' "$f"
                    sed -i 's/^FORWARD_IP\s*=.*/FORWARD_IP = "127.0.0.1"/' "$f"
                    sed -i 's/^FORWARD_PORT\s*=.*/FORWARD_PORT = 10808/' "$f"
                fi
            done
            echo -e "${GREEN}✓ Маршрутизация установлена: Xray SOCKS5${NC}"
            ;;
        2)
            for f in "$COTTEN_CONFIG_FILE" "$MASTERDNS_CONFIG_FILE"; do
                if [ -f "$f" ]; then
                    sed -i 's/^USE_EXTERNAL_SOCKS5\s*=.*/USE_EXTERNAL_SOCKS5 = false/' "$f"
                fi
            done
            echo -e "${GREEN}✓ Маршрутизация установлена: Прямой выход (Direct)${NC}"
            ;;
        *) return ;;
    esac

    local cur_s=$(get_active_dns_engine)
    systemctl restart "$cur_s" 2>/dev/null || true
    sleep 2
}

menu_dns_settings() {
    while true; do
        clear
        echo -e "${CYAN}╔══════════════════════════════════════════════════════════════════════╗${NC}"
        echo -e "${CYAN}║${BOLD}                 НАСТРОЙКИ ПАРАМЕТРОВ DNS-ТУННЕЛЯ                      ${CYAN}║${NC}"
        echo -e "${CYAN}╠══════════════════════════════════════════════════════════════════════╣${NC}"
        echo -e "${CYAN}║${NC}  Домен зоны:  ${CYAN}${BOLD}$(get_dns_domain)${NC}"
        echo -e "${CYAN}║${NC}  Ключ шифр.:  ${GREEN}$(get_dns_key)${NC} (AES-256-GCM)"
        echo -e "${CYAN}║${NC}  Имя профиля: ${YELLOW}${BOLD}$(get_dns_profile_name)${NC}"
        echo -e "${CYAN}║${NC}  Маршрут:     $(get_dns_routing)"
        echo -e "${CYAN}╚══════════════════════════════════════════════════════════════════════╝${NC}"
        echo ""
        echo -e "  ${YELLOW}[1]${NC} 🌐 Сменить домен DNS-зоны"
        echo -e "  ${YELLOW}[2]${NC} 🔑 Сменить / сгенерировать ключ шифрования"
        echo -e "  ${YELLOW}[3]${NC} 🏷️  Сменить имя подключения (профилей в приложении)"
        echo -e "  ${YELLOW}[4]${NC} 🔀 Изменить маршрутизацию (Xray SOCKS5 / Direct)"
        echo -e "  ${YELLOW}[0]${NC} ⬅️  Назад"
        echo ""
        read -p "Выберите пункт [0-4]: " s_choice
        case "$s_choice" in
            1) dns_change_domain ;;
            2) dns_change_key ;;
            3) dns_change_profile_name ;;
            4) dns_change_routing ;;
            0) return ;;
        esac
    done
}

install_cottendns() {
    clear
    echo -e "${CYAN}╔══════════════════════════════════════════════════════════════════════╗${NC}"
    echo -e "${CYAN}║${BOLD}    УСТАНОВКА COTTENDNS (WHITEDNS HIGH-SPEED DNS TUNNEL ENGINE)        ${CYAN}║${NC}"
    echo -e "${CYAN}╚══════════════════════════════════════════════════════════════════════╝${NC}"
    echo ""
    local base_d=$(detect_base_domain)
    local cur_dom=$(get_dns_domain)
    if [ -z "$cur_dom" ] || [ "$cur_dom" = "d.lesovoi.pro" ]; then
        if [ -n "$base_d" ]; then
            cur_dom="d.${base_d}"
        else
            cur_dom="d.lesovoi.pro"
        fi
    fi
    [ -n "$base_d" ] && echo -e "  Базовый домен сервера: ${GREEN}${base_d}${NC}"
    read -p "Введите домен DNS-зоны [по умолчанию $cur_dom]: " user_dom
    user_dom=$(echo "$user_dom" | tr -d '[:space:]')
    [ -z "$user_dom" ] && user_dom="$cur_dom"
    if [[ "$user_dom" != d.* ]]; then
        user_dom="d.${user_dom}"
        echo -e "  ${YELLOW}Автоматически добавлен префикс 'd.': ${user_dom}${NC}"
    fi
    cur_dom="$user_dom"

    local cur_key=$(get_dns_key)
    [ -z "$cur_key" ] && cur_key=$(openssl rand -hex 16 2>/dev/null || echo "a7125b5f3cc23e525123c677bc6d202e")
    read -p "Ключ шифрования (AES-256-GCM, 32 hex символа) [Enter для $cur_key]: " user_key
    [ -n "$user_key" ] && cur_key="$user_key"

    local cur_pname=$(get_dns_profile_name)
    read -p "Имя профилей подключения в приложении [Enter для '$cur_pname']: " user_pname
    user_pname=$(echo "$user_pname" | sed -e 's/^[[:space:]]*//' -e 's/[[:space:]]*$//')
    [ -z "$user_pname" ] && user_pname="$cur_pname"
    mkdir -p /etc/x-manager /etc/cottendns /etc/masterdns
    echo -n "$user_pname" > /etc/x-manager/dns_profile_name.txt
    echo -n "$user_pname" > /etc/cottendns/profile_name.txt 2>/dev/null || true
    echo -n "$user_pname" > /etc/masterdns/profile_name.txt 2>/dev/null || true

    echo ""
    echo -e "${YELLOW}Скачивание и установка CottenDNS...${NC}"
    local arch=$(uname -m)
    local pkg_arch="AMD64"
    case "$arch" in
        x86_64) pkg_arch="AMD64" ;;
        aarch64|arm64) pkg_arch="ARM64" ;;
        *) echo -e "${RED}Архитектура $arch не поддерживается автоматически.${NC}"; sleep 2; return ;;
    esac

    local tmp_dir=$(mktemp -d)
    local dl_url="https://github.com/WhiteDNS/CottenDNS/releases/download/v2026.09.01.221444-530ffbf/CottenDns_Server_Linux_${pkg_arch}.tar.gz"
    if ! curl -sL "$dl_url" -o "$tmp_dir/cotten.tar.gz"; then
        echo -e "${RED}Ошибка скачивания с GitHub!${NC}"
        rm -rf "$tmp_dir"
        sleep 2
        return
    fi

    tar -xzf "$tmp_dir/cotten.tar.gz" -C "$tmp_dir"
    local bin_file=$(find "$tmp_dir" -type f -name "CottenDns_Server_Linux_*" | head -n 1)
    if [ -z "$bin_file" ] || [ ! -f "$bin_file" ]; then
        echo -e "${RED}Бинарник не найден в архиве!${NC}"
        rm -rf "$tmp_dir"
        sleep 2
        return
    fi

    mkdir -p /etc/cottendns /usr/local/bin
    cp "$bin_file" /usr/local/bin/cottendns-server
    chmod +x /usr/local/bin/cottendns-server
    echo -n "$cur_key" > /etc/cottendns/encrypt_key.txt
    chmod 600 /etc/cottendns/encrypt_key.txt

    cat << EOF > /etc/cottendns/server_config.toml
DOMAIN = ["${cur_dom}"]
PROTOCOL_TYPE = "SOCKS5"
SUPPORTED_UPLOAD_COMPRESSION_TYPES = [0, 1, 2, 3]
SUPPORTED_DOWNLOAD_COMPRESSION_TYPES = [0, 1, 2, 3]
UDP_HOST = "0.0.0.0"
UDP_PORT = 53
TCP_LISTENER_ENABLED = true
TCP_IPV6_ENABLED = false
TCP_MAX_CONNS = 2048
TCP_MAX_CONNS_PER_IP = 128
TCP_MAX_QUERIES_PER_CONN = 0
DOT_LISTENER_ENABLED = false
DOH_LISTENER_ENABLED = false
UDP_READERS = 4
DNS_REQUEST_WORKERS = 4
MAX_CONCURRENT_REQUESTS = 16384
SOCKET_BUFFER_SIZE = 8388608
MAX_PACKET_SIZE = 4096
DROP_LOG_INTERVAL_SECONDS = 2.0
DEFERRED_SESSION_WORKERS = 4
DEFERRED_SESSION_QUEUE_LIMIT = 4096
MAX_STREAMS_PER_SESSION = 4096
MAX_ACTIVE_SESSIONS = 2048
DNS_UPSTREAM_SERVERS = ["1.1.1.1:53", "8.8.8.8:53", "77.88.8.8:53"]
DNS_UPSTREAM_TIMEOUT = 4.0
DNS_CACHE_MAX_RECORDS = 50000
DNS_CACHE_TTL_SECONDS = 300.0
SOCKS_CONNECT_TIMEOUT = 120.0
USE_EXTERNAL_SOCKS5 = true
SOCKS5_AUTH = false
FORWARD_IP = "127.0.0.1"
FORWARD_PORT = 10808
DATA_ENCRYPTION_METHOD = 5
ENCRYPTION_AUTO_DETECT = true
ENCRYPTION_KEY_FILE = "/etc/cottendns/encrypt_key.txt"
LOG_LEVEL = "INFO"
CONFIG_VERSION = "14"
EOF

    cat << EOF > /etc/systemd/system/cottendns.service
[Unit]
Description=CottenDNS High-Speed DNS Tunnel Server (WhiteDNS Engine)
After=network.target xray.service
Wants=xray.service

[Service]
Type=simple
WorkingDirectory=/etc/cottendns
ExecStart=/usr/local/bin/cottendns-server -config /etc/cottendns/server_config.toml
Restart=always
RestartSec=3
LimitNOFILE=65535
CapabilityBoundingSet=CAP_NET_BIND_SERVICE CAP_NET_ADMIN
AmbientCapabilities=CAP_NET_BIND_SERVICE CAP_NET_ADMIN

[Install]
WantedBy=multi-user.target
EOF

    systemctl daemon-reload
    rm -rf "$tmp_dir"

    if systemctl is-active --quiet masterdns; then
        echo -e "${GREEN}✓ CottenDNS успешно установлен как альтернативный скоростной движок.${NC}"
        echo -e "  Так как сейчас активен MasterDnsVPN (основной), CottenDNS находится в резерве."
        echo -e "  Вы можете переключить активный движок в пункте [2] меню DNS."
    else
        systemctl enable cottendns
        systemctl restart cottendns
        sleep 2
        if systemctl is-active --quiet cottendns; then
            echo -e "${GREEN}✓ CottenDNS успешно установлен и запущен на порту UDP/TCP 53!${NC}"
        else
            echo -e "${RED}✗ Ошибка запуска CottenDNS! Проверьте логи journalctl -u cottendns${NC}"
        fi
    fi
    sleep 2
}

install_masterdns() {
    clear
    echo -e "${CYAN}╔══════════════════════════════════════════════════════════════════════╗${NC}"
    echo -e "${CYAN}║${BOLD}        УСТАНОВКА MASTERDNSVPN (ОСНОВНОЙ DNS-ТУННЕЛЬ)                  ${CYAN}║${NC}"
    echo -e "${CYAN}╚══════════════════════════════════════════════════════════════════════╝${NC}"
    echo ""
    local base_d=$(detect_base_domain)
    local cur_dom=$(get_dns_domain)
    if [ -z "$cur_dom" ] || [ "$cur_dom" = "d.lesovoi.pro" ]; then
        if [ -n "$base_d" ]; then
            cur_dom="d.${base_d}"
        else
            cur_dom="d.lesovoi.pro"
        fi
    fi
    [ -n "$base_d" ] && echo -e "  Базовый домен сервера: ${GREEN}${base_d}${NC}"
    read -p "Введите домен DNS-зоны [по умолчанию $cur_dom]: " user_dom
    user_dom=$(echo "$user_dom" | tr -d '[:space:]')
    [ -z "$user_dom" ] && user_dom="$cur_dom"
    if [[ "$user_dom" != d.* ]]; then
        user_dom="d.${user_dom}"
        echo -e "  ${YELLOW}Автоматически добавлен префикс 'd.': ${user_dom}${NC}"
    fi
    cur_dom="$user_dom"

    local cur_key=$(get_dns_key)
    [ -z "$cur_key" ] && cur_key=$(openssl rand -hex 16 2>/dev/null || echo "a7125b5f3cc23e525123c677bc6d202e")
    read -p "Ключ шифрования (AES-256-GCM, 32 hex символа) [Enter для $cur_key]: " user_key
    [ -n "$user_key" ] && cur_key="$user_key"

    local cur_pname=$(get_dns_profile_name)
    read -p "Имя профилей подключения в приложении [Enter для '$cur_pname']: " user_pname
    user_pname=$(echo "$user_pname" | sed -e 's/^[[:space:]]*//' -e 's/[[:space:]]*$//')
    [ -z "$user_pname" ] && user_pname="$cur_pname"
    mkdir -p /etc/x-manager /etc/masterdns /etc/cottendns
    echo -n "$user_pname" > /etc/x-manager/dns_profile_name.txt
    echo -n "$user_pname" > /etc/masterdns/profile_name.txt 2>/dev/null || true
    echo -n "$user_pname" > /etc/cottendns/profile_name.txt 2>/dev/null || true

    echo ""
    echo -e "${YELLOW}Скачивание и установка MasterDnsVPN...${NC}"
    local arch=$(uname -m)
    local pkg_arch="AMD64"
    case "$arch" in
        x86_64) pkg_arch="AMD64" ;;
        aarch64|arm64) pkg_arch="ARM64" ;;
        *) echo -e "${RED}Архитектура $arch не поддерживается автоматически.${NC}"; sleep 2; return ;;
    esac

    local tmp_dir=$(mktemp -d)
    local dl_url="https://github.com/masterking32/MasterDnsVPN/releases/download/v2026.06.13.234407-7de2476/MasterDnsVPN_Server_Linux_${pkg_arch}.tar.gz"
    if ! curl -sL "$dl_url" -o "$tmp_dir/master.tar.gz"; then
        echo -e "${RED}Ошибка скачивания с GitHub!${NC}"
        rm -rf "$tmp_dir"
        sleep 2
        return
    fi

    tar -xzf "$tmp_dir/master.tar.gz" -C "$tmp_dir"
    local bin_file=$(find "$tmp_dir" -type f -name "MasterDnsVPN_Server_Linux_*" | head -n 1)
    if [ -z "$bin_file" ] || [ ! -f "$bin_file" ]; then
        echo -e "${RED}Бинарник не найден в архиве!${NC}"
        rm -rf "$tmp_dir"
        sleep 2
        return
    fi

    mkdir -p /etc/masterdns /usr/local/bin
    cp "$bin_file" /usr/local/bin/masterdns-server
    chmod +x /usr/local/bin/masterdns-server
    echo -n "$cur_key" > /etc/masterdns/encrypt_key.txt
    chmod 600 /etc/masterdns/encrypt_key.txt

    cat << EOF > /etc/masterdns/server_config.toml
DOMAIN = ["${cur_dom}"]
PROTOCOL_TYPE = "SOCKS5"
UDP_HOST = "0.0.0.0"
UDP_PORT = 53
UDP_READERS = 4
DNS_REQUEST_WORKERS = 4
MAX_CONCURRENT_REQUESTS = 16384
SOCKET_BUFFER_SIZE = 8388608
MAX_PACKET_SIZE = 4096
DNS_UPSTREAM_SERVERS = ["1.1.1.1:53", "8.8.8.8:53"]
USE_EXTERNAL_SOCKS5 = true
SOCKS5_AUTH = false
FORWARD_IP = "127.0.0.1"
FORWARD_PORT = 10808
DATA_ENCRYPTION_METHOD = 5
ENCRYPTION_KEY_FILE = "/etc/masterdns/encrypt_key.txt"
LOG_LEVEL = "INFO"
EOF

    cat << EOF > /etc/systemd/system/masterdns.service
[Unit]
Description=MasterDnsVPN DNS Tunnel Server (Primary Engine)
After=network.target xray.service
Wants=xray.service

[Service]
Type=simple
WorkingDirectory=/etc/masterdns
ExecStart=/usr/local/bin/masterdns-server -config /etc/masterdns/server_config.toml
Restart=always
RestartSec=3
LimitNOFILE=65535
CapabilityBoundingSet=CAP_NET_BIND_SERVICE CAP_NET_ADMIN
AmbientCapabilities=CAP_NET_BIND_SERVICE CAP_NET_ADMIN

[Install]
WantedBy=multi-user.target
EOF

    systemctl daemon-reload
    rm -rf "$tmp_dir"

    # Stop CottenDNS if it was running to free port 53 for MasterDnsVPN
    systemctl stop cottendns 2>/dev/null || true
    systemctl disable cottendns 2>/dev/null || true

    systemctl enable masterdns
    systemctl restart masterdns
    sleep 2
    if systemctl is-active --quiet masterdns; then
        echo -e "${GREEN}✓ MasterDnsVPN успешно установлен и запущен как основной движок на порту UDP 53!${NC}"
    else
        echo -e "${RED}✗ Ошибка запуска MasterDnsVPN! Проверьте логи journalctl -u masterdns${NC}"
    fi
    sleep 2
}

uninstall_dns() {
    clear
    echo -e "${RED}╔══════════════════════════════════════════════════════════════════════╗${NC}"
    echo -e "${RED}║${BOLD}                     УДАЛЕНИЕ DNS-ТУННЕЛЯ                             ${RED}║${NC}"
    echo -e "${RED}╚══════════════════════════════════════════════════════════════════════╝${NC}"
    echo ""
    echo -e "  ${YELLOW}[1]${NC} Удалить только CottenDNS"
    echo -e "  ${YELLOW}[2]${NC} Удалить только MasterDnsVPN"
    echo -e "  ${YELLOW}[3]${NC} ${RED}${BOLD}Удалить ОБА сервиса и очистить конфигурации${NC}"
    echo -e "  ${YELLOW}[0]${NC} Отмена"
    echo ""
    read -p "Выберите вариант [0-3]: " u_choice
    case "$u_choice" in
        1)
            systemctl stop cottendns 2>/dev/null || true
            systemctl disable cottendns 2>/dev/null || true
            rm -f /etc/systemd/system/cottendns.service /usr/local/bin/cottendns-server
            rm -rf /etc/cottendns
            systemctl daemon-reload
            echo -e "${GREEN}✓ CottenDNS удален.${NC}"
            ;;
        2)
            systemctl stop masterdns 2>/dev/null || true
            systemctl disable masterdns 2>/dev/null || true
            rm -f /etc/systemd/system/masterdns.service /usr/local/bin/masterdns-server
            rm -rf /etc/masterdns
            systemctl daemon-reload
            echo -e "${GREEN}✓ MasterDnsVPN удален.${NC}"
            ;;
        3)
            systemctl stop cottendns masterdns 2>/dev/null || true
            systemctl disable cottendns masterdns 2>/dev/null || true
            rm -f /etc/systemd/system/cottendns.service /etc/systemd/system/masterdns.service
            rm -f /usr/local/bin/cottendns-server /usr/local/bin/masterdns-server
            rm -rf /etc/cottendns /etc/masterdns "$DNS_WAN_LOCK"
            iptables -D INPUT -i "$WAN_IF" -p udp --dport 53 -m comment --comment "DNS_WAN_BLOCK" -j DROP 2>/dev/null || true
            iptables -D INPUT -i "$WAN_IF" -p tcp --dport 53 -m comment --comment "DNS_WAN_BLOCK" -j DROP 2>/dev/null || true
            systemctl daemon-reload
            echo -e "${GREEN}✓ Все DNS-туннели удалены и настройки очищены.${NC}"
            ;;
        *) return ;;
    esac
    sleep 2
}

menu_dns_manage_engines() {
    clear
    echo -e "${CYAN}╔══════════════════════════════════════════════════════════════════════╗${NC}"
    echo -e "${CYAN}║${BOLD}          УПРАВЛЕНИЕ УСТАНОВКОЙ И УДАЛЕНИЕМ ДВИЖКОВ DNS               ${CYAN}║${NC}"
    echo -e "${CYAN}╚══════════════════════════════════════════════════════════════════════╝${NC}"
    echo ""
    echo -e "  Статус MasterDnsVPN: $([ -f "$MASTERDNS_BIN" ] && echo -e "${GREEN}Установлен${NC}" || echo -e "${RED}Не установлен${NC}")"
    echo -e "  Статус CottenDNS:    $([ -f "$COTTEN_BIN" ] && echo -e "${GREEN}Установлен${NC}" || echo -e "${RED}Не установлен${NC}")"
    echo ""
    echo -e "  ${YELLOW}[1]${NC} 🛡️  ${BOLD}Установить / Обновить MasterDnsVPN${NC} (Основной движок)"
    echo -e "  ${YELLOW}[2]${NC} 🚀 Установить / Обновить CottenDNS (Альтернативный WhiteDNS)"
    echo -e "  ${YELLOW}[3]${NC} 🗑️  Удалить DNS-сервисы"
    echo -e "  ${YELLOW}[0]${NC} ⬅️  Назад"
    echo ""
    read -p "Выберите вариант [0-3]: " eng_choice
    case "$eng_choice" in
        1) install_masterdns ;;
        2) install_cottendns ;;
        3) uninstall_dns ;;
        0) return ;;
    esac
}

show_dns_header() {
    clear
    local eng=$(get_active_dns_engine)
    local eng_name=$(get_dns_engine_name)
    local dom=$(get_dns_domain)
    local key=$(get_dns_key)
    local pname=$(get_dns_profile_name)
    echo -e "${CYAN}╔══════════════════════════════════════════════════════════════════════╗${NC}"
    echo -e "${CYAN}║${BOLD}          УПРАВЛЕНИЕ DNS-ТУННЕЛЯМИ (MASTERDNSVPN / COTTENDNS)         ${CYAN}║${NC}"
    echo -e "${CYAN}╠══════════════════════════════════════════════════════════════════════╣${NC}"
    echo -e "${CYAN}║${NC}  Сервер: ${BOLD}${SERVER_IP}${NC}  |  Статус: $(get_dns_status)"
    echo -e "${CYAN}║${NC}  Активный движок: ${BOLD}${eng_name}${NC}"
    echo -e "${CYAN}║${NC}  Домен:  ${CYAN}${BOLD}${dom}${NC}  |  Порт: ${BOLD}:53 (UDP/TCP)${NC}"
    echo -e "${CYAN}║${NC}  Имя:    ${YELLOW}${BOLD}${pname}${NC}  |  Доступ WAN: $(get_dns_wan_status)"
    echo -e "${CYAN}║${NC}  Ключ:   ${GREEN}${key:0:16}...${NC}  |  Маршрут: $(get_dns_routing)"
    echo -e "${CYAN}╚══════════════════════════════════════════════════════════════════════╝${NC}"
    echo ""
}

menu_dns() {
    if ! is_dns_installed; then
        clear
        echo -e "${YELLOW}╔══════════════════════════════════════════════════════════════════════╗${NC}"
        echo -e "${YELLOW}║${BOLD}                 DNS-ТУННЕЛИ НЕ ОБНАРУЖЕНЫ                            ${YELLOW}║${NC}"
        echo -e "${YELLOW}╚══════════════════════════════════════════════════════════════════════╝${NC}"
        echo ""
        echo -e "${RED}Ни MasterDnsVPN, ни CottenDNS не установлены на данном сервере.${NC}"
        echo ""
        echo -e "  ${YELLOW}[1]${NC} 🛡️  ${BOLD}Установить MasterDnsVPN${NC} (Основной движок по умолчанию - Рекомендуется)"
        echo -e "  ${YELLOW}[2]${NC} 🚀 ${BOLD}Установить CottenDNS${NC} (Альтернативный WhiteDNS Engine)"
        echo -e "  ${YELLOW}[0]${NC} ⬅️  Назад в Главное Меню"
        echo ""
        read -p "Выберите пункт [0-2]: " d_choice
        case "$d_choice" in
            1) install_masterdns ;;
            2) install_cottendns ;;
            *) return ;;
        esac
        return
    fi

    while true; do
        show_dns_header
        echo -e "  ${YELLOW}[1]${NC} 📱 ${BOLD}Показать 3 профиля подключения${NC} (stormdns:// ссылки + QR-коды)"
        echo -e "  ${YELLOW}[2]${NC} 🔄 ${BOLD}Переключить активный движок${NC} (CottenDNS <-> MasterDnsVPN)"
        echo -e "  ${YELLOW}[3]${NC} 🔒 ${BOLD}Включить / Выключить доступ из WAN${NC} (Блокировка порта 53 через iptables)"
        echo -e "  ${YELLOW}[4]${NC} ⚙️  ${BOLD}Настройки туннеля${NC} (Домен, Ключ, Маршрут Xray/Direct)"
        echo -e "  ${YELLOW}[5]${NC} 📜 Живые логи службы (journalctl)"
        echo -e "  ${YELLOW}[6]${NC} 🔄 Перезапустить DNS-службу"
        echo -e "  ${YELLOW}[7]${NC} ➕ Установить второй движок / Удалить DNS-туннель"
        echo -e "  ${YELLOW}[0]${NC} ⬅️  Назад в Главное Меню"
        echo ""
        read -p "Выберите пункт [0-7]: " top_d_choice
        case "$top_d_choice" in
            1) show_dns_profiles ;;
            2) switch_dns_engine ;;
            3) toggle_dns_wan ;;
            4) menu_dns_settings ;;
            5)
                local cur_s=$(get_active_dns_engine)
                journalctl -u "$cur_s" -f -n 50
                ;;
            6)
                local cur_s=$(get_active_dns_engine)
                echo -e "${YELLOW}Перезапуск службы $cur_s...${NC}"
                systemctl restart "$cur_s"
                sleep 2
                echo -e "${GREEN}✓ Служба $cur_s перезапущена${NC}"
                sleep 1
                ;;
            7) menu_dns_manage_engines ;;
            0) return ;;
        esac
    done
}

# ==============================================================================
# РАЗДЕЛ 5: ОБЩИЙ СТАТУС И ИНВЕНТАРИЗАЦИЯ ВСЕХ СЛУЖБ
# ==============================================================================
rescan_and_adopt_protocols() {
    clear
    echo -e "${CYAN}╔══════════════════════════════════════════════════════════════════════╗${NC}"
    echo -e "${CYAN}║${BOLD}      ИНВЕНТАРИЗАЦИЯ И ПОДХВАТ УСТАНОВЛЕННЫХ ПРОТОКОЛОВ               ${CYAN}║${NC}"
    echo -e "${CYAN}╚══════════════════════════════════════════════════════════════════════╝${NC}"
    echo ""
    echo -e "${YELLOW}Сканирование системы на наличие установленных протоколов и служб...${NC}"
    echo ""

    systemctl daemon-reload 2>/dev/null || true

    local count=0

    # Snell
    if is_snell_installed; then
        [ ! -L "/usr/local/bin/x-snell" ] && ln -sf /usr/local/bin/x-manager /usr/local/bin/x-snell 2>/dev/null || true
        echo -e "  ${GREEN}[✓] Snell v5${NC}:           Обнаружен! $(get_snell_status) | Порт: $(get_snell_port)"
        count=$((count + 1))
    else
        echo -e "  ${RED}[✗] Snell v5${NC}:           Не установлен"
    fi

    # Mieru
    if is_mieru_installed; then
        [ ! -L "/usr/local/bin/x-mieru" ] && ln -sf /usr/local/bin/x-manager /usr/local/bin/x-mieru 2>/dev/null || true
        echo -e "  ${GREEN}[✓] Mieru (mita)${NC}:       Обнаружен! $(get_mieru_status) | Порты: $(get_mieru_ports)"
        count=$((count + 1))
    else
        echo -e "  ${RED}[✗] Mieru (mita)${NC}:       Не установлен"
    fi

    # WDTT
    if is_wdtt_installed; then
        [ ! -L "/usr/local/bin/x-wdtt" ] && ln -sf /usr/local/bin/x-manager /usr/local/bin/x-wdtt 2>/dev/null || true
        [ ! -L "/usr/local/bin/x-qwdtt" ] && ln -sf /usr/local/bin/x-manager /usr/local/bin/x-qwdtt 2>/dev/null || true
        echo -e "  ${GREEN}[✓] WDTT / qwdtt${NC}:       Обнаружен! $(get_wdtt_status) | Порты: 56000-56003"
        count=$((count + 1))
    else
        echo -e "  ${RED}[✗] WDTT / qwdtt${NC}:       Не установлен"
    fi

    # CSQTT
    if is_csqtt_installed; then
        [ ! -L "/usr/local/bin/x-csqtt" ] && ln -sf /usr/local/bin/x-manager /usr/local/bin/x-csqtt 2>/dev/null || true
        echo -e "  ${GREEN}[✓] CSQTT${NC}:              Обнаружен! $(get_csqtt_status) | Панель: :$(get_csqtt_web_port)"
        count=$((count + 1))
    else
        echo -e "  ${RED}[✗] CSQTT${NC}:              Не установлен"
    fi

    # Firewall aliases
    [ ! -L "/usr/local/bin/x-fw" ] && ln -sf /usr/local/bin/x-manager /usr/local/bin/x-fw 2>/dev/null || true
    [ ! -L "/usr/local/bin/x-firewall" ] && ln -sf /usr/local/bin/x-manager /usr/local/bin/x-firewall 2>/dev/null || true

    # MasterDnsVPN adoption if binary is in /opt/masterdnsvpn
    if [ ! -f "$MASTERDNS_BIN" ] && [ -d "/opt/masterdnsvpn" ]; then
        local found_m=$(find /opt/masterdnsvpn -maxdepth 1 -type f -name "MasterDnsVPN_Server_Linux_*" 2>/dev/null | head -n 1)
        if [ -n "$found_m" ] && [ -f "$found_m" ]; then
            ln -sf "$found_m" "$MASTERDNS_BIN"
            chmod +x "$MASTERDNS_BIN"
            mkdir -p /etc/masterdns
            [ ! -f "$MASTERDNS_CONFIG_FILE" ] && [ -f "/opt/masterdnsvpn/server_config.toml" ] && cp /opt/masterdnsvpn/server_config.toml "$MASTERDNS_CONFIG_FILE"
            [ ! -f "$MASTERDNS_KEY_FILE" ] && [ -f "/opt/masterdnsvpn/encrypt_key.txt" ] && cp /opt/masterdnsvpn/encrypt_key.txt "$MASTERDNS_KEY_FILE"
        fi
    fi

    # CottenDNS
    if is_cottendns_installed; then
        [ ! -L "/usr/local/bin/x-dns" ] && ln -sf /usr/local/bin/x-manager /usr/local/bin/x-dns 2>/dev/null || true
        [ ! -L "/usr/local/bin/x-cottendns" ] && ln -sf /usr/local/bin/x-manager /usr/local/bin/x-cottendns 2>/dev/null || true
        local c_st="ОСТАНОВЛЕН"
        systemctl is-active --quiet cottendns 2>/dev/null && c_st="АКТИВЕН"
        echo -e "  ${GREEN}[✓] CottenDNS${NC}:          Обнаружен! ${c_st}"
        count=$((count + 1))
    else
        echo -e "  ${RED}[✗] CottenDNS${NC}:          Не установлен"
    fi

    # MasterDnsVPN
    if is_masterdns_installed; then
        [ ! -L "/usr/local/bin/x-dns" ] && ln -sf /usr/local/bin/x-manager /usr/local/bin/x-dns 2>/dev/null || true
        [ ! -L "/usr/local/bin/x-masterdns" ] && ln -sf /usr/local/bin/x-manager /usr/local/bin/x-masterdns 2>/dev/null || true
        local m_st="ОСТАНОВЛЕН (В РЕЗЕРВЕ)"
        systemctl is-active --quiet masterdns 2>/dev/null && m_st="АКТИВЕН"
        echo -e "  ${GREEN}[✓] MasterDnsVPN${NC}:       Обнаружен! ${m_st}"
        count=$((count + 1))
    else
        echo -e "  ${RED}[✗] MasterDnsVPN${NC}:       Не установлен"
    fi

    # Автоматическая синхронизация правил фаервола ACCEPT для активных протоколов
    sync_active_firewall_rules

    local base_d=$(detect_base_domain)
    echo ""
    echo -e "  ${BOLD}Базовый домен сервера:${NC} ${GREEN}${base_d:-не определен}${NC}"
    if [ -n "$base_d" ]; then
        echo -e "  ${BOLD}DNS-зона для туннелей:${NC} ${CYAN}d.${base_d}${NC}"
    fi

    echo ""
    echo -e "${GREEN}✓ Протоколы подхвачены и зарегистрированы в x-manager (всего: ${count})${NC}"
    echo -e "  Все статусы в Главном Меню синхронизированы."
    echo ""
    read -p "Нажмите Enter для возврата..."
}

view_global_status() {
    clear
    echo -e "${CYAN}╔══════════════════════════════════════════════════════════════════════╗${NC}"
    echo -e "${CYAN}║${BOLD}          СВОДНЫЙ СТАТУС ВСЕХ СЕТЕВЫХ СЛУЖБ И ШЛЮЗА                ${CYAN}║${NC}"
    echo -e "${CYAN}╠══════════════════════════════════════════════════════════════════════╣${NC}"
    echo -e "${CYAN}║${NC}  Сервер: ${BOLD}${SERVER_IP}${NC}"
    echo -e "${CYAN}╚══════════════════════════════════════════════════════════════════════╝${NC}"
    echo ""
    echo -e "${BOLD}--- Статус служб и маршрутизации ---${NC}"
    printf "  %-22s %-25b [Маршрут: %b]\n" "Mieru (mita):" "$(get_mieru_status)" "$(get_mieru_routing)"
    printf "  %-22s %-25b [Маршрут: %b]\n" "Snell (v5):" "$(get_snell_status)" "$(get_snell_routing)"
    printf "  %-22s %-25b [Маршрут: %b]\n" "WDTT (qwdtt):" "$(get_wdtt_status)" "$(get_wdtt_routing)"
    if is_csqtt_installed; then
        printf "  %-22s %-25b [Панель :%s | %b]\n" "CSQTT (VPN Server):" "$(get_csqtt_status)" "$(get_csqtt_web_port)" "$(get_csqtt_protect_status)"
    else
        printf "  %-22s %-25b\n" "CSQTT (VPN Server):" "$(get_csqtt_status)"
    fi
    if is_dns_installed; then
        printf "  %-22s %-25b [Зона: %s:53 | %b]\n" "DNS-Туннель:" "$(get_dns_status)" "$(get_dns_domain)" "$(get_dns_wan_status)"
    else
        printf "  %-22s %-25b\n" "DNS-Туннель:" "$(get_dns_status)"
    fi
    printf "  %-22s %s\n" "Xray Core (3X-UI):" "$(systemctl is-active x-ui 2>/dev/null || echo 'inactive')"
    echo ""
    echo -e "${BOLD}--- Системные оптимизации и безопасность ---${NC}"
    printf "  %-22s %-25b\n" "Системный DNS:" "$(get_sys_dns_short)"
    printf "  %-22s %-25b\n" "TCP BBR & Очередь:" "$(get_bbr_short_status)"
    printf "  %-22s %-25b\n" "Файл подкачки (Swap):" "$(get_swap_short_status)"
    printf "  %-22s %-25b\n" "Fail2ban (Защита SSH):" "$(get_f2b_short_status)"
    echo ""
    echo -e "${BOLD}--- Внутренние шлюзы ядра Xray (Вход для прокси-служб) ---${NC}"
    echo -e "  • ${CYAN}TPROXY (прозрачный шлюз):${NC} 127.0.0.1:12345 (TCP/UDP) ${GREEN}[Локально / Извне ЗАКРЫТ 🔒]${NC}"
    echo -e "  • ${CYAN}SOCKS5 вход ядра:${NC}         127.0.0.1:10808 (TCP)     ${GREEN}[Локально / Извне ЗАКРЫТ 🔒]${NC}"
    echo -e "  • ${CYAN}Dokodemo REDIRECT:${NC}       127.0.0.1:12346 (TCP)     ${GREEN}[Локально / Вход для Snell 🔒]${NC}"
    echo ""
    echo -e "${BOLD}--- Открытые прослушиваемые порты ---${NC}"
    echo -e "${YELLOW}TCP порты:${NC}"
    ss -tlpn | grep -E 'mita|snell|xray|wdtt|csqtt|cottendns|masterdns|sshd' | awk '{printf "  %-6s %-22s %-25s\n", $1, $4, $NF}'
    echo ""
    echo -e "${YELLOW}UDP порты:${NC}"
    ss -ulpn | grep -E 'mita|snell|xray|wdtt|csqtt|cottendns|masterdns' | head -n 16 | awk '{printf "  %-6s %-22s %-25s\n", $1, $4, $NF}'
    echo ""
    read -p "Нажмите Enter для возврата..."
}

restart_all_services() {
    clear
    echo -e "${YELLOW}Перезапуск всех сетевых служб (Mieru, Snell, WDTT, CSQTT, DNS)...${NC}"
    systemctl restart mita 2>/dev/null || true
    systemctl restart snell 2>/dev/null || true
    systemctl restart wdtt 2>/dev/null || true
    if is_csqtt_installed; then
        systemctl restart csqtt 2>/dev/null || true
    fi
    if is_dns_installed; then
        local cur_dns=$(get_active_dns_engine)
        systemctl restart "$cur_dns" 2>/dev/null || true
    fi
    sleep 2
    echo -e "Mieru: $(get_mieru_status)"
    echo -e "Snell: $(get_snell_status)"
    echo -e "WDTT:  $(get_wdtt_status)"
    if is_csqtt_installed; then
        echo -e "CSQTT: $(get_csqtt_status)"
    fi
    if is_dns_installed; then
        echo -e "DNS:   $(get_dns_status)"
    fi
    sync_active_firewall_rules
    sleep 2
}


# ==============================================================================
# ВСПОМОГАТЕЛЬНЫЕ ФУНКЦИИ: СИСТЕМНЫЙ СТАТУС (DNS, BBR, SWAP, FAIL2BAN)
# ==============================================================================
get_sys_dns_short() {
    local dns_list=$(grep -E "^nameserver" /etc/resolv.conf 2>/dev/null | awk '{print $2}' | tr '\n' ' ' | sed 's/ $//')
    [ -z "$dns_list" ] && dns_list="Не определен"
    echo "$dns_list"
}

get_bbr_short_status() {
    local cc=$(sysctl -n net.ipv4.tcp_congestion_control 2>/dev/null || echo "unknown")
    local qd=$(sysctl -n net.core.default_qdisc 2>/dev/null || echo "unknown")
    if [ "$cc" = "bbr" ]; then
        echo -e "${GREEN}BBR (${qd}+${cc})${NC}"
    else
        echo -e "${YELLOW}${cc} (Не оптим.)${NC}"
    fi
}

get_swap_short_status() {
    local sw_total=$(free -m 2>/dev/null | awk '/^Swap:/{print $2}')
    if [ -n "$sw_total" ] && [ "$sw_total" -gt 0 ]; then
        local sw_h=$(free -h 2>/dev/null | awk '/^Swap:/{print $2}')
        local sw_u=$(free -h 2>/dev/null | awk '/^Swap:/{print $3}')
        echo -e "${GREEN}${sw_h}${NC} (занято ${sw_u})"
    else
        echo -e "${YELLOW}НЕТ SWAP${NC}"
    fi
}

get_f2b_short_status() {
    if ! which fail2ban-client >/dev/null 2>&1; then
        echo -e "${RED}НЕ УСТАНОВЛЕН${NC}"
    elif systemctl is-active --quiet fail2ban; then
        local j_cnt=$(fail2ban-client status 2>/dev/null | grep -E "Number of jail:" | awk '{print $NF}')
        [ -z "$j_cnt" ] && j_cnt="0"
        echo -e "${GREEN}АКТИВЕН (${j_cnt} jails)${NC}"
    else
        echo -e "${YELLOW}ОСТАНОВЛЕН${NC}"
    fi
}

# ------------------------------------------------------------------------------
# СИСТЕМНЫЙ DNS: ПАРАЛЛЕЛЬНЫЙ ПИНГ И ПРИМЕНЕНИЕ
# ------------------------------------------------------------------------------
ping_dns_target() {
    local ip="$1"
    local outfile="$2"
    local rtt=$(ping -c 2 -i 0.2 -W 1 "$ip" 2>/dev/null | awk -F'/' '/avg|rtt/{printf "%.1f ms", $5}')
    if [ -n "$rtt" ]; then
        echo "$rtt" > "$outfile"
    else
        if nc -z -u -w 1 "$ip" 53 2>/dev/null || (timeout 1 bash -c "echo >/dev/tcp/$ip/53") 2>/dev/null; then
            echo "Port 53 OK" > "$outfile"
        else
            echo "Таймаут" > "$outfile"
        fi
    fi
}

format_dns_ping() {
    local ping_val="$1"
    if [[ "$ping_val" =~ "Таймаут" ]]; then
        echo -e "${RED}[ Таймаут ]${NC}"
    elif [[ "$ping_val" =~ "Port 53" ]]; then
        echo -e "${CYAN}[ Порт 53 OK ]${NC}"
    elif [ -n "$ping_val" ]; then
        local ms_num=$(echo "$ping_val" | awk '{print int($1)}')
        if [ "$ms_num" -lt 15 ]; then
            echo -e "${GREEN}[ ${ping_val} ]${NC}"
        elif [ "$ms_num" -lt 50 ]; then
            echo -e "${CYAN}[ ${ping_val} ]${NC}"
        elif [ "$ms_num" -lt 100 ]; then
            echo -e "${YELLOW}[ ${ping_val} ]${NC}"
        else
            echo -e "${PURPLE}[ ${ping_val} ]${NC}"
        fi
    else
        echo -e "${YELLOW}[ Замер... ]${NC}"
    fi
}

apply_system_dns() {
    local p_dns="$1"
    local s_dns="$2"
    local desc="$3"

    clear
    echo -e "${BOLD}--- Применение системного DNS ---${NC}"
    echo -e "Выбран DNS: ${GREEN}${desc}${NC}"
    echo -e "  • Основной (Primary):   ${CYAN}${p_dns}${NC}"
    [ -n "$s_dns" ] && echo -e "  • Резервный (Secondary): ${CYAN}${s_dns}${NC}"
    echo ""

    chattr -i /etc/resolv.conf 2>/dev/null || true

    if [ ! -f /etc/resolv.conf.x-bak ]; then
        cp /etc/resolv.conf /etc/resolv.conf.x-bak 2>/dev/null || true
    fi

    # 1. systemd-resolved
    if systemctl is-active --quiet systemd-resolved 2>/dev/null; then
        mkdir -p /etc/systemd/resolved.conf.d
        cat > /etc/systemd/resolved.conf.d/99-xmanager-dns.conf <<EOF
[Resolve]
DNS=${p_dns} ${s_dns}
FallbackDNS=1.1.1.1 8.8.8.8
Domains=~.
DNSSEC=allow-downgrade
DNSOverTLS=no
EOF
        systemctl restart systemd-resolved 2>/dev/null || true
        local def_if=$(ip route show default 2>/dev/null | awk '{print $5}' | head -n1)
        if [ -n "$def_if" ] && which resolvectl >/dev/null 2>&1; then
            resolvectl dns "$def_if" $p_dns $s_dns 2>/dev/null || true
            resolvectl default-route "$def_if" true 2>/dev/null || true
        fi
    fi

    # 2. Прямая запись в /etc/resolv.conf
    [ -L /etc/resolv.conf ] && rm -f /etc/resolv.conf
    cat > /etc/resolv.conf <<EOF
# Generated by x-manager system optimizer
nameserver ${p_dns}
EOF
    [ -n "$s_dns" ] && echo "nameserver ${s_dns}" >> /etc/resolv.conf
    cat >> /etc/resolv.conf <<EOF
options timeout:2 attempts:2
EOF

    # 3. Фиксация в dhclient.conf
    if [ -d /etc/dhcp ]; then
        local dh_conf="/etc/dhcp/dhclient.conf"
        [ -f "$dh_conf" ] && sed -i '/supersede domain-name-servers/d' "$dh_conf"
        if [ -n "$s_dns" ]; then
            echo "supersede domain-name-servers ${p_dns}, ${s_dns};" >> "$dh_conf" 2>/dev/null || true
        else
            echo "supersede domain-name-servers ${p_dns};" >> "$dh_conf" 2>/dev/null || true
        fi
    fi

    mkdir -p /etc/x-manager 2>/dev/null || true
    echo "${desc}|${p_dns}|${s_dns}" > /etc/x-manager/dns_profile.txt

    sleep 1
    echo -e "${YELLOW}Тестирование разрешения доменных имён...${NC}"
    local ya_ip=$(getent ahostsv4 ya.ru 2>/dev/null | awk '{print $1}' | head -n1)
    local goog_ip=$(getent ahostsv4 google.com 2>/dev/null | awk '{print $1}' | head -n1)

    if [ -n "$ya_ip" ] || [ -n "$goog_ip" ]; then
        echo -e "${GREEN}✓ Системный DNS успешно применён и работает!${NC}"
        [ -n "$ya_ip" ] && echo -e "  • ya.ru       -> ${GREEN}${ya_ip}${NC}"
        [ -n "$goog_ip" ] && echo -e "  • google.com  -> ${GREEN}${goog_ip}${NC}"
    else
        echo -e "${RED}⚠️ Внимание: доменные имена не разрешаются через выбранный DNS!${NC}"
        echo -e "${YELLOW}Возможно, провайдер или фаервол блокирует порт 53 UDP.${NC}"
    fi
    echo ""
    read -p "Нажмите Enter для продолжения..."
}

menu_dns_russian() {
    clear
    echo -e "${BOLD}--- Выбор системного DNS (Серверы в России) ---${NC}"
    echo -e "${YELLOW}⏳ Замер задержки (пинг) до российских DNS-серверов...${NC}"

    local tmpdir=$(mktemp -d /tmp/x_dns_ping.XXXXXX)
    ping_dns_target "77.88.8.8" "$tmpdir/p1" &
    ping_dns_target "77.88.8.88" "$tmpdir/p2" &
    ping_dns_target "77.88.8.7" "$tmpdir/p3" &
    ping_dns_target "193.58.251.251" "$tmpdir/p4" &
    ping_dns_target "83.220.169.155" "$tmpdir/p5" &
    ping_dns_target "195.34.32.116" "$tmpdir/p6" &
    wait

    local p1=$(cat "$tmpdir/p1" 2>/dev/null)
    local p2=$(cat "$tmpdir/p2" 2>/dev/null)
    local p3=$(cat "$tmpdir/p3" 2>/dev/null)
    local p4=$(cat "$tmpdir/p4" 2>/dev/null)
    local p5=$(cat "$tmpdir/p5" 2>/dev/null)
    local p6=$(cat "$tmpdir/p6" 2>/dev/null)
    rm -rf "$tmpdir"

    clear
    echo -e "${CYAN}╔══════════════════════════════════════════════════════════════════════╗${NC}"
    echo -e "${CYAN}║${BOLD}             РОССИЙСКИЕ СИСТЕМНЫЕ DNS-СЕРВЕРЫ (IPv4 :53)              ${CYAN}║${NC}"
    echo -e "${CYAN}╠══════════════════════════════════════════════════════════════════════╣${NC}"
    echo -e "${CYAN}║${NC}  Текущие DNS: ${GREEN}$(get_sys_dns_short)${NC}"
    echo -e "${CYAN}╚══════════════════════════════════════════════════════════════════════╝${NC}"
    echo ""
    printf "  ${YELLOW}[1]${NC} %-19s %-32s %-18b %s\n" "Yandex DNS" "77.88.8.8 / 77.88.8.1" "$(format_dns_ping "$p1")" "(Обычный, быстрый Anycast)"
    printf "  ${YELLOW}[2]${NC} %-19s %-32s %-18b %s\n" "Yandex DNS Safe" "77.88.8.88 / 77.88.8.2" "$(format_dns_ping "$p2")" "(Фильтрация опасных сайтов)"
    printf "  ${YELLOW}[3]${NC} %-19s %-32s %-18b %s\n" "Yandex Family" "77.88.8.7 / 77.88.8.3" "$(format_dns_ping "$p3")" "(Семейная фильтрация)"
    printf "  ${YELLOW}[4]${NC} %-19s %-32s %-18b %s\n" "SkyDNS" "193.58.251.251" "$(format_dns_ping "$p4")" "(Российский DNS, фильтрация)"
    printf "  ${YELLOW}[5]${NC} %-19s %-32s %-18b %s\n" "Comss.one DNS" "83.220.169.155 / 212.109.195.93" "$(format_dns_ping "$p5")" "(Узел в Москве + резерв)"
    printf "  ${YELLOW}[6]${NC} %-19s %-32s %-18b %s\n" "MTS DNS" "195.34.32.116 / 212.188.4.10" "$(format_dns_ping "$p6")" "(Операторский DNS МТС)"
    echo ""
    echo -e "  ${YELLOW}[0]${NC} Назад"
    echo ""
    read -p "Выберите DNS-сервер [0-6]: " ru_choice
    case "$ru_choice" in
        1) apply_system_dns "77.88.8.8" "77.88.8.1" "Yandex DNS" ;;
        2) apply_system_dns "77.88.8.88" "77.88.8.2" "Yandex DNS Safe" ;;
        3) apply_system_dns "77.88.8.7" "77.88.8.3" "Yandex Family" ;;
        4) apply_system_dns "193.58.251.251" "193.58.251.252" "SkyDNS" ;;
        5) apply_system_dns "83.220.169.155" "212.109.195.93" "Comss.one DNS" ;;
        6) apply_system_dns "195.34.32.116" "212.188.4.10" "MTS DNS" ;;
        0) return ;;
        *) echo "Неверный выбор"; sleep 1 ;;
    esac
}

menu_dns_foreign() {
    clear
    echo -e "${BOLD}--- Выбор системного DNS (Зарубежные серверы) ---${NC}"
    echo -e "${YELLOW}⏳ Замер задержки (пинг) до зарубежных DNS-серверов...${NC}"

    local tmpdir=$(mktemp -d /tmp/x_dns_ping.XXXXXX)
    ping_dns_target "1.1.1.1" "$tmpdir/p1" &
    ping_dns_target "8.8.8.8" "$tmpdir/p2" &
    ping_dns_target "9.9.9.9" "$tmpdir/p3" &
    ping_dns_target "76.76.2.0" "$tmpdir/p4" &
    ping_dns_target "94.140.14.140" "$tmpdir/p5" &
    ping_dns_target "208.67.222.222" "$tmpdir/p6" &
    ping_dns_target "8.26.56.26" "$tmpdir/p7" &
    ping_dns_target "185.228.168.9" "$tmpdir/p8" &
    ping_dns_target "195.46.39.39" "$tmpdir/p9" &
    ping_dns_target "64.6.64.6" "$tmpdir/p10" &
    wait

    local p1=$(cat "$tmpdir/p1" 2>/dev/null)
    local p2=$(cat "$tmpdir/p2" 2>/dev/null)
    local p3=$(cat "$tmpdir/p3" 2>/dev/null)
    local p4=$(cat "$tmpdir/p4" 2>/dev/null)
    local p5=$(cat "$tmpdir/p5" 2>/dev/null)
    local p6=$(cat "$tmpdir/p6" 2>/dev/null)
    local p7=$(cat "$tmpdir/p7" 2>/dev/null)
    local p8=$(cat "$tmpdir/p8" 2>/dev/null)
    local p9=$(cat "$tmpdir/p9" 2>/dev/null)
    local p10=$(cat "$tmpdir/p10" 2>/dev/null)
    rm -rf "$tmpdir"

    clear
    echo -e "${CYAN}╔══════════════════════════════════════════════════════════════════════╗${NC}"
    echo -e "${CYAN}║${BOLD}             ЗАРУБЕЖНЫЕ СИСТЕМНЫЕ DNS-СЕРВЕРЫ (IPv4 :53)               ${CYAN}║${NC}"
    echo -e "${CYAN}╠══════════════════════════════════════════════════════════════════════╣${NC}"
    echo -e "${CYAN}║${NC}  Текущие DNS: ${GREEN}$(get_sys_dns_short)${NC}"
    echo -e "${CYAN}╚══════════════════════════════════════════════════════════════════════╝${NC}"
    echo ""
    printf "  ${YELLOW}[1]${NC}  %-22s %-32s %-18b %s\n" "Cloudflare" "1.1.1.1 / 1.0.0.1" "$(format_dns_ping "$p1")" "(Без фильтрации, ультрабыстрый)"
    printf "  ${YELLOW}[2]${NC}  %-22s %-32s %-18b %s\n" "Google Public DNS" "8.8.8.8 / 8.8.4.4" "$(format_dns_ping "$p2")" "(Без фильтрации, глобальный)"
    printf "  ${YELLOW}[3]${NC}  %-22s %-32s %-18b %s\n" "Quad9" "9.9.9.9 / 149.112.112.112" "$(format_dns_ping "$p3")" "(Защита от malware / фишинга)"
    printf "  ${YELLOW}[4]${NC}  %-22s %-32s %-18b %s\n" "Control D" "76.76.2.0 / 76.76.10.0" "$(format_dns_ping "$p4")" "(Без фильтрации, Anycast)"
    printf "  ${YELLOW}[5]${NC}  %-22s %-32s %-18b %s\n" "AdGuard Non-filtering" "94.140.14.140 / 94.140.14.141" "$(format_dns_ping "$p5")" "(Без фильтрации рекламы)"
    printf "  ${YELLOW}[6]${NC}  %-22s %-32s %-18b %s\n" "OpenDNS" "208.67.222.222 / 208.67.220.220" "$(format_dns_ping "$p6")" "(Защитные функции Cisco)"
    printf "  ${YELLOW}[7]${NC}  %-22s %-32s %-18b %s\n" "Comodo Secure DNS" "8.26.56.26 / 8.20.247.20" "$(format_dns_ping "$p7")" "(Безопасность Comodo)"
    printf "  ${YELLOW}[8]${NC}  %-22s %-32s %-18b %s\n" "CleanBrowsing Security" "185.228.168.9 / 185.228.169.9" "$(format_dns_ping "$p8")" "(Malware / Phishing защита)"
    printf "  ${YELLOW}[9]${NC}  %-22s %-32s %-18b %s\n" "SafeDNS" "195.46.39.39 / 195.46.39.40" "$(format_dns_ping "$p9")" "(Фильтрация сетевых угроз)"
    printf "  ${YELLOW}[10]${NC} %-22s %-32s %-18b %s\n" "Verisign / Vercara" "64.6.64.6 / 64.6.65.6" "$(format_dns_ping "$p10")" "(Базовый надёжный DNS)"
    echo ""
    echo -e "  ${YELLOW}[0]${NC}  Назад"
    echo ""
    read -p "Выберите DNS-сервер [0-10]: " for_choice
    case "$for_choice" in
        1) apply_system_dns "1.1.1.1" "1.0.0.1" "Cloudflare" ;;
        2) apply_system_dns "8.8.8.8" "8.8.4.4" "Google Public DNS" ;;
        3) apply_system_dns "9.9.9.9" "149.112.112.112" "Quad9" ;;
        4) apply_system_dns "76.76.2.0" "76.76.10.0" "Control D" ;;
        5) apply_system_dns "94.140.14.140" "94.140.14.141" "AdGuard Non-filtering" ;;
        6) apply_system_dns "208.67.222.222" "208.67.220.220" "OpenDNS" ;;
        7) apply_system_dns "8.26.56.26" "8.20.247.20" "Comodo Secure DNS" ;;
        8) apply_system_dns "185.228.168.9" "185.228.169.9" "CleanBrowsing Security" ;;
        9) apply_system_dns "195.46.39.39" "195.46.39.40" "SafeDNS" ;;
        10) apply_system_dns "64.6.64.6" "64.6.65.6" "Verisign / Vercara" ;;
        0) return ;;
        *) echo "Неверный выбор"; sleep 1 ;;
    esac
}

reset_system_dns() {
    clear
    echo -e "${BOLD}--- Сброс системного DNS ---${NC}"
    read -p "Сбросить DNS на исходные настройки? [y/N]: " conf_res
    [[ ! "$conf_res" =~ ^[yY]$ ]] && return

    chattr -i /etc/resolv.conf 2>/dev/null || true
    rm -f /etc/systemd/resolved.conf.d/99-xmanager-dns.conf 2>/dev/null || true
    rm -f /etc/x-manager/dns_profile.txt 2>/dev/null || true

    if [ -f /etc/resolv.conf.x-bak ]; then
        cp /etc/resolv.conf.x-bak /etc/resolv.conf
        echo -e "${GREEN}✓ Восстановлен исходный /etc/resolv.conf${NC}"
    else
        cat > /etc/resolv.conf <<EOF
nameserver 1.1.1.1
nameserver 8.8.8.8
EOF
        echo -e "${GREEN}✓ Установлен стандартный fallback DNS (1.1.1.1, 8.8.8.8)${NC}"
    fi

    systemctl restart systemd-resolved 2>/dev/null || true
    sleep 1
    echo -e "Текущие DNS: ${GREEN}$(get_sys_dns_short)${NC}"
    read -p "Нажмите Enter для возврата..."
}

menu_dns_system() {
    while true; do
        clear
        echo -e "${CYAN}╔══════════════════════════════════════════════════════════════════════╗${NC}"
        echo -e "${CYAN}║${BOLD}              УПРАВЛЕНИЕ СИСТЕМНЫМ DNS СЕРВЕРА                        ${CYAN}║${NC}"
        echo -e "${CYAN}╠══════════════════════════════════════════════════════════════════════╣${NC}"
        echo -e "${CYAN}║${NC}  Текущие системные DNS: ${GREEN}${BOLD}$(get_sys_dns_short)${NC}"
        local active_prof="Пользовательский"
        [ -f /etc/x-manager/dns_profile.txt ] && active_prof=$(cat /etc/x-manager/dns_profile.txt | awk -F'|' '{print $1}')
        echo -e "${CYAN}║${NC}  Активный профиль:      ${CYAN}${active_prof}${NC}"
        echo -e "${CYAN}╚══════════════════════════════════════════════════════════════════════╝${NC}"
        echo ""
        echo -e "  ${YELLOW}[1]${NC} 🇷🇺 ${BOLD}Российские DNS-серверы${NC} (Yandex, Safe, Family, SkyDNS, Comss, MTS)"
        echo -e "  ${YELLOW}[2]${NC} 🌍 ${BOLD}Зарубежные DNS-серверы${NC} (Cloudflare, Google, Quad9, Control D, AdGuard...)"
        echo -e "  ${YELLOW}[3]${NC} ✍️  ${BOLD}Указать свой DNS вручную${NC} (Primary + Secondary IPv4)"
        echo -e "  ${YELLOW}[4]${NC} 🔄 ${BOLD}Сбросить DNS на стандартный${NC} (DHCP / от провайдера)"
        echo -e "  ${YELLOW}[5]${NC} 🧪 ${BOLD}Тест разрешения доменов${NC} (Проверка ya.ru и google.com)"
        echo -e "  ${YELLOW}[0]${NC} Назад"
        echo ""
        read -p "Выберите раздел [0-5]: " dns_top_ch
        case "$dns_top_ch" in
            1) menu_dns_russian ;;
            2) menu_dns_foreign ;;
            3)
                clear
                echo -e "${BOLD}--- Ручной ввод системных DNS ---${NC}"
                read -p "Введите основной DNS (Primary IPv4): " custom_p
                [ -z "$custom_p" ] && continue
                read -p "Введите резервный DNS (Secondary IPv4, можно оставить пустым): " custom_s
                apply_system_dns "$custom_p" "$custom_s" "Ручной ввод"
                ;;
            4) reset_system_dns ;;
            5)
                clear
                echo -e "${BOLD}--- Тест разрешения доменов через текущий системный DNS ---${NC}"
                echo -e "Текущие DNS: ${CYAN}$(get_sys_dns_short)${NC}"
                echo ""
                echo -e "Тестирование ya.ru..."
                local t_ya=$(getent ahostsv4 ya.ru 2>/dev/null | head -n2)
                [ -n "$t_ya" ] && echo -e "${GREEN}✓ ya.ru разрешен:${NC}\n$t_ya" || echo -e "${RED}✗ ya.ru не разрешился!${NC}"
                echo ""
                echo -e "Тестирование google.com..."
                local t_goog=$(getent ahostsv4 google.com 2>/dev/null | head -n2)
                [ -n "$t_goog" ] && echo -e "${GREEN}✓ google.com разрешен:${NC}\n$t_goog" || echo -e "${RED}✗ google.com не разрешился!${NC}"
                echo ""
                read -p "Нажмите Enter для возврата..."
                ;;
            0) return ;;
            *) echo "Неверный выбор"; sleep 1 ;;
        esac
    done
}

# ------------------------------------------------------------------------------
# BBR И СЕТЕВЫЕ БУФЕРЫ (ТЮНИНГ ПОД RAM)
# ------------------------------------------------------------------------------
apply_adaptive_bbr_tuning() {
    clear
    echo -e "${BOLD}--- Адаптивная оптимизация сетевых буферов и TCP BBR ---${NC}"
    local ram_mb=$(free -m | awk '/^Mem:/{print $2}')
    echo -e "Обнаружен объём оперативной памяти: ${CYAN}${ram_mb} MB${NC}"

    local rmem=16777216
    local wmem=16777216
    local somax=8192
    local syn_backlog=8192
    local tw_buckets=200000
    local prof_name="Standard Proxy VPS (1.5G - 4G)"

    if [ "$ram_mb" -lt 1500 ]; then
        prof_name="Low RAM VPS (до 1.5 ГБ)"
        rmem=8388608
        wmem=8388608
        somax=4096
        syn_backlog=4096
        tw_buckets=50000
    elif [ "$ram_mb" -gt 5000 ]; then
        prof_name="High Performance Server (> 4 ГБ)"
        rmem=33554432
        wmem=33554432
        somax=32768
        syn_backlog=16384
        tw_buckets=500000
    fi

    echo -e "Выбран оптимизационный профиль: ${GREEN}${prof_name}${NC}"
    echo -e "  • Алгоритм контроля перегрузки: ${BOLD}BBR + FQ${NC}"
    echo -e "  • Буферы сокетов rmem/wmem:     ${BOLD}$((rmem / 1048576)) MB${NC}"
    echo -e "  • Лимит очереди соединений:     ${BOLD}somaxconn = ${somax}${NC}"
    echo -e "  • TCP Fast Open:                ${BOLD}3 (Включен для входящих и исходящих)${NC}"
    echo ""

    modprobe tcp_bbr 2>/dev/null || true
    echo "tcp_bbr" > /etc/modules-load.d/bbr.conf 2>/dev/null || true

    [ -f /etc/sysctl.d/99-network-tuning.conf ] && cp /etc/sysctl.d/99-network-tuning.conf /etc/sysctl.d/99-network-tuning.conf.bak 2>/dev/null || true

    cat > /etc/sysctl.d/99-network-tuning.conf <<EOF
# Оптимизация сети и TCP BBR от x-manager
# Профиль: ${prof_name} (RAM: ${ram_mb} MB)

net.core.default_qdisc = fq
net.ipv4.tcp_congestion_control = bbr

net.core.rmem_max = ${rmem}
net.core.wmem_max = ${wmem}
net.core.rmem_default = 524288
net.core.wmem_default = 524288
net.ipv4.tcp_rmem = 4096 87380 ${rmem}
net.ipv4.tcp_wmem = 4096 65536 ${wmem}

net.core.somaxconn = ${somax}
net.core.netdev_max_backlog = 10000
net.ipv4.tcp_max_syn_backlog = ${syn_backlog}
net.ipv4.tcp_max_tw_buckets = ${tw_buckets}

net.ipv4.tcp_fastopen = 3
net.ipv4.tcp_tw_reuse = 1
net.ipv4.tcp_fin_timeout = 20
net.ipv4.tcp_slow_start_after_idle = 0
net.ipv4.tcp_keepalive_time = 300
net.ipv4.tcp_keepalive_intvl = 30
net.ipv4.tcp_keepalive_probes = 5
net.ipv4.tcp_mtu_probing = 1
fs.file-max = 1048576
EOF

    sysctl -p /etc/sysctl.d/99-network-tuning.conf >/dev/null 2>&1 || sysctl --system >/dev/null 2>&1

    sleep 1
    local new_cc=$(sysctl -n net.ipv4.tcp_congestion_control 2>/dev/null)
    local new_qd=$(sysctl -n net.core.default_qdisc 2>/dev/null)
    local new_tfo=$(sysctl -n net.ipv4.tcp_fastopen 2>/dev/null)

    echo -e "${GREEN}✓ Оптимизация успешно применена!${NC}"
    echo -e "  • Текущий алгоритм: ${GREEN}${new_cc}${NC} (очередь: ${GREEN}${new_qd}${NC})"
    echo -e "  • TCP Fast Open:    ${GREEN}${new_tfo}${NC}"
    echo -e "  • Конфиг сохранен в: ${CYAN}/etc/sysctl.d/99-network-tuning.conf${NC}"
    echo ""
    read -p "Нажмите Enter для возврата..."
}

menu_bbr_tuning() {
    while true; do
        clear
        local cur_cc=$(sysctl -n net.ipv4.tcp_congestion_control 2>/dev/null || echo "неизвестно")
        local cur_qd=$(sysctl -n net.core.default_qdisc 2>/dev/null || echo "неизвестно")
        local ram_total=$(free -h 2>/dev/null | awk '/^Mem:/{print $2}')
        local ram_mb=$(free -m 2>/dev/null | awk '/^Mem:/{print $2}')
        local cpus=$(nproc 2>/dev/null || echo "1")
        local kern=$(uname -r)

        echo -e "${CYAN}╔══════════════════════════════════════════════════════════════════════╗${NC}"
        echo -e "${CYAN}║${BOLD}         BBR И АДАПТИВНАЯ ОПТИМИЗАЦИЯ СЕТЕВЫХ БУФЕРОВ           ${CYAN}║${NC}"
        echo -e "${CYAN}╠══════════════════════════════════════════════════════════════════════╣${NC}"
        echo -e "${CYAN}║${NC}  Сервер:   ${BOLD}${SERVER_IP}${NC}  |  CPU: ${BOLD}${cpus} ядра${NC}  |  RAM: ${BOLD}${ram_total}${NC}  |  Ядро: ${kern}"
        echo -e "${CYAN}║${NC}"
        if [ "$cur_cc" = "bbr" ] && [ "$cur_qd" = "fq" ]; then
            echo -e "${CYAN}║${NC}  Статус BBR:      ${GREEN}${BOLD}✓ BBR АКТИВЕН (контроль: bbr, очередь: fq)${NC}"
        elif [ "$cur_cc" = "bbr" ]; then
            echo -e "${CYAN}║${NC}  Статус BBR:      ${GREEN}${BOLD}✓ BBR активен${NC} (очередь: ${cur_qd})"
        else
            echo -e "${CYAN}║${NC}  Статус BBR:      ${YELLOW}⚠ ВЫКЛЮЧЕН (алгоритм: ${cur_cc}, очередь: ${cur_qd})${NC}"
        fi
        echo -e "${CYAN}║${NC}  TCP Fast Open:   $(sysctl -n net.ipv4.tcp_fastopen 2>/dev/null || echo '0') (3 = Client+Server)"
        echo -e "${CYAN}║${NC}  Буфер приёма:    $(sysctl -n net.core.rmem_max 2>/dev/null || echo 'N/A') байт"
        echo -e "${CYAN}║${NC}  Буфер отправки:  $(sysctl -n net.core.wmem_max 2>/dev/null || echo 'N/A') байт"
        echo -e "${CYAN}║${NC}  Макс. соединений: somaxconn = $(sysctl -n net.core.somaxconn 2>/dev/null || echo 'N/A')"
        echo -e "${CYAN}╚══════════════════════════════════════════════════════════════════════╝${NC}"
        echo ""
        echo -e "  ${YELLOW}[1]${NC} 🚀 ${BOLD}Включить BBR и оптимизировать буферы под RAM сервера (${ram_total})${NC}"
        echo -e "  ${YELLOW}[2]${NC} 📊 Просмотреть текущую полную конфигурацию sysctl"
        echo -e "  ${YELLOW}[3]${NC} 🔄 Перепроверить статус BBR"
        echo -e "  ${YELLOW}[0]${NC} Назад"
        echo ""
        read -p "Выберите действие [0-3]: " bbr_choice
        case "$bbr_choice" in
            1) apply_adaptive_bbr_tuning ;;
            2)
                clear
                echo -e "${BOLD}--- Текущие параметры сети и ядра (sysctl) ---${NC}"
                sysctl net.ipv4.tcp_congestion_control net.core.default_qdisc net.ipv4.tcp_fastopen net.core.rmem_max net.core.wmem_max net.core.somaxconn net.ipv4.tcp_max_syn_backlog net.ipv4.tcp_tw_reuse net.ipv4.tcp_fin_timeout fs.file-max
                echo ""
                read -p "Нажмите Enter для возврата..."
                ;;
            3) sleep 0.5 ;;
            0) return ;;
            *) echo "Неверный выбор"; sleep 1 ;;
        esac
    done
}

# ------------------------------------------------------------------------------
# ФАЙЛ ПОДКАЧКИ SWAP (ВЫБОР 2G / 4G / УДАЛЕНИЕ)
# ------------------------------------------------------------------------------
create_or_resize_swap() {
    local target_gb="$1"
    local target_mb=$((target_gb * 1024))
    clear
    echo -e "${BOLD}--- Создание файла подкачки Swap ${target_gb} ГБ ---${NC}"

    local cur_swap_mb=$(free -m 2>/dev/null | awk '/^Swap:/{print $2}')
    local cur_swap_used=$(free -m 2>/dev/null | awk '/^Swap:/{print $3}')
    local free_ram_mb=$(free -m 2>/dev/null | awk '/^Mem:/{print $4}')
    local disk_free_mb=$(df -m / 2>/dev/null | awk 'NR==2{print $4}')

    local required_mb=$((target_mb + 500))
    if [ "$disk_free_mb" -lt "$required_mb" ]; then
        echo -e "${RED}❌ Ошибка: недостаточно места на диске!${NC}"
        echo -e "Требуется минимум: ${required_mb} MB, свободно: ${disk_free_mb} MB."
        read -p "Нажмите Enter для возврата..."
        return
    fi

    if [ -n "$cur_swap_mb" ] && [ "$cur_swap_mb" -gt 0 ]; then
        echo -e "${YELLOW}Обнаружен существующий Swap: ${cur_swap_mb} MB (занято: ${cur_swap_used} MB).${NC}"
        if [ "$cur_swap_mb" -eq "$target_mb" ]; then
            read -p "Swap уже имеет размер ${target_gb} ГБ. Пересоздать заново? [y/N]: " confirm_recreate
            [[ ! "$confirm_recreate" =~ ^[yY]$ ]] && return
        else
            read -p "Изменить текущий Swap (${cur_swap_mb} MB) на ${target_gb} ГБ? [Y/n]: " confirm_change
            [[ "$confirm_change" =~ ^[nN]$ ]] && return
        fi

        echo -e "${YELLOW}Безопасное отключение текущего Swap (swapoff)...${NC}"
        swapoff -a 2>/dev/null || true
    fi

    [ -f /swapfile ] && rm -f /swapfile

    echo -e "${YELLOW}Выделение файла /swapfile размером ${target_gb} ГБ...${NC}"
    if ! fallocate -l "${target_gb}G" /swapfile 2>/dev/null; then
        echo -e "${YELLOW}fallocate не поддерживается файловой системой, создаём через dd...${NC}"
        dd if=/dev/zero of=/swapfile bs=1M count="$target_mb" status=none
    fi

    chmod 600 /swapfile
    mkswap /swapfile >/dev/null 2>&1

    if ! swapon /swapfile 2>/dev/null; then
        echo -e "${YELLOW}Повторная инициализация через dd...${NC}"
        rm -f /swapfile
        dd if=/dev/zero of=/swapfile bs=1M count="$target_mb" status=none
        chmod 600 /swapfile
        mkswap /swapfile >/dev/null 2>&1
        swapon /swapfile
    fi

    sed -i '\|/swapfile|d' /etc/fstab 2>/dev/null || true
    echo '/swapfile none swap sw 0 0' >> /etc/fstab

    mkdir -p /etc/sysctl.d 2>/dev/null || true
    cat > /etc/sysctl.d/99-swap.conf <<EOF
vm.swappiness = 10
vm.vfs_cache_pressure = 50
EOF
    sysctl -p /etc/sysctl.d/99-swap.conf >/dev/null 2>&1 || true

    echo ""
    echo -e "${GREEN}✓ Swap-файл ${target_gb} ГБ успешно создан и подключен!${NC}"
    echo ""
    free -h
    echo ""
    read -p "Нажмите Enter для возврата..."
}

remove_swap() {
    clear
    echo -e "${BOLD}--- Отключение и удаление Swap-файла ---${NC}"
    local cur_swap_mb=$(free -m 2>/dev/null | awk '/^Swap:/{print $2}')
    if [ -z "$cur_swap_mb" ] || [ "$cur_swap_mb" -eq 0 ]; then
        echo -e "${YELLOW}Swap не обнаружен или уже отключен.${NC}"
        sleep 2
        return
    fi

    read -p "Вы уверены, что хотите полностью отключить и удалить Swap? [y/N]: " confirm_del
    [[ ! "$confirm_del" =~ ^[yY]$ ]] && return

    echo -e "${YELLOW}Отключение подкачки (swapoff)...${NC}"
    swapoff -a 2>/dev/null || true
    [ -f /swapfile ] && rm -f /swapfile
    sed -i '\|/swapfile|d' /etc/fstab 2>/dev/null || true
    rm -f /etc/sysctl.d/99-swap.conf 2>/dev/null || true

    echo -e "${GREEN}✓ Swap успешно отключен и удален!${NC}"
    sleep 2
}

configure_swappiness() {
    clear
    echo -e "${BOLD}--- Настройка vm.swappiness (агрессивность использования Swap) ---${NC}"
    echo -e "Текущее значение: ${GREEN}$(sysctl -n vm.swappiness 2>/dev/null)${NC}"
    echo ""
    echo -e "  ${YELLOW}[1]${NC} 10 (Рекомендуется для SSD/NVMe — использование памяти до последнего)"
    echo -e "  ${YELLOW}[2]${NC} 20 (Сбалансированное значение)"
    echo -e "  ${YELLOW}[3]${NC} 60 (Стандартное значение ядра Linux)"
    echo -e "  ${YELLOW}[4]${NC} Ввести своё значение (0-100)"
    echo -e "  ${YELLOW}[0]${NC} Отмена"
    echo ""
    read -p "Выберите вариант [0-4]: " swp_c
    local val=""
    case "$swp_c" in
        1) val="10" ;;
        2) val="20" ;;
        3) val="60" ;;
        4) read -p "Введите значение (0-100): " val ;;
        *) return ;;
    esac
    if [ -n "$val" ]; then
        mkdir -p /etc/sysctl.d 2>/dev/null || true
        echo "vm.swappiness = $val" > /etc/sysctl.d/99-swap.conf
        echo "vm.vfs_cache_pressure = 50" >> /etc/sysctl.d/99-swap.conf
        sysctl -p /etc/sysctl.d/99-swap.conf >/dev/null 2>&1 || true
        echo -e "${GREEN}✓ Установлен vm.swappiness = $val${NC}"
        sleep 2
    fi
}

menu_swap_manager() {
    while true; do
        clear
        local swap_total_mb=$(free -m 2>/dev/null | awk '/^Swap:/{print $2}')
        local swap_used_mb=$(free -m 2>/dev/null | awk '/^Swap:/{print $3}')
        local swap_free_mb=$(free -m 2>/dev/null | awk '/^Swap:/{print $4}')
        local swap_total_h=$(free -h 2>/dev/null | awk '/^Swap:/{print $2}')
        local swap_used_h=$(free -h 2>/dev/null | awk '/^Swap:/{print $3}')
        local cur_swappiness=$(sysctl -n vm.swappiness 2>/dev/null || echo "60")
        local cur_swap_path=$(swapon --show=NAME --noheadings 2>/dev/null | head -n1)
        local disk_free_mb=$(df -m / 2>/dev/null | awk 'NR==2{print $4}')

        echo -e "${CYAN}╔══════════════════════════════════════════════════════════════════════╗${NC}"
        echo -e "${CYAN}║${BOLD}               УПРАВЛЕНИЕ ФАЙЛОМ ПОДКАЧКИ (SWAP)               ${CYAN}║${NC}"
        echo -e "${CYAN}╠══════════════════════════════════════════════════════════════════════╣${NC}"
        if [ -n "$swap_total_mb" ] && [ "$swap_total_mb" -gt 0 ]; then
            echo -e "${CYAN}║${NC}  Статус Swap:      ${GREEN}${BOLD}АКТИВЕН (${swap_total_h})${NC}"
            echo -e "${CYAN}║${NC}  Использование:    ${BOLD}${swap_used_h}${NC} занято / свободно: ${BOLD}${swap_free_mb} MB${NC}"
            echo -e "${CYAN}║${NC}  Файл подкачки:    ${CYAN}${cur_swap_path}${NC}"
        else
            echo -e "${CYAN}║${NC}  Статус Swap:      ${YELLOW}${BOLD}НЕ СОЗДАН (0 MB)${NC}"
        fi
        echo -e "${CYAN}║${NC}  Swappiness:       ${BOLD}${cur_swappiness}${NC} (Рекомендуется 10 для SSD)"
        echo -e "${CYAN}║${NC}  Свободно на диске: ${BOLD}${disk_free_mb} MB${NC}"
        echo -e "${CYAN}╚══════════════════════════════════════════════════════════════════════╝${NC}"
        echo ""
        echo -e "  ${YELLOW}[1]${NC} 💾 Создать / Пересоздать Swap-файл ${BOLD}2 ГБ${NC} (/swapfile)"
        echo -e "  ${YELLOW}[2]${NC} 💾 Создать / Пересоздать Swap-файл ${BOLD}4 ГБ${NC} (/swapfile)"
        echo -e "  ${YELLOW}[3]${NC} ⚙️  Настроить swappiness (10 / 20 / 60)"
        echo -e "  ${YELLOW}[4]${NC} 🗑️  Отключить и удалить Swap-файл"
        echo -e "  ${YELLOW}[0]${NC} Назад"
        echo ""
        read -p "Выберите действие [0-4]: " sw_choice
        case "$sw_choice" in
            1) create_or_resize_swap 2 ;;
            2) create_or_resize_swap 4 ;;
            3) configure_swappiness ;;
            4) remove_swap ;;
            0) return ;;
            *) echo "Неверный выбор"; sleep 1 ;;
        esac
    done
}

# ------------------------------------------------------------------------------
# FAIL2BAN: УСТАНОВКА И УПРАВЛЕНИЕ ЗАЩИТОЙ SSH
# ------------------------------------------------------------------------------
detect_ssh_port() {
    local p=$(ss -tlnp 2>/dev/null | grep -E 'sshd|/sshd' | awk '{print $4}' | awk -F':' '{print $NF}' | head -n1)
    if [ -z "$p" ]; then
        p=$(grep -a -E "^[[:space:]]*Port[[:space:]]+" /etc/ssh/sshd_config 2>/dev/null | awk '{print $2}' | head -n1)
    fi
    if [ -z "$p" ] && [ -n "$SSH_CONNECTION" ]; then
        p=$(echo "$SSH_CONNECTION" | awk '{print $4}')
    fi
    [ -z "$p" ] && p="22"
    echo "$p"
}

sync_fail2ban_ssh_port() {
    local ssh_p=$(detect_ssh_port)
    mkdir -p /etc/fail2ban/jail.d 2>/dev/null || true

    cat > /etc/fail2ban/jail.d/99-xmanager-ssh.local <<EOF
[sshd]
enabled = true
port = ${ssh_p}
filter = sshd
backend = systemd
maxretry = 5
findtime = 10m
bantime = 1h
ignoreip = 127.0.0.1/8 ::1
EOF
    systemctl restart fail2ban 2>/dev/null || true
    echo -e "${GREEN}✓ Защита SSH настроена для порта :${ssh_p} (/etc/fail2ban/jail.d/99-xmanager-ssh.local)${NC}"
}

install_configure_fail2ban() {
    clear
    echo -e "${BOLD}--- Установка и базовая настройка Fail2ban ---${NC}"
    local ssh_p=$(detect_ssh_port)
    echo -e "Обнаружен рабочий порт SSH: ${CYAN}:${ssh_p}${NC}"
    echo ""

    if ! which fail2ban-client >/dev/null 2>&1; then
        echo -e "${YELLOW}Установка пакета fail2ban через apt...${NC}"
        apt-get update -y >/dev/null 2>&1
        apt-get install -y fail2ban
    fi

    sync_fail2ban_ssh_port
    systemctl enable fail2ban 2>/dev/null || true
    systemctl restart fail2ban 2>/dev/null || true
    sleep 2

    if systemctl is-active --quiet fail2ban; then
        echo -e "${GREEN}✓ Fail2ban успешно установлен и запущен!${NC}"
        echo -e "  • Защита SSH: порт ${CYAN}:${ssh_p}${NC}"
        echo -e "  • Время бана:  ${BOLD}1 час${NC}"
        echo -e "  • Лимит:       ${BOLD}5 неудачных попыток за 10 минут${NC}"
    else
        echo -e "${RED}✗ Ошибка запуска службы fail2ban!${NC}"
        journalctl -u fail2ban -n 8 --no-pager
    fi
    echo ""
    read -p "Нажмите Enter для возврата..."
}

show_fail2ban_banned() {
    clear
    echo -e "${BOLD}--- Список заблокированных IP-адресов Fail2ban ---${NC}"
    echo ""
    local jails=$(fail2ban-client status 2>/dev/null | grep "Jail list:" | sed 's/.*Jail list:[[:space:]]*//')
    if [ -z "$jails" ]; then
        echo -e "${YELLOW}Нет активных джейлов.${NC}"
    else
        for j in $(echo "$jails" | tr ',' ' '); do
            echo -e "${CYAN}${BOLD}=== Джейл: ${j} ===${NC}"
            fail2ban-client status "$j" 2>/dev/null | grep -E "Currently failed:|Total failed:|Currently banned:|Total banned:|Banned IP list:"
            echo ""
        done
    fi
    read -p "Нажмите Enter для возврата..."
}

unban_ip_fail2ban() {
    clear
    echo -e "${BOLD}--- Разблокировка IP-адреса (Unban) ---${NC}"
    echo ""
    read -p "Введите IP-адрес для разблокировки (или 'all' для разбана всех): " un_ip
    [ -z "$un_ip" ] && return

    local jails=$(fail2ban-client status 2>/dev/null | grep "Jail list:" | sed 's/.*Jail list:[[:space:]]*//')
    if [ "$un_ip" = "all" ]; then
        echo -e "${YELLOW}Снятие бана со всех IP во всех джейлах...${NC}"
        for j in $(echo "$jails" | tr ',' ' '); do
            fail2ban-client unban --all 2>/dev/null || true
        done
        echo -e "${GREEN}✓ Все IP успешно разблокированы!${NC}"
    else
        for j in $(echo "$jails" | tr ',' ' '); do
            fail2ban-client set "$j" unbanip "$un_ip" 2>/dev/null || true
        done
        echo -e "${GREEN}✓ Команда разблокировки отправлена для ${un_ip}${NC}"
    fi
    sleep 2
}

ban_ip_fail2ban() {
    clear
    echo -e "${BOLD}--- Ручная блокировка IP-адреса (Ban) ---${NC}"
    echo ""
    read -p "Введите IP-адрес для блокировки: " b_ip
    [ -z "$b_ip" ] && return

    fail2ban-client set sshd banip "$b_ip" 2>/dev/null || true
    echo -e "${GREEN}✓ IP-адрес ${b_ip} заблокирован в джейле sshd!${NC}"
    sleep 2
}

configure_fail2ban_timings() {
    clear
    echo -e "${BOLD}--- Настройка времени блокировки Fail2ban ---${NC}"
    echo ""
    echo -e "  ${YELLOW}[1]${NC} 1 час (3600 с, 5 попыток)"
    echo -e "  ${YELLOW}[2]${NC} 24 часа (86400 с, 3 попытки)"
    echo -e "  ${YELLOW}[3]${NC} 7 дней (604800 с, 3 попытки)"
    echo -e "  ${YELLOW}[4]${NC} Навсегда (-1, 3 попытки)"
    echo -e "  ${YELLOW}[0]${NC} Отмена"
    echo ""
    read -p "Выберите вариант [0-4]: " t_ch
    local b_time="1h"
    local m_retry="5"
    case "$t_ch" in
        1) b_time="1h"; m_retry="5" ;;
        2) b_time="24h"; m_retry="3" ;;
        3) b_time="7d"; m_retry="3" ;;
        4) b_time="-1"; m_retry="3" ;;
        *) return ;;
    esac

    local ssh_p=$(detect_ssh_port)
    cat > /etc/fail2ban/jail.d/99-xmanager-ssh.local <<EOF
[sshd]
enabled = true
port = ${ssh_p}
filter = sshd
backend = systemd
maxretry = ${m_retry}
findtime = 10m
bantime = ${b_time}
ignoreip = 127.0.0.1/8 ::1
EOF
    systemctl restart fail2ban 2>/dev/null || true
    echo -e "${GREEN}✓ Параметры сохранены: bantime=${b_time}, maxretry=${m_retry}${NC}"
    sleep 2
}

menu_fail2ban() {
    while true; do
        clear
        local is_inst=false
        local is_act=false
        which fail2ban-client >/dev/null 2>&1 && is_inst=true
        systemctl is-active --quiet fail2ban 2>/dev/null && is_act=true
        local ssh_p=$(detect_ssh_port)

        echo -e "${CYAN}╔══════════════════════════════════════════════════════════════════════╗${NC}"
        echo -e "${CYAN}║${BOLD}                  УПРАВЛЕНИЕ ЗАЩИТОЙ FAIL2BAN                  ${CYAN}║${NC}"
        echo -e "${CYAN}╠══════════════════════════════════════════════════════════════════════╣${NC}"
        if ! $is_inst; then
            echo -e "${CYAN}║${NC}  Статус:          ${RED}${BOLD}НЕ УСТАНОВЛЕН${NC}"
            echo -e "${CYAN}║${NC}  Порт SSH:        ${CYAN}:${ssh_p}${NC}"
            echo -e "${CYAN}╚══════════════════════════════════════════════════════════════════════╝${NC}"
            echo ""
            echo -e "  ${YELLOW}[1]${NC} 🛡️  ${BOLD}Установить Fail2ban и включить защиту SSH (порт :${ssh_p})${NC}"
            echo -e "  ${YELLOW}[0]${NC} Назад"
            echo ""
            read -p "Выберите действие [0-1]: " f2b_ch
            case "$f2b_ch" in
                1) install_configure_fail2ban ;;
                0) return ;;
                *) echo "Неверный выбор"; sleep 1 ;;
            esac
            continue
        fi

        local jails=$(fail2ban-client status 2>/dev/null | grep "Jail list:" | sed 's/.*Jail list:[[:space:]]*//')
        local banned_cnt=0
        if [ -n "$jails" ]; then
            for j in $(echo "$jails" | tr ',' ' '); do
                local cnt=$(fail2ban-client status "$j" 2>/dev/null | awk -F':' '/Currently banned/{print $2}' | tr -d ' ')
                [ -n "$cnt" ] && banned_cnt=$((banned_cnt + cnt))
            done
        fi

        if $is_act; then
            echo -e "${CYAN}║${NC}  Статус:          ${GREEN}${BOLD}АКТИВЕН (Служба работает)${NC}"
            echo -e "${CYAN}║${NC}  Активные джейлы: ${GREEN}${jails:-Нет}${NC}"
            echo -e "${CYAN}║${NC}  Забанено IP:     ${YELLOW}${banned_cnt} IP${NC}"
        else
            echo -e "${CYAN}║${NC}  Статус:          ${YELLOW}${BOLD}ОСТАНОВЛЕН (Установлен)${NC}"
        fi
        echo -e "${CYAN}║${NC}  Порт SSH:        ${CYAN}:${ssh_p}${NC}"
        echo -e "${CYAN}╚══════════════════════════════════════════════════════════════════════╝${NC}"
        echo ""
        echo -e "  ${YELLOW}[1]${NC} 📋 Список заблокированных IP-адресов"
        echo -e "  ${YELLOW}[2]${NC} 🔓 Разблокировать IP-адрес (Unban IP)"
        echo -e "  ${YELLOW}[3]${NC} 🔒 Заблокировать IP-адрес вручную (Ban IP)"
        echo -e "  ${YELLOW}[4]${NC} ⏱️  Настроить параметры бана (время бана, попытки)"
        echo -e "  ${YELLOW}[5]${NC} 🎯 Проверить / синхронизировать защиту порта SSH (:${ssh_p})"
        echo -e "  ${YELLOW}[6]${NC} 🔄 Перезапустить службу Fail2ban"
        echo -e "  ${YELLOW}[7]${NC} 🛑 Остановить / Запустить Fail2ban"
        echo -e "  ${YELLOW}[0]${NC} Назад"
        echo ""
        read -p "Выберите действие [0-7]: " f2b_ch
        case "$f2b_ch" in
            1) show_fail2ban_banned ;;
            2) unban_ip_fail2ban ;;
            3) ban_ip_fail2ban ;;
            4) configure_fail2ban_timings ;;
            5) sync_fail2ban_ssh_port ;;
            6)
                systemctl restart fail2ban
                echo -e "${GREEN}✓ Fail2ban успешно перезапущен!${NC}"
                sleep 2
                ;;
            7)
                if $is_act; then
                    systemctl stop fail2ban
                    echo -e "${YELLOW}Fail2ban остановлен.${NC}"
                else
                    systemctl start fail2ban
                    echo -e "${GREEN}Fail2ban запущен.${NC}"
                fi
                sleep 2
                ;;
            0) return ;;
            *) echo "Неверный выбор"; sleep 1 ;;
        esac
    done
}

# ------------------------------------------------------------------------------
# ГЛАВНЫЙ РАЗДЕЛ: СИСТЕМНЫЕ НАСТРОЙКИ И ОПТИМИЗАЦИЯ
# ------------------------------------------------------------------------------
menu_system_opt() {
    while true; do
        clear
        local cur_dns=$(get_sys_dns_short)
        local cur_bbr=$(get_bbr_short_status)
        local cur_swap=$(get_swap_short_status)
        local cur_f2b=$(get_f2b_short_status)
        local ram_h=$(free -h 2>/dev/null | awk '/^Mem:/{print $2}')
        local cpus=$(nproc 2>/dev/null || echo "1")
        local kern=$(uname -r)

        echo -e "${CYAN}╔══════════════════════════════════════════════════════════════════════╗${NC}"
        echo -e "${CYAN}║${BOLD}        СИСТЕМНЫЕ НАСТРОЙКИ, ОПТИМИЗАЦИЯ И БЕЗОПАСНОСТЬ        ${CYAN}║${NC}"
        echo -e "${CYAN}╠══════════════════════════════════════════════════════════════════════╣${NC}"
        echo -e "${CYAN}║${NC}  Сервер:    ${BOLD}${SERVER_IP}${NC}  |  CPU: ${BOLD}${cpus} ядра${NC}  |  RAM: ${BOLD}${ram_h}${NC}  |  Ядро: ${kern}"
        echo -e "${CYAN}║${NC}"
        echo -e "${CYAN}║${NC}  • Системный DNS:  ${GREEN}${cur_dns}${NC}"
        echo -e "${CYAN}║${NC}  • BBR & Буферы:   ${cur_bbr}"
        echo -e "${CYAN}║${NC}  • Файл подкачки:  ${cur_swap}"
        echo -e "${CYAN}║${NC}  • Fail2ban:       ${cur_f2b}"
        echo -e "${CYAN}╚══════════════════════════════════════════════════════════════════════╝${NC}"
        echo ""
        echo -e "  ${GREEN}${BOLD}[1]${NC} 🌐 ${BOLD}Смена системного DNS${NC} (Российские / Зарубежные DNS с пингом)"
        echo -e "  ${BLUE}${BOLD}[2]${NC} 🚀 ${BOLD}Включить BBR и оптимизировать сетевые буферы${NC} (TCP тюнинг под RAM)"
        echo -e "  ${PURPLE}${BOLD}[3]${NC} 💾 ${BOLD}Управление файлом подкачки SWAP${NC} (Выбор 2 ГБ / 4 ГБ, статус, удаление)"
        echo -e "  ${RED}${BOLD}[4]${NC} 🛡️  ${BOLD}Управление Fail2ban${NC} (Установка, защита SSH, забаненные IP, unban)"
        echo ""
        echo -e "  ${YELLOW}${BOLD}[5]${NC} 📊 Сводный отчет о характеристиках сервера и сети"
        echo -e "  ${BOLD}[0]${NC} 🚪 Назад в главное меню"
        echo ""
        read -p "Выберите раздел [0-5]: " sys_choice
        case "$sys_choice" in
            1) menu_dns_system ;;
            2) menu_bbr_tuning ;;
            3) menu_swap_manager ;;
            4) menu_fail2ban ;;
            5)
                clear
                echo -e "${BOLD}=== СВОДНЫЙ ОТЧЁТ О СИСТЕМЕ И СЕТИ ===${NC}"
                echo ""
                echo -e "${CYAN}--- Память и подкачка ---${NC}"
                free -h
                echo ""
                echo -e "${CYAN}--- Дисковое пространство ---${NC}"
                df -h /
                echo ""
                echo -e "${CYAN}--- Сетевые параметры ядра (sysctl) ---${NC}"
                sysctl net.ipv4.tcp_congestion_control net.core.default_qdisc net.ipv4.tcp_fastopen net.core.rmem_max net.core.wmem_max net.core.somaxconn vm.swappiness
                echo ""
                echo -e "${CYAN}--- Системный DNS (/etc/resolv.conf) ---${NC}"
                cat /etc/resolv.conf | grep -E '^nameserver|^options'
                echo ""
                read -p "Нажмите Enter для возврата..."
                ;;
            0) return ;;
            *) echo "Неверный выбор"; sleep 1 ;;
        esac
    done
}

# ==============================================================================
# РАЗДЕЛ 12: СЕРВЕР ПОДПИСОК TUNA (TUNA-SUBSCRIPTIONS)
# ==============================================================================

is_sub_server_installed() {
    [ -f "/usr/local/bin/tuna-subscriptions" ] || [ -f "/etc/systemd/system/tuna-subscriptions.service" ]
}

get_sub_server_status() {
    if ! is_sub_server_installed; then
        echo -e "${RED}НЕ УСТАНОВЛЕН${NC}"
        return
    fi
    if systemctl is-active --quiet tuna-subscriptions 2>/dev/null; then
        echo -e "${GREEN}🟢 РАБОТАЕТ (Active)${NC}"
    else
        echo -e "${RED}🔴 ОСТАНОВЛЕН (Inactive)${NC}"
    fi
}

get_sub_server_short_status() {
    if systemctl is-active --quiet tuna-subscriptions 2>/dev/null; then
        echo -e "${GREEN}Active${NC}"
    else
        echo -e "${RED}Inactive${NC}"
    fi
}

extract_current_server_links() {
    local nick="$1"
    [ -z "$nick" ] && nick="user_$(date +%s)"

    # 1. Snell URI
    local s_uri=""
    if is_snell_installed; then
        local s_port=$(get_snell_port)
        local s_psk=$(get_snell_psk)
        if [ -n "$s_port" ] && [ -n "$s_psk" ]; then
            s_uri="snell://${s_psk}@${SERVER_IP}:${s_port}/?version=5&reuse=true&tfo=true#Snell-v5"
        fi
    fi

    # 2. WDTT URI
    local w_uri=""
    if is_wdtt_installed; then
        local w_port=$(get_wdtt_peer_port)
        local w_pass=$(get_wdtt_password)
        local w_name=$(get_wdtt_profile_name)
        if [ -n "$w_port" ] && [ -n "$w_pass" ]; then
            w_uri=$(python3 -c "
import urllib.parse, sys
name, ip, port, password = sys.argv[1], sys.argv[2], sys.argv[3], sys.argv[4]
print(f'qwdtt://config?name={urllib.parse.quote_plus(name)}&peer={ip}%3A{port}&hashes=&workers=18&port=9000&pass={urllib.parse.quote_plus(password)}')
" "$w_name" "$SERVER_IP" "$w_port" "$w_pass" 2>/dev/null || echo "")
        fi
    fi

    # 3. Mieru URI
    local m_uri=""
    if is_mieru_installed && [ -f "$MIERU_USER_STORE" ]; then
        local m_first_user=$(jq -r 'keys[0] // empty' "$MIERU_USER_STORE" 2>/dev/null || echo "")
        if [ -n "$m_first_user" ]; then
            local m_pass=$(jq -r --arg u "$m_first_user" '.[$u]' "$MIERU_USER_STORE" 2>/dev/null || echo "")
            local ports_str=$(get_mieru_ports)
            local p_range=$(echo "$ports_str" | cut -d'/' -f1)
            local proto=$(echo "$ports_str" | cut -d'/' -f2)
            local pattern=$(mita export traffic-pattern 2>/dev/null || echo "")
            m_uri="mierus://${m_first_user}:${m_pass}@${SERVER_IP}/?profile=Mieru-Home&port=${p_range}&protocol=${proto}&multiplexing=MULTIPLEXING_HIGH&traffic-pattern=${pattern}&low-entropy-mode=LOW_ENTROPY_MODE_48&low-entropy-mask-rotation=LOW_ENTROPY_MASK_ROTATE_RIGHT_7"
        fi
    fi

    # 4. CSQTT URI
    local c_uri=""
    if is_csqtt_installed; then
        local c_port=$(get_csqtt_peer_port)
        local c_pass=$(get_csqtt_tunnel_pass)
        if [ -n "$c_port" ] && [ -n "$c_pass" ] && [ "$c_pass" != "N/A" ]; then
            c_uri="csqtt://${c_pass}@${SERVER_IP}:${c_port}#CSQTT"
        fi
    fi

    # 5. MasterDnsVPN URI
    local d_uri=""
    if is_dns_installed; then
        d_uri=$(get_stormdns_link 1 2>/dev/null || echo "")
    fi

    python3 -c "
import json, sys
data = {
    'nickname': sys.argv[1],
    'snell_uri': sys.argv[2],
    'qwdtt_uri': sys.argv[3],
    'mieru_uri': sys.argv[4],
    'csqtt_uri': sys.argv[5],
    'masterdnsvpn_uri': sys.argv[6]
}
print(json.dumps(data))
" "$nick" "$s_uri" "$w_uri" "$m_uri" "$c_uri" "$d_uri"
}

menu_subscriptions() {
    local SUB_API="http://127.0.0.1:22217"

    while true; do
        clear
        local s_stat=$(get_sub_server_status)
        echo -e "${CYAN}╔══════════════════════════════════════════════════════════════════════╗${NC}"
        echo -e "${CYAN}║${BOLD}          УПРАВЛЕНИЕ СЕРВЕРОМ ПОДПИСОК TUNA (TUNA-SUBSCRIPTIONS)       ${CYAN}║${NC}"
        echo -e "${CYAN}╠══════════════════════════════════════════════════════════════════════╣${NC}"
        echo -e "${CYAN}║${NC}  Статус службы: ${s_stat}"
        echo -e "${CYAN}║${NC}  API: ${CYAN}${SUB_API}${NC} (Localhost) | База: ${BOLD}/var/lib/tuna-subscriptions/subscriptions.db${NC}"
        echo -e "${CYAN}╚══════════════════════════════════════════════════════════════════════╝${NC}"
        echo ""
        echo -e "  ${YELLOW}[1]${NC} 👥 ${BOLD}Список профилей и ссылки подписок${NC}"
        echo -e "  ${YELLOW}[2]${NC} 🚀 ${BOLD}Создать подписку из текущих ссылок сервера${NC} (Snell, Mieru, WDTT, DNS...)"
        echo -e "  ${YELLOW}[3]${NC} ➕ ${BOLD}Создать пользователя с произвольными ссылками вручную${NC}"
        echo -e "  ${YELLOW}[4]${NC} 🔄 ${BOLD}Ротация токена подписки${NC} (мгновенно отзывает старую ссылку)"
        echo -e "  ${YELLOW}[5]${NC} ✏️  ${BOLD}Включить / отключить подписку пользователя${NC}"
        echo -e "  ${YELLOW}[6]${NC} 🗑️  ${BOLD}Удалить пользователя из сервера подписок${NC}"
        echo -e "  ${YELLOW}[7]${NC} 🔄 ${BOLD}Перезапустить службу tuna-subscriptions${NC}"
        echo -e "  ${YELLOW}[8]${NC} 📜 ${BOLD}Логи службы tuna-subscriptions${NC}"
        echo -e "  ${YELLOW}[9]${NC} 📥 ${BOLD}Установить / Обновить службу tuna-subscriptions${NC}"
        echo -e "  ${YELLOW}[0]${NC} ⬅️  Назад в Главное Меню"
        echo ""
        read -p "Выберите действие [0-9]: " sub_act
        case "$sub_act" in
            1)
                clear
                echo -e "${CYAN}=== СПИСОК ПОЛЬЗОВАТЕЛЕЙ И ССЫЛОК ПОДПИСКИ ===${NC}\n"
                local raw_users=$(curl -s "${SUB_API}/api/users" 2>/dev/null || echo "")
                if [ -z "$raw_users" ] || [ "$raw_users" = "[]" ]; then
                    echo -e "${YELLOW}Пользователи еще не созданы или служба не запущена.${NC}"
                else
                    echo "$raw_users" | jq -r '.[] | "--------------------------------------------------\n👤 Пользователь: \(.nickname)\n🆔 ID:           \(.id)\n🟢 Активен:      \(.enabled)\n🔢 Ревизия:      \(.revision)\n🔗 Ссылка:       \(.subscription_url)\n"' 2>/dev/null || echo "$raw_users"
                fi
                echo ""
                read -p "Нажмите Enter для возврата..."
                ;;
            2)
                clear
                echo -e "${CYAN}=== СОЗДАНИЕ ПОДПИСКИ ИЗ ТЕКУЩИХ СЛУЖБ СЕРВЕРА ===${NC}\n"
                read -p "Введите ник пользователя (например: alex_travel): " new_nick
                [ -z "$new_nick" ] && new_nick="user_$(openssl rand -hex 3 2>/dev/null || echo "1")"

                local payload=$(extract_current_server_links "$new_nick")
                echo -e "${CYAN}[*] Отправка данных в локальный сервер подписок...${NC}"
                local resp=$(curl -s -X POST "${SUB_API}/api/users" \
                    -H "Content-Type: application/json" \
                    -d "$payload" 2>/dev/null || echo "")

                local sub_url=$(echo "$resp" | jq -r '.subscription_url // empty' 2>/dev/null || echo "")
                if [ -n "$sub_url" ]; then
                    echo ""
                    echo -e "${GREEN}${BOLD}✓ Профиль успешно создан!${NC}"
                    echo -e "  • Никнейм:   ${GREEN}${new_nick}${NC}"
                    echo -e "  • Ссылка:    ${CYAN}${BOLD}${sub_url}${NC}"
                    echo ""
                    echo -e "${BOLD}QR-код персональной ссылки подписки:${NC}"
                    qrencode -t ANSI256 "$sub_url" 2>/dev/null || qrencode -t UTF8 "$sub_url" 2>/dev/null || true
                    echo ""
                    echo -e "${YELLOW}Эту ссылку нужно передать в панель или клиент TUNA как подписку.${NC}"
                else
                    echo -e "${RED}Ошибка при создании пользователя:${NC}"
                    echo "$resp"
                fi
                echo ""
                read -p "Нажмите Enter для возврата..."
                ;;
            3)
                clear
                echo -e "${CYAN}=== РУЧНОЕ СОЗДАНИЕ ПОЛЬЗОВАТЕЛЯ ===${NC}\n"
                read -p "Никнейм: " m_nick
                [ -z "$m_nick" ] && return
                read -p "Snell URI [Enter если нет]: " m_snell
                read -p "WDTT (qwdtt) URI [Enter если нет]: " m_wdtt
                read -p "Mieru URI [Enter если нет]: " m_mieru
                read -p "CSQTT URI [Enter если нет]: " m_csqtt
                read -p "MasterDNS (stormdns) URI [Enter если нет]: " m_dns

                local m_json=$(python3 -c "
import json, sys
print(json.dumps({
    'nickname': sys.argv[1],
    'snell_uri': sys.argv[2],
    'qwdtt_uri': sys.argv[3],
    'mieru_uri': sys.argv[4],
    'csqtt_uri': sys.argv[5],
    'masterdnsvpn_uri': sys.argv[6]
}))" "$m_nick" "$m_snell" "$m_wdtt" "$m_mieru" "$m_csqtt" "$m_dns")
                local resp=$(curl -s -X POST "${SUB_API}/api/users" -H "Content-Type: application/json" -d "$m_json" 2>/dev/null || echo "")
                local sub_url=$(echo "$resp" | jq -r '.subscription_url // empty' 2>/dev/null || echo "")
                if [ -n "$sub_url" ]; then
                    echo -e "${GREEN}✓ Пользователь создан! URL: ${CYAN}${sub_url}${NC}"
                    qrencode -t ANSI256 "$sub_url" 2>/dev/null || true
                else
                    echo -e "${RED}Ошибка:${NC} $resp"
                fi
                echo ""
                read -p "Нажмите Enter..."
                ;;
            4)
                clear
                echo -e "${CYAN}=== РОТАЦИЯ ТОКЕНА ПОДПИСКИ ===${NC}\n"
                read -p "Введите ID пользователя (UUID): " rot_id
                if [ -n "$rot_id" ]; then
                    local resp=$(curl -s -X POST "${SUB_API}/api/users/${rot_id}/rotate-token" 2>/dev/null || echo "")
                    local new_url=$(echo "$resp" | jq -r '.subscription_url // empty' 2>/dev/null || echo "")
                    if [ -n "$new_url" ]; then
                        echo -e "${GREEN}✓ Токен успешно обновлен! Старая ссылка более недействительна.${NC}"
                        echo -e "Новый URL: ${CYAN}${new_url}${NC}"
                        qrencode -t ANSI256 "$new_url" 2>/dev/null || true
                    else
                        echo -e "${RED}Ошибка:${NC} $resp"
                    fi
                fi
                echo ""
                read -p "Нажмите Enter..."
                ;;
            5)
                clear
                echo -e "${CYAN}=== ВКЛЮЧЕНИЕ / ОТКЛЮЧЕНИЕ ПОДПИСКИ ===${NC}\n"
                read -p "Введите ID пользователя: " tog_id
                if [ -n "$tog_id" ]; then
                    read -p "Активировать (1) или деактивировать (0)? [1/0]: " tog_val
                    local en_bool="true"
                    [ "$tog_val" = "0" ] && en_bool="false"
                    local resp=$(curl -s -X PUT "${SUB_API}/api/users/${tog_id}" -H "Content-Type: application/json" -d "{\"enabled\": ${en_bool}}" 2>/dev/null || echo "")
                    echo -e "${GREEN}✓ Статус обновлен:${NC} $resp"
                fi
                echo ""
                read -p "Нажмите Enter..."
                ;;
            6)
                clear
                echo -e "${CYAN}=== УДАЛЕНИЕ ПОЛЬЗОВАТЕЛЯ ===${NC}\n"
                read -p "Введите ID пользователя для удаления: " del_id
                if [ -n "$del_id" ]; then
                    read -p "Вы уверены, что хотите удалить ${del_id}? [y/N]: " conf
                    if [ "$conf" = "y" ] || [ "$conf" = "Y" ]; then
                        local resp=$(curl -s -X DELETE "${SUB_API}/api/users/${del_id}" 2>/dev/null || echo "")
                        echo -e "${GREEN}✓ Результат:${NC} $resp"
                    fi
                fi
                echo ""
                read -p "Нажмите Enter..."
                ;;
            7)
                echo -e "${CYAN}[*] Перезапуск службы tuna-subscriptions...${NC}"
                systemctl restart tuna-subscriptions 2>/dev/null || true
                sleep 1
                if systemctl is-active --quiet tuna-subscriptions; then
                    echo -e "${GREEN}✓ Служба tuna-subscriptions активна и работает!${NC}"
                else
                    echo -e "${RED}✗ Служба не смогла запуститься.${NC}"
                    journalctl -u tuna-subscriptions -n 10 --no-pager
                fi
                sleep 2
                ;;
            8)
                journalctl -u tuna-subscriptions -f -n 50
                ;;
            9)
                echo -e "${CYAN}[*] Запуск установки / обновления tuna-subscriptions...${NC}"
                mkdir -p /tmp/tuna-sub-install
                curl -fsSL -o /tmp/tuna-sub-install/tuna-subscriptions.py "https://raw.githubusercontent.com/534188-create/x-manager/main/tuna-sub-server/tuna-subscriptions.py?v=$(date +%s)" 2>/dev/null || true
                curl -fsSL -o /tmp/tuna-sub-install/config.toml.example "https://raw.githubusercontent.com/534188-create/x-manager/main/tuna-sub-server/config.toml.example?v=$(date +%s)" 2>/dev/null || true
                curl -fsSL -o /tmp/tuna-sub-install/tuna-subscriptions.service "https://raw.githubusercontent.com/534188-create/x-manager/main/tuna-sub-server/tuna-subscriptions.service?v=$(date +%s)" 2>/dev/null || true
                curl -fsSL -o /tmp/tuna-sub-install/install-sub-server.sh "https://raw.githubusercontent.com/534188-create/x-manager/main/tuna-sub-server/install-sub-server.sh?v=$(date +%s)" 2>/dev/null || true
                if [ -f /tmp/tuna-sub-install/install-sub-server.sh ]; then
                    bash /tmp/tuna-sub-install/install-sub-server.sh || true
                fi
                rm -rf /tmp/tuna-sub-install
                sleep 2
                ;;
            0) return ;;
            *) echo "Неверный выбор"; sleep 1 ;;
        esac
    done
}

# ==============================================================================
# ГЛАВНОЕ МЕНЮ ДИСПЕТЧЕРА
# ==============================================================================
main_hub() {
    sync_active_firewall_rules >/dev/null 2>&1 || true

    local invoked=$(basename "$0")
    if [ "$invoked" = "x-snell" ]; then
        menu_snell
        exit 0
    elif [ "$invoked" = "x-mieru" ]; then
        menu_mieru
        exit 0
    elif [ "$invoked" = "x-wdtt" ] || [ "$invoked" = "x-qwdtt" ]; then
        menu_wdtt
        exit 0
    elif [ "$invoked" = "x-csqtt" ]; then
        menu_csqtt
        exit 0
    elif [ "$invoked" = "x-dns" ] || [ "$invoked" = "x-cottendns" ] || [ "$invoked" = "x-masterdns" ]; then
        menu_dns
        exit 0
    elif [ "$invoked" = "x-fw" ] || [ "$invoked" = "x-firewall" ]; then
        menu_firewall
        exit 0
    elif [ "$invoked" = "x-opt" ] || [ "$invoked" = "x-sys" ] || [ "$invoked" = "x-bbr" ] || [ "$invoked" = "x-swap" ] || [ "$invoked" = "x-f2b" ]; then
        menu_system_opt
        exit 0
    elif [ "$invoked" = "x-ssl" ] || [ "$invoked" = "x-cert" ] || [ "$invoked" = "x-acme" ]; then
        menu_ssl
        exit 0
    elif [ "$invoked" = "x-sub" ] || [ "$invoked" = "x-tuna" ] || [ "$invoked" = "x-subscriptions" ]; then
        menu_subscriptions
        exit 0
    fi

    while true; do
        clear
        echo -e "${CYAN}╔══════════════════════════════════════════════════════════════════════╗${NC}"
        echo -e "${CYAN}║${BOLD}          ЦЕНТР УПРАВЛЕНИЯ ПРОКСИ-СЕРВИСАМИ             ${CYAN}║${NC}"
        echo -e "${CYAN}╠══════════════════════════════════════════════════════════════════════╣${NC}"
        echo -e "${CYAN}║${NC}  Сервер: ${BOLD}${SERVER_IP}${NC}  |  Шлюзы: TPROXY :12345 [127.0.0.1] | SOCKS5 :10808 [127.0.0.1] 🔒"
        echo -e "${CYAN}║${NC}  Система: BBR: $(get_bbr_short_status) | Swap: $(get_swap_short_status) | F2B: $(get_f2b_short_status) | SSL: $(get_ssl_short_status) | Sub: $(get_sub_server_short_status)"
        echo -e "${CYAN}║${NC}"
        if is_mieru_installed; then
            echo -e "${CYAN}║${NC}  ${BOLD}[1] 🚀 Mieru (mita v$(get_mieru_version))${NC}   -> $(get_mieru_status)"
            echo -e "${CYAN}║${NC}      Порты: ${BOLD}$(get_mieru_ports)${NC}  |  Фаервол: $(get_mieru_fw_status)"
            echo -e "${CYAN}║${NC}      Маршрут: $(get_mieru_routing)  |  Профиль: $(get_mieru_preset)"
        else
            echo -e "${CYAN}║${NC}  ${BOLD}[1] 🚀 Mieru (mita)${NC}           -> ${RED}НЕ УСТАНОВЛЕН${NC}"
        fi
        echo -e "${CYAN}║${NC}"
        if is_snell_installed; then
            echo -e "${CYAN}║${NC}  ${BOLD}[2] ⚡ Snell (v5.0.1)${NC}         -> $(get_snell_status)"
            echo -e "${CYAN}║${NC}      Порт:  ${BOLD}$(get_snell_port)${NC} (TCP+UDP QUIC) |  Фаервол: $(get_snell_fw_status)"
            echo -e "${CYAN}║${NC}      Маршрут: $(get_snell_routing)  |  Обфускация: $(get_snell_obfs)"
        else
            echo -e "${CYAN}║${NC}  ${BOLD}[2] ⚡ Snell (v5.0.1)${NC}         -> ${RED}НЕ УСТАНОВЛЕН${NC}"
        fi
        echo -e "${CYAN}║${NC}"
        if is_wdtt_installed; then
            echo -e "${CYAN}║${NC}  ${BOLD}[3] 🛡️ WDTT / qwdtt${NC}          -> $(get_wdtt_status)"
            echo -e "${CYAN}║${NC}      Порт:   :${BOLD}$(get_wdtt_peer_port)/UDP${NC}   |  Фаервол: $(get_wdtt_fw_status)"
            echo -e "${CYAN}║${NC}      Профиль: ${BOLD}$(get_wdtt_profile_name)${NC}  |  Пароль: ${GREEN}$(get_wdtt_password)${NC}"
            echo -e "${CYAN}║${NC}      Маршрут: $(get_wdtt_routing)"
        else
            echo -e "${CYAN}║${NC}  ${BOLD}[3] 🛡️ WDTT / qwdtt${NC}          -> ${RED}НЕ УСТАНОВЛЕН${NC}"
        fi
        echo -e "${CYAN}║${NC}"
        if is_csqtt_installed; then
            echo -e "${CYAN}║${NC}  ${BOLD}[4] 🔒 CSQTT (VPN & Web-панель)${NC}-> $(get_csqtt_status)"
            echo -e "${CYAN}║${NC}      VPN порт:   :${BOLD}$(get_csqtt_peer_port)/UDP${NC}   |  Фаервол: $(get_csqtt_tunnel_status)"
            echo -e "${CYAN}║${NC}      Веб-панель: :${BOLD}$(get_csqtt_web_port)/TCP${NC}   |  Защита: $(get_csqtt_protect_status)"
            echo -e "${CYAN}║${NC}      Веб-вход:   Логин: ${GREEN}$(get_csqtt_user)${NC}  |  Пароль: ${GREEN}$(get_csqtt_pass)${NC}"
        else
            echo -e "${CYAN}║${NC}  ${BOLD}[4] 🔒 CSQTT (VPN & Web-панель)${NC}-> ${RED}НЕ УСТАНОВЛЕН${NC}"
        fi
        echo -e "${CYAN}║${NC}"
        if is_dns_installed; then
            echo -e "${CYAN}║${NC}  ${BOLD}[5] 🌐 DNS-Туннель (MasterDnsVPN)${NC}  -> $(get_dns_status)"
            echo -e "${CYAN}║${NC}      Домен: ${BOLD}$(get_dns_domain)${NC} (:53 UDP/TCP) | Фаервол WAN: $(get_dns_wan_status)"
            echo -e "${CYAN}║${NC}      Маршрут: $(get_dns_routing)"
        else
            echo -e "${CYAN}║${NC}  ${BOLD}[5] 🌐 DNS-Туннель (MasterDnsVPN)${NC}  -> ${RED}НЕ УСТАНОВЛЕН${NC}"
        fi
        echo -e "${CYAN}║${NC}"
        if is_sub_server_installed; then
            echo -e "${CYAN}║${NC}  ${BOLD}[6] 📋 Подписки TUNA${NC}          -> $(get_sub_server_status)"
            echo -e "${CYAN}║${NC}      API: http://127.0.0.1:22217   |  Порт: :22217 [127.0.0.1] 🔒"
        else
            echo -e "${CYAN}║${NC}  ${BOLD}[6] 📋 Подписки TUNA${NC}          -> ${RED}НЕ УСТАНОВЛЕН${NC}"
        fi
        echo -e "${CYAN}╚══════════════════════════════════════════════════════════════════════╝${NC}"
        echo ""
        echo -e "  ${GREEN}${BOLD}[1]${NC} 🚀 ${BOLD}Управление Mieru${NC} (Anti-TSPU, Egress, пользователи, порты, фаервол)"
        echo -e "  ${BLUE}${BOLD}[2]${NC} ⚡ ${BOLD}Управление Snell v5${NC} (0-RTT, Egress Xray/Direct, HTTP-obfs, фаервол)"
        echo -e "  ${PURPLE}${BOLD}[3]${NC} 🛡️  ${BOLD}Управление WDTT / qwdtt${NC} (Egress в ядро / Прямой выход, клиенты, фаервол)"
        echo -e "  ${CYAN}${BOLD}[4]${NC} 🔒 ${BOLD}Управление CSQTT${NC} (Защита веб-панели, туннель фаервол, логин/пароли)"
        echo -e "  ${YELLOW}${BOLD}[5]${NC} 🌐 ${BOLD}Управление DNS-туннелями${NC} (MasterDnsVPN / CottenDNS, stormdns://, WAN)"
        echo ""
        echo -e "  ${RED}${BOLD}[6]${NC} 🛡️  ${BOLD}Центр управления фаерволом портов${NC} (Включение/Выключение протоколов, Локдаун)"
        echo -e "  ${BOLD}[7]${NC} 📊 Сводный статус всех служб и портов сервера"
        echo -e "  ${BOLD}[8]${NC} 🔄 Перезапустить все сервисы (Mieru + Snell + WDTT + CSQTT + DNS)"
        echo -e "  ${BOLD}[9]${NC} 🔍 ${BOLD}Пересканировать и подхватить протоколы${NC} (Автоопределение установленных служб)"
        echo -e "  ${GREEN}${BOLD}[10]${NC} ⚙️  ${BOLD}Оптимизация и безопасность${NC} (DNS с пингом, BBR/буферы под RAM, Swap 2/4G, Fail2ban)"
        echo -e "  ${PURPLE}${BOLD}[11]${NC} 🔒 ${BOLD}Управление SSL-сертификатами${NC} (Cloudflare Wildcard / Standalone :80 / ACME / 3X-UI)"
        echo -e "  ${CYAN}${BOLD}[12]${NC} 📋 ${BOLD}Сервер подписок TUNA${NC} (Профили, выдача Base64-ссылок, ротация токенов)"
        echo -e "  ${BOLD}[0]${NC} 🚪 Выход"
        echo ""
        read -p "Выберите раздел [0-12]: " top_choice
        case "$top_choice" in
            1) menu_mieru ;;
            2) menu_snell ;;
            3) menu_wdtt ;;
            4) menu_csqtt ;;
            5) menu_dns ;;
            6) menu_firewall ;;
            7) view_global_status ;;
            8) restart_all_services ;;
            9) rescan_and_adopt_protocols ;;
            10) menu_system_opt ;;
            11) menu_ssl ;;
            12) menu_subscriptions ;;
            0) clear; exit 0 ;;
            *) echo "Неверный выбор"; sleep 1 ;;
        esac
    done
}

if [ "${BASH_SOURCE[0]}" = "$0" ]; then
    main_hub
fi
