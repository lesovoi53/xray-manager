reset_system_dns() {
    clear
    echo -e "${BOLD}--- Сброс системного DNS ---${NC}"
    read -p "Сбросить DNS на исходные настройки? [y/N]: " conf_res
    [[ ! "$conf_res" =~ ^[yY]$ ]] && return

    chattr -i /etc/resolv.conf 2>/dev/null || true
    rm -f /etc/systemd/resolved.conf.d/99-xmanager-dns.conf 2>/dev/null || true
    rm -f /etc/x-manager/dns_profile.txt 2>/dev/null || true

    if [ -f /etc/resolv.conf.x-bak ]; then
        cp /etc/resolv.conf.x-bak /etc/resolv.conf
        echo -e "${GREEN}✓ Восстановлен исходный /etc/resolv.conf${NC}"
    else
        cat > /etc/resolv.conf <<EOF
nameserver 1.1.1.1
nameserver 8.8.8.8
EOF
        echo -e "${GREEN}✓ Установлен стандартный fallback DNS (1.1.1.1, 8.8.8.8)${NC}"
    fi

    systemctl restart systemd-resolved 2>/dev/null || true
    sleep 1
    echo -e "Текущие DNS: ${GREEN}$(get_sys_dns_short)${NC}"
    read -p "Нажмите Enter для возврата..."
}

menu_dns_system() {
    while true; do
        clear
        echo -e "${CYAN}╔══════════════════════════════════════════════════════════════════════╗${NC}"
        echo -e "${CYAN}║${BOLD}              УПРАВЛЕНИЕ СИСТЕМНЫМ DNS СЕРВЕРА                        ${CYAN}║${NC}"
        echo -e "${CYAN}╠══════════════════════════════════════════════════════════════════════╣${NC}"
        echo -e "${CYAN}║${NC}  Текущие системные DNS: ${GREEN}${BOLD}$(get_sys_dns_short)${NC}"
        local active_prof="Пользовательский"
        [ -f /etc/x-manager/dns_profile.txt ] && active_prof=$(cat /etc/x-manager/dns_profile.txt | awk -F'|' '{print $1}')
        echo -e "${CYAN}║${NC}  Активный профиль:      ${CYAN}${active_prof}${NC}"
        echo -e "${CYAN}╚══════════════════════════════════════════════════════════════════════╝${NC}"
        echo ""
        echo -e "  ${YELLOW}[1]${NC} 🇷🇺 ${BOLD}Российские DNS-серверы${NC} (Yandex, Safe, Family, SkyDNS, Comss, MTS)"
        echo -e "  ${YELLOW}[2]${NC} 🌍 ${BOLD}Зарубежные DNS-серверы${NC} (Cloudflare, Google, Quad9, Control D, AdGuard...)"
        echo -e "  ${YELLOW}[3]${NC} ✍️  ${BOLD}Указать свой DNS вручную${NC} (Primary + Secondary IPv4)"
        echo -e "  ${YELLOW}[4]${NC} 🔄 ${BOLD}Сбросить DNS на стандартный${NC} (DHCP / от провайдера)"
        echo -e "  ${YELLOW}[5]${NC} 🧪 ${BOLD}Тест разрешения доменов${NC} (Проверка ya.ru и google.com)"
        echo -e "  ${YELLOW}[0]${NC} Назад"
        echo ""
        read -p "Выберите раздел [0-5]: " dns_top_ch
        case "$dns_top_ch" in
            1) menu_dns_russian ;;
            2) menu_dns_foreign ;;
            3)
                clear
                echo -e "${BOLD}--- Ручной ввод системных DNS ---${NC}"
                read -p "Введите основной DNS (Primary IPv4): " custom_p
                [ -z "$custom_p" ] && continue
                read -p "Введите резервный DNS (Secondary IPv4, можно оставить пустым): " custom_s
                apply_system_dns "$custom_p" "$custom_s" "Ручной ввод"
                ;;
            4) reset_system_dns ;;
            5)
                clear
                echo -e "${BOLD}--- Тест разрешения доменов через текущий системный DNS ---${NC}"
                echo -e "Текущие DNS: ${CYAN}$(get_sys_dns_short)${NC}"
                echo ""
                echo -e "Тестирование ya.ru..."
                local t_ya=$(getent ahostsv4 ya.ru 2>/dev/null | head -n2)
                [ -n "$t_ya" ] && echo -e "${GREEN}✓ ya.ru разрешен:${NC}\n$t_ya" || echo -e "${RED}✗ ya.ru не разрешился!${NC}"
                echo ""
                echo -e "Тестирование google.com..."
                local t_goog=$(getent ahostsv4 google.com 2>/dev/null | head -n2)
                [ -n "$t_goog" ] && echo -e "${GREEN}✓ google.com разрешен:${NC}\n$t_goog" || echo -e "${RED}✗ google.com не разрешился!${NC}"
                echo ""
                read -p "Нажмите Enter для возврата..."
                ;;
            0) return ;;
            *) echo "Неверный выбор"; sleep 1 ;;
        esac
    done
}

# ------------------------------------------------------------------------------
# BBR И СЕТЕВЫЕ БУФЕРЫ (ТЮНИНГ ПОД RAM)
# ------------------------------------------------------------------------------
apply_adaptive_bbr_tuning() {
    clear
    echo -e "${BOLD}--- Адаптивная оптимизация сетевых буферов и TCP BBR ---${NC}"
    local ram_mb=$(free -m | awk '/^Mem:/{print $2}')
    echo -e "Обнаружен объём оперативной памяти: ${CYAN}${ram_mb} MB${NC}"

    local rmem=16777216
    local wmem=16777216
    local somax=8192
    local syn_backlog=8192
    local tw_buckets=200000
    local prof_name="Standard Proxy VPS (1.5G - 4G)"

    if [ "$ram_mb" -lt 1500 ]; then
        prof_name="Low RAM VPS (до 1.5 ГБ)"
        rmem=8388608
        wmem=8388608
        somax=4096
        syn_backlog=4096
        tw_buckets=50000
    elif [ "$ram_mb" -gt 5000 ]; then
        prof_name="High Performance Server (> 4 ГБ)"
        rmem=33554432
        wmem=33554432
        somax=32768
        syn_backlog=16384
        tw_buckets=500000
    fi

    echo -e "Выбран оптимизационный профиль: ${GREEN}${prof_name}${NC}"
    echo -e "  • Алгоритм контроля перегрузки: ${BOLD}BBR + FQ${NC}"
    echo -e "  • Буферы сокетов rmem/wmem:     ${BOLD}$((rmem / 1048576)) MB${NC}"
    echo -e "  • Лимит очереди соединений:     ${BOLD}somaxconn = ${somax}${NC}"
    echo -e "  • TCP Fast Open:                ${BOLD}3 (Включен для входящих и исходящих)${NC}"
    echo ""

    modprobe tcp_bbr 2>/dev/null || true
    echo "tcp_bbr" > /etc/modules-load.d/bbr.conf 2>/dev/null || true

    [ -f /etc/sysctl.d/99-network-tuning.conf ] && cp /etc/sysctl.d/99-network-tuning.conf /etc/sysctl.d/99-network-tuning.conf.bak 2>/dev/null || true

    cat > /etc/sysctl.d/99-network-tuning.conf <<EOF
# Оптимизация сети и TCP BBR от x-manager
# Профиль: ${prof_name} (RAM: ${ram_mb} MB)

net.core.default_qdisc = fq
net.ipv4.tcp_congestion_control = bbr

net.core.rmem_max = ${rmem}
net.core.wmem_max = ${wmem}
net.core.rmem_default = 524288
net.core.wmem_default = 524288
net.ipv4.tcp_rmem = 4096 87380 ${rmem}
net.ipv4.tcp_wmem = 4096 65536 ${wmem}

net.core.somaxconn = ${somax}
net.core.netdev_max_backlog = 10000
net.ipv4.tcp_max_syn_backlog = ${syn_backlog}
net.ipv4.tcp_max_tw_buckets = ${tw_buckets}

net.ipv4.tcp_fastopen = 3
net.ipv4.tcp_tw_reuse = 1
net.ipv4.tcp_fin_timeout = 20
net.ipv4.tcp_slow_start_after_idle = 0
net.ipv4.tcp_keepalive_time = 300
net.ipv4.tcp_keepalive_intvl = 30
net.ipv4.tcp_keepalive_probes = 5
net.ipv4.tcp_mtu_probing = 1
fs.file-max = 1048576
EOF

    sysctl -p /etc/sysctl.d/99-network-tuning.conf >/dev/null 2>&1 || sysctl --system >/dev/null 2>&1

    sleep 1
    local new_cc=$(sysctl -n net.ipv4.tcp_congestion_control 2>/dev/null)
    local new_qd=$(sysctl -n net.core.default_qdisc 2>/dev/null)
    local new_tfo=$(sysctl -n net.ipv4.tcp_fastopen 2>/dev/null)

    echo -e "${GREEN}✓ Оптимизация успешно применена!${NC}"
    echo -e "  • Текущий алгоритм: ${GREEN}${new_cc}${NC} (очередь: ${GREEN}${new_qd}${NC})"
    echo -e "  • TCP Fast Open:    ${GREEN}${new_tfo}${NC}"
    echo -e "  • Конфиг сохранен в: ${CYAN}/etc/sysctl.d/99-network-tuning.conf${NC}"
    echo ""
    read -p "Нажмите Enter для возврата..."
}

menu_bbr_tuning() {
    while true; do
        clear
        local cur_cc=$(sysctl -n net.ipv4.tcp_congestion_control 2>/dev/null || echo "неизвестно")
        local cur_qd=$(sysctl -n net.core.default_qdisc 2>/dev/null || echo "неизвестно")
        local ram_total=$(free -h 2>/dev/null | awk '/^Mem:/{print $2}')
        local ram_mb=$(free -m 2>/dev/null | awk '/^Mem:/{print $2}')
        local cpus=$(nproc 2>/dev/null || echo "1")
        local kern=$(uname -r)

        echo -e "${CYAN}╔══════════════════════════════════════════════════════════════════════╗${NC}"
        echo -e "${CYAN}║${BOLD}         BBR И АДАПТИВНАЯ ОПТИМИЗАЦИЯ СЕТЕВЫХ БУФЕРОВ           ${CYAN}║${NC}"
        echo -e "${CYAN}╠══════════════════════════════════════════════════════════════════════╣${NC}"
        echo -e "${CYAN}║${NC}  Сервер:   ${BOLD}${SERVER_IP}${NC}  |  CPU: ${BOLD}${cpus} ядра${NC}  |  RAM: ${BOLD}${ram_total}${NC}  |  Ядро: ${kern}"
        echo -e "${CYAN}║${NC}"
        if [ "$cur_cc" = "bbr" ] && [ "$cur_qd" = "fq" ]; then
            echo -e "${CYAN}║${NC}  Статус BBR:      ${GREEN}${BOLD}✓ BBR АКТИВЕН (контроль: bbr, очередь: fq)${NC}"
        elif [ "$cur_cc" = "bbr" ]; then
            echo -e "${CYAN}║${NC}  Статус BBR:      ${GREEN}${BOLD}✓ BBR активен${NC} (очередь: ${cur_qd})"
        else
            echo -e "${CYAN}║${NC}  Статус BBR:      ${YELLOW}⚠ ВЫКЛЮЧЕН (алгоритм: ${cur_cc}, очередь: ${cur_qd})${NC}"
        fi
        echo -e "${CYAN}║${NC}  TCP Fast Open:   $(sysctl -n net.ipv4.tcp_fastopen 2>/dev/null || echo '0') (3 = Client+Server)"
        echo -e "${CYAN}║${NC}  Буфер приёма:    $(sysctl -n net.core.rmem_max 2>/dev/null || echo 'N/A') байт"
        echo -e "${CYAN}║${NC}  Буфер отправки:  $(sysctl -n net.core.wmem_max 2>/dev/null || echo 'N/A') байт"
        echo -e "${CYAN}║${NC}  Макс. соединений: somaxconn = $(sysctl -n net.core.somaxconn 2>/dev/null || echo 'N/A')"
        echo -e "${CYAN}╚══════════════════════════════════════════════════════════════════════╝${NC}"
        echo ""
        echo -e "  ${YELLOW}[1]${NC} 🚀 ${BOLD}Включить BBR и оптимизировать буферы под RAM сервера (${ram_total})${NC}"
        echo -e "  ${YELLOW}[2]${NC} 📊 Просмотреть текущую полную конфигурацию sysctl"
        echo -e "  ${YELLOW}[3]${NC} 🔄 Перепроверить статус BBR"
        echo -e "  ${YELLOW}[0]${NC} Назад"
        echo ""
        read -p "Выберите действие [0-3]: " bbr_choice
        case "$bbr_choice" in
            1) apply_adaptive_bbr_tuning ;;
            2)
                clear
                echo -e "${BOLD}--- Текущие параметры сети и ядра (sysctl) ---${NC}"
                sysctl net.ipv4.tcp_congestion_control net.core.default_qdisc net.ipv4.tcp_fastopen net.core.rmem_max net.core.wmem_max net.core.somaxconn net.ipv4.tcp_max_syn_backlog net.ipv4.tcp_tw_reuse net.ipv4.tcp_fin_timeout fs.file-max
                echo ""
                read -p "Нажмите Enter для возврата..."
                ;;
            3) sleep 0.5 ;;
            0) return ;;
            *) echo "Неверный выбор"; sleep 1 ;;
        esac
    done
}

# ------------------------------------------------------------------------------
# ФАЙЛ ПОДКАЧКИ SWAP (ВЫБОР 2G / 4G / УДАЛЕНИЕ)
# ------------------------------------------------------------------------------
create_or_resize_swap() {
    local target_gb="$1"
    local target_mb=$((target_gb * 1024))
    clear
    echo -e "${BOLD}--- Создание файла подкачки Swap ${target_gb} ГБ ---${NC}"

    local cur_swap_mb=$(free -m 2>/dev/null | awk '/^Swap:/{print $2}')
    local cur_swap_used=$(free -m 2>/dev/null | awk '/^Swap:/{print $3}')
    local free_ram_mb=$(free -m 2>/dev/null | awk '/^Mem:/{print $4}')
    local disk_free_mb=$(df -m / 2>/dev/null | awk 'NR==2{print $4}')

    local required_mb=$((target_mb + 500))
    if [ "$disk_free_mb" -lt "$required_mb" ]; then
        echo -e "${RED}❌ Ошибка: недостаточно места на диске!${NC}"
        echo -e "Требуется минимум: ${required_mb} MB, свободно: ${disk_free_mb} MB."
        read -p "Нажмите Enter для возврата..."
        return
    fi

    if [ -n "$cur_swap_mb" ] && [ "$cur_swap_mb" -gt 0 ]; then
        echo -e "${YELLOW}Обнаружен существующий Swap: ${cur_swap_mb} MB (занято: ${cur_swap_used} MB).${NC}"
        if [ "$cur_swap_mb" -eq "$target_mb" ]; then
            read -p "Swap уже имеет размер ${target_gb} ГБ. Пересоздать заново? [y/N]: " confirm_recreate
            [[ ! "$confirm_recreate" =~ ^[yY]$ ]] && return
        else
            read -p "Изменить текущий Swap (${cur_swap_mb} MB) на ${target_gb} ГБ? [Y/n]: " confirm_change
            [[ "$confirm_change" =~ ^[nN]$ ]] && return
        fi

        echo -e "${YELLOW}Безопасное отключение текущего Swap (swapoff)...${NC}"
        swapoff -a 2>/dev/null || true
    fi

    [ -f /swapfile ] && rm -f /swapfile

    echo -e "${YELLOW}Выделение файла /swapfile размером ${target_gb} ГБ...${NC}"
    if ! fallocate -l "${target_gb}G" /swapfile 2>/dev/null; then
        echo -e "${YELLOW}fallocate не поддерживается файловой системой, создаём через dd...${NC}"
        dd if=/dev/zero of=/swapfile bs=1M count="$target_mb" status=none
    fi

    chmod 600 /swapfile
    mkswap /swapfile >/dev/null 2>&1

    if ! swapon /swapfile 2>/dev/null; then
        echo -e "${YELLOW}Повторная инициализация через dd...${NC}"
        rm -f /swapfile
        dd if=/dev/zero of=/swapfile bs=1M count="$target_mb" status=none
        chmod 600 /swapfile
        mkswap /swapfile >/dev/null 2>&1
        swapon /swapfile
    fi

    sed -i '\|/swapfile|d' /etc/fstab 2>/dev/null || true
    echo '/swapfile none swap sw 0 0' >> /etc/fstab

    mkdir -p /etc/sysctl.d 2>/dev/null || true
    cat > /etc/sysctl.d/99-swap.conf <<EOF
vm.swappiness = 10
vm.vfs_cache_pressure = 50
EOF
    sysctl -p /etc/sysctl.d/99-swap.conf >/dev/null 2>&1 || true

    echo ""
    echo -e "${GREEN}✓ Swap-файл ${target_gb} ГБ успешно создан и подключен!${NC}"
    echo ""
    free -h
    echo ""
    read -p "Нажмите Enter для возврата..."
}

remove_swap() {
    clear
    echo -e "${BOLD}--- Отключение и удаление Swap-файла ---${NC}"
    local cur_swap_mb=$(free -m 2>/dev/null | awk '/^Swap:/{print $2}')
    if [ -z "$cur_swap_mb" ] || [ "$cur_swap_mb" -eq 0 ]; then
        echo -e "${YELLOW}Swap не обнаружен или уже отключен.${NC}"
        sleep 2
        return
    fi

    read -p "Вы уверены, что хотите полностью отключить и удалить Swap? [y/N]: " confirm_del
    [[ ! "$confirm_del" =~ ^[yY]$ ]] && return

    echo -e "${YELLOW}Отключение подкачки (swapoff)...${NC}"
    swapoff -a 2>/dev/null || true
    [ -f /swapfile ] && rm -f /swapfile
    sed -i '\|/swapfile|d' /etc/fstab 2>/dev/null || true
    rm -f /etc/sysctl.d/99-swap.conf 2>/dev/null || true

    echo -e "${GREEN}✓ Swap успешно отключен и удален!${NC}"
    sleep 2
}

configure_swappiness() {
    clear
    echo -e "${BOLD}--- Настройка vm.swappiness (агрессивность использования Swap) ---${NC}"
    echo -e "Текущее значение: ${GREEN}$(sysctl -n vm.swappiness 2>/dev/null)${NC}"
    echo ""
    echo -e "  ${YELLOW}[1]${NC} 10 (Рекомендуется для SSD/NVMe — использование памяти до последнего)"
    echo -e "  ${YELLOW}[2]${NC} 20 (Сбалансированное значение)"
    echo -e "  ${YELLOW}[3]${NC} 60 (Стандартное значение ядра Linux)"
    echo -e "  ${YELLOW}[4]${NC} Ввести своё значение (0-100)"
    echo -e "  ${YELLOW}[0]${NC} Отмена"
    echo ""
    read -p "Выберите вариант [0-4]: " swp_c
    local val=""
    case "$swp_c" in
        1) val="10" ;;
        2) val="20" ;;
        3) val="60" ;;
        4) read -p "Введите значение (0-100): " val ;;
        *) return ;;
    esac
    if [ -n "$val" ]; then
        mkdir -p /etc/sysctl.d 2>/dev/null || true
        echo "vm.swappiness = $val" > /etc/sysctl.d/99-swap.conf
        echo "vm.vfs_cache_pressure = 50" >> /etc/sysctl.d/99-swap.conf
        sysctl -p /etc/sysctl.d/99-swap.conf >/dev/null 2>&1 || true
        echo -e "${GREEN}✓ Установлен vm.swappiness = $val${NC}"
        sleep 2
    fi
}

menu_swap_manager() {
    while true; do
        clear
        local swap_total_mb=$(free -m 2>/dev/null | awk '/^Swap:/{print $2}')
        local swap_used_mb=$(free -m 2>/dev/null | awk '/^Swap:/{print $3}')
        local swap_free_mb=$(free -m 2>/dev/null | awk '/^Swap:/{print $4}')
        local swap_total_h=$(free -h 2>/dev/null | awk '/^Swap:/{print $2}')
        local swap_used_h=$(free -h 2>/dev/null | awk '/^Swap:/{print $3}')
        local cur_swappiness=$(sysctl -n vm.swappiness 2>/dev/null || echo "60")
        local cur_swap_path=$(swapon --show=NAME --noheadings 2>/dev/null | head -n1)
        local disk_free_mb=$(df -m / 2>/dev/null | awk 'NR==2{print $4}')

        echo -e "${CYAN}╔══════════════════════════════════════════════════════════════════════╗${NC}"
        echo -e "${CYAN}║${BOLD}               УПРАВЛЕНИЕ ФАЙЛОМ ПОДКАЧКИ (SWAP)               ${CYAN}║${NC}"
        echo -e "${CYAN}╠══════════════════════════════════════════════════════════════════════╣${NC}"
        if [ -n "$swap_total_mb" ] && [ "$swap_total_mb" -gt 0 ]; then
            echo -e "${CYAN}║${NC}  Статус Swap:      ${GREEN}${BOLD}АКТИВЕН (${swap_total_h})${NC}"
            echo -e "${CYAN}║${NC}  Использование:    ${BOLD}${swap_used_h}${NC} занято / свободно: ${BOLD}${swap_free_mb} MB${NC}"
            echo -e "${CYAN}║${NC}  Файл подкачки:    ${CYAN}${cur_swap_path}${NC}"
        else
            echo -e "${CYAN}║${NC}  Статус Swap:      ${YELLOW}${BOLD}НЕ СОЗДАН (0 MB)${NC}"
        fi
        echo -e "${CYAN}║${NC}  Swappiness:       ${BOLD}${cur_swappiness}${NC} (Рекомендуется 10 для SSD)"
        echo -e "${CYAN}║${NC}  Свободно на диске: ${BOLD}${disk_free_mb} MB${NC}"
        echo -e "${CYAN}╚══════════════════════════════════════════════════════════════════════╝${NC}"
        echo ""
        echo -e "  ${YELLOW}[1]${NC} 💾 Создать / Пересоздать Swap-файл ${BOLD}2 ГБ${NC} (/swapfile)"
        echo -e "  ${YELLOW}[2]${NC} 💾 Создать / Пересоздать Swap-файл ${BOLD}4 ГБ${NC} (/swapfile)"
        echo -e "  ${YELLOW}[3]${NC} ⚙️  Настроить swappiness (10 / 20 / 60)"
        echo -e "  ${YELLOW}[4]${NC} 🗑️  Отключить и удалить Swap-файл"
        echo -e "  ${YELLOW}[0]${NC} Назад"
        echo ""
        read -p "Выберите действие [0-4]: " sw_choice
        case "$sw_choice" in
            1) create_or_resize_swap 2 ;;
            2) create_or_resize_swap 4 ;;
            3) configure_swappiness ;;
            4) remove_swap ;;
            0) return ;;
            *) echo "Неверный выбор"; sleep 1 ;;
        esac
    done
}

# ------------------------------------------------------------------------------
# FAIL2BAN: УСТАНОВКА И УПРАВЛЕНИЕ ЗАЩИТОЙ SSH
# ------------------------------------------------------------------------------
detect_ssh_port() {
    local p=$(ss -tlnp 2>/dev/null | grep -E 'sshd|/sshd' | awk '{print $4}' | awk -F':' '{print $NF}' | head -n1)
    if [ -z "$p" ]; then
        p=$(grep -a -E "^[[:space:]]*Port[[:space:]]+" /etc/ssh/sshd_config 2>/dev/null | awk '{print $2}' | head -n1)
    fi
    if [ -z "$p" ] && [ -n "$SSH_CONNECTION" ]; then
        p=$(echo "$SSH_CONNECTION" | awk '{print $4}')
    fi
    [ -z "$p" ] && p="22"
    echo "$p"
}

sync_fail2ban_ssh_port() {
    local ssh_p=$(detect_ssh_port)
    mkdir -p /etc/fail2ban/jail.d 2>/dev/null || true

    cat > /etc/fail2ban/jail.d/99-xmanager-ssh.local <<EOF
[sshd]
enabled = true
port = ${ssh_p}
filter = sshd
backend = systemd
maxretry = 5
findtime = 10m
bantime = 1h
ignoreip = 127.0.0.1/8 ::1
EOF
    systemctl restart fail2ban 2>/dev/null || true
    echo -e "${GREEN}✓ Защита SSH настроена для порта :${ssh_p} (/etc/fail2ban/jail.d/99-xmanager-ssh.local)${NC}"
}

install_configure_fail2ban() {
    clear
    echo -e "${BOLD}--- Установка и базовая настройка Fail2ban ---${NC}"
    local ssh_p=$(detect_ssh_port)
    echo -e "Обнаружен рабочий порт SSH: ${CYAN}:${ssh_p}${NC}"
    echo ""

    if ! which fail2ban-client >/dev/null 2>&1; then
        echo -e "${YELLOW}Установка пакета fail2ban через apt...${NC}"
        apt-get update -y >/dev/null 2>&1
        apt-get install -y fail2ban
    fi

    sync_fail2ban_ssh_port
    systemctl enable fail2ban 2>/dev/null || true
    systemctl restart fail2ban 2>/dev/null || true
    sleep 2

    if systemctl is-active --quiet fail2ban; then
        echo -e "${GREEN}✓ Fail2ban успешно установлен и запущен!${NC}"
        echo -e "  • Защита SSH: порт ${CYAN}:${ssh_p}${NC}"
        echo -e "  • Время бана:  ${BOLD}1 час${NC}"
        echo -e "  • Лимит:       ${BOLD}5 неудачных попыток за 10 минут${NC}"
    else
        echo -e "${RED}✗ Ошибка запуска службы fail2ban!${NC}"
        journalctl -u fail2ban -n 8 --no-pager
    fi
    echo ""
    read -p "Нажмите Enter для возврата..."
}

show_fail2ban_banned() {
    clear
    echo -e "${BOLD}--- Список заблокированных IP-адресов Fail2ban ---${NC}"
    echo ""
    local jails=$(fail2ban-client status 2>/dev/null | grep "Jail list:" | sed 's/.*Jail list:[[:space:]]*//')
    if [ -z "$jails" ]; then
        echo -e "${YELLOW}Нет активных джейлов.${NC}"
    else
        for j in $(echo "$jails" | tr ',' ' '); do
            echo -e "${CYAN}${BOLD}=== Джейл: ${j} ===${NC}"
            fail2ban-client status "$j" 2>/dev/null | grep -E "Currently failed:|Total failed:|Currently banned:|Total banned:|Banned IP list:"
            echo ""
        done
    fi
    read -p "Нажмите Enter для возврата..."
}

unban_ip_fail2ban() {
    clear
    echo -e "${BOLD}--- Разблокировка IP-адреса (Unban) ---${NC}"
    echo ""
    read -p "Введите IP-адрес для разблокировки (или 'all' для разбана всех): " un_ip
    [ -z "$un_ip" ] && return

    local jails=$(fail2ban-client status 2>/dev/null | grep "Jail list:" | sed 's/.*Jail list:[[:space:]]*//')
    if [ "$un_ip" = "all" ]; then
        echo -e "${YELLOW}Снятие бана со всех IP во всех джейлах...${NC}"
        for j in $(echo "$jails" | tr ',' ' '); do
            fail2ban-client unban --all 2>/dev/null || true
        done
        echo -e "${GREEN}✓ Все IP успешно разблокированы!${NC}"
    else
        for j in $(echo "$jails" | tr ',' ' '); do
            fail2ban-client set "$j" unbanip "$un_ip" 2>/dev/null || true
        done
        echo -e "${GREEN}✓ Команда разблокировки отправлена для ${un_ip}${NC}"
    fi
    sleep 2
}

ban_ip_fail2ban() {
    clear
    echo -e "${BOLD}--- Ручная блокировка IP-адреса (Ban) ---${NC}"
    echo ""
    read -p "Введите IP-адрес для блокировки: " b_ip
    [ -z "$b_ip" ] && return

    fail2ban-client set sshd banip "$b_ip" 2>/dev/null || true
    echo -e "${GREEN}✓ IP-адрес ${b_ip} заблокирован в джейле sshd!${NC}"
    sleep 2
}

configure_fail2ban_timings() {
    clear
    echo -e "${BOLD}--- Настройка времени блокировки Fail2ban ---${NC}"
    echo ""
    echo -e "  ${YELLOW}[1]${NC} 1 час (3600 с, 5 попыток)"
    echo -e "  ${YELLOW}[2]${NC} 24 часа (86400 с, 3 попытки)"
    echo -e "  ${YELLOW}[3]${NC} 7 дней (604800 с, 3 попытки)"
    echo -e "  ${YELLOW}[4]${NC} Навсегда (-1, 3 попытки)"
    echo -e "  ${YELLOW}[0]${NC} Отмена"
    echo ""
    read -p "Выберите вариант [0-4]: " t_ch
    local b_time="1h"
    local m_retry="5"
    case "$t_ch" in
        1) b_time="1h"; m_retry="5" ;;
        2) b_time="24h"; m_retry="3" ;;
        3) b_time="7d"; m_retry="3" ;;
        4) b_time="-1"; m_retry="3" ;;
        *) return ;;
    esac

    local ssh_p=$(detect_ssh_port)
    cat > /etc/fail2ban/jail.d/99-xmanager-ssh.local <<EOF
[sshd]
enabled = true
port = ${ssh_p}
filter = sshd
backend = systemd
maxretry = ${m_retry}
findtime = 10m
bantime = ${b_time}
ignoreip = 127.0.0.1/8 ::1
EOF
    systemctl restart fail2ban 2>/dev/null || true
    echo -e "${GREEN}✓ Параметры сохранены: bantime=${b_time}, maxretry=${m_retry}${NC}"
    sleep 2
}

menu_fail2ban() {
    while true; do
        clear
        local is_inst=false
        local is_act=false
        which fail2ban-client >/dev/null 2>&1 && is_inst=true
        systemctl is-active --quiet fail2ban 2>/dev/null && is_act=true
        local ssh_p=$(detect_ssh_port)

        echo -e "${CYAN}╔══════════════════════════════════════════════════════════════════════╗${NC}"
        echo -e "${CYAN}║${BOLD}                  УПРАВЛЕНИЕ ЗАЩИТОЙ FAIL2BAN                  ${CYAN}║${NC}"
        echo -e "${CYAN}╠══════════════════════════════════════════════════════════════════════╣${NC}"
        if ! $is_inst; then
            echo -e "${CYAN}║${NC}  Статус:          ${RED}${BOLD}НЕ УСТАНОВЛЕН${NC}"
            echo -e "${CYAN}║${NC}  Порт SSH:        ${CYAN}:${ssh_p}${NC}"
            echo -e "${CYAN}╚══════════════════════════════════════════════════════════════════════╝${NC}"
            echo ""
            echo -e "  ${YELLOW}[1]${NC} 🛡️  ${BOLD}Установить Fail2ban и включить защиту SSH (порт :${ssh_p})${NC}"
            echo -e "  ${YELLOW}[0]${NC} Назад"
            echo ""
            read -p "Выберите действие [0-1]: " f2b_ch
            case "$f2b_ch" in
                1) install_configure_fail2ban ;;
                0) return ;;
                *) echo "Неверный выбор"; sleep 1 ;;
            esac
            continue
        fi

        local jails=$(fail2ban-client status 2>/dev/null | grep "Jail list:" | sed 's/.*Jail list:[[:space:]]*//')
        local banned_cnt=0
        if [ -n "$jails" ]; then
            for j in $(echo "$jails" | tr ',' ' '); do
                local cnt=$(fail2ban-client status "$j" 2>/dev/null | awk -F':' '/Currently banned/{print $2}' | tr -d ' ')
                [ -n "$cnt" ] && banned_cnt=$((banned_cnt + cnt))
            done
        fi

        if $is_act; then
            echo -e "${CYAN}║${NC}  Статус:          ${GREEN}${BOLD}АКТИВЕН (Служба работает)${NC}"
            echo -e "${CYAN}║${NC}  Активные джейлы: ${GREEN}${jails:-Нет}${NC}"
            echo -e "${CYAN}║${NC}  Забанено IP:     ${YELLOW}${banned_cnt} IP${NC}"
        else
            echo -e "${CYAN}║${NC}  Статус:          ${YELLOW}${BOLD}ОСТАНОВЛЕН (Установлен)${NC}"
        fi
        echo -e "${CYAN}║${NC}  Порт SSH:        ${CYAN}:${ssh_p}${NC}"
        echo -e "${CYAN}╚══════════════════════════════════════════════════════════════════════╝${NC}"
        echo ""
        echo -e "  ${YELLOW}[1]${NC} 📋 Список заблокированных IP-адресов"
        echo -e "  ${YELLOW}[2]${NC} 🔓 Разблокировать IP-адрес (Unban IP)"
        echo -e "  ${YELLOW}[3]${NC} 🔒 Заблокировать IP-адрес вручную (Ban IP)"
        echo -e "  ${YELLOW}[4]${NC} ⏱️  Настроить параметры бана (время бана, попытки)"
        echo -e "  ${YELLOW}[5]${NC} 🎯 Проверить / синхронизировать защиту порта SSH (:${ssh_p})"
        echo -e "  ${YELLOW}[6]${NC} 🔄 Перезапустить службу Fail2ban"
        echo -e "  ${YELLOW}[7]${NC} 🛑 Остановить / Запустить Fail2ban"
        echo -e "  ${YELLOW}[0]${NC} Назад"
        echo ""
        read -p "Выберите действие [0-7]: " f2b_ch
        case "$f2b_ch" in
            1) show_fail2ban_banned ;;
            2) unban_ip_fail2ban ;;
            3) ban_ip_fail2ban ;;
            4) configure_fail2ban_timings ;;
            5) sync_fail2ban_ssh_port ;;
            6)
                systemctl restart fail2ban
                echo -e "${GREEN}✓ Fail2ban успешно перезапущен!${NC}"
                sleep 2
                ;;
            7)
                if $is_act; then
                    systemctl stop fail2ban
                    echo -e "${YELLOW}Fail2ban остановлен.${NC}"
                else
                    systemctl start fail2ban
                    echo -e "${GREEN}Fail2ban запущен.${NC}"
                fi
                sleep 2
                ;;
            0) return ;;
            *) echo "Неверный выбор"; sleep 1 ;;
        esac
    done
}

# ------------------------------------------------------------------------------
# ГЛАВНЫЙ РАЗДЕЛ: СИСТЕМНЫЕ НАСТРОЙКИ И ОПТИМИЗАЦИЯ
# ------------------------------------------------------------------------------
menu_system_opt() {
    while true; do
        clear
        local cur_dns=$(get_sys_dns_short)
        local cur_bbr=$(get_bbr_short_status)
        local cur_swap=$(get_swap_short_status)
        local cur_f2b=$(get_f2b_short_status)
        local ram_h=$(free -h 2>/dev/null | awk '/^Mem:/{print $2}')
        local cpus=$(nproc 2>/dev/null || echo "1")
        local kern=$(uname -r)

        echo -e "${CYAN}╔══════════════════════════════════════════════════════════════════════╗${NC}"
        echo -e "${CYAN}║${BOLD}        СИСТЕМНЫЕ НАСТРОЙКИ, ОПТИМИЗАЦИЯ И БЕЗОПАСНОСТЬ        ${CYAN}║${NC}"
        echo -e "${CYAN}╠══════════════════════════════════════════════════════════════════════╣${NC}"
        echo -e "${CYAN}║${NC}  Сервер:    ${BOLD}${SERVER_IP}${NC}  |  CPU: ${BOLD}${cpus} ядра${NC}  |  RAM: ${BOLD}${ram_h}${NC}  |  Ядро: ${kern}"
        echo -e "${CYAN}║${NC}"
        echo -e "${CYAN}║${NC}  • Системный DNS:  ${GREEN}${cur_dns}${NC}"
        echo -e "${CYAN}║${NC}  • BBR & Буферы:   ${cur_bbr}"
        echo -e "${CYAN}║${NC}  • Файл подкачки:  ${cur_swap}"
        echo -e "${CYAN}║${NC}  • Fail2ban:       ${cur_f2b}"
        echo -e "${CYAN}╚══════════════════════════════════════════════════════════════════════╝${NC}"
        echo ""
        echo -e "  ${GREEN}${BOLD}[1]${NC} 🌐 ${BOLD}Смена системного DNS${NC} (Российские / Зарубежные DNS с пингом)"
        echo -e "  ${BLUE}${BOLD}[2]${NC} 🚀 ${BOLD}Включить BBR и оптимизировать сетевые буферы${NC} (TCP тюнинг под RAM)"
        echo -e "  ${PURPLE}${BOLD}[3]${NC} 💾 ${BOLD}Управление файлом подкачки SWAP${NC} (Выбор 2 ГБ / 4 ГБ, статус, удаление)"
        echo -e "  ${RED}${BOLD}[4]${NC} 🛡️  ${BOLD}Управление Fail2ban${NC} (Установка, защита SSH, забаненные IP, unban)"
        echo ""
        echo -e "  ${YELLOW}${BOLD}[5]${NC} 📊 Сводный отчет о характеристиках сервера и сети"
        echo -e "  ${BOLD}[0]${NC} 🚪 Назад в главное меню"
        echo ""
        read -p "Выберите раздел [0-5]: " sys_choice
        case "$sys_choice" in
            1) menu_dns_system ;;
            2) menu_bbr_tuning ;;
            3) menu_swap_manager ;;
            4) menu_fail2ban ;;
            5)
                clear
                echo -e "${BOLD}=== СВОДНЫЙ ОТЧЁТ О СИСТЕМЕ И СЕТИ ===${NC}"
                echo ""
                echo -e "${CYAN}--- Память и подкачка ---${NC}"
                free -h
                echo ""
                echo -e "${CYAN}--- Дисковое пространство ---${NC}"
                df -h /
                echo ""
                echo -e "${CYAN}--- Сетевые параметры ядра (sysctl) ---${NC}"
                sysctl net.ipv4.tcp_congestion_control net.core.default_qdisc net.ipv4.tcp_fastopen net.core.rmem_max net.core.wmem_max net.core.somaxconn vm.swappiness
                echo ""
                echo -e "${CYAN}--- Системный DNS (/etc/resolv.conf) ---${NC}"
                cat /etc/resolv.conf | grep -E '^nameserver|^options'
                echo ""
                read -p "Нажмите Enter для возврата..."
                ;;
            0) return ;;
            *) echo "Неверный выбор"; sleep 1 ;;
        esac
    done
}

# ==============================================================================
# РАЗДЕЛ 12: СЕРВЕР ПОДПИСОК TUNA (TUNA-SUBSCRIPTIONS)
# ==============================================================================

is_sub_server_installed() {
    [ -f "/usr/local/bin/tuna-subscriptions" ] || [ -f "/etc/systemd/system/tuna-subscriptions.service" ]
}

get_sub_server_status() {
    if ! is_sub_server_installed; then
        echo -e "${RED}НЕ УСТАНОВЛЕН${NC}"
        return
    fi
    if systemctl is-active --quiet tuna-subscriptions 2>/dev/null; then
        echo -e "${GREEN}🟢 РАБОТАЕТ (Active)${NC}"
    else
        echo -e "${RED}🔴 ОСТАНОВЛЕН (Inactive)${NC}"
    fi
}

get_sub_server_short_status() {
    if systemctl is-active --quiet tuna-subscriptions 2>/dev/null; then
        echo -e "${GREEN}Active${NC}"
    else
        echo -e "${RED}Inactive${NC}"
    fi
}

extract_current_server_links() {
    local nick="$1"
    [ -z "$nick" ] && nick="user_$(date +%s)"

    # 1. Snell URI
    local s_uri=""
    if is_snell_installed; then
        local s_port=$(get_snell_port)
        local s_psk=$(get_snell_psk)
        if [ -n "$s_port" ] && [ -n "$s_psk" ]; then
            s_uri="snell://${s_psk}@${SERVER_IP}:${s_port}/?version=5&reuse=true&tfo=true#Snell-v5"
        fi
    fi

    # 2. WDTT URI
    local w_uri=""
    if is_wdtt_installed; then
        local w_port=$(get_wdtt_peer_port)
        local w_pass=$(get_wdtt_password)
        local w_name=$(get_wdtt_profile_name)
        if [ -n "$w_port" ] && [ -n "$w_pass" ]; then
            w_uri=$(python3 -c "
import urllib.parse, sys
name, ip, port, password = sys.argv[1], sys.argv[2], sys.argv[3], sys.argv[4]
print(f'qwdtt://config?name={urllib.parse.quote_plus(name)}&peer={ip}%3A{port}&hashes=&workers=18&port=9000&pass={urllib.parse.quote_plus(password)}')
" "$w_name" "$SERVER_IP" "$w_port" "$w_pass" 2>/dev/null || echo "")
        fi
    fi

    # 3. Mieru URI
    local m_uri=""
    if is_mieru_installed && [ -f "$MIERU_USER_STORE" ]; then
        local m_first_user=$(jq -r 'keys[0] // empty' "$MIERU_USER_STORE" 2>/dev/null || echo "")
        if [ -n "$m_first_user" ]; then
            local m_pass=$(jq -r --arg u "$m_first_user" '.[$u]' "$MIERU_USER_STORE" 2>/dev/null || echo "")
            local ports_str=$(get_mieru_ports)
            local p_range=$(echo "$ports_str" | cut -d'/' -f1)
            local proto=$(echo "$ports_str" | cut -d'/' -f2)
            local pattern=$(mita export traffic-pattern 2>/dev/null || echo "")
            m_uri="mierus://${m_first_user}:${m_pass}@${SERVER_IP}/?profile=Mieru-Home&port=${p_range}&protocol=${proto}&multiplexing=MULTIPLEXING_HIGH&traffic-pattern=${pattern}&low-entropy-mode=LOW_ENTROPY_MODE_48&low-entropy-mask-rotation=LOW_ENTROPY_MASK_ROTATE_RIGHT_7"
        fi
    fi

    # 4. CSQTT URI
    local c_uri=""
    if is_csqtt_installed; then
        c_uri=$(get_csqtt_link 2>/dev/null || echo "")
    fi

    # 5. MasterDnsVPN URI
    local d_uri=""
    if is_dns_installed; then
        d_uri=$(get_stormdns_link 1 2>/dev/null || echo "")
    fi

    python3 -c "
import json, sys
data = {
    'nickname': sys.argv[1],
    'snell_uri': sys.argv[2],
    'qwdtt_uri': sys.argv[3],
    'mieru_uri': sys.argv[4],
    'csqtt_uri': sys.argv[5],
    'masterdnsvpn_uri': sys.argv[6]
}
print(json.dumps(data))
" "$nick" "$s_uri" "$w_uri" "$m_uri" "$c_uri" "$d_uri"
}

collect_multi_uris() {
    local proto_title="$1"
    local proto_example="$2"
    local uris_collected=()

    echo -e "\n${BOLD}${CYAN}► Ссылки протокола: ${YELLOW}${proto_title}${NC}" >&2
    if [ -n "$proto_example" ]; then
        echo -e "  ${GRAY}Формат/Пример: ${proto_example}${NC}" >&2
    fi
    echo -e "  ${GRAY}(Вводите ссылки по одной или вставьте сразу блок строк. Пустой Enter — завершить)${NC}" >&2

    local count=1
    while true; do
        read -r -p "  [#${count}] Ссылка (или Enter для перехода): " single_u < /dev/tty 2>/dev/null || read -r -p "  [#${count}] Ссылка (или Enter для перехода): " single_u
        single_u=$(echo "$single_u" | sed -e 's/^[[:space:]]*//' -e 's/[[:space:]]*$//')
        if [ -z "$single_u" ]; then
            break
        fi
        while IFS= read -r line; do
            line=$(echo "$line" | sed -e 's/^[[:space:]]*//' -e 's/[[:space:]]*$//')
            if [ -n "$line" ]; then
                # Возможность индивидуально задать имя сервера/подключения для ссылки CSQTT
                if [[ "$proto_title" =~ CSQTT ]] || [[ "$line" =~ ^csqtt:// ]]; then
                    local cur_tag=""
                    if [[ "$line" =~ \#(.*)$ ]]; then
                        cur_tag="${BASH_REMATCH[1]}"
                    fi
                    local prompt_lbl="     🏷️  Имя подключения/сервера CSQTT"
                    if [ -n "$cur_tag" ]; then
                        prompt_lbl="${prompt_lbl} (сейчас: '${cur_tag}')"
                    fi
                    prompt_lbl="${prompt_lbl} [Enter - оставить]: "
                    local node_name=""
                    read -r -p "$prompt_lbl" node_name < /dev/tty 2>/dev/null || read -r -p "$prompt_lbl" node_name
                    node_name=$(echo "$node_name" | sed -e 's/^[[:space:]]*//' -e 's/[[:space:]]*$//')
                    if [ -n "$node_name" ]; then
                        line="$(echo "$line" | sed 's/#.*$//')#${node_name}"
                    fi
                fi
                uris_collected+=("$line")
                local preview="${line:0:55}"
                [ "${#line}" -gt 55 ] && preview="${preview}..."
                echo -e "     ${GREEN}✓ Добавлен узел #${#uris_collected[@]}:${NC} ${preview}" >&2
            fi
        done <<< "$single_u"
        count=$((${#uris_collected[@]} + 1))
    done

    local result=""
    for u in "${uris_collected[@]}"; do
        if [ -z "$result" ]; then
            result="$u"
        else
            result="${result}
${u}"
        fi
    done
    printf "%s" "$result"
}

select_sub_user() {
    local SUB_API="http://127.0.0.1:22217"
    local raw_users=$(curl -s "${SUB_API}/api/users" 2>/dev/null || echo "")
    if [ -z "$raw_users" ] || [ "$raw_users" = "[]" ]; then
        if [ -f "/var/lib/tuna-subscriptions/subscriptions.db" ]; then
            raw_users=$(python3 -c "
import sqlite3, json
try:
    with sqlite3.connect('/var/lib/tuna-subscriptions/subscriptions.db') as conn:
        conn.row_factory = sqlite3.Row
        rows = conn.execute('SELECT id, nickname, enabled FROM users').fetchall()
        print(json.dumps([{'id': r['id'], 'nickname': r['nickname'], 'enabled': bool(r['enabled']), 'total_uris': 0} for r in rows]))
except Exception:
    print('[]')
" 2>/dev/null || echo "[]")
        fi
    fi

    if [ -z "$raw_users" ] || [ "$raw_users" = "[]" ]; then
        echo -e "${YELLOW}Пользователи еще не созданы или служба tuna-subscriptions не запущена.${NC}" >&2
        return 1
    fi

    echo -e "${CYAN}╔══════════════════════════════════════════════════════════════════════╗${NC}" >&2
    echo -e "${CYAN}║${BOLD}                  ВЫБОР ПОЛЬЗОВАТЕЛЯ ПОДПИСКИ                         ${CYAN}║${NC}" >&2
    echo -e "${CYAN}╚══════════════════════════════════════════════════════════════════════╝${NC}" >&2

    local py_res
    py_res=$(python3 -c '
import json, sys
try:
    users = json.loads(sys.argv[1])
    for idx, u in enumerate(users, 1):
        nick = u.get("nickname", "N/A")
        uid = u.get("id", "")
        en = "🟢" if u.get("enabled") else "🔴"
        tot = u.get("total_uris", 0)
        print(f"{idx}\t{uid}\t{nick}\t{en}\t{tot}")
except Exception:
    pass
' "$raw_users" 2>/dev/null)

    if [ -z "$py_res" ]; then
        echo -e "${RED}Не удалось разобрать список пользователей.${NC}" >&2
        return 1
    fi

    local lines=()
    while IFS= read -r line; do
        [ -n "$line" ] && lines+=("$line")
    done <<< "$py_res"

    local total="${#lines[@]}"
    for item in "${lines[@]}"; do
        local num=$(echo "$item" | cut -f1)
        local uid=$(echo "$item" | cut -f2)
        local nick=$(echo "$item" | cut -f3)
        local en=$(echo "$item" | cut -f4)
        local tot=$(echo "$item" | cut -f5)
        local short_id="${uid:0:8}..."
        printf "  \033[1;33m[%2s]\033[0m %b \033[1;32m%-16s\033[0m (Узлов: \033[1;33m%2s\033[0m, ID: \033[0;36m%s\033[0m)\n" "$num" "$en" "$nick" "$tot" "$short_id" >&2
    done
    echo -e "  ${YELLOW}[ 0]${NC} ⬅️  Отмена" >&2
    echo "" >&2

    echo -ne "  ${BOLD}Выберите номер [1-${total}] или введите никнейм/ID: ${NC}" >&2
    read -r user_choice < /dev/tty 2>/dev/null || read -r user_choice
    user_choice=$(echo "$user_choice" | sed -e 's/^[[:space:]]*//' -e 's/[[:space:]]*$//')

    if [ -z "$user_choice" ] || [ "$user_choice" = "0" ]; then
        return 1
    fi

    if [[ "$user_choice" =~ ^[0-9]+$ ]] && [ "$user_choice" -ge 1 ] && [ "$user_choice" -le "$total" ]; then
        local chosen_line="${lines[$((user_choice - 1))]}"
        local chosen_id=$(echo "$chosen_line" | cut -f2 | tr -d ' \r\n')
        echo "$chosen_id"
        return 0
    fi

    for item in "${lines[@]}"; do
        local uid=$(echo "$item" | cut -f2 | tr -d ' \r\n')
        local nick=$(echo "$item" | cut -f3 | tr -d ' \r\n')
        if [ "$user_choice" = "$nick" ] || [ "$user_choice" = "$uid" ]; then
            echo "$uid"
            return 0
        fi
    done

    # Дополнительная проверка напрямую в базе данных SQLite
    if [ -f "/var/lib/tuna-subscriptions/subscriptions.db" ]; then
        local direct_id=$(python3 -c "
import sqlite3, sys
db = '/var/lib/tuna-subscriptions/subscriptions.db'
q = sys.argv[1].strip()
try:
    with sqlite3.connect(db) as conn:
        row = conn.execute('SELECT id FROM users WHERE id = ? OR nickname = ?', (q, q)).fetchone()
        if row:
            print(row[0])
except Exception:
    pass
" "$user_choice" 2>/dev/null || true)
        if [ -n "$direct_id" ]; then
            echo "$direct_id" | tr -d ' \r\n'
            return 0
        fi
    fi

    echo "$user_choice" | tr -d ' \r\n'
    return 0
}

delete_sub_user_safe() {
    local SUB_API="http://127.0.0.1:22217"
    local target="$1"
    if [ -z "$target" ]; then
        target=$(select_sub_user)
        [ -z "$target" ] && return 1
    fi

    local u_id=""
    local u_nick=""

    # 1. Попытка получить информацию через API
    local u_info=$(curl -s "${SUB_API}/api/users/${target}" 2>/dev/null || echo "")
    u_id=$(echo "$u_info" | jq -r '.id // empty' 2>/dev/null || echo "")
    u_nick=$(echo "$u_info" | jq -r '.nickname // empty' 2>/dev/null || echo "")

    # 2. Если API не ответил, получаем напрямую из SQLite базы данных
    local db_file="/var/lib/tuna-subscriptions/subscriptions.db"
    if [ -z "$u_id" ] && [ -f "$db_file" ]; then
        local db_lookup
        db_lookup=$(python3 -c "
import sqlite3, sys
db = sys.argv[1]
t = sys.argv[2]
try:
    with sqlite3.connect(db) as conn:
        r = conn.execute('SELECT id, nickname FROM users WHERE id = ? OR nickname = ?', (t, t)).fetchone()
        if r:
            print(f'{r[0]}\t{r[1]}')
except Exception:
    pass
" "$db_file" "$target" 2>/dev/null || echo "")
        if [ -n "$db_lookup" ]; then
            u_id=$(echo "$db_lookup" | cut -f1 | tr -d ' \r\n')
            u_nick=$(echo "$db_lookup" | cut -f2 | tr -d ' \r\n')
        fi
    fi

    [ -z "$u_id" ] && u_id="$target"
    [ -z "$u_nick" ] && u_nick="$target"

    echo ""
    echo -e "  Вы действительно хотите ${RED}${BOLD}безвозвратно удалить${NC} пользователя '${BOLD}${u_nick}${NC}' (ID: ${CYAN}${u_id}${NC})?"
    local conf=""
    read -p "  Подтвердите удаление [y/N]: " conf < /dev/tty 2>/dev/null || read -p "  Подтвердите удаление [y/N]: " conf
    if [[ ! "$conf" =~ ^[YyДд]$ ]]; then
        echo -e "  ${YELLOW}Удаление отменено пользователем.${NC}"
        return 2
    fi

    echo -e "  ${GRAY}Выполняется удаление пользователя '${u_nick}'...${NC}"
    local deleted=false

    # 1. Запрос удаления через REST API
    local http_code
    http_code=$(curl -s -o /tmp/tuna_sub_del.json -w "%{http_code}" -X DELETE "${SUB_API}/api/users/${u_id}" 2>/dev/null || echo "000")
    if [ "$http_code" = "200" ]; then
        deleted=true
    fi

    # 2. Прямое удаление из SQLite базы данных (гарантированный fallback)
    if [ -f "$db_file" ]; then
        local db_del
        db_del=$(python3 -c "
import sqlite3, sys
db = sys.argv[1]
uid = sys.argv[2]
nick = sys.argv[3]
try:
    with sqlite3.connect(db) as conn:
        c = conn.cursor()
        c.execute('DELETE FROM users WHERE id = ? OR nickname = ? OR id = ? OR nickname = ?', (uid, uid, nick, nick))
        conn.commit()
        if c.rowcount > 0:
            print('DELETED')
        else:
            print('NO_ROWS')
except Exception as e:
    print('ERR:' + str(e))
" "$db_file" "$u_id" "$u_nick" 2>/dev/null || echo "")
        if [ "$db_del" = "DELETED" ]; then
            deleted=true
        fi
    fi

    if [ "$deleted" = true ]; then
        echo -e "  ${GREEN}${BOLD}✓ Пользователь '${u_nick}' успешно и безвозвратно удален!${NC}"
        return 0
    else
        echo -e "  ${RED}${BOLD}✗ Ошибка: не удалось удалить пользователя '${u_nick}' (HTTP ${http_code}).${NC}"
        return 1
    fi
}

edit_sub_user() {
    local SUB_API="http://127.0.0.1:22217"
    local sel_id="$1"
    if [ -z "$sel_id" ]; then
        sel_id=$(select_sub_user)
        [ -z "$sel_id" ] && return
    fi

    while true; do
        clear
        local user_json=$(curl -s "${SUB_API}/api/users/${sel_id}" 2>/dev/null || echo "")
        local uid=$(echo "$user_json" | jq -r '.id // empty' 2>/dev/null || echo "")
        if [ -z "$uid" ]; then
            echo -e "${RED}Ошибка: пользователь '${sel_id}' не найден на сервере подписок.${NC}"
            sleep 2
            return
        fi

        local u_nick=$(echo "$user_json" | jq -r '.nickname // "N/A"')
        local u_en=$(echo "$user_json" | jq -r '.enabled')
        local u_rev=$(echo "$user_json" | jq -r '.revision // 1')
        local u_tot=$(echo "$user_json" | jq -r '.total_uris // 0')

        local u_snell=$(echo "$user_json" | jq -r '.snell // empty')
        local u_wdtt=$(echo "$user_json" | jq -r '.qwdtt // empty')
        local u_mieru=$(echo "$user_json" | jq -r '.mieru // empty')
        local u_csqtt=$(echo "$user_json" | jq -r '.csqtt // empty')
        local u_dns=$(echo "$user_json" | jq -r '.masterdnsvpn // empty')
        local u_custom=$(echo "$user_json" | jq -r '.custom // empty')

        local c_snell=$(echo "$user_json" | jq -r '(.snell_uris // []) | length')
        local c_wdtt=$(echo "$user_json" | jq -r '(.qwdtt_uris // []) | length')
        local c_mieru=$(echo "$user_json" | jq -r '(.mieru_uris // []) | length')
        local c_csqtt=$(echo "$user_json" | jq -r '(.csqtt_uris // []) | length')
        local c_dns=$(echo "$user_json" | jq -r '(.masterdnsvpn_uris // []) | length')
        local c_custom=$(echo "$user_json" | jq -r '(.custom_uris // []) | length')

        local status_str="🟢 Активен"
        [ "$u_en" != "true" ] && status_str="🔴 Отключен"

        echo -e "${CYAN}╔══════════════════════════════════════════════════════════════════════╗${NC}"
        echo -e "${CYAN}║${BOLD}          РЕДАКТИРОВАНИЕ ПОЛЬЗОВАТЕЛЯ ПОДПИСКИ TUNA                   ${CYAN}║${NC}"
        echo -e "${CYAN}╠══════════════════════════════════════════════════════════════════════╣${NC}"
        echo -e "${CYAN}║${NC}  Пользователь: ${GREEN}${BOLD}${u_nick}${NC} (Статус: ${status_str} | Ревизия: ${u_rev})"
        echo -e "${CYAN}║${NC}  ID:           ${GRAY}${uid}${NC}"
        echo -e "${CYAN}║${NC}  Всего узлов:  ${YELLOW}${BOLD}${u_tot}${NC}"
        echo -e "${CYAN}╚══════════════════════════════════════════════════════════════════════╝${NC}"
        echo ""
        echo -e "  ${YELLOW}[1]${NC} 👤 ${BOLD}Изменить никнейм${NC} (сейчас: ${GREEN}${u_nick}${NC})"
        echo -e "  ${YELLOW}[2]${NC} ⚡ ${BOLD}Snell v5${NC} (узлов: ${BOLD}${c_snell}${NC})"
        echo -e "  ${YELLOW}[3]${NC} 🏎️  ${BOLD}WDTT (qwdtt)${NC} (узлов: ${BOLD}${c_wdtt}${NC})"
        echo -e "  ${YELLOW}[4]${NC} 🌊 ${BOLD}Mieru (mita)${NC} (узлов: ${BOLD}${c_mieru}${NC})"
        echo -e "  ${YELLOW}[5]${NC} 🛡️  ${BOLD}CSQTT${NC} (узлов: ${BOLD}${c_csqtt}${NC})"
        echo -e "  ${YELLOW}[6]${NC} 🌐 ${BOLD}MasterDNS / StormDNS${NC} (узлов: ${BOLD}${c_dns}${NC})"
        echo -e "  ${YELLOW}[7]${NC} 📦 ${BOLD}Дополнительные узлы (VLESS / Trojan / Shadowsocks / TUIC)${NC} (узлов: ${BOLD}${c_custom}${NC})"
        echo -e "  ${YELLOW}[8]${NC} 🔄 ${BOLD}Пересобрать профиль из активных служб сервера${NC}"
        echo -e "  ${RED}[9]${NC} 🗑️  ${BOLD}Удалить этого пользователя безвозвратно${NC}"
        echo -e "  ${YELLOW}[0]${NC} ⬅️  Завершить редактирование"
        echo ""
        read -p "Выберите действие [0-9]: " e_act
        case "$e_act" in
            1)
                echo ""
                read -p "Введите новый никнейм (Enter для отмены): " new_n
                new_n=$(echo "$new_n" | sed -e 's/^[[:space:]]*//' -e 's/[[:space:]]*$//')
                if [ -n "$new_n" ]; then
                    local p_json=$(python3 -c "import json, sys; print(json.dumps({'nickname': sys.argv[1]}))" "$new_n")
                    local resp=$(curl -s -X PUT "${SUB_API}/api/users/${uid}" -H "Content-Type: application/json" -d "$p_json" 2>/dev/null || echo "")
                    local err_msg=$(echo "$resp" | jq -r '.error // empty' 2>/dev/null || echo "")
                    if [ -n "$err_msg" ]; then
                        echo -e "${RED}Ошибка: ${err_msg}${NC}"
                    else
                        echo -e "${GREEN}✓ Никнейм успешно изменен на: ${BOLD}${new_n}${NC}"
                    fi
                    sleep 1.5
                fi
                ;;
            2|3|4|5|6|7)
                local proto_field=""
                local proto_label=""
                local proto_ex=""
                local cur_links=""
                case "$e_act" in
                    2) proto_field="snell_uri"; proto_label="Snell v5"; proto_ex="snell://psk@ip:port/?version=5#Node"; cur_links="$u_snell" ;;
                    3) proto_field="qwdtt_uri"; proto_label="WDTT (qwdtt)"; proto_ex="qwdtt://config?name=...&peer=ip%3Aport..."; cur_links="$u_wdtt" ;;
                    4) proto_field="mieru_uri"; proto_label="Mieru (mita)"; proto_ex="mierus://user:pass@ip/?profile=...&port=..."; cur_links="$u_mieru" ;;
                    5) proto_field="csqtt_uri"; proto_label="CSQTT"; proto_ex="csqtt://pass@ip:port#CSQTT"; cur_links="$u_csqtt" ;;
                    6) proto_field="masterdnsvpn_uri"; proto_label="MasterDNS / StormDNS"; proto_ex="stormdns://domain?key=...#DNS"; cur_links="$u_dns" ;;
                    7) proto_field="custom_uri"; proto_label="Дополнительные узлы"; proto_ex="vless://... или ss://..."; cur_links="$u_custom" ;;
                esac

                echo -e "\n${BOLD}--- Текущие ссылки ${proto_label}: ---${NC}"
                if [ -z "$cur_links" ]; then
                    echo -e "${GRAY}(нет сохраненных ссылок)${NC}"
                else
                    echo -e "${CYAN}${cur_links}${NC}"
                fi
                echo ""
                echo -e "  [1] ✏️  Заменить новыми ссылками"
                echo -e "  [2] ➕ Добавить новые ссылки к существующим"
                echo -e "  [3] 🗑️  Очистить (удалить все ссылки ${proto_label})"
                if [ "$proto_field" = "csqtt_uri" ] && [ -n "$cur_links" ]; then
                    echo -e "  ${YELLOW}[4]${NC} 🏷️  ${BOLD}Изменить имя подключения/сервера для сохраненных ссылок CSQTT${NC}"
                fi
                echo -e "  [0] Отмена"
                read -p "Выберите вариант: " sub_opt
                case "$sub_opt" in
                    1)
                        local new_u=$(collect_multi_uris "$proto_label" "$proto_ex")
                        local p_json=$(python3 -c "import json, sys; print(json.dumps({sys.argv[1]: sys.argv[2]}))" "$proto_field" "$new_u")
                        local resp=$(curl -s -X PUT "${SUB_API}/api/users/${uid}" -H "Content-Type: application/json" -d "$p_json" 2>/dev/null || echo "")
                        local err_msg=$(echo "$resp" | jq -r '.error // empty' 2>/dev/null || echo "")
                        if [ -n "$err_msg" ]; then
                            echo -e "${RED}Ошибка: ${err_msg}${NC}"
                        else
                            echo -e "${GREEN}✓ Ссылки ${proto_label} успешно обновлены!${NC}"
                        fi
                        sleep 1.5
                        ;;
                    2)
                        local add_u=$(collect_multi_uris "$proto_label" "$proto_ex")
                        if [ -n "$add_u" ]; then
                            local merged_u="$cur_links"
                            if [ -n "$merged_u" ]; then
                                merged_u="${merged_u}
${add_u}"
                            else
                                merged_u="$add_u"
                            fi
                            local p_json=$(python3 -c "import json, sys; print(json.dumps({sys.argv[1]: sys.argv[2]}))" "$proto_field" "$merged_u")
                            local resp=$(curl -s -X PUT "${SUB_API}/api/users/${uid}" -H "Content-Type: application/json" -d "$p_json" 2>/dev/null || echo "")
                            local err_msg=$(echo "$resp" | jq -r '.error // empty' 2>/dev/null || echo "")
                            if [ -n "$err_msg" ]; then
                                echo -e "${RED}Ошибка: ${err_msg}${NC}"
                            else
                                echo -e "${GREEN}✓ Новые ссылки ${proto_label} добавлены к профилю!${NC}"
                            fi
                            sleep 1.5
                        fi
                        ;;
                    3)
                        read -p "Точно удалить все ссылки ${proto_label}? [y/N]: " conf_clr
                        if [[ "$conf_clr" =~ ^[YyДд]$ ]]; then
                            local p_json=$(python3 -c "import json, sys; print(json.dumps({sys.argv[1]: ''}))" "$proto_field")
                            local resp=$(curl -s -X PUT "${SUB_API}/api/users/${uid}" -H "Content-Type: application/json" -d "$p_json" 2>/dev/null || echo "")
                            echo -e "${GREEN}✓ Ссылки ${proto_label} очищены!${NC}"
                            sleep 1.5
                        fi
                        ;;
                    4)
                        if [ "$proto_field" = "csqtt_uri" ] && [ -n "$cur_links" ]; then
                            local updated_lines=()
                            local idx=1
                            while IFS= read -r c_link; do
                                c_link=$(echo "$c_link" | sed -e 's/^[[:space:]]*//' -e 's/[[:space:]]*$//')
                                [ -z "$c_link" ] && continue
                                local cur_tag=""
                                if [[ "$c_link" =~ \#(.*)$ ]]; then
                                    cur_tag="${BASH_REMATCH[1]}"
                                fi
                                echo ""
                                echo -e "  Узел #${idx}: ${CYAN}${c_link}${NC}"
                                local new_t=""
                                read -p "  Новое имя сервера для узла #${idx} (сейчас: '${cur_tag}') [Enter - без изменений]: " new_t < /dev/tty 2>/dev/null || read -p "  Новое имя сервера для узла #${idx} (сейчас: '${cur_tag}') [Enter - без изменений]: " new_t
                                new_t=$(echo "$new_t" | sed -e 's/^[[:space:]]*//' -e 's/[[:space:]]*$//')
                                if [ -n "$new_t" ]; then
                                    c_link="$(echo "$c_link" | sed 's/#.*$//')#${new_t}"
                                    echo -e "  ${GREEN}✓ Обновлено:${NC} ${c_link}"
                                fi
                                updated_lines+=("$c_link")
                                idx=$((idx + 1))
                            done <<< "$cur_links"

                            local new_csqtt_val=""
                            for ul in "${updated_lines[@]}"; do
                                if [ -z "$new_csqtt_val" ]; then
                                    new_csqtt_val="$ul"
                                else
                                    new_csqtt_val="${new_csqtt_val}
${ul}"
                                fi
                            done
                            local p_json=$(python3 -c "import json, sys; print(json.dumps({'csqtt_uri': sys.argv[1]}))" "$new_csqtt_val")
                            local resp=$(curl -s -X PUT "${SUB_API}/api/users/${uid}" -H "Content-Type: application/json" -d "$p_json" 2>/dev/null || echo "")
                            echo -e "${GREEN}✓ Имена серверов CSQTT успешно обновлены!${NC}"
                            sleep 1.5
                        fi
                        ;;
                    *) ;;
                esac
                ;;
            8)
                echo ""
                read -p "Перезаписать профиль ссылками текущих служб сервера? [y/N]: " conf_rebuild
                if [[ "$conf_rebuild" =~ ^[YyДд]$ ]]; then
                    local s_payload=$(extract_current_server_links "$u_nick")
                    local resp=$(curl -s -X PUT "${SUB_API}/api/users/${uid}" -H "Content-Type: application/json" -d "$s_payload" 2>/dev/null || echo "")
                    echo -e "${GREEN}✓ Профиль синхронизирован с активными службами сервера!${NC}"
                    sleep 2
                fi
                ;;
            9)
                delete_sub_user_safe "$uid"
                local ret=$?
                if [ $ret -eq 0 ]; then
                    sleep 1.5
                    return
                fi
                sleep 1.5
                ;;
            0) return ;;
            *) echo "Неверный выбор"; sleep 1 ;;
        esac
    done
}

sync_tuna_sub_daemon() {
    local daemon_src=""
    local cur_script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" 2>/dev/null && pwd)"
    if [ -f "${cur_script_dir}/../tuna-sub-server/tuna-subscriptions.py" ]; then
        daemon_src="${cur_script_dir}/../tuna-sub-server/tuna-subscriptions.py"
    elif [ -f "${cur_script_dir}/tuna-sub-server/tuna-subscriptions.py" ]; then
        daemon_src="${cur_script_dir}/tuna-sub-server/tuna-subscriptions.py"
    elif [ -f "/root/x-manager/tuna-sub-server/tuna-subscriptions.py" ]; then
        daemon_src="/root/x-manager/tuna-sub-server/tuna-subscriptions.py"
    fi

    if [ -n "$daemon_src" ] && [ -f "$daemon_src" ] && [ -f "/usr/local/bin/tuna-subscriptions" ]; then
        if ! cmp -s "$daemon_src" "/usr/local/bin/tuna-subscriptions" 2>/dev/null; then
            cp -f "$daemon_src" /usr/local/bin/tuna-subscriptions
            chmod 0755 /usr/local/bin/tuna-subscriptions
            systemctl restart tuna-subscriptions 2>/dev/null || true
        fi
    fi
}

menu_subscriptions() {
    local SUB_API="http://127.0.0.1:22217"
    sync_tuna_sub_daemon

    while true; do
        clear
        local s_stat=$(get_sub_server_status)
        echo -e "${CYAN}╔══════════════════════════════════════════════════════════════════════╗${NC}"
        echo -e "${CYAN}║${BOLD}          УПРАВЛЕНИЕ СЕРВЕРОМ ПОДПИСОК TUNA (TUNA-SUBSCRIPTIONS)       ${CYAN}║${NC}"
        echo -e "${CYAN}╠══════════════════════════════════════════════════════════════════════╣${NC}"
        echo -e "${CYAN}║${NC}  Статус службы: ${s_stat}"
        echo -e "${CYAN}║${NC}  API: ${CYAN}${SUB_API}${NC} (Localhost) | База: ${BOLD}/var/lib/tuna-subscriptions/subscriptions.db${NC}"
        echo -e "${CYAN}╚══════════════════════════════════════════════════════════════════════╝${NC}"
        echo ""
        echo -e "  ${YELLOW}[1]${NC} 👥 ${BOLD}Список профилей и ссылки подписок${NC}"
        echo -e "  ${YELLOW}[2]${NC} 🚀 ${BOLD}Создать подписку из текущих ссылок сервера${NC} (Snell, Mieru, WDTT, CSQTT, DNS...)"
        echo -e "  ${YELLOW}[3]${NC} ➕ ${BOLD}Создать пользователя с произвольными ссылками вручную${NC} (мульти-ноды)"
        echo -e "  ${YELLOW}[4]${NC} ✏️  ${BOLD}Редактировать пользователя${NC} (ссылки протоколов и никнейм)"
        echo -e "  ${YELLOW}[5]${NC} 🗑️  ${BOLD}Удалить пользователя из сервера подписок${NC}"
        echo -e "  ${YELLOW}[6]${NC} 🔄 ${BOLD}Ротация токена подписки${NC} (мгновенно отзывает старую ссылку)"
        echo -e "  ${YELLOW}[7]${NC} ⚡ ${BOLD}Включить / отключить подписку пользователя${NC}"
        echo -e "  ${YELLOW}[8]${NC} 🔄 ${BOLD}Перезапустить службу tuna-subscriptions${NC}"
        echo -e "  ${YELLOW}[9]${NC} 📜 ${BOLD}Логи службы tuna-subscriptions${NC}"
        echo -e "  ${YELLOW}[10]${NC} 📥 ${BOLD}Установить / Обновить службу tuna-subscriptions${NC}"
        echo -e "  ${YELLOW}[0]${NC} ⬅️  Назад в Главное Меню"
        echo ""
        read -p "Выберите действие [0-10]: " sub_act
        case "$sub_act" in
            1)
                clear
                echo -e "${CYAN}=== СПИСОК ПОЛЬЗОВАТЕЛЕЙ И ССЫЛОК ПОДПИСКИ ===${NC}\n"
                local raw_users=$(curl -s "${SUB_API}/api/users" 2>/dev/null || echo "")
                if [ -z "$raw_users" ] || [ "$raw_users" = "[]" ]; then
                    echo -e "${YELLOW}Пользователи еще не созданы или служба не запущена.${NC}"
                else
                    python3 -c '
import json, sys
try:
    users = json.loads(sys.argv[1])
    if not users:
        print("Пользователи не найдены.")
        sys.exit(0)
    for u in users:
        nick = u.get("nickname", "N/A")
        uid = u.get("id", "N/A")
        en = "🟢 Активен" if u.get("enabled") else "🔴 Отключен"
        rev = u.get("revision", 1)
        tot = u.get("total_uris", 0)
        counts = u.get("counts", {})
        details = []
        for k, label in [("snell", "Snell"), ("mieru", "Mieru"), ("qwdtt", "WDTT"),
                         ("csqtt", "CSQTT"), ("masterdnsvpn", "DNS"), ("custom", "Extra")]:
            v = counts.get(k, 0)
            if v > 0:
                details.append(f"{label}: {v}")
        j_details = ", ".join(details)
        detail_str = f" ({j_details})" if details else ""
        sub_url = u.get("subscription_url", "")
        server_ip = sys.argv[2] if len(sys.argv) > 2 and sys.argv[2] else "127.0.0.1"
        if sub_url and ("127.0.0.1" in sub_url or "0.0.0.0" in sub_url):
            sub_url = sub_url.replace("127.0.0.1", server_ip).replace("0.0.0.0", server_ip)
        print("──────────────────────────────────────────────────────────────────────")
        print(f"👤 Пользователь: \033[1;32m{nick}\033[0m")
        print(f"🆔 ID:           {uid}")
        print(f"⚡ Статус:       {en}  |  Ревизия: {rev}")
        print(f"🌐 Всего узлов:  \033[1;33m{tot}\033[0m{detail_str}")
        if sub_url:
            print(f"🔗 Ссылка:       \033[1;36m{sub_url}\033[0m")
        else:
            print("🔗 Ссылка:       \033[1;33m[Не сгенерирована]\033[0m")
    print("──────────────────────────────────────────────────────────────────────")
except Exception:
    print(sys.argv[1])
' "$raw_users" "$SERVER_IP"
                fi
                echo ""
                read -p "Нажмите Enter для возврата..."
                ;;
            2)
                clear
                echo -e "${CYAN}=== СОЗДАНИЕ ПОДПИСКИ ИЗ ТЕКУЩИХ СЛУЖБ СЕРВЕРА ===${NC}\n"
                read -p "Введите ник пользователя (например: alex_travel): " new_nick
                [ -z "$new_nick" ] && new_nick="user_$(openssl rand -hex 3 2>/dev/null || echo "1")"

                local payload=$(extract_current_server_links "$new_nick")
                echo -e "${CYAN}[*] Отправка данных в локальный сервер подписок...${NC}"
                local resp=$(curl -s -X POST "${SUB_API}/api/users" \
                    -H "Content-Type: application/json" \
                    -d "$payload" 2>/dev/null || echo "")

                local sub_url=$(echo "$resp" | jq -r '.subscription_url // empty' 2>/dev/null || echo "")
                if [ -n "$sub_url" ]; then
                    echo ""
                    echo -e "${GREEN}${BOLD}✓ Профиль успешно создан!${NC}"
                    echo -e "  • Никнейм:   ${GREEN}${new_nick}${NC}"
                    echo -e "  • Ссылка:    ${CYAN}${BOLD}${sub_url}${NC}"
                    echo ""
                    echo -e "${BOLD}QR-код персональной ссылки подписки:${NC}"
                    qrencode -t ANSI256 "$sub_url" 2>/dev/null || qrencode -t UTF8 "$sub_url" 2>/dev/null || true
                    echo ""
                    echo -e "${YELLOW}Эту ссылку нужно передать в панель или клиент TUNA как подписку.${NC}"
                else
                    echo -e "${RED}Ошибка при создании пользователя:${NC}"
                    echo "$resp"
                fi
                echo ""
                read -p "Нажмите Enter для возврата..."
                ;;
            3)
                clear
                echo -e "${CYAN}=== РУЧНОЕ СОЗДАНИЕ ПОЛЬЗОВАТЕЛЯ (МУЛЬТИ-ССЫЛКИ) ===${NC}\n"
                read -p "Никнейм пользователя: " m_nick
                m_nick=$(echo "$m_nick" | sed -e 's/^[[:space:]]*//' -e 's/[[:space:]]*$//')
                [ -z "$m_nick" ] && continue

                local m_snell=$(collect_multi_uris "Snell v5" "snell://psk@ip:port/?version=5&reuse=true#Node")
                local m_wdtt=$(collect_multi_uris "WDTT (qwdtt)" "qwdtt://config?name=...&peer=ip%3Aport...")
                local m_mieru=$(collect_multi_uris "Mieru (mita)" "mierus://user:pass@ip/?profile=...&port=...")
                local m_csqtt=$(collect_multi_uris "CSQTT" "csqtt://pass@ip:port#CSQTT")
                local m_dns=$(collect_multi_uris "MasterDNS / StormDNS" "stormdns://domain?key=...#DNS")
                local m_custom=$(collect_multi_uris "Дополнительные узлы (VLESS / Trojan / Shadowsocks / TUIC)" "vless://... или ss://...")

                local count_snell=$(python3 -c "import sys; print(len([l for l in sys.argv[1].splitlines() if l.strip()]))" "$m_snell" 2>/dev/null || echo 0)
                local count_wdtt=$(python3 -c "import sys; print(len([l for l in sys.argv[1].splitlines() if l.strip()]))" "$m_wdtt" 2>/dev/null || echo 0)
                local count_mieru=$(python3 -c "import sys; print(len([l for l in sys.argv[1].splitlines() if l.strip()]))" "$m_mieru" 2>/dev/null || echo 0)
                local count_csqtt=$(python3 -c "import sys; print(len([l for l in sys.argv[1].splitlines() if l.strip()]))" "$m_csqtt" 2>/dev/null || echo 0)
                local count_dns=$(python3 -c "import sys; print(len([l for l in sys.argv[1].splitlines() if l.strip()]))" "$m_dns" 2>/dev/null || echo 0)
                local count_custom=$(python3 -c "import sys; print(len([l for l in sys.argv[1].splitlines() if l.strip()]))" "$m_custom" 2>/dev/null || echo 0)
                local total_nodes=$((count_snell + count_wdtt + count_mieru + count_csqtt + count_dns + count_custom))

                clear
                echo -e "${CYAN}╔══════════════════════════════════════════════════════════════════════╗${NC}"
                echo -e "${CYAN}║${BOLD}          СВОДКА СОЗДАВАЕМОГО ПРОФИЛЯ ПОДПИСКИ TUNA             ${CYAN}║${NC}"
                echo -e "${CYAN}╠══════════════════════════════════════════════════════════════════════╣${NC}"
                echo -e "${CYAN}║${NC}  Пользователь: ${GREEN}${BOLD}${m_nick}${NC}"
                echo -e "${CYAN}║${NC}  Всего узлов в подписке: ${YELLOW}${BOLD}${total_nodes}${NC}"
                echo -e "${CYAN}╟──────────────────────────────────────────────────────────────────────╢${NC}"
                echo -e "${CYAN}║${NC}  • Snell v5:      ${BOLD}${count_snell}${NC} ссылок"
                echo -e "${CYAN}║${NC}  • WDTT (qwdtt):  ${BOLD}${count_wdtt}${NC} ссылок"
                echo -e "${CYAN}║${NC}  • Mieru (mita):  ${BOLD}${count_mieru}${NC} ссылок"
                echo -e "${CYAN}║${NC}  • CSQTT:         ${BOLD}${count_csqtt}${NC} ссылок"
                echo -e "${CYAN}║${NC}  • MasterDNS:     ${BOLD}${count_dns}${NC} ссылок"
                echo -e "${CYAN}║${NC}  • Дополнительно: ${BOLD}${count_custom}${NC} ссылок (VLESS/Trojan/SS...)"
                echo -e "${CYAN}╚══════════════════════════════════════════════════════════════════════╝${NC}"
                echo ""
                read -p "Создать профиль с указанными узлами? [Y/n]: " conf_create
                conf_create=${conf_create:-Y}
                if [[ ! "$conf_create" =~ ^[YyДд]$ ]]; then
                    echo -e "${YELLOW}Создание отменено.${NC}"
                    sleep 1
                    continue
                fi

                local m_json=$(python3 -c "
import json, sys
data = {
    'nickname': sys.argv[1],
    'snell_uri': sys.argv[2],
    'qwdtt_uri': sys.argv[3],
    'mieru_uri': sys.argv[4],
    'csqtt_uri': sys.argv[5],
    'masterdnsvpn_uri': sys.argv[6],
    'custom_uri': sys.argv[7]
}
print(json.dumps(data))
" "$m_nick" "$m_snell" "$m_wdtt" "$m_mieru" "$m_csqtt" "$m_dns" "$m_custom")

                local resp=$(curl -s -X POST "${SUB_API}/api/users" -H "Content-Type: application/json" -d "$m_json" 2>/dev/null || echo "")
                local sub_url=$(echo "$resp" | jq -r '.subscription_url // empty' 2>/dev/null || echo "")
                if [ -n "$sub_url" ]; then
                    echo ""
                    echo -e "${GREEN}${BOLD}✓ Профиль успешно создан!${NC}"
                    echo -e "  • Никнейм:    ${GREEN}${m_nick}${NC}"
                    echo -e "  • Всего узлов: ${YELLOW}${BOLD}${total_nodes}${NC}"
                    echo -e "  • Ссылка:     ${CYAN}${BOLD}${sub_url}${NC}"
                    echo ""
                    echo -e "${BOLD}QR-код персональной ссылки подписки:${NC}"
                    qrencode -t ANSI256 "$sub_url" 2>/dev/null || qrencode -t UTF8 "$sub_url" 2>/dev/null || true
                    echo ""
                    echo -e "${YELLOW}Эту ссылку нужно передать в панель или клиент TUNA как подписку.${NC}"
                else
                    echo -e "${RED}Ошибка при создании пользователя:${NC} $resp"
                fi
                echo ""
                read -p "Нажмите Enter..."
                ;;
            4)
                edit_sub_user
                ;;
            5)
                clear
                echo -e "${CYAN}=== УДАЛЕНИЕ ПОЛЬЗОВАТЕЛЯ ИЗ СЕРВЕРА ПОДПИСОК ===${NC}\n"
                delete_sub_user_safe
                echo ""
                read -p "Нажмите Enter для возврата..." < /dev/tty 2>/dev/null || read -p "Нажмите Enter для возврата..."
                ;;
            6)
                clear
                echo -e "${CYAN}=== РОТАЦИЯ ТОКЕНА ПОДПИСКИ ===${NC}\n"
                local rot_id=$(select_sub_user)
                if [ -n "$rot_id" ]; then
                    local resp=$(curl -s -X POST "${SUB_API}/api/users/${rot_id}/rotate-token" 2>/dev/null || echo "")
                    local new_url=$(echo "$resp" | jq -r '.subscription_url // empty' 2>/dev/null || echo "")
                    if [ -n "$new_url" ]; then
                        echo ""
                        echo -e "${GREEN}✓ Токен успешно обновлен! Старая ссылка более недействительна.${NC}"
                        echo -e "Новый URL: ${CYAN}${BOLD}${new_url}${NC}"
                        echo ""
                        echo -e "${BOLD}Новый QR-код ссылки подписки:${NC}"
                        qrencode -t ANSI256 "$new_url" 2>/dev/null || qrencode -t UTF8 "$new_url" 2>/dev/null || true
                    else
                        echo -e "${RED}Ошибка ротации токена:${NC} $resp"
                    fi
                fi
                echo ""
                read -p "Нажмите Enter для возврата..."
                ;;
            7)
                clear
                echo -e "${CYAN}=== ВКЛЮЧЕНИЕ / ОТКЛЮЧЕНИЕ ПОДПИСКИ ПОЛЬЗОВАТЕЛЯ ===${NC}\n"
                local tog_id=$(select_sub_user)
                if [ -n "$tog_id" ]; then
                    local u_info=$(curl -s "${SUB_API}/api/users/${tog_id}" 2>/dev/null || echo "")
                    local cur_en=$(echo "$u_info" | jq -r '.enabled // "true"')
                    local cur_nick=$(echo "$u_info" | jq -r '.nickname // empty' 2>/dev/null || echo "$tog_id")

                    echo ""
                    if [ "$cur_en" = "true" ]; then
                        echo -e "Текущий статус пользователя ${GREEN}${cur_nick}${NC}: ${GREEN}🟢 Активен${NC}"
                        read -p "Отключить подписку? [y/N]: " conf_tog
                        if [[ "$conf_tog" =~ ^[YyДд]$ ]]; then
                            curl -s -X PUT "${SUB_API}/api/users/${tog_id}" -H "Content-Type: application/json" -d '{"enabled": false}' >/dev/null 2>&1
                            echo -e "${YELLOW}✓ Подписка пользователя '${cur_nick}' ОТКЛЮЧЕНА (клиенты будут получать 403 Forbidden).${NC}"
                        else
                            echo -e "${GRAY}Действие отменено.${NC}"
                        fi
                    else
                        echo -e "Текущий статус пользователя ${GREEN}${cur_nick}${NC}: ${RED}🔴 Отключен${NC}"
                        read -p "Включить (активировать) подписку? [y/N]: " conf_tog
                        if [[ "$conf_tog" =~ ^[YyДд]$ ]]; then
                            curl -s -X PUT "${SUB_API}/api/users/${tog_id}" -H "Content-Type: application/json" -d '{"enabled": true}' >/dev/null 2>&1
                            echo -e "${GREEN}✓ Подписка пользователя '${cur_nick}' ВКЛЮЧЕНА и активна.${NC}"
                        else
                            echo -e "${GRAY}Действие отменено.${NC}"
                        fi
                    fi
                fi
                echo ""
                read -p "Нажмите Enter для возврата..."
                ;;
            8)
                echo -e "${CYAN}[*] Перезапуск службы tuna-subscriptions...${NC}"
                systemctl restart tuna-subscriptions 2>/dev/null || true
                sleep 1
                if systemctl is-active --quiet tuna-subscriptions; then
                    echo -e "${GREEN}✓ Служба tuna-subscriptions активна и работает!${NC}"
                else
                    echo -e "${RED}✗ Служба не смогла запуститься.${NC}"
                    journalctl -u tuna-subscriptions -n 10 --no-pager
                fi
                sleep 2
                ;;
            9)
                journalctl -u tuna-subscriptions -f -n 50
                ;;
            10)
                echo -e "${CYAN}[*] Запуск установки / обновления tuna-subscriptions...${NC}"
                mkdir -p /tmp/tuna-sub-install
                curl -fsSL -o /tmp/tuna-sub-install/tuna-subscriptions.py "https://raw.githubusercontent.com/lesovoi53/xray-manager/main/tuna-sub-server/tuna-subscriptions.py?v=$(date +%s)" 2>/dev/null || true
                curl -fsSL -o /tmp/tuna-sub-install/config.toml.example "https://raw.githubusercontent.com/lesovoi53/xray-manager/main/tuna-sub-server/config.toml.example?v=$(date +%s)" 2>/dev/null || true
                curl -fsSL -o /tmp/tuna-sub-install/tuna-subscriptions.service "https://raw.githubusercontent.com/lesovoi53/xray-manager/main/tuna-sub-server/tuna-subscriptions.service?v=$(date +%s)" 2>/dev/null || true
                curl -fsSL -o /tmp/tuna-sub-install/install-sub-server.sh "https://raw.githubusercontent.com/lesovoi53/xray-manager/main/tuna-sub-server/install-sub-server.sh?v=$(date +%s)" 2>/dev/null || true
                if [ -f /tmp/tuna-sub-install/install-sub-server.sh ]; then
                    bash /tmp/tuna-sub-install/install-sub-server.sh || true
                fi
                rm -rf /tmp/tuna-sub-install
                sleep 2
                ;;
            0) return ;;
            *) echo "Неверный выбор"; sleep 1 ;;
        esac
    done
}

# ==============================================================================
# РАЗДЕЛ: УПРАВЛЕНИЕ МУЛЬТИКАНАЛЬНЫМ OPENFLUX (1-8 КАНАЛОВ, L4 gVisor Proxy)
# ==============================================================================

show_openflux_header() {
    clear
    local of_counts=$(get_openflux_counts)
    local of_act=$(echo "$of_counts" | cut -d':' -f1)
    local of_cfg=$(echo "$of_counts" | cut -d':' -f2)
    local of_status="${RED}ОСТАНОВЛЕН${NC}"
    [ "$of_act" -gt 0 ] && of_status="${GREEN}АКТИВНО: ${of_act}/8${NC}"
    local of_transport=$(get_openflux_prop "TRANSPORT" "vyandex")
    local of_codec=$(get_openflux_prop "CODEC" "legacy")
    local of_key=$(get_openflux_prop "ENCRYPTION_KEY" "")
    local key_status="${YELLOW}Отключено${NC}"
    [ -n "$of_key" ] && key_status="${GREEN}Включено (AES-GCM)${NC}"

    echo -e "${CYAN}╔══════════════════════════════════════════════════════════════════════╗${NC}"
    echo -e "${CYAN}║${BOLD}          РАЗДЕЛ: УПРАВЛЕНИЕ МУЛЬТИКАНАЛЬНЫМ OPENFLUX (1-8)            ${CYAN}║${NC}"
    echo -e "${CYAN}╠══════════════════════════════════════════════════════════════════════╣${NC}"
    echo -e "${CYAN}║${NC}  Сервер:     ${BOLD}${SERVER_IP}${NC}  |  Статус: ${of_status}"
    echo -e "${CYAN}║${NC}  Режим:      ${CYAN}L4 (gVisor Userspace Proxy)${NC}  |  Маршрут: $(get_openflux_routing)"
    echo -e "${CYAN}║${NC}  Транспорт:  ${GREEN}${of_transport}${NC} (дефолт)  |  Кодек: ${MAGENTA}${of_codec}${NC} (LZ4)"
    echo -e "${CYAN}║${NC}  Шифрование: ${key_status}  |  Шлюз Xray: :12346 REDIRECT"
    echo -e "${CYAN}╚══════════════════════════════════════════════════════════════════════╝${NC}"
    echo ""
}

openflux_manage_routing() {
    show_openflux_header
    echo -e "${BOLD}--- Настройка маршрутизации OpenFlux (L4 gVisor) ---${NC}"
    echo -e "Текущий режим: $(get_openflux_routing)"
    echo ""
    echo -e "  ${YELLOW}[1]${NC} 🌐 Маршрутизация Xray (REDIRECT :12346)"
    echo -e "  ${YELLOW}[2]${NC} ⚡ Прямой выход (Direct WAN)"
    echo ""
    echo -e "  ${YELLOW}[0]${NC} Назад"
    echo ""
    read -p "Выберите режим [0-2]: " of_rt_choice
    case "$of_rt_choice" in
        1)
            mkdir -p /etc/openflux
            echo "xray" > /etc/openflux/routing.mode
            [ -x /usr/local/bin/openflux-routing.sh ] && /usr/local/bin/openflux-routing.sh
            echo -e "${GREEN}✓ Маршрутизация OpenFlux: Xray (REDIRECT :12346)${NC}"
            sleep 2
            ;;
        2)
            mkdir -p /etc/openflux
            echo "direct" > /etc/openflux/routing.mode
            [ -x /usr/local/bin/openflux-routing.sh ] && /usr/local/bin/openflux-routing.sh
            echo -e "${GREEN}✓ Маршрутизация OpenFlux: Прямой выход${NC}"
            sleep 2
            ;;
        0) return ;;
        *) echo "Неверный выбор"; sleep 1 ;;
    esac
}

rebuild_openflux() {
    clear
    echo -e "${CYAN}╔══════════════════════════════════════════════════════════════════════╗${NC}"
    echo -e "${CYAN}║${BOLD}          СБОРКА / ОБНОВЛЕНИЕ OPENFLUX ИЗ ИСХОДНИКОВ (GO)             ${CYAN}║${NC}"
    echo -e "${CYAN}╚══════════════════════════════════════════════════════════════════════╝${NC}"
    echo ""
    if ! command -v go >/dev/null 2>&1 && [ ! -x /usr/local/go/bin/go ]; then
        echo -e "${YELLOW}Установка Go компилятора...${NC}"
        apt-get update -qq && apt-get install -y -qq golang-go git >/dev/null 2>&1 || true
        if ! command -v go >/dev/null 2>&1; then
            local g_arch="amd64"
            [ "$(uname -m)" = "aarch64" ] || [ "$(uname -m)" = "arm64" ] && g_arch="arm64"
            curl -fsSL "https://dl.google.com/go/go1.22.6.linux-${g_arch}.tar.gz" -o /tmp/go.tar.gz 2>/dev/null || true
            if [ -s /tmp/go.tar.gz ]; then
                rm -rf /usr/local/go && tar -C /usr/local -xzf /tmp/go.tar.gz && rm -f /tmp/go.tar.gz
            fi
        fi
    fi
    export PATH=$PATH:/usr/local/go/bin

    if ! command -v go >/dev/null 2>&1; then
        echo -e "${RED}Ошибка: компилятор Go не найден. Установите Go и повторите попытку.${NC}"
        read -p "Нажмите Enter..." dummy
        return 1
    fi

    id -u openflux &>/dev/null || useradd -r -s /usr/sbin/nologin openflux 2>/dev/null || true
    mkdir -p /etc/openflux/instances /var/log/openflux

    local tmp_dir="/tmp/openflux_build_$(date +%s)"
    rm -rf "$tmp_dir"
    echo -e "  -> Клонирование github.com/p1neappleXpress/OpenFlux..."
    if git clone --depth 1 https://github.com/p1neappleXpress/OpenFlux.git "$tmp_dir"; then
        echo -e "  -> Компиляция бинарного файла OpenFlux (CGO_ENABLED=0)..."
        (cd "$tmp_dir" && CGO_ENABLED=0 go build -v -trimpath -ldflags='-s -w' -o /usr/local/bin/openflux . && chmod +x /usr/local/bin/openflux)
        rm -rf "$tmp_dir"
        echo -e "${GREEN}✓ Бинарный файл /usr/local/bin/openflux успешно скомпилирован!${NC}"
    else
        echo -e "${RED}Ошибка клонирования репозитория OpenFlux!${NC}"
        rm -rf "$tmp_dir"
        read -p "Нажмите Enter..." dummy
        return 1
    fi

    # Установка сервисов и скриптов
    mkdir -p /usr/local/bin /etc/systemd/system
    cat << 'EOF_RUNNER' > /usr/local/bin/openflux-runner.sh
#!/usr/bin/env bash
set -e
INSTANCE="${1:-1}"
if [ -n "$INSTANCE" ] && [ -f "/etc/openflux/instances/${INSTANCE}.env" ]; then
    ENV_FILE="/etc/openflux/instances/${INSTANCE}.env"
elif [ -n "$INSTANCE" ] && [ -f "$INSTANCE" ]; then
    ENV_FILE="$INSTANCE"
else
    ENV_FILE="/etc/openflux/openflux.env"
    INSTANCE="1"
fi
if [ -f "$ENV_FILE" ]; then
    set -a
    . "$ENV_FILE"
    set +a
fi
ROLE="${ROLE:-exit}"
MODE="${MODE:-l4}"
TRANSPORT="${TRANSPORT:-vyandex}"
URL="${URL:-}"
CODEC="${CODEC:-legacy}"
DEBUG="${DEBUG:-1}"
ENCRYPTION_KEY="${ENCRYPTION_KEY:-}"
KEY_FILE="/etc/openflux/psk-${INSTANCE}.key"
if [ -z "$URL" ]; then
    echo "[OpenFlux #$INSTANCE] ВНИМАНИЕ: URL не настроен!"
    sleep 30
    exit 1
fi
ARGS=("--role=$ROLE" "--mode=$MODE" "--transport=$TRANSPORT" "--codec=$CODEC" "--url=$URL")
[ "$DEBUG" = "1" ] || [ "$DEBUG" = "true" ] && ARGS+=("--debug")
if [ -n "$ENCRYPTION_KEY" ]; then
    mkdir -p /etc/openflux
    echo -n "$ENCRYPTION_KEY" > "$KEY_FILE"
    chmod 600 "$KEY_FILE"
    ARGS+=("--encryption-key-file=$KEY_FILE")
fi
exec /usr/local/bin/openflux "${ARGS[@]}"
EOF_RUNNER
    chmod +x /usr/local/bin/openflux-runner.sh

    cat << 'EOF_ROUTING' > /usr/local/bin/openflux-routing.sh
#!/usr/bin/env bash
set -e
MODE_FILE="/etc/openflux/routing.mode"
ENV_FILE="/etc/x-manager/gateways.env"
XRAY_REDIRECT_PORT=12346
if [ -f "$ENV_FILE" ]; then
    val=$(grep -oP '^XRAY_REDIRECT_PORT=\K[0-9]+' "$ENV_FILE" 2>/dev/null || true)
    [ -n "$val" ] && XRAY_REDIRECT_PORT="$val"
fi
MODE="xray"
[ -f "$MODE_FILE" ] && MODE=$(cat "$MODE_FILE" | tr -d ' 
')
SERVER_IP=$(ip -4 addr show scope global 2>/dev/null | grep -oP '(?<=inet\s)\d+(\.\d+){3}' | head -n 1)

iptables -w 5 -t nat -D OUTPUT -m owner --uid-owner openflux -j OPENFLUX_OUT 2>/dev/null || true
iptables -w 5 -t nat -F OPENFLUX_OUT 2>/dev/null || true
iptables -w 5 -t nat -X OPENFLUX_OUT 2>/dev/null || true

if [ "$MODE" = "xray" ]; then
    iptables -w 5 -t nat -N OPENFLUX_OUT 2>/dev/null || true
    iptables -w 5 -t nat -F OPENFLUX_OUT 2>/dev/null || true
    iptables -w 5 -t nat -A OPENFLUX_OUT -d 127.0.0.0/8 -j RETURN
    [ -n "$SERVER_IP" ] && iptables -w 5 -t nat -A OPENFLUX_OUT -d "$SERVER_IP" -j RETURN 2>/dev/null || true
    iptables -w 5 -t nat -A OPENFLUX_OUT -p tcp -m multiport --dports 80,443 -d 77.88.0.0/18 -j RETURN 2>/dev/null || true
    iptables -w 5 -t nat -A OPENFLUX_OUT -p tcp -m multiport --dports 80,443 -d 87.250.250.0/24 -j RETURN 2>/dev/null || true
    iptables -w 5 -t nat -A OPENFLUX_OUT -p tcp -m multiport --dports 80,443 -d 94.100.180.0/24 -j RETURN 2>/dev/null || true
    iptables -w 5 -t nat -A OPENFLUX_OUT -p tcp -m multiport --dports 80,443 -d 217.69.139.0/24 -j RETURN 2>/dev/null || true
    iptables -w 5 -t nat -A OPENFLUX_OUT -p tcp -j REDIRECT --to-ports "${XRAY_REDIRECT_PORT}"
    iptables -w 5 -t nat -C OUTPUT -m owner --uid-owner openflux -j OPENFLUX_OUT 2>/dev/null || iptables -w 5 -t nat -I OUTPUT 1 -m owner --uid-owner openflux -j OPENFLUX_OUT
fi
EOF_ROUTING
    chmod +x /usr/local/bin/openflux-routing.sh

    cat << 'EOF_UNIT' > /etc/systemd/system/openflux@.service
[Unit]
Description=OpenFlux Exit-Node Service (Channel %i • L4 Mode)
After=network.target network-online.target xray.service
Wants=network-online.target
StartLimitIntervalSec=0

[Service]
Type=simple
User=openflux
Group=openflux
LimitNOFILE=65535
ExecStartPre=+/usr/local/bin/openflux-routing.sh
ExecStart=/usr/local/bin/openflux-runner.sh %i
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
EOF_UNIT

    systemctl daemon-reload
    echo -e "${GREEN}✓ Системные службы и скрипты OpenFlux обновлены.${NC}"
    read -p "Нажмите Enter для продолжения..." dummy
}

# ==============================================================================
# WEBDAV TUNNEL — Хелперы (чтение/запись конфига, статус)
# ==============================================================================

get_wdavtunnel_prop() {
    local prop="$1"
    local default="${2:-}"
    local val=""
    if [ -f "$WDAVTUNNEL_CONFIG_ENV" ]; then
        val=$(grep -oP "^${prop}=\\K.*" "$WDAVTUNNEL_CONFIG_ENV" | tr -d '"' | tr -d "'" | head -n 1)
    fi
    echo "${val:-$default}"
}

set_wdavtunnel_prop() {
    local prop="$1"
    local val="$2"
    mkdir -p "$WDAVTUNNEL_DIR"
    [ ! -f "$WDAVTUNNEL_CONFIG_ENV" ] && touch "$WDAVTUNNEL_CONFIG_ENV"
    if grep -q "^${prop}=" "$WDAVTUNNEL_CONFIG_ENV" 2>/dev/null; then
        sed -i "s|^${prop}=.*|${prop}=\"${val}\"|" "$WDAVTUNNEL_CONFIG_ENV"
    else
        echo "${prop}=\"${val}\"" >> "$WDAVTUNNEL_CONFIG_ENV"
    fi
}

get_wdavtunnel_status() {
    if ! is_webdav_tunnel_installed; then
        echo -e "${RED}НЕ УСТАНОВЛЕН${NC}"
        return
    fi
    if systemctl is-active --quiet "$WDAVTUNNEL_SERVICE" 2>/dev/null; then
        echo -e "${GREEN}🟢 АКТИВЕН${NC}"
    else
        echo -e "${RED}🔴 ОСТАНОВЛЕН${NC}"
    fi
}

get_wdavtunnel_routing() {
    local mode=$(get_wdavtunnel_prop "ROUTING_MODE" "xray")
    if [ "$mode" = "xray" ]; then
        echo -e "${GREEN}→ Xray REDIRECT (:${XRAY_REDIRECT_PORT:-12346})${NC}"
    else
        echo -e "${YELLOW}→ Прямой выход (WAN)${NC}"
    fi
}

get_wdavtunnel_mode() {
    local mode
    mode=$(get_wdavtunnel_prop "WEBDAV_MODE" "selfhosted")
    if [ "$mode" = "multi" ]; then
        echo "multi"
    elif [ "$mode" = "server" ] || [ "$mode" = "external" ]; then
        echo "server"
    else
        echo "selfhosted"
    fi
}

get_wdavtunnel_listen_port() {
    local listen=$(get_wdavtunnel_prop "WEBDAV_LISTEN" ":8443")
    echo "$listen" | grep -oP ':\K[0-9]+$' || echo "8443"
}

get_wdavtunnel_provider_label() {
    local mode
    mode=$(get_wdavtunnel_mode)
    if [ "$mode" = "multi" ]; then
        local count=0
        local parts=()
        if [ "$(get_wdavtunnel_prop "MULTI_LOCAL_ENABLED" "true")" = "true" ]; then
            count=$((count+1))
            parts+=("VPS :$(get_wdavtunnel_listen_port)")
        fi
        if [ "$(get_wdavtunnel_prop "MULTI_MAILRU_ENABLED" "true")" = "true" ]; then
            count=$((count+1))
            parts+=("Mail.ru")
        fi
        if [ "$(get_wdavtunnel_prop "MULTI_YANDEX_ENABLED" "false")" = "true" ]; then
            count=$((count+1))
            parts+=("Яндекс")
        fi
        if [ "$(get_wdavtunnel_prop "MULTI_CUSTOM_ENABLED" "false")" = "true" ]; then
            count=$((count+1))
            parts+=("Кастом")
        fi
        local joined
        joined=$(IFS=" + "; echo "${parts[*]}")
        echo -e "${PURPLE}🔀 Мульти-бекенд [${count}] (${joined:-пусто})${NC}"
        return
    fi
    if [ "$mode" != "server" ]; then
        echo -e "${CYAN}Встроенный сервер (Selfhosted :$(get_wdavtunnel_listen_port))${NC}"
        return
    fi
    local url
    url=$(get_wdavtunnel_prop "WEBDAV_URL" "")
    if [[ "$url" =~ mail\.ru ]]; then
        echo -e "${BLUE}Облако Mail.ru (webdav.cloud.mail.ru)${NC}"
    elif [[ "$url" =~ yandex ]]; then
        echo -e "${YELLOW}Яндекс.Диск (webdav.yandex.ru)${NC}"
    else
        echo -e "${GREEN}Внешний WebDAV ($url)${NC}"
    fi
}

generate_wdavtunnel_yaml() {
    local srv_ip
    srv_ip=$(get_server_ip)
    local l_port
    l_port=$(get_wdavtunnel_listen_port)
    local l_login
    l_login=$(get_wdavtunnel_prop "WEBDAV_LOGIN" "wdav")
    local l_pass
    l_pass=$(get_wdavtunnel_prop "WEBDAV_PASSWORD" "")
    local enc
    enc=$(get_wdavtunnel_prop "WEBDAV_ENC" "false")

    local loc_en
    loc_en=$(get_wdavtunnel_prop "MULTI_LOCAL_ENABLED" "true")
    local mail_en
    mail_en=$(get_wdavtunnel_prop "MULTI_MAILRU_ENABLED" "true")
    local mail_login
    mail_login=$(get_wdavtunnel_prop "MULTI_MAILRU_LOGIN" "")
    local mail_pass
    mail_pass=$(get_wdavtunnel_prop "MULTI_MAILRU_PASSWORD" "")

    local yan_en
    yan_en=$(get_wdavtunnel_prop "MULTI_YANDEX_ENABLED" "false")
    local yan_login
    yan_login=$(get_wdavtunnel_prop "MULTI_YANDEX_LOGIN" "")
    local yan_pass
    yan_pass=$(get_wdavtunnel_prop "MULTI_YANDEX_PASSWORD" "")

    local cust_en
    cust_en=$(get_wdavtunnel_prop "MULTI_CUSTOM_ENABLED" "false")
    local cust_url
    cust_url=$(get_wdavtunnel_prop "MULTI_CUSTOM_URL" "")
    local cust_login
    cust_login=$(get_wdavtunnel_prop "MULTI_CUSTOM_LOGIN" "")
    local cust_pass
    cust_pass=$(get_wdavtunnel_prop "MULTI_CUSTOM_PASSWORD" "")

    mkdir -p "$WDAVTUNNEL_DIR" 2>/dev/null || true
    local yaml_file="$WDAVTUNNEL_DIR/webdav-tunnel.yaml"

    cat > "$yaml_file" <<EOF_YML
mode: server
timeout: 60s
tuning:
  chunk-size: 131071
  coalesce: 10ms
  poll-max: 500ms
  poll-min: 200ms
  puts: 8
  read-max: 8
  read-min: 3
backends:
EOF_YML

    if [ "$loc_en" = "true" ] && [ -n "$l_pass" ]; then
        cat >> "$yaml_file" <<EOF_YML
  - url: http://${srv_ip}:${l_port}
    login: ${l_login}
    password: ${l_pass}
EOF_YML
    fi

    if [ "$mail_en" = "true" ] && [ -n "$mail_login" ] && [ -n "$mail_pass" ]; then
        cat >> "$yaml_file" <<EOF_YML
  - url: https://webdav.cloud.mail.ru
    login: ${mail_login}
    password: ${mail_pass}
EOF_YML
    fi

    if [ "$yan_en" = "true" ] && [ -n "$yan_login" ] && [ -n "$yan_pass" ]; then
        cat >> "$yaml_file" <<EOF_YML
  - url: https://webdav.yandex.ru
    login: ${yan_login}
    password: ${yan_pass}
EOF_YML
    fi

    if [ "$cust_en" = "true" ] && [ -n "$cust_url" ] && [ -n "$cust_login" ] && [ -n "$cust_pass" ]; then
        cat >> "$yaml_file" <<EOF_YML
  - url: ${cust_url}
    login: ${cust_login}
    password: ${cust_pass}
EOF_YML
    fi

    if [ "$enc" = "true" ] || [ "$enc" = "1" ]; then
        echo "enc: true" >> "$yaml_file"
    fi

    chmod 660 "$yaml_file" 2>/dev/null || true
    chown "$WDAVTUNNEL_USER:$WDAVTUNNEL_USER" "$yaml_file" 2>/dev/null || true
    chown -R "$WDAVTUNNEL_USER:$WDAVTUNNEL_USER" "$WDAVTUNNEL_DIR" 2>/dev/null || true
    chmod 770 "$WDAVTUNNEL_DIR" 2>/dev/null || true
}

get_wdavtunnel_client_uri() {
    local mode
    mode=$(get_wdavtunnel_mode)
    local enc
    enc=$(get_wdavtunnel_prop "WEBDAV_ENC" "false")

    if [ "$mode" = "multi" ]; then
        local j_uri=""
        j_uri=$(journalctl -u "$WDAVTUNNEL_SERVICE" -n 50 --no-pager 2>/dev/null | grep -oP 'server: client -uri\s+\K\S+' | tail -n 1 || true)
        if [ -n "$j_uri" ] && [[ "$j_uri" =~ ^webdav ]]; then
            if [[ ! "$j_uri" =~ \# ]]; then
                j_uri="${j_uri}#Multi-WebDAV"
            fi
            echo "$j_uri"
            return
        fi

        local srv="${SERVER_IP:-$(get_server_ip)}"
        local l_port
        l_port=$(get_wdavtunnel_listen_port)
        local l_pass
        l_pass=$(get_wdavtunnel_prop "WEBDAV_PASSWORD" "")
        local l_login
        l_login=$(get_wdavtunnel_prop "WEBDAV_LOGIN" "wdav")

        local loc_en
        loc_en=$(get_wdavtunnel_prop "MULTI_LOCAL_ENABLED" "true")
        local mail_en
        mail_en=$(get_wdavtunnel_prop "MULTI_MAILRU_ENABLED" "true")
        local mail_login
        mail_login=$(get_wdavtunnel_prop "MULTI_MAILRU_LOGIN" "")
        local mail_pass
        mail_pass=$(get_wdavtunnel_prop "MULTI_MAILRU_PASSWORD" "")
        local yan_en
        yan_en=$(get_wdavtunnel_prop "MULTI_YANDEX_ENABLED" "false")
        local yan_login
        yan_login=$(get_wdavtunnel_prop "MULTI_YANDEX_LOGIN" "")
        local yan_pass
        yan_pass=$(get_wdavtunnel_prop "MULTI_YANDEX_PASSWORD" "")
        local cust_en
        cust_en=$(get_wdavtunnel_prop "MULTI_CUSTOM_ENABLED" "false")
        local cust_url
        cust_url=$(get_wdavtunnel_prop "MULTI_CUSTOM_URL" "")
        local cust_login
        cust_login=$(get_wdavtunnel_prop "MULTI_CUSTOM_LOGIN" "")
        local cust_pass
        cust_pass=$(get_wdavtunnel_prop "MULTI_CUSTOM_PASSWORD" "")

        local b_uris=()
        if [ "$loc_en" = "true" ] && [ -n "$l_pass" ]; then
            b_uris+=("webdav://${l_login}:${l_pass}@${srv}:${l_port}")
        fi
        if [ "$mail_en" = "true" ] && [ -n "$mail_login" ] && [ -n "$mail_pass" ]; then
            b_uris+=("webdavs://${mail_login}:${mail_pass}@webdav.cloud.mail.ru")
        fi
        if [ "$yan_en" = "true" ] && [ -n "$yan_login" ] && [ -n "$yan_pass" ]; then
            b_uris+=("webdavs://${yan_login}:${yan_pass}@webdav.yandex.ru")
        fi
        if [ "$cust_en" = "true" ] && [ -n "$cust_url" ] && [ -n "$cust_login" ] && [ -n "$cust_pass" ]; then
            local c_scheme="webdavs"
            [[ "$cust_url" =~ ^http:// ]] && c_scheme="webdav"
            local c_host
            c_host=$(echo "$cust_url" | sed -e 's|^https\?://||' -e 's|/$||')
            b_uris+=("${c_scheme}://${cust_login}:${cust_pass}@${c_host}")
        fi

        if [ ${#b_uris[@]} -eq 0 ]; then
            echo "(в пуле нет настроенных хранилищ — добавьте хотя бы одно)"
            return
        fi

        local primary="${b_uris[0]}"
        local res_uri="${primary}?chunk-size=131071&coalesce=10ms&poll-max=500ms&poll-min=200ms&puts=8&read-max=8&read-min=3&timeout=60s"
        for (( i=1; i<${#b_uris[@]}; i++ )); do
            local extra="${b_uris[$i]}"
            local enc_extra
            enc_extra=$(python3 -c "import urllib.parse, sys; print(urllib.parse.quote(sys.argv[1], safe=''))" "$extra" 2>/dev/null || true)
            if [ -n "$enc_extra" ]; then
                res_uri="${res_uri}&backend=${enc_extra}"
            fi
        done

        if [ "$enc" = "true" ] || [ "$enc" = "1" ]; then
            res_uri="${res_uri}&enc=1"
        fi
        res_uri="${res_uri}#Multi-WebDAV"
        echo "$res_uri"
        return
    fi

    local login
    login=$(get_wdavtunnel_prop "WEBDAV_LOGIN" "")
    local pass
    pass=$(get_wdavtunnel_prop "WEBDAV_PASSWORD" "")

    if [ -z "$login" ] || [ -z "$pass" ]; then
        echo "(не настроен — укажите логин и пароль)"
        return
    fi

    if [ "$mode" = "server" ]; then
        local url
        url=$(get_wdavtunnel_prop "WEBDAV_URL" "https://webdav.cloud.mail.ru")
        local scheme="webdavs"
        if [[ "$url" =~ ^http:// ]]; then
            scheme="webdav"
        fi
        local host_part
        host_part=$(echo "$url" | sed -e 's|^https\?://||' -e 's|/$||')
        local tag="Cloud-WebDAV"
        if [[ "$url" =~ mail\.ru ]]; then
            tag="Mailru-WebDAV"
        elif [[ "$url" =~ yandex ]]; then
            tag="Yandex-WebDAV"
        fi
        local uri="${scheme}://${login}:${pass}@${host_part}?chunk-size=131071&coalesce=10ms&poll-max=500ms&poll-min=200ms&puts=8&read-max=8&read-min=3&timeout=60s"
        if [ "$enc" = "true" ] || [ "$enc" = "1" ]; then
            uri="${uri}&enc=1"
        fi
        uri="${uri}#${tag}"
        echo "$uri"
    else
        local port
        port=$(get_wdavtunnel_listen_port)
        local srv="${SERVER_IP:-$(get_server_ip)}"
        local uri="webdav://${login}:${pass}@${srv}:${port}?chunk-size=131071&coalesce=5ms&poll-max=200ms&poll-min=50ms&puts=8&read-max=8&read-min=3&timeout=60s"
        if [ "$enc" = "true" ] || [ "$enc" = "1" ]; then
            uri="${uri}&enc=1"
        fi
        uri="${uri}#WebDAV-Tunnel"
        echo "$uri"
    fi
}

menu_webdav_tunnel_pool() {
    while true; do
        clear
        local srv_ip
        srv_ip=$(get_server_ip)
        local l_port
        l_port=$(get_wdavtunnel_listen_port)
        local l_login
        l_login=$(get_wdavtunnel_prop "WEBDAV_LOGIN" "wdav")
        local l_pass
        l_pass=$(get_wdavtunnel_prop "WEBDAV_PASSWORD" "")

        local loc_en
        loc_en=$(get_wdavtunnel_prop "MULTI_LOCAL_ENABLED" "true")
        local mail_en
        mail_en=$(get_wdavtunnel_prop "MULTI_MAILRU_ENABLED" "true")
        local mail_login
        mail_login=$(get_wdavtunnel_prop "MULTI_MAILRU_LOGIN" "")
        local mail_pass
        mail_pass=$(get_wdavtunnel_prop "MULTI_MAILRU_PASSWORD" "")

        local yan_en
        yan_en=$(get_wdavtunnel_prop "MULTI_YANDEX_ENABLED" "false")
        local yan_login
        yan_login=$(get_wdavtunnel_prop "MULTI_YANDEX_LOGIN" "")
        local yan_pass
        yan_pass=$(get_wdavtunnel_prop "MULTI_YANDEX_PASSWORD" "")

        local cust_en
        cust_en=$(get_wdavtunnel_prop "MULTI_CUSTOM_ENABLED" "false")
        local cust_url
        cust_url=$(get_wdavtunnel_prop "MULTI_CUSTOM_URL" "")
        local cust_login
        cust_login=$(get_wdavtunnel_prop "MULTI_CUSTOM_LOGIN" "")
        local cust_pass
        cust_pass=$(get_wdavtunnel_prop "MULTI_CUSTOM_PASSWORD" "")

        echo -e "${PURPLE}╔══════════════════════════════════════════════════════════════════════╗${NC}"
        echo -e "${PURPLE}║${BOLD}   Настройка пула хранилищ (Мульти-бекенд WebDAV Tunnel)              ${PURPLE}║${NC}"
        echo -e "${PURPLE}╠══════════════════════════════════════════════════════════════════════╣${NC}"
        echo -e "${PURPLE}║${NC}  WireTurn балансирует сессии между всеми включенными хранилищами    ${PURPLE}║${NC}"
        echo -e "${PURPLE}║${NC}  и автоматически переключается при сбоях (Failover / Cooldown).       ${PURPLE}║${NC}"
        echo -e "${PURPLE}╚══════════════════════════════════════════════════════════════════════╝${NC}"
        echo ""

        if [ "$loc_en" = "true" ]; then
            echo -e "  ${BOLD}[1]${NC} 🖥  ${GREEN}[ВКЛЮЧЕН]${NC}  ${BOLD}Встроенный сервер VPS (:8443)${NC}"
            echo -e "       Логин: ${CYAN}${l_login}${NC} | Пароль: ${GREEN}${l_pass}${NC}"
        else
            echo -e "  ${BOLD}[1]${NC} 🖥  ${RED}[ВЫКЛЮЧЕН]${NC} ${BOLD}Встроенный сервер VPS (:8443)${NC}"
        fi
        echo ""

        if [ "$mail_en" = "true" ]; then
            echo -e "  ${BOLD}[2]${NC} ☁️  ${GREEN}[ВКЛЮЧЕН]${NC}  ${BOLD}Облако Mail.ru (webdav.cloud.mail.ru)${NC}"
            echo -e "       Логин: ${CYAN}${mail_login:-(не задан)}${NC} | Пароль прил.: ${GREEN}${mail_pass:-(не задан)}${NC}"
        else
            echo -e "  ${BOLD}[2]${NC} ☁️  ${RED}[ВЫКЛЮЧЕН]${NC} ${BOLD}Облако Mail.ru (webdav.cloud.mail.ru)${NC}"
        fi
        echo ""

        if [ "$yan_en" = "true" ]; then
            echo -e "  ${BOLD}[3]${NC} 🟡  ${GREEN}[ВКЛЮЧЕН]${NC}  ${BOLD}Яндекс.Диск (webdav.yandex.ru)${NC} ${YELLOW}(требует подписку 360)${NC}"
            echo -e "       Логин: ${CYAN}${yan_login:-(не задан)}${NC} | Пароль прил.: ${GREEN}${yan_pass:-(не задан)}${NC}"
        else
            echo -e "  ${BOLD}[3]${NC} 🟡  ${RED}[ВЫКЛЮЧЕН]${NC} ${BOLD}Яндекс.Диск (webdav.yandex.ru)${NC}"
        fi
        echo ""

        if [ "$cust_en" = "true" ]; then
            echo -e "  ${BOLD}[4]${NC} 🌐  ${GREEN}[ВКЛЮЧЕН]${NC}  ${BOLD}Кастомный WebDAV-сервер${NC}"
            echo -e "       URL: ${CYAN}${cust_url:-(не задан)}${NC} | Логин: ${CYAN}${cust_login:-(не задан)}${NC}"
        else
            echo -e "  ${BOLD}[4]${NC} 🌐  ${RED}[ВЫКЛЮЧЕН]${NC} ${BOLD}Кастомный WebDAV-сервер${NC}"
        fi
        echo ""
        echo -e "  ${GREEN}${BOLD}[5]${NC} 💾 ${BOLD}Сохранить пул и применить настройки${NC}"
        echo -e "  ${BOLD}[0]${NC} ← Назад"
        echo ""
        read -p "Выберите действие [0-5]: " p_choice

        case "$p_choice" in
            1)
                echo ""
                echo -e "  [1] Включить / Выключить встроенный сервер VPS в пуле (сейчас: ${loc_en})"
                echo -e "  [2] Сменить логин и пароль встроенного сервера"
                read -p "  Действие [1-2, Enter для отмены]: " l_sub
                if [ "$l_sub" = "1" ]; then
                    if [ "$loc_en" = "true" ]; then
                        set_wdavtunnel_prop "MULTI_LOCAL_ENABLED" "false"
                        echo -e "${YELLOW}Встроенный сервер ВЫКЛЮЧЕН из пула.${NC}"
                    else
                        set_wdavtunnel_prop "MULTI_LOCAL_ENABLED" "true"
                        echo -e "${GREEN}✓ Встроенный сервер ВКЛЮЧЕН в пул.${NC}"
                    fi
                    sleep 1
                elif [ "$l_sub" = "2" ]; then
                    read -p "  Логин [${l_login}]: " new_ll
                    [ -n "$new_ll" ] && set_wdavtunnel_prop "WEBDAV_LOGIN" "$new_ll"
                    read -p "  Пароль [${l_pass}]: " new_lp
                    [ -n "$new_lp" ] && set_wdavtunnel_prop "WEBDAV_PASSWORD" "$new_lp"
                    echo -e "${GREEN}✓ Данные обновлены.${NC}"
                    sleep 1
                fi
                ;;
            2)
                echo ""
                echo -e "  [1] Включить / Выключить Mail.ru в пуле (сейчас: ${mail_en})"
                echo -e "  [2] Настроить логин и пароль приложения Mail.ru"
                read -p "  Действие [1-2, Enter для отмены]: " m_sub
                if [ "$m_sub" = "1" ]; then
                    if [ "$mail_en" = "true" ]; then
                        set_wdavtunnel_prop "MULTI_MAILRU_ENABLED" "false"
                        echo -e "${YELLOW}Mail.ru ВЫКЛЮЧЕН из пула.${NC}"
                    else
                        set_wdavtunnel_prop "MULTI_MAILRU_ENABLED" "true"
                        echo -e "${GREEN}✓ Mail.ru ВКЛЮЧЕН в пул.${NC}"
                    fi
                    sleep 1
                elif [ "$m_sub" = "2" ]; then
                    echo -e "  ${YELLOW}Получите пароль приложения: https://account.mail.ru/user/2-step-auth/passwords${NC}"
                    read -p "  Логин Mail.ru (email) [${mail_login}]: " new_ml
                    [ -n "$new_ml" ] && set_wdavtunnel_prop "MULTI_MAILRU_LOGIN" "$new_ml"
                    read -p "  Пароль для внешних приложений Mail.ru: " new_mp
                    [ -n "$new_mp" ] && set_wdavtunnel_prop "MULTI_MAILRU_PASSWORD" "$new_mp"
                    set_wdavtunnel_prop "MULTI_MAILRU_ENABLED" "true"
                    echo -e "${GREEN}✓ Данные Mail.ru сохранены.${NC}"
                    sleep 1
                fi
                ;;
            3)
                echo ""
                echo -e "  ${RED}! ВНИМАНИЕ: WebDAV у Яндекса требует платную подписку Яндекс 360.${NC}"
                echo -e "  [1] Включить / Выключить Яндекс.Диск в пуле (сейчас: ${yan_en})"
                echo -e "  [2] Настроить логин и пароль приложения Яндекс"
                read -p "  Действие [1-2, Enter для отмены]: " y_sub
                if [ "$y_sub" = "1" ]; then
                    if [ "$yan_en" = "true" ]; then
                        set_wdavtunnel_prop "MULTI_YANDEX_ENABLED" "false"
                        echo -e "${YELLOW}Яндекс.Диск ВЫКЛЮЧЕН из пула.${NC}"
                    else
                        set_wdavtunnel_prop "MULTI_YANDEX_ENABLED" "true"
                        echo -e "${GREEN}✓ Яндекс.Диск ВКЛЮЧЕН в пул.${NC}"
                    fi
                    sleep 1
                elif [ "$y_sub" = "2" ]; then
                    echo -e "  ${YELLOW}Получите пароль приложения (тип «Файлы/Диск»): https://id.yandex.ru/security${NC}"
                    read -p "  Логин Яндекс (email или логин) [${yan_login}]: " new_yl
                    [ -n "$new_yl" ] && set_wdavtunnel_prop "MULTI_YANDEX_LOGIN" "$new_yl"
                    read -p "  Пароль приложения Яндекс: " new_yp
                    [ -n "$new_yp" ] && set_wdavtunnel_prop "MULTI_YANDEX_PASSWORD" "$new_yp"
                    set_wdavtunnel_prop "MULTI_YANDEX_ENABLED" "true"
                    echo -e "${GREEN}✓ Данные Яндекс.Диска сохранены.${NC}"
                    sleep 1
                fi
                ;;
            4)
                echo ""
                echo -e "  [1] Включить / Выключить Кастомный WebDAV (сейчас: ${cust_en})"
                echo -e "  [2] Настроить параметры подключения"
                read -p "  Действие [1-2, Enter для отмены]: " c_sub
                if [ "$c_sub" = "1" ]; then
                    if [ "$cust_en" = "true" ]; then
                        set_wdavtunnel_prop "MULTI_CUSTOM_ENABLED" "false"
                        echo -e "${YELLOW}Кастомный WebDAV ВЫКЛЮЧЕН из пула.${NC}"
                    else
                        set_wdavtunnel_prop "MULTI_CUSTOM_ENABLED" "true"
                        echo -e "${GREEN}✓ Кастомный WebDAV ВКЛЮЧЕН в пул.${NC}"
                    fi
                    sleep 1
                elif [ "$c_sub" = "2" ]; then
                    read -p "  URL [${cust_url}]: " new_cu
                    [ -n "$new_cu" ] && set_wdavtunnel_prop "MULTI_CUSTOM_URL" "$new_cu"
                    read -p "  Логин [${cust_login}]: " new_cl
                    [ -n "$new_cl" ] && set_wdavtunnel_prop "MULTI_CUSTOM_LOGIN" "$new_cl"
                    read -p "  Пароль: " new_cp
                    [ -n "$new_cp" ] && set_wdavtunnel_prop "MULTI_CUSTOM_PASSWORD" "$new_cp"
                    set_wdavtunnel_prop "MULTI_CUSTOM_ENABLED" "true"
                    echo -e "${GREEN}✓ Данные сохранены.${NC}"
                    sleep 1
                fi
                ;;
            5)
                generate_wdavtunnel_yaml
                chown root:"$WDAVTUNNEL_USER" "$WDAVTUNNEL_CONFIG_ENV" 2>/dev/null || true
                chmod 640 "$WDAVTUNNEL_CONFIG_ENV" 2>/dev/null || true
                if [ "$(get_wdavtunnel_prop "ROUTING_MODE" "xray")" = "xray" ] && [ -x "$WDAVTUNNEL_ROUTING" ]; then
                    "$WDAVTUNNEL_ROUTING" up 2>/dev/null || true
                fi
                if systemctl is-active --quiet "$WDAVTUNNEL_SERVICE" 2>/dev/null; then
                    systemctl restart "$WDAVTUNNEL_SERVICE" 2>/dev/null || true
                    echo -e "${GREEN}✓ Конфигурация пула сохранена и служба перезапущена!${NC}"
                else
                    echo -e "${GREEN}✓ Конфигурация пула сохранена! Запустите туннель из меню.${NC}"
                fi
                sleep 2
                return
                ;;
            0) return ;;
            *) ;;
        esac
    done
}

# Сборка webdav-tunnel из исходников
build_webdav_tunnel_binary() {
    echo -e "${YELLOW}  → Сборка webdav-tunnel из исходников (spkprsnts/webdav-tunnel)...${NC}"
    export PATH=$PATH:/usr/local/go/bin
    if ! command -v go >/dev/null 2>&1; then
        echo -e "${RED}  ! Go компилятор не найден. Установите Go и попробуйте снова.${NC}"
        return 1
    fi
    local tmp_dir="/tmp/webdav_tunnel_build_$(date +%s)"
    rm -rf "$tmp_dir"
    if git clone --depth 1 https://github.com/spkprsnts/webdav-tunnel.git "$tmp_dir" >/dev/null 2>&1; then
        if (cd "$tmp_dir" && CGO_ENABLED=0 go build -trimpath -ldflags='-s -w' -o /usr/local/bin/webdav-tunnel . 2>/dev/null); then
            chmod +x /usr/local/bin/webdav-tunnel
            rm -rf "$tmp_dir"
            echo -e "${GREEN}  ✓ /usr/local/bin/webdav-tunnel успешно скомпилирован${NC}"
            return 0
        else
            rm -rf "$tmp_dir"
            echo -e "${RED}  ! Ошибка компиляции.${NC}"
            return 1
        fi
    else
        rm -rf "$tmp_dir"
        echo -e "${RED}  ! Не удалось клонировать репозиторий.${NC}"
        return 1
    fi
}

menu_webdav_tunnel() {
    if ! is_webdav_tunnel_installed; then
        clear
        echo -e "${YELLOW}╔══════════════════════════════════════════════════════════════════════╗${NC}"
        echo -e "${YELLOW}║${BOLD}   WebDAV Tunnel — НЕ УСТАНОВЛЕН                                     ${YELLOW}║${NC}"
        echo -e "${YELLOW}╚══════════════════════════════════════════════════════════════════════╝${NC}"
        echo ""
        echo -e "  WebDAV Tunnel — TCP-туннель поверх WebDAV (Selfhosted и Яндекс.Диск)."
        echo -e "  Трафик маскируется под WebDAV-запросы к хранилищу."
        echo ""
        echo -e "  ${YELLOW}[1]${NC} 📦 Установить WebDAV Tunnel (скачать + собрать из исходников)"
        echo -e "  ${BOLD}[0]${NC} ← Назад"
        echo ""
        read -p "Выберите действие [0-1]: " inst_ch
        case "$inst_ch" in
            1)
                clear
                echo -e "${CYAN}==> Установка WebDAV Tunnel...${NC}"
                # Пользователь
                id -u "$WDAVTUNNEL_USER" &>/dev/null || useradd -r -s /usr/sbin/nologin "$WDAVTUNNEL_USER" 2>/dev/null || true
                # Директории
                mkdir -p "$WDAVTUNNEL_DIR" "$WDAVTUNNEL_STORAGE" "/var/log/webdav-tunnel"
                chown -R "$WDAVTUNNEL_USER:$WDAVTUNNEL_USER" "$WDAVTUNNEL_DIR" "$WDAVTUNNEL_STORAGE" "/var/log/webdav-tunnel" 2>/dev/null || true
                # Go
                export PATH=$PATH:/usr/local/go/bin
                if ! command -v go >/dev/null 2>&1; then
                    echo -e "${CYAN}  → Установка компилятора Go...${NC}"
                    apt-get install -y -qq golang-go >/dev/null 2>&1 || true
                fi
                # Бинарник
                if build_webdav_tunnel_binary; then
                    # Дефолтный конфиг
                    if [ ! -f "$WDAVTUNNEL_CONFIG_ENV" ]; then
                        local rnd_pass
                        rnd_pass=$(tr -dc 'a-zA-Z0-9' < /dev/urandom | head -c 24 2>/dev/null || date +%s | sha256sum | head -c 24)
                        cat > "$WDAVTUNNEL_CONFIG_ENV" <<EOF_CFG
WEBDAV_MODE="selfhosted"
WEBDAV_LISTEN=":8443"
WEBDAV_STORAGE="${WDAVTUNNEL_STORAGE}"
WEBDAV_URL="https://webdav.yandex.ru"
WEBDAV_LOGIN="wdav"
WEBDAV_PASSWORD="${rnd_pass}"
WEBDAV_ENC="false"
ROUTING_MODE="xray"
XRAY_REDIRECT_PORT="${XRAY_REDIRECT_PORT:-12346}"
EOF_CFG
                        chown root:"$WDAVTUNNEL_USER" "$WDAVTUNNEL_CONFIG_ENV"
                        chmod 640 "$WDAVTUNNEL_CONFIG_ENV"
                    fi
                    # Runner script
                    local sd
                    sd=$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")" && pwd)
                    if [ -f "$sd/../scripts/webdav-tunnel-runner.sh" ]; then
                        cp -f "$sd/../scripts/webdav-tunnel-runner.sh" "$WDAVTUNNEL_RUNNER"
                    else
                        curl -fsSL -o "$WDAVTUNNEL_RUNNER" \
                            "https://raw.githubusercontent.com/lesovoi53/xray-manager/main/scripts/webdav-tunnel-runner.sh?v=$(date +%s)" 2>/dev/null || true
                    fi
                    chmod +x "$WDAVTUNNEL_RUNNER" 2>/dev/null || true
                    # Routing script
                    if [ -f "$sd/../scripts/webdav-tunnel-routing.sh" ]; then
                        cp -f "$sd/../scripts/webdav-tunnel-routing.sh" "$WDAVTUNNEL_ROUTING"
                    else
                        curl -fsSL -o "$WDAVTUNNEL_ROUTING" \
                            "https://raw.githubusercontent.com/lesovoi53/xray-manager/main/scripts/webdav-tunnel-routing.sh?v=$(date +%s)" 2>/dev/null || true
                    fi
                    chmod +x "$WDAVTUNNEL_ROUTING" 2>/dev/null || true
                    # Systemd unit
                    if [ -f "$sd/../systemd/webdav-tunnel.service" ]; then
                        cp -f "$sd/../systemd/webdav-tunnel.service" "/etc/systemd/system/${WDAVTUNNEL_SERVICE}.service"
                    else
                        curl -fsSL -o "/etc/systemd/system/${WDAVTUNNEL_SERVICE}.service" \
                            "https://raw.githubusercontent.com/lesovoi53/xray-manager/main/systemd/webdav-tunnel.service?v=$(date +%s)" 2>/dev/null || true
                    fi
                    systemctl daemon-reload
                    echo -e "${GREEN}✓ WebDAV Tunnel установлен. Настройте логин/пароль и запустите из меню.${NC}"
                fi
                read -p "Нажмите Enter..."
                ;;
        esac
        return
    fi

    while true; do
        clear
        local wdt_status
        wdt_status=$(get_wdavtunnel_status)
        local wdt_mode
        wdt_mode=$(get_wdavtunnel_mode)
        local wdt_port
        wdt_port=$(get_wdavtunnel_listen_port)
        local wdt_url
        wdt_url=$(get_wdavtunnel_prop "WEBDAV_URL" "https://webdav.cloud.mail.ru")
        local wdt_login
        wdt_login=$(get_wdavtunnel_prop "WEBDAV_LOGIN" "(не задан)")
        local wdt_pass
        wdt_pass=$(get_wdavtunnel_prop "WEBDAV_PASSWORD" "(не задан)")
        local wdt_enc
        wdt_enc=$(get_wdavtunnel_prop "WEBDAV_ENC" "false")
        local wdt_routing
        wdt_routing=$(get_wdavtunnel_routing)
        local wdt_uri
        wdt_uri=$(get_wdavtunnel_client_uri)
        local wdt_prov
        wdt_prov=$(get_wdavtunnel_provider_label)

        echo -e "${CYAN}╔══════════════════════════════════════════════════════════════════════╗${NC}"
        echo -e "${CYAN}║${BOLD}   WebDAV Tunnel — TCP over WebDAV (WireTurn / webdav-tunnel)         ${CYAN}║${NC}"
        echo -e "${CYAN}╠══════════════════════════════════════════════════════════════════════╣${NC}"
        echo -e "${CYAN}║${NC}  Статус: ${wdt_status}"
        echo -e "${CYAN}║${NC}  Режим: ${wdt_prov}"
        if [ "$wdt_mode" = "multi" ]; then
            local loc_st="${RED}[ВЫКЛ]${NC}"
            [ "$(get_wdavtunnel_prop "MULTI_LOCAL_ENABLED" "true")" = "true" ] && loc_st="${GREEN}[ВКЛ]${NC} (:${wdt_port}, user: ${wdt_login})"
            local mail_st="${RED}[ВЫКЛ]${NC}"
            [ "$(get_wdavtunnel_prop "MULTI_MAILRU_ENABLED" "true")" = "true" ] && mail_st="${GREEN}[ВКЛ]${NC} (${BOLD}$(get_wdavtunnel_prop "MULTI_MAILRU_LOGIN" "не задан")${NC})"
            local yan_st="${RED}[ВЫКЛ]${NC}"
            [ "$(get_wdavtunnel_prop "MULTI_YANDEX_ENABLED" "false")" = "true" ] && yan_st="${GREEN}[ВКЛ]${NC} (${BOLD}$(get_wdavtunnel_prop "MULTI_YANDEX_LOGIN" "не задан")${NC})"
            local cust_st="${RED}[ВЫКЛ]${NC}"
            [ "$(get_wdavtunnel_prop "MULTI_CUSTOM_ENABLED" "false")" = "true" ] && cust_st="${GREEN}[ВКЛ]${NC} (${BOLD}$(get_wdavtunnel_prop "MULTI_CUSTOM_URL" "не задан")${NC})"

            echo -e "${CYAN}║${NC}  Хранилища в пуле:"
            echo -e "${CYAN}║${NC}    • 🖥  Свой сервер: ${loc_st}"
            echo -e "${CYAN}║${NC}    • ☁️  Облако Mail.ru: ${mail_st}"
            echo -e "${CYAN}║${NC}    • 🟡  Яндекс.Диск: ${yan_st}"
            if [ "$(get_wdavtunnel_prop "MULTI_CUSTOM_ENABLED" "false")" = "true" ]; then
                echo -e "${CYAN}║${NC}    • 🌐  Кастомный WebDAV: ${cust_st}"
            fi
        elif [ "$wdt_mode" = "server" ]; then
            echo -e "${CYAN}║${NC}  WebDAV URL: ${BOLD}${wdt_url}${NC}"
            echo -e "${CYAN}║${NC}  Логин: ${BOLD}${wdt_login}${NC}  |  Пароль: ${GREEN}${wdt_pass}${NC}"
        else
            echo -e "${CYAN}║${NC}  Порт WebDAV (встроенный): ${BOLD}:${wdt_port}/TCP${NC}"
            echo -e "${CYAN}║${NC}  Логин: ${BOLD}${wdt_login}${NC}  |  Пароль: ${GREEN}${wdt_pass}${NC}"
        fi
        echo -e "${CYAN}║${NC}  Шифрование чанков (AES-256-GCM): ${BOLD}${wdt_enc}${NC}"
        echo -e "${CYAN}║${NC}  Маршрутизация: ${wdt_routing}"
        echo -e "${CYAN}║${NC}"
        echo -e "${CYAN}║${NC}  Ссылка для WireTurn (вставить в приложение):"
        echo -e "${CYAN}║${NC}  ${GREEN}${wdt_uri}${NC}"
        echo -e "${CYAN}╚══════════════════════════════════════════════════════════════════════╝${NC}"
        echo ""
        echo -e "  ${GREEN}[1]${NC} ▶  Запустить WebDAV Tunnel"
        echo -e "  ${RED}[2]${NC} ■  Остановить WebDAV Tunnel"
        echo -e "  ${YELLOW}[3]${NC} 🔄 Перезапустить WebDAV Tunnel"
        echo -e "  ${CYAN}[4]${NC} 🔀 Сменить режим (Мульти-пул / Mail.ru / Selfhosted / Яндекс / Кастом)"
        if [ "$wdt_mode" = "multi" ]; then
            echo -e "  ${CYAN}[5]${NC} ⚙️  ${BOLD}Настроить хранилища в пуле${NC} (Вкл/Выкл, логины, пароли)"
        else
            echo -e "  ${CYAN}[5]${NC} 🔑 Сменить логин / пароль (пароль приложения)"
            if [ "$wdt_mode" = "server" ]; then
                echo -e "  ${CYAN}[6]${NC} 🌐 Сменить URL WebDAV-хранилища (текущий: ${wdt_url})"
            else
                echo -e "  ${CYAN}[6]${NC} 🔌 Сменить порт WebDAV-сервера (текущий: :${wdt_port})"
            fi
        fi
        echo -e "  ${CYAN}[7]${NC} 🔒 Включить / выключить AES-256-GCM шифрование чанков"
        echo -e "  ${CYAN}[8]${NC} 🧭 Переключить маршрутизацию (Xray REDIRECT / Прямой WAN)"
        echo -e "  ${CYAN}[9]${NC} 📋 Показать ссылку и QR-код для WireTurn"
        echo -e "  ${CYAN}[10]${NC} 📜 Логи службы (journalctl)"
        echo -e "  ${CYAN}[11]${NC} ⚡ Живые логи (journalctl -f)"
        echo -e "  ${CYAN}[12]${NC} 🔨 Пересобрать бинарник из исходников (spkprsnts/webdav-tunnel)"
        echo -e "  ${BOLD}[0]${NC} ← Назад в главное меню"
        echo ""
        read -p "Выберите действие [0-12]: " wdt_choice

        case "$wdt_choice" in
            1)
                systemctl start "$WDAVTUNNEL_SERVICE" 2>/dev/null \
                    && echo -e "${GREEN}✓ WebDAV Tunnel запущен${NC}" \
                    || echo -e "${RED}✗ Не удалось запустить${NC}"
                sleep 1
                ;;
            2)
                systemctl stop "$WDAVTUNNEL_SERVICE" 2>/dev/null \
                    && echo -e "${YELLOW}■ WebDAV Tunnel остановлен${NC}" \
                    || echo -e "${RED}✗ Не удалось остановить${NC}"
                sleep 1
                ;;
            3)
                systemctl restart "$WDAVTUNNEL_SERVICE" 2>/dev/null \
                    && echo -e "${GREEN}✓ WebDAV Tunnel перезапущен${NC}" \
                    || echo -e "${RED}✗ Не удалось перезапустить${NC}"
                sleep 1
                ;;
            4)
                clear
                echo -e "${CYAN}╔══════════════════════════════════════════════════════════════════════╗${NC}"
                echo -e "${CYAN}║${BOLD}   Выбор режима и провайдера WebDAV Tunnel                            ${CYAN}║${NC}"
                echo -e "${CYAN}╚══════════════════════════════════════════════════════════════════════╝${NC}"
                echo ""
                echo -e "  ${PURPLE}[1]${NC} 🔀 ${BOLD}МУЛЬТИ-БЕКЕНД (Гибридный пул)${NC} — одновременная работа нескольких хранилищ"
                echo -e "       • Объединяет Mail.ru + Свой сервер (:8443) + Яндекс в единый пул."
                echo -e "       • WireTurn распределяет сессии по кругу и переключается при сбоях (Failover)."
                echo ""
                echo -e "  ${CYAN}[2]${NC} ☁️  ${BOLD}Облако Mail.ru (Одиночный)${NC} (https://webdav.cloud.mail.ru)"
                echo -e "       • Передача данных через WebDAV Mail.ru (нужен пароль для внешних приложений)."
                echo -e "       • VPS не открывает входящих портов, работает скрытно через облако."
                echo ""
                echo -e "  ${CYAN}[3]${NC} 🖥  ${BOLD}Встроенный сервер (Selfhosted Одиночный)${NC} — порт на VPS (например :8443)"
                echo -e "       • Клиент WireTurn подключается напрямую к вашему VPS по IP:порт."
                echo -e "       • Самая быстрая скорость и минимальный пинг."
                echo ""
                echo -e "  ${CYAN}[4]${NC} 🟡  ${BOLD}Яндекс.Диск (Одиночный)${NC} (https://webdav.yandex.ru)"
                echo -e "       • ${RED}ВНИМАНИЕ: WebDAV у Яндекса требует платную подписку Яндекс 360!${NC}"
                echo -e "       • На бесплатном тарифе Яндекс возвращает ошибку '402 Payment Required'."
                echo ""
                echo -e "  ${CYAN}[5]${NC} 🌐  ${BOLD}Другой кастомный WebDAV-сервер${NC} (Nextcloud, Owncloud и др.)"
                echo ""
                read -p "  Выберите вариант [1-5, 0 для отмены]: " new_m_ch
                case "$new_m_ch" in
                    1)
                        set_wdavtunnel_prop "WEBDAV_MODE" "multi"
                        menu_webdav_tunnel_pool
                        ;;
                    2)
                        set_wdavtunnel_prop "WEBDAV_MODE" "server"
                        set_wdavtunnel_prop "WEBDAV_URL" "https://webdav.cloud.mail.ru"
                        echo ""
                        echo -e "${YELLOW}╔══════════════════════════════════════════════════════════════════════╗${NC}"
                        echo -e "${YELLOW}║${BOLD}  ИНСТРУКЦИЯ ПО НАСТРОЙКЕ ОБЛАКА MAIL.RU:                             ${YELLOW}║${NC}"
                        echo -e "${YELLOW}╚══════════════════════════════════════════════════════════════════════╝${NC}"
                        echo -e "  1. Перейдите в браузере: ${BOLD}https://account.mail.ru/user/2-step-auth/passwords${NC}"
                        echo -e "  2. Нажмите ${CYAN}«Пароли для внешних приложений»${NC} → ${BOLD}«Добавить»${NC}"
                        echo -e "  3. Введите название (например: ${BOLD}WireTurn${NC}) и нажмите «Создать»"
                        echo -e "  4. Скопируйте полученный пароль приложения"
                        echo ""
                        read -p "  Логин Mail.ru (email, например user@mail.ru) [${wdt_login}]: " in_m_login
                        [ -n "$in_m_login" ] && set_wdavtunnel_prop "WEBDAV_LOGIN" "$in_m_login"
                        read -p "  Пароль для внешних приложений Mail.ru: " in_m_pass
                        [ -n "$in_m_pass" ] && set_wdavtunnel_prop "WEBDAV_PASSWORD" "$in_m_pass"

                        chown root:"$WDAVTUNNEL_USER" "$WDAVTUNNEL_CONFIG_ENV" 2>/dev/null || true
                        chmod 640 "$WDAVTUNNEL_CONFIG_ENV" 2>/dev/null || true

                        if [ "$(get_wdavtunnel_prop "ROUTING_MODE" "xray")" = "xray" ] && [ -x "$WDAVTUNNEL_ROUTING" ]; then
                            "$WDAVTUNNEL_ROUTING" up 2>/dev/null || true
                        fi

                        if systemctl is-active --quiet "$WDAVTUNNEL_SERVICE" 2>/dev/null; then
                            systemctl restart "$WDAVTUNNEL_SERVICE" 2>/dev/null || true
                            echo -e "${GREEN}✓ Режим переключен на Облако Mail.ru и служба перезапущена.${NC}"
                        else
                            echo -e "${GREEN}✓ Режим переключен на Облако Mail.ru.${NC}"
                        fi
                        read -p "Нажмите Enter..."
                        ;;
                    3)
                        set_wdavtunnel_prop "WEBDAV_MODE" "selfhosted"
                        echo -e "${GREEN}✓ Режим переключен на Встроенный сервер (Selfhosted).${NC}"
                        if systemctl is-active --quiet "$WDAVTUNNEL_SERVICE" 2>/dev/null; then
                            systemctl restart "$WDAVTUNNEL_SERVICE" 2>/dev/null || true
                            echo -e "${GREEN}✓ Служба перезапущена.${NC}"
                        fi
                        sleep 1
                        ;;
                    4)
                        set_wdavtunnel_prop "WEBDAV_MODE" "server"
                        set_wdavtunnel_prop "WEBDAV_URL" "https://webdav.yandex.ru"
                        echo ""
                        echo -e "${YELLOW}╔══════════════════════════════════════════════════════════════════════╗${NC}"
                        echo -e "${YELLOW}║${BOLD}  ИНСТРУКЦИЯ ПО НАСТРОЙКЕ ЯНДЕКС.ДИСКА:                               ${YELLOW}║${NC}"
                        echo -e "${YELLOW}╚══════════════════════════════════════════════════════════════════════╝${NC}"
                        echo -e "  ${RED}! ВНИМАНИЕ: WebDAV у Яндекса требует платную подписку Яндекс 360.${NC}"
                        echo -e "  1. Перейдите в браузере: ${BOLD}https://id.yandex.ru/security${NC}"
                        echo -e "  2. Прокрутите до блока ${CYAN}«Пароли приложений»${NC} → ${BOLD}«Создать пароль»${NC}"
                        echo -e "  3. Выберите тип приложения: ${BOLD}«Файлы (Диск)»${NC}"
                        echo -e "  4. Задайте имя (например: ${BOLD}wireturn${NC}) и нажмите «Создать»"
                        echo -e "  5. Скопируйте сгенерированный пароль приложения"
                        echo ""
                        read -p "  Логин Яндекс (email или логин) [${wdt_login}]: " in_y_login
                        [ -n "$in_y_login" ] && set_wdavtunnel_prop "WEBDAV_LOGIN" "$in_y_login"
                        read -p "  Пароль приложения Яндекс: " in_y_pass
                        [ -n "$in_y_pass" ] && set_wdavtunnel_prop "WEBDAV_PASSWORD" "$in_y_pass"

                        chown root:"$WDAVTUNNEL_USER" "$WDAVTUNNEL_CONFIG_ENV" 2>/dev/null || true
                        chmod 640 "$WDAVTUNNEL_CONFIG_ENV" 2>/dev/null || true

                        if [ "$(get_wdavtunnel_prop "ROUTING_MODE" "xray")" = "xray" ] && [ -x "$WDAVTUNNEL_ROUTING" ]; then
                            "$WDAVTUNNEL_ROUTING" up 2>/dev/null || true
                        fi

                        if systemctl is-active --quiet "$WDAVTUNNEL_SERVICE" 2>/dev/null; then
                            systemctl restart "$WDAVTUNNEL_SERVICE" 2>/dev/null || true
                            echo -e "${GREEN}✓ Режим переключен на Яндекс.Диск и служба перезапущена.${NC}"
                        else
                            echo -e "${GREEN}✓ Режим переключен на Яндекс.Диск.${NC}"
                        fi
                        read -p "Нажмите Enter..."
                        ;;
                    5)
                        set_wdavtunnel_prop "WEBDAV_MODE" "server"
                        echo ""
                        read -p "  URL WebDAV-сервера (например https://my-cloud.com/dav/) [${wdt_url}]: " in_c_url
                        [ -n "$in_c_url" ] && set_wdavtunnel_prop "WEBDAV_URL" "$in_c_url"
                        read -p "  Логин WebDAV [${wdt_login}]: " in_c_login
                        [ -n "$in_c_login" ] && set_wdavtunnel_prop "WEBDAV_LOGIN" "$in_c_login"
                        read -p "  Пароль WebDAV: " in_c_pass
                        [ -n "$in_c_pass" ] && set_wdavtunnel_prop "WEBDAV_PASSWORD" "$in_c_pass"

                        chown root:"$WDAVTUNNEL_USER" "$WDAVTUNNEL_CONFIG_ENV" 2>/dev/null || true
                        chmod 640 "$WDAVTUNNEL_CONFIG_ENV" 2>/dev/null || true

                        if [ "$(get_wdavtunnel_prop "ROUTING_MODE" "xray")" = "xray" ] && [ -x "$WDAVTUNNEL_ROUTING" ]; then
                            "$WDAVTUNNEL_ROUTING" up 2>/dev/null || true
                        fi

                        if systemctl is-active --quiet "$WDAVTUNNEL_SERVICE" 2>/dev/null; then
                            systemctl restart "$WDAVTUNNEL_SERVICE" 2>/dev/null || true
                            echo -e "${GREEN}✓ Настройки сохранены и служба перезапущена.${NC}"
                        else
                            echo -e "${GREEN}✓ Настройки сохранены.${NC}"
                        fi
                        read -p "Нажмите Enter..."
                        ;;
                    *) ;;
                esac
                ;;
            5)
                if [ "$wdt_mode" = "multi" ]; then
                    menu_webdav_tunnel_pool
                else
                    echo ""
                    if [[ "$wdt_url" =~ mail\.ru ]]; then
                        echo -e "  ${YELLOW}Примечание для Mail.ru:${NC} используйте ${BOLD}пароль для внешних приложений${NC} (account.mail.ru)"
                    elif [[ "$wdt_url" =~ yandex ]]; then
                        echo -e "  ${YELLOW}Примечание для Яндекс.Диска:${NC} используйте ${BOLD}пароль приложения${NC} (id.yandex.ru)"
                    fi
                    read -p "  Новый логин [${wdt_login}]: " new_login
                    read -p "  Новый пароль: " new_pass
                    if [ -n "$new_login" ]; then
                        set_wdavtunnel_prop "WEBDAV_LOGIN" "$new_login"
                    fi
                    if [ -n "$new_pass" ]; then
                        set_wdavtunnel_prop "WEBDAV_PASSWORD" "$new_pass"
                    fi
                    chown root:"$WDAVTUNNEL_USER" "$WDAVTUNNEL_CONFIG_ENV" 2>/dev/null || true
                    chmod 640 "$WDAVTUNNEL_CONFIG_ENV" 2>/dev/null || true
                    echo -e "${GREEN}✓ Логин/пароль обновлены. Перезапустите туннель для применения.${NC}"
                    read -p "Нажмите Enter..."
                fi
                ;;
            6)
                if [ "$wdt_mode" = "multi" ]; then
                    echo "Не применимо в режиме мульти-пула"
                    sleep 1
                elif [ "$wdt_mode" = "server" ]; then
                    echo ""
                    read -p "  Новый WebDAV URL [текущий: ${wdt_url}]: " new_url
                    if [ -n "$new_url" ]; then
                        set_wdavtunnel_prop "WEBDAV_URL" "$new_url"
                        echo -e "${GREEN}✓ URL изменён на ${new_url}. Перезапустите туннель для применения.${NC}"
                    fi
                    read -p "Нажмите Enter..."
                else
                    echo ""
                    read -p "  Новый порт WebDAV-сервера (текущий: ${wdt_port}): " new_port
                    if [[ "$new_port" =~ ^[0-9]+$ ]] && [ "$new_port" -ge 1024 ] && [ "$new_port" -le 65535 ]; then
                        set_wdavtunnel_prop "WEBDAV_LISTEN" ":${new_port}"
                        echo -e "${GREEN}✓ Порт изменён на :${new_port}. Перезапустите для применения.${NC}"
                        # Обновить правило фаервола
                        iptables -C INPUT -p tcp --dport "$new_port" -m comment --comment "WDAVTUNNEL_MANAGED" -j ACCEPT 2>/dev/null \
                            || iptables -I INPUT 1 -p tcp --dport "$new_port" -m comment --comment "WDAVTUNNEL_MANAGED" -j ACCEPT 2>/dev/null || true
                    else
                        echo -e "${RED}  Неверный порт (1024-65535)${NC}"
                    fi
                    read -p "Нажмите Enter..."
                fi
                ;;
            7)
                if [ "$wdt_enc" = "true" ] || [ "$wdt_enc" = "1" ]; then
                    set_wdavtunnel_prop "WEBDAV_ENC" "false"
                    echo -e "${YELLOW}Шифрование ВЫКЛЮЧЕНО. Перезапустите туннель.${NC}"
                else
                    set_wdavtunnel_prop "WEBDAV_ENC" "true"
                    echo -e "${GREEN}✓ Шифрование AES-256-GCM ВКЛЮЧЕНО. Перезапустите туннель.${NC}"
                fi
                read -p "Нажмите Enter..."
                ;;
            8)
                local cur_mode
                cur_mode=$(get_wdavtunnel_prop "ROUTING_MODE" "xray")
                if [ "$cur_mode" = "xray" ]; then
                    set_wdavtunnel_prop "ROUTING_MODE" "direct"
                    # Снять iptables-правила
                    [ -x "$WDAVTUNNEL_ROUTING" ] && "$WDAVTUNNEL_ROUTING" down 2>/dev/null || true
                    echo -e "${YELLOW}Маршрутизация: Прямой WAN (без Xray).${NC}"
                else
                    set_wdavtunnel_prop "ROUTING_MODE" "xray"
                    # Применить iptables-правила
                    [ -x "$WDAVTUNNEL_ROUTING" ] && "$WDAVTUNNEL_ROUTING" up 2>/dev/null || true
                    echo -e "${GREEN}✓ Маршрутизация: Xray REDIRECT (:${XRAY_REDIRECT_PORT:-12346}).${NC}"
                fi
                read -p "Нажмите Enter..."
                ;;
            9)
                clear
                echo -e "${CYAN}╔══════════════════════════════════════════════════════════════════════╗${NC}"
                echo -e "${CYAN}║${BOLD}   WebDAV Tunnel — Ссылка для подключения WireTurn                     ${CYAN}║${NC}"
                echo -e "${CYAN}╚══════════════════════════════════════════════════════════════════════╝${NC}"
                echo ""
                local uri_full
                uri_full=$(get_wdavtunnel_client_uri)
                echo -e "  ${BOLD}Ссылка для WireTurn (Android / Клиент):${NC}"
                echo -e "  ${GREEN}${uri_full}${NC}"
                echo ""
                echo -e "  ${BOLD}Инструкция по подключению в WireTurn:${NC}"
                echo -e "  1. Скопируйте ссылку выше"
                echo -e "  2. Откройте приложение WireTurn на смартфоне"
                echo -e "  3. Нажмите '+' (Добавить) или 'Импорт из буфера обмена'"
                echo -e "  4. Запустите профиль туннеля"
                echo ""
                echo -e "  ${BOLD}Использование через CLI (Linux / Windows / macOS):${NC}"
                echo -e "  webdav-tunnel -mode client \\"
                echo -e "    -uri \"${uri_full}\" \\"
                echo -e "    -socks-listen 127.0.0.1:1080"
                if command -v qrencode >/dev/null 2>&1; then
                    echo ""
                    echo -e "  ${BOLD}QR-код для сканирования камерой в WireTurn:${NC}"
                    qrencode -t ANSIUTF8 "$uri_full" 2>/dev/null || true
                fi
                echo ""
                read -p "Нажмите Enter для возврата..."
                ;;
            10)
                journalctl -u "$WDAVTUNNEL_SERVICE" -n 80 --no-pager 2>/dev/null || echo "(логи недоступны)"
                read -p "Нажмите Enter..."
                ;;
            11)
                echo -e "${YELLOW}(Нажмите Ctrl+C для остановки)${NC}"
                journalctl -u "$WDAVTUNNEL_SERVICE" -f --no-pager 2>/dev/null || true
                ;;
            12)
                clear
                echo -e "${CYAN}==> Пересборка webdav-tunnel из исходников...${NC}"
                export PATH=$PATH:/usr/local/go/bin
                build_webdav_tunnel_binary && systemctl restart "$WDAVTUNNEL_SERVICE" 2>/dev/null || true
                read -p "Нажмите Enter..."
                ;;
            0) return ;;
            *) echo "Неверный выбор"; sleep 1 ;;
        esac
    done
}

menu_openflux() {
    if ! is_openflux_installed; then
        clear
        echo -e "${YELLOW}╔══════════════════════════════════════════════════════════════════════╗${NC}"
        echo -e "${YELLOW}║${BOLD}                    OPENFLUX НЕ УСТАНОВЛЕН                            ${YELLOW}║${NC}"
        echo -e "${YELLOW}╚══════════════════════════════════════════════════════════════════════╝${NC}"
        echo ""
        echo -e "${RED}Служба OpenFlux или бинарный файл /usr/local/bin/openflux не найдены.${NC}"
        echo ""
        echo -e "Хотите скомпилировать и установить OpenFlux прямо сейчас? [Y/n]: "
        read -rp "" inst_ans
        if [[ ! "$inst_ans" =~ ^[Nn] ]]; then
            rebuild_openflux
        else
            return
        fi
    fi

    while true; do
        show_openflux_header
        local of_transport=$(get_openflux_prop "TRANSPORT" "vyandex")
        local of_codec=$(get_openflux_prop "CODEC" "legacy")
        local of_debug=$(get_openflux_prop "DEBUG" "1")
        local of_key=$(get_openflux_prop "ENCRYPTION_KEY" "")

        echo -e " ${BOLD}[КАНАЛЫ СВЯЗИ / ОБЛАЧНЫЕ ДОКУМЕНТЫ (1-8)]${NC}"
        for ch in 1 2 3 4 5 6 7 8; do
            local ch_url=$(get_openflux_channel_prop "$ch" "URL" "")
            local ch_tr=$(get_openflux_channel_prop "$ch" "TRANSPORT" "$of_transport")
            local ch_st="${YELLOW}[НЕ НАСТРОЕН]${NC}"
            local disp_url="${YELLOW}(ссылка не задана)${NC}"
            if [ -n "$ch_url" ]; then
                disp_url="${CYAN}${ch_url}${NC}"
                if systemctl is-active --quiet "openflux@$ch" 2>/dev/null; then
                    ch_st="${GREEN}[АКТИВЕН]${NC}"
                else
                    ch_st="${RED}[ОСТАНОВЛЕН]${NC}"
                fi
            fi
            printf "   Канал %d: %-22b [%-7s] %b\n" "$ch" "$ch_st" "$ch_tr" "$disp_url"
        done
        echo -e "${CYAN}──────────────────────────────────────────────────────────────────────${NC}"
        echo -e "  ${YELLOW}[1]${NC} 🔗 Выбрать и настроить ссылку для канала (1-8) (Автоопределение Яндекс/Mail.ru)"
        echo -e "  ${YELLOW}[2]${NC} ⚡ Мастер настройки всех 8 каналов подряд"
        echo -e "  ${YELLOW}[3]${NC} 🔄 Сменить транспорт по умолчанию (1: vyandex, 2: yandex, 3: mailru)"
        echo -e "  ${YELLOW}[4]${NC} 📦 Сменить кодек сжатия (1: legacy [LZ4], 2: batched [zstd])"
        echo -e "  ${YELLOW}[5]${NC} 🔐 Управление сквозным ключом шифрования AES-256-GCM"
        echo -e "  ${YELLOW}[6]${NC} 🐞 Переключить режим отладки Debug (вкл/выкл в journalctl)"
        echo -e "  ${YELLOW}[7]${NC} 🌐 Маршрутизация трафика (Xray REDIRECT / Прямой выход)"
        echo -e "  ${YELLOW}[8]${NC} ▶️  Запустить / перезапустить ВСЕ настроенные каналы"
        echo -e "  ${YELLOW}[9]${NC} ⏹️  Остановить ВСЕ каналы OpenFlux"
        echo -e "  ${YELLOW}[10]${NC} 📜 Просмотр последних 30 строк логов (выбор канала 1-8 или общий)"
        echo -e "  ${YELLOW}[11]${NC} 🔍 Мониторинг логов в реальном времени (live follow)"
        echo -e "  ${YELLOW}[12]${NC} 🔨 Скомпилировать / переустановить OpenFlux из репозитория"
        echo -e "  ${YELLOW}[0]${NC} ⬅️  Назад в Главное Меню"
        echo ""
        read -p "Выберите действие [0-12, или c1-c8]: " of_choice

        case "$of_choice" in
            1|c1|c2|c3|c4|c5|c6|c7|c8|C1|C2|C3|C4|C5|C6|C7|C8)
                local target_ch=""
                if [[ "$of_choice" =~ ^[cC]([1-8])$ ]]; then
                    target_ch="${BASH_REMATCH[1]}"
                else
                    echo ""
                    read -rp "Какой канал настроить [1-8, Enter для отмены]: " target_ch
                fi

                if [[ ! "$target_ch" =~ ^[1-8]$ ]]; then
                    echo -e "${YELLOW}Действие отменено.${NC}"
                    sleep 1
                    continue
                fi

                echo ""
                echo -e "${BOLD}--- ВВОД ССЫЛКИ НА ДОКУМЕНТ ДЛЯ КАНАЛА ${target_ch} ---${NC}"
                local cur_u=$(get_openflux_channel_prop "$target_ch" "URL" "")
                echo "Текущая ссылка: ${cur_u:-[не задана]}"
                echo ""
                echo "• Введите ссылку на документ (Яндекс Диск / 360 или Облако Mail.ru) с правом редактирования."
                echo "• Оставьте пустым и нажмите Enter, чтобы очистить ссылку (отключить канал)."
                echo ""
                read -rp "Новая ссылка: " new_u
                if [ -n "$new_u" ]; then
                    local auto_tr=$(detect_transport_from_url "$new_u" "$of_transport")
                    echo ""
                    echo -e "${CYAN}ℹ Выбор транспорта для Канала ${target_ch}:${NC}"
                    echo " 1) $auto_tr (определен автоматически по ссылке)"
                    echo " 2) vyandex (Яндекс Волга)"
                    echo " 3) mailru  (Mail.ru Документы)"
                    echo " 4) yandex  (Яндекс OnlyOffice)"
                    read -rp "Транспорт [1-4, Enter для '$auto_tr']: " sel_tr
                    local use_tr="$auto_tr"
                    case "$sel_tr" in
                        2) use_tr="vyandex" ;;
                        3) use_tr="mailru" ;;
                        4) use_tr="yandex" ;;
                        *) use_tr="$auto_tr" ;;
                    esac
                    set_openflux_channel_prop "$target_ch" "URL" "$new_u"
                    set_openflux_channel_prop "$target_ch" "ROLE" "exit"
                    set_openflux_channel_prop "$target_ch" "MODE" "l4"
                    set_openflux_channel_prop "$target_ch" "TRANSPORT" "$use_tr"
                    set_openflux_channel_prop "$target_ch" "CODEC" "$of_codec"
                    set_openflux_channel_prop "$target_ch" "DEBUG" "$of_debug"
                    set_openflux_channel_prop "$target_ch" "ENCRYPTION_KEY" "$of_key"
                    echo -e "${GREEN}${BOLD}✓ Ссылка для Канала ${target_ch} сохранена (Транспорт: ${use_tr})!${NC}"
                    echo "Запуск службы openflux@${target_ch}..."
                    systemctl enable "openflux@${target_ch}" 2>/dev/null || true
                    systemctl restart "openflux@${target_ch}"
                    sleep 2
                    if systemctl is-active --quiet "openflux@${target_ch}"; then
                        echo -e "${GREEN}${BOLD}✓ Канал ${target_ch} успешно запущен и работает!${NC}"
                    else
                        echo -e "${RED}${BOLD}Ошибка запуска Канала ${target_ch}! Логи:${NC}"
                        journalctl -u "openflux@${target_ch}" -n 10 --no-pager
                    fi
                else
                    echo -e "${YELLOW}Очистить ссылку и отключить Канал ${target_ch}? [y/N]: ${NC}"
                    read -rp "" confirm_clr
                    if [[ "$confirm_clr" =~ ^[YyДд] ]]; then
                        set_openflux_channel_prop "$target_ch" "URL" ""
                        systemctl stop "openflux@${target_ch}" 2>/dev/null || true
                        systemctl disable "openflux@${target_ch}" 2>/dev/null || true
                        echo -e "${YELLOW}Канал ${target_ch} отключен.${NC}"
                    fi
                fi
                sleep 2
                ;;
            2)
                echo ""
                echo -e "${BOLD}--- МАСТЕР НАСТРОЙКИ ВСЕХ 8 КАНАЛОВ МУЛЬТИПЛЕКСИРОВАНИЯ ---${NC}"
                echo "Введите по очереди ссылки на 8 документов Яндекс / Mail.ru (с правом редактирования)."
                echo "Транспорт (vyandex / mailru) определяется автоматически по формату ссылки."
                echo "Нажмите Enter без ввода, чтобы оставить текущую ссылку без изменений."
                echo ""
                for m_ch in 1 2 3 4 5 6 7 8; do
                    local cur_m_u=$(get_openflux_channel_prop "$m_ch" "URL" "")
                    local cur_m_tr=$(get_openflux_channel_prop "$m_ch" "TRANSPORT" "$of_transport")
                    echo -e "${BOLD}Канал $m_ch${NC} (текущий: ${cur_m_u:-[не задан]} [${cur_m_tr}]):"
                    read -rp "  Введите URL: " in_u
                    if [ -n "$in_u" ]; then
                        local auto_m_tr=$(detect_transport_from_url "$in_u" "$of_transport")
                        set_openflux_channel_prop "$m_ch" "URL" "$in_u"
                        set_openflux_channel_prop "$m_ch" "ROLE" "exit"
                        set_openflux_channel_prop "$m_ch" "MODE" "l4"
                        set_openflux_channel_prop "$m_ch" "TRANSPORT" "$auto_m_tr"
                        set_openflux_channel_prop "$m_ch" "CODEC" "$of_codec"
                        set_openflux_channel_prop "$m_ch" "DEBUG" "$of_debug"
                        set_openflux_channel_prop "$m_ch" "ENCRYPTION_KEY" "$of_key"
                        systemctl enable "openflux@${m_ch}" 2>/dev/null || true
                        systemctl restart "openflux@${m_ch}"
                        echo -e "  ${GREEN}✓ Канал $m_ch обновлен и запущен (${auto_m_tr}).${NC}"
                    fi
                done
                echo ""
                echo -e "${GREEN}${BOLD}✓ Настройка завершена!${NC}"
                sleep 2
                ;;
            3)
                echo ""
                echo -e "${BOLD}--- ВЫБОР РЕЖИМА ТРАНСПОРТА ДЛЯ ВСЕХ КАНАЛОВ ---${NC}"
                echo "Текущий транспорт по умолчанию: ${of_transport}"
                echo ""
                echo " 1) Яндекс Волга (vyandex - современный редактор Яндекс 360 / Диск, рекомендуется)"
                echo " 2) Яндекс.Документы (yandex - классический OnlyOffice редактор)"
                echo " 3) Mail.ru Документы (mailru - docs.datacloudmail.ru, Облако Mail.ru)"
                read -rp "Выберите транспорт [1-3]: " tr_choice
                local new_tr=""
                case "$tr_choice" in
                    1) new_tr="vyandex" ;;
                    2) new_tr="yandex" ;;
                    3) new_tr="mailru" ;;
                    *) echo -e "${YELLOW}Без изменений.${NC}" ;;
                esac
                if [ -n "$new_tr" ]; then
                    set_openflux_prop "TRANSPORT" "$new_tr"
                    echo -e "${GREEN}✓ Транспорт установлен: ${new_tr}${NC}"
                fi
                for r_ch in 1 2 3 4 5 6 7 8; do
                    if [ -n "$(get_openflux_channel_prop "$r_ch" "URL" "")" ] && systemctl is-active --quiet "openflux@$r_ch"; then
                        systemctl restart "openflux@$r_ch"
                    fi
                done
                sleep 2
                ;;
            4)
                echo ""
                echo -e "${BOLD}--- ВЫБОР КОДЕКА СЖАТИЯ ДЛЯ ВСЕХ КАНАЛОВ ---${NC}"
                echo "Текущий кодек: ${of_codec}"
                echo ""
                echo " 1) legacy (LZ4 - ОБЯЗАТЕЛЕН для мобильных клиентов Android и iOS!)"
                echo " 2) batched (zstd + coalescing - для десктопного OpenFlux CLI)"
                read -rp "Выберите кодек [1-2]: " cod_choice
                case "$cod_choice" in
                    1) set_openflux_prop "CODEC" "legacy"; echo -e "${GREEN}✓ Кодек установлен: legacy (LZ4)${NC}" ;;
                    2) set_openflux_prop "CODEC" "batched"; echo -e "${GREEN}✓ Кодек установлен: batched (zstd)${NC}" ;;
                    *) echo -e "${YELLOW}Без изменений.${NC}" ;;
                esac
                for r_ch in 1 2 3 4 5 6 7 8; do
                    if [ -n "$(get_openflux_channel_prop "$r_ch" "URL" "")" ] && systemctl is-active --quiet "openflux@$r_ch"; then
                        systemctl restart "openflux@$r_ch"
                    fi
                done
                sleep 2
                ;;
            5)
                echo ""
                echo -e "${BOLD}--- УПРАВЛЕНИЕ СКВОЗНЫМ ШИФРОВАНИЕМ (AES-256-GCM) ---${NC}"
                if [ -n "$of_key" ]; then
                    echo -e "Текущий ключ шифрования: ${GREEN}${of_key}${NC}"
                else
                    echo -e "Шифрование: ${YELLOW}Отключено (трафик защищен стандартным TLS облачного сервиса)${NC}"
                fi
                echo ""
                echo " 1) Ввести свой ключ шифрования (парольную фразу)"
                echo " 2) Сгенерировать случайный безопасный hex-ключ"
                echo " 3) Отключить дополнительное шифрование (очистить ключ)"
                read -rp "Выберите действие [1-3]: " key_choice
                case "$key_choice" in
                    1)
                        read -rp "Введите секретный ключ/пароль: " user_key
                        if [ -n "$user_key" ]; then
                            set_openflux_prop "ENCRYPTION_KEY" "$user_key"
                            echo -e "${GREEN}✓ Ключ шифрования сохранен для всех 8 каналов!${NC}"
                        fi
                        ;;
                    2)
                        gen_key=$(openssl rand -hex 16 2>/dev/null || tr -dc 'a-f0-9' < /dev/urandom | head -c 32)
                        set_openflux_prop "ENCRYPTION_KEY" "$gen_key"
                        echo -e "${GREEN}✓ Сгенерирован новый ключ шифрования:${NC}"
                        echo -e "   ${BOLD}${CYAN}${gen_key}${NC}"
                        echo -e "${YELLOW}ВАЖНО: Скопируйте этот ключ и вставьте в поле Encryption Key на клиенте!${NC}"
                        ;;
                    3)
                        set_openflux_prop "ENCRYPTION_KEY" ""
                        rm -f /etc/openflux/psk*.key 2>/dev/null || true
                        echo -e "${GREEN}✓ Дополнительное шифрование отключено.${NC}"
                        ;;
                    *) echo -e "${YELLOW}Без изменений.${NC}" ;;
                esac
                for r_ch in 1 2 3 4 5 6 7 8; do
                    if [ -n "$(get_openflux_channel_prop "$r_ch" "URL" "")" ] && systemctl is-active --quiet "openflux@$r_ch"; then
                        systemctl restart "openflux@$r_ch"
                    fi
                done
                sleep 3
                ;;
            6)
                echo ""
                if [ "$of_debug" = "1" ] || [ "$of_debug" = "true" ]; then
                    set_openflux_prop "DEBUG" "0"
                    echo -e "${YELLOW}✓ Режим отладки отключен (тихий режим в journalctl).${NC}"
                else
                    set_openflux_prop "DEBUG" "1"
                    echo -e "${GREEN}✓ Режим отладки включен (подробные логи со статистикой пакетов).${NC}"
                fi
                for r_ch in 1 2 3 4 5 6 7 8; do
                    if [ -n "$(get_openflux_channel_prop "$r_ch" "URL" "")" ] && systemctl is-active --quiet "openflux@$r_ch"; then
                        systemctl restart "openflux@$r_ch"
                    fi
                done
                sleep 2
                ;;
            7)
                openflux_manage_routing
                ;;
            8)
                echo ""
                echo "Запуск / перезапуск всех настроенных каналов OpenFlux..."
                local started=0
                for r_ch in 1 2 3 4 5 6 7 8; do
                    local u=$(get_openflux_channel_prop "$r_ch" "URL" "")
                    if [ -n "$u" ]; then
                        systemctl enable "openflux@$r_ch" 2>/dev/null || true
                        systemctl restart "openflux@$r_ch"
                        if systemctl is-active --quiet "openflux@$r_ch"; then
                            echo -e "  [${GREEN}АКТИВЕН${NC}] Канал $r_ch"
                            ((started++))
                        else
                            echo -e "  [${RED}ОШИБКА${NC}] Канал $r_ch"
                        fi
                    else
                        echo -e "  [${YELLOW}ПРОПУЩЕН${NC}] Канал $r_ch (ссылка не задана)"
                    fi
                done
                echo ""
                echo -e "Успешно запущено каналов: ${BOLD}${started}${NC}"
                read -rp "Нажмите Enter для продолжения..." dummy
                ;;
            9)
                echo ""
                echo "Остановка всех каналов OpenFlux..."
                systemctl stop openflux@1 openflux@2 openflux@3 openflux@4 openflux@5 openflux@6 openflux@7 openflux@8 2>/dev/null || true
                echo -e "${YELLOW}✓ Все каналы OpenFlux (1-8) остановлены.${NC}"
                sleep 2
                ;;
            10)
                echo ""
                echo -e "${BOLD}--- ВЫБОР КАНАЛА ДЛЯ ПРОСМОТРА ЛОГОВ (1-8) ---${NC}"
                for l_i in 1 2 3 4 5 6 7 8; do
                    echo " $l_i) Логи Канала $l_i"
                done
                echo " A) Общие логи всех каналов вместе"
                read -rp "Выберите вариант [1-8, A]: " log_ch
                echo ""
                case "$log_ch" in
                    [1-8])
                        echo -e "${BOLD}--- ПОСЛЕДНИЕ 30 СТРОК ЛОГОВ КАНАЛА ${log_ch} ---${NC}"
                        journalctl -u "openflux@${log_ch}" -n 30 --no-pager
                        ;;
                    [AaФф])
                        echo -e "${BOLD}--- ПОСЛЕДНИЕ 40 СТРОК ЛОГОВ ВСЕХ КАНАЛОВ ---${NC}"
                        journalctl -u "openflux@*" -n 40 --no-pager
                        ;;
                    *)
                        echo "Неверный выбор."
                        ;;
                esac
                echo ""
                read -rp "Нажмите Enter для возврата..." dummy
                ;;
            11)
                echo ""
                read -rp "Мониторить конкретный канал [1-8] или все сразу [A]? " fol_ch
                case "$fol_ch" in
                    [1-8])
                        echo -e "${BOLD}--- МОНИТОРИНГ КАНАЛА ${fol_ch} (Ctrl+C для выхода) ---${NC}"
                        journalctl -u "openflux@${fol_ch}" -f
                        ;;
                    *)
                        echo -e "${BOLD}--- МОНИТОРИНГ ВСЕХ КАНАЛОВ (Ctrl+C для выхода) ---${NC}"
                        journalctl -u "openflux@*" -f
                        ;;
                esac
                ;;
            12)
                rebuild_openflux
                ;;
            0) return ;;
            *) echo "Неверный выбор"; sleep 1 ;;
        esac
    done
}

# ==============================================================================
# ГЛАВНОЕ МЕНЮ ДИСПЕТЧЕРА
# ==============================================================================
main_hub() {
    sync_active_firewall_rules >/dev/null 2>&1 || true

    local invoked=$(basename "$0")
    if [ "$invoked" = "x-snell" ]; then
        menu_snell
        exit 0
    elif [ "$invoked" = "x-mieru" ]; then
        menu_mieru
        exit 0
    elif [ "$invoked" = "x-wdtt" ] || [ "$invoked" = "x-qwdtt" ]; then
        menu_wdtt
        exit 0
    elif [ "$invoked" = "x-csqtt" ]; then
        menu_csqtt
        exit 0
    elif [ "$invoked" = "x-dns" ] || [ "$invoked" = "x-cottendns" ] || [ "$invoked" = "x-masterdns" ]; then
        menu_dns
        exit 0
    elif [ "$invoked" = "x-fw" ] || [ "$invoked" = "x-firewall" ]; then
        menu_firewall
        exit 0
    elif [ "$invoked" = "x-opt" ] || [ "$invoked" = "x-sys" ] || [ "$invoked" = "x-bbr" ] || [ "$invoked" = "x-swap" ] || [ "$invoked" = "x-f2b" ]; then
        menu_system_opt
        exit 0
    elif [ "$invoked" = "x-ssl" ] || [ "$invoked" = "x-cert" ] || [ "$invoked" = "x-acme" ]; then
        menu_ssl
        exit 0
    elif [ "$invoked" = "x-sub" ] || [ "$invoked" = "x-tuna" ] || [ "$invoked" = "x-subscriptions" ]; then
        menu_subscriptions
        exit 0
    elif [ "$invoked" = "x-openflux" ] || [ "$invoked" = "x-flux" ]; then
        menu_openflux
        exit 0
    elif [ "$invoked" = "x-webdav" ] || [ "$invoked" = "x-wdav" ]; then
        menu_webdav_tunnel
        exit 0
    fi

    while true; do
        clear
        echo -e "${CYAN}╔══════════════════════════════════════════════════════════════════════╗${NC}"
        echo -e "${CYAN}║${BOLD}          ЦЕНТР УПРАВЛЕНИЯ ПРОКСИ-СЕРВИСАМИ             ${CYAN}║${NC}"
        echo -e "${CYAN}╠══════════════════════════════════════════════════════════════════════╣${NC}"
        echo -e "${CYAN}║${NC}  Сервер: ${BOLD}${SERVER_IP}${NC}  |  Шлюзы: TPROXY :12345 [127.0.0.1] | SOCKS5 :10808 [127.0.0.1] 🔒"
        echo -e "${CYAN}║${NC}  Система: BBR: $(get_bbr_short_status) | Swap: $(get_swap_short_status) | F2B: $(get_f2b_short_status) | SSL: $(get_ssl_short_status) | Sub: $(get_sub_server_short_status)"
        echo -e "${CYAN}║${NC}"
        if is_mieru_installed; then
            echo -e "${CYAN}║${NC}  ${BOLD}[1] 🚀 Mieru (mita v$(get_mieru_version))${NC}   -> $(get_mieru_status)"
            echo -e "${CYAN}║${NC}      Порты: ${BOLD}$(get_mieru_ports)${NC}  |  Фаервол: $(get_mieru_fw_status)"
            echo -e "${CYAN}║${NC}      Маршрут: $(get_mieru_routing)  |  Профиль: $(get_mieru_preset)"
        else
            echo -e "${CYAN}║${NC}  ${BOLD}[1] 🚀 Mieru (mita)${NC}           -> ${RED}НЕ УСТАНОВЛЕН${NC}"
        fi
        echo -e "${CYAN}║${NC}"
        if is_snell_installed; then
            echo -e "${CYAN}║${NC}  ${BOLD}[2] ⚡ Snell (v5.0.1)${NC}         -> $(get_snell_status)"
            echo -e "${CYAN}║${NC}      Порт:  ${BOLD}$(get_snell_port)${NC} (TCP+UDP QUIC) |  Фаервол: $(get_snell_fw_status)"
            echo -e "${CYAN}║${NC}      Маршрут: $(get_snell_routing)  |  Обфускация: $(get_snell_obfs)"
        else
            echo -e "${CYAN}║${NC}  ${BOLD}[2] ⚡ Snell (v5.0.1)${NC}         -> ${RED}НЕ УСТАНОВЛЕН${NC}"
        fi
        echo -e "${CYAN}║${NC}"
        if is_wdtt_installed; then
            echo -e "${CYAN}║${NC}  ${BOLD}[3] 🛡️ WDTT / qwdtt${NC}          -> $(get_wdtt_status)"
            echo -e "${CYAN}║${NC}      Порт:   :${BOLD}$(get_wdtt_peer_port)/UDP${NC}   |  Фаервол: $(get_wdtt_fw_status)"
            echo -e "${CYAN}║${NC}      Профиль: ${BOLD}$(get_wdtt_profile_name)${NC}  |  Пароль: ${GREEN}$(get_wdtt_password)${NC}"
            echo -e "${CYAN}║${NC}      Маршрут: $(get_wdtt_routing)"
        else
            echo -e "${CYAN}║${NC}  ${BOLD}[3] 🛡️ WDTT / qwdtt${NC}          -> ${RED}НЕ УСТАНОВЛЕН${NC}"
        fi
        echo -e "${CYAN}║${NC}"
        if is_csqtt_installed; then
            echo -e "${CYAN}║${NC}  ${BOLD}[4] 🔒 CSQTT (VPN & Web-панель)${NC}-> $(get_csqtt_status)"
            echo -e "${CYAN}║${NC}      VPN порт:   :${BOLD}$(get_csqtt_peer_port)/UDP${NC}   |  Фаервол: $(get_csqtt_tunnel_status)"
            echo -e "${CYAN}║${NC}      Веб-панель: :${BOLD}$(get_csqtt_web_port)/TCP${NC}   |  Защита: $(get_csqtt_protect_status)"
            echo -e "${CYAN}║${NC}      Веб-вход:   Логин: ${GREEN}$(get_csqtt_user)${NC}  |  Пароль: ${GREEN}$(get_csqtt_pass)${NC}"
        else
            echo -e "${CYAN}║${NC}  ${BOLD}[4] 🔒 CSQTT (VPN & Web-панель)${NC}-> ${RED}НЕ УСТАНОВЛЕН${NC}"
        fi
        echo -e "${CYAN}║${NC}"
        if is_dns_installed; then
            echo -e "${CYAN}║${NC}  ${BOLD}[5] 🌐 DNS-Туннель (MasterDnsVPN)${NC}  -> $(get_dns_status)"
            echo -e "${CYAN}║${NC}      Домен: ${BOLD}$(get_dns_domain)${NC} (:53 UDP/TCP) | Фаервол WAN: $(get_dns_wan_status)"
            echo -e "${CYAN}║${NC}      Маршрут: $(get_dns_routing)"
        else
            echo -e "${CYAN}║${NC}  ${BOLD}[5] 🌐 DNS-Туннель (MasterDnsVPN)${NC}  -> ${RED}НЕ УСТАНОВЛЕН${NC}"
        fi
        echo -e "${CYAN}║${NC}"
        if is_openflux_installed; then
            local of_cnt=$(get_openflux_counts)
            local of_a=$(echo "$of_cnt" | cut -d':' -f1)
            echo -e "${CYAN}║${NC}  ${BOLD}[6] 📡 OpenFlux (Мультиплекс 1-8)${NC} -> $(get_openflux_status)"
            echo -e "${CYAN}║${NC}      Режим: L4 (gVisor)  |  Каналы: 1-8 (Яндекс/Mail.ru) | Маршрут: $(get_openflux_routing)"
        else
            echo -e "${CYAN}║${NC}  ${BOLD}[6] 📡 OpenFlux (Мультиплекс 1-8)${NC} -> ${RED}НЕ УСТАНОВЛЕН${NC}"
        fi
        echo -e "${CYAN}║${NC}"
        if is_sub_server_installed; then
            echo -e "${CYAN}║${NC}  ${BOLD}[13] 📋 Подписки TUNA${NC}          -> $(get_sub_server_status)"
            echo -e "${CYAN}║${NC}       API: http://127.0.0.1:22217   |  Порт: :22217 [127.0.0.1] 🔒"
        else
            echo -e "${CYAN}║${NC}  ${BOLD}[13] 📋 Подписки TUNA${NC}          -> ${RED}НЕ УСТАНОВЛЕН${NC}"
        fi
        echo -e "${CYAN}║${NC}"
        if is_webdav_tunnel_installed; then
            local w_prov=$(get_wdavtunnel_provider_label)
            echo -e "${CYAN}║${NC}  ${BOLD}[14] 📦 WebDAV Tunnel (WireTurn)${NC}  -> $(get_wdavtunnel_status)"
            echo -e "${CYAN}║${NC}       Провайдер: ${w_prov} | Маршрут: $(get_wdavtunnel_routing)"
        else
            echo -e "${CYAN}║${NC}  ${BOLD}[14] 📦 WebDAV Tunnel (WireTurn)${NC}  -> ${RED}НЕ УСТАНОВЛЕН${NC}"
        fi
        echo -e "${CYAN}╚══════════════════════════════════════════════════════════════════════╝${NC}"
        echo ""
        echo -e "  ${GREEN}${BOLD}[1]${NC} 🚀 ${BOLD}Управление Mieru${NC} (Anti-TSPU, Egress, пользователи, порты, фаервол)"
        echo -e "  ${BLUE}${BOLD}[2]${NC} ⚡ ${BOLD}Управление Snell v5${NC} (0-RTT, Egress Xray/Direct, HTTP-obfs, фаервол)"
        echo -e "  ${PURPLE}${BOLD}[3]${NC} 🛡️  ${BOLD}Управление WDTT / qwdtt${NC} (Egress в ядро / Прямой выход, клиенты, фаервол)"
        echo -e "  ${CYAN}${BOLD}[4]${NC} 🔒 ${BOLD}Управление CSQTT${NC} (Защита веб-панели, туннель фаервол, логин/пароли)"
        echo -e "  ${YELLOW}${BOLD}[5]${NC} 🌐 ${BOLD}Управление DNS-туннелями${NC} (MasterDnsVPN / CottenDNS, stormdns://, WAN)"
        echo -e "  ${YELLOW}${BOLD}[6]${NC} 📡 ${BOLD}Управление OpenFlux${NC} (Мультиплекс 1-8 • Яндекс/Mail.ru • Режим L4)"
        echo ""
        echo -e "  ${RED}${BOLD}[7]${NC} 🛡️  ${BOLD}Центр управления фаерволом портов${NC} (Включение/Выключение протоколов, Локдаун)"
        echo -e "  ${BOLD}[8]${NC} 📊 Сводный статус всех служб и портов сервера"
        echo -e "  ${BOLD}[9]${NC} 🔄 Перезапустить все сервисы (Mieru + Snell + WDTT + CSQTT + DNS + OpenFlux + WebDAV)"
        echo -e "  ${BOLD}[10]${NC} 🔍 ${BOLD}Пересканировать и подхватить протоколы${NC} (Автоопределение установленных служб)"
        echo -e "  ${GREEN}${BOLD}[11]${NC} ⚙️  ${BOLD}Оптимизация и безопасность${NC} (DNS с пингом, BBR/буферы под RAM, Swap 2/4G, Fail2ban)"
        echo -e "  ${PURPLE}${BOLD}[12]${NC} 🔒 ${BOLD}Управление SSL-сертификатами${NC} (Cloudflare Wildcard / Standalone :80 / ACME / 3X-UI)"
        echo -e "  ${CYAN}${BOLD}[13]${NC} 📋 ${BOLD}Сервер подписок TUNA${NC} (Профили, выдача Base64-ссылок, ротация токенов)"
        echo -e "  ${CYAN}${BOLD}[14]${NC} 📦 ${BOLD}Управление WebDAV Tunnel${NC} (Mail.ru / Selfhosted / Яндекс.Диск • WireTurn)"
        echo -e "  ${BOLD}[0]${NC} 🚪 Выход"
        echo ""
        read -p "Выберите раздел [0-14]: " top_choice
        case "$top_choice" in
            1) menu_mieru ;;
            2) menu_snell ;;
            3) menu_wdtt ;;
            4) menu_csqtt ;;
            5) menu_dns ;;
            6) menu_openflux ;;
            7) menu_firewall ;;
            8) view_global_status ;;
            9) restart_all_services ;;
            10) rescan_and_adopt_protocols ;;
            11) menu_system_opt ;;
            12) menu_ssl ;;
            13) menu_subscriptions ;;
            14) menu_webdav_tunnel ;;
            0) clear; exit 0 ;;
            *) echo "Неверный выбор"; sleep 1 ;;
        esac
    done
}

if [ "${BASH_SOURCE[0]}" = "$0" ]; then
    main_hub
fi
