+package tunnel
+
+import (
+	"bytes"
+	"gvisor.dev/gvisor/pkg/tcpip"
+	"gvisor.dev/gvisor/pkg/tcpip/adapters/gonet"
+	"gvisor.dev/gvisor/pkg/tcpip/network/ipv4"
+	"openflux/internal/sockstest"
+	"openflux/transport"
+	"openflux/tunnel/upstream"
+	"testing"
+	"time"
+)
+
+type linkTransport struct {
+	*transport.BaseTransport
+	peer *linkTransport
+}
+
+func (t *linkTransport) Send(b []byte) error {
+	t.peer.CallReceive(append([]byte(nil), b...))
+	return nil
+}
+
+func TestTunnelTCPAndUDPUseSOCKS(t *testing.T) {
+	s := sockstest.Start(t, false)
+	egress, _ := upstream.New(s.Address)
+	a := &linkTransport{BaseTransport: transport.NewBaseTransport(transport.DefaultConfig())}
+	b := &linkTransport{BaseTransport: transport.NewBaseTransport(transport.DefaultConfig())}
+	a.peer = b
+	b.peer = a
+	exit := newTCPTunnelEgress(b, true, ExitModeL4, egress)
+	client := NewTCPTunnelMode(a, false, ExitModeL4)
+	t.Cleanup(func() { client.gvisorStack.Close(); exit.gvisorStack.Close() })
+	tcp, err := client.DialTCP("198.18.0.1:45678")
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer tcp.Close()
+	udp, err := gonet.DialUDP(client.gvisorStack, nil, &tcpip.FullAddress{NIC: 1, Addr: tcpip.AddrFrom4([4]byte{198, 18, 0, 1}), Port: 45678}, ipv4.ProtocolNumber)
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer udp.Close()
+	for name, c := range map[string]interface {
+		Read([]byte) (int, error)
+		Write([]byte) (int, error)
+		SetDeadline(time.Time) error
+	}{"tcp": tcp, "udp": udp} {
+		c.SetDeadline(time.Now().Add(3 * time.Second))
+		payload := []byte("gvisor through SOCKS " + name)
+		if _, err := c.Write(payload); err != nil {
+			t.Fatal(name, err)
+		}
+		out := make([]byte, 1500)
+		n, err := c.Read(out)
+		if err != nil {
+			t.Fatal(name, err)
+		}
+		if !bytes.Equal(payload, out[:n]) {
+			t.Fatal(name, "corruption")
+		}
+	}
+	if s.TCP.Load() != 1 || s.UDP.Load() != 1 {
+		t.Fatal("not both SOCKS commands")
+	}
+}
