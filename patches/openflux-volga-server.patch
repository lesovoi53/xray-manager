@@ -0,0 +1,93 @@
+package yandex
+
+import (
+	"context"
+	"errors"
+	"io"
+	"net/http"
+	"openflux/transport"
+	"strings"
+	"sync/atomic"
+	"testing"
+	"time"
+)
+
+func TestVolgaRejectsTruncatedBatch(t *testing.T) {
+	for _, b := range [][]byte{{0, 4, 1, 2}, {0, 1, 9, 0, 4, 8}, {0, 0, 1}} {
+		if got := decodeBatch(b); len(got) != 0 {
+			t.Fatalf("malformed batch delivered as %d packets", len(got))
+		}
+	}
+	b := decodeBatch([]byte{0, 1, 9, 0, 2, 8, 7})
+	if len(b) != 2 || len(b[1]) != 2 {
+		t.Fatal("valid wire format changed")
+	}
+}
+
+func TestVolgaIdentifiesLegacyDocument(t *testing.T) {
+	u := serveConfig(t, clientConfigPage(`{"officeActionData":{"office_online_editor_type":"only_office","balancer_url":"https://example.invalid"}}`))
+	if _, err := authorizeWithJar(u, nil); !errors.Is(err, ErrLegacyDocument) {
+		t.Fatalf("wrong document diagnostic: %v", err)
+	}
+}
+
+func TestVolgaHealthRequiresWebSocket(t *testing.T) {
+	v := NewYandexVolgaTransport("", transport.DefaultConfig())
+	v.BaseTransport.Start()
+	v.BaseTransport.SetConnected(true)
+	if v.IsConnected() {
+		t.Fatal("false connected before WS")
+	}
+	v.ws = newWSListener(&v.auth, nil, v.config, v.stats, nil, nil)
+	v.ws.connected.Store(true)
+	if !v.IsConnected() {
+		t.Fatal("connected socket not reported")
+	}
+	v.ws.RequestReconnect()
+	if v.IsConnected() {
+		t.Fatal("reconnecting socket reported healthy")
+	}
+	v.Stop()
+}
+
+func TestVolgaRepeated401DoesNotStorm(t *testing.T) {
+	var shared atomic.Pointer[volgaAuth]
+	shared.Store(&volgaAuth{Token: "old", RequestPath: "test"})
+	var requests, refresh atomic.Int32
+	r := &relayClient{auth: &shared, ctx: context.Background(), stats: &VolgaStats{}, authWait: time.Millisecond,
+		onAuthRejected: func() { refresh.Add(1) },
+		httpClient: &http.Client{Transport: roundTripFunc(func(*http.Request) (*http.Response, error) {
+			requests.Add(1)
+			return &http.Response{StatusCode: 401, Body: io.NopCloser(strings.NewReader("")), Header: make(http.Header)}, nil
+		})}}
+	for i := 0; i < 5; i++ {
+		if err := r.deliver([][]byte{{1, 2, 3}}); err == nil {
+			t.Fatal("false success")
+		}
+	}
+	if requests.Load() != 1 || refresh.Load() != 1 {
+		t.Fatalf("storm: requests=%d refresh=%d", requests.Load(), refresh.Load())
+	}
+}
+
+func TestVolga401RetriesWithFreshAuth(t *testing.T) {
+	var shared atomic.Pointer[volgaAuth]
+	shared.Store(&volgaAuth{Token: "old", RequestPath: "test"})
+	var requests atomic.Int32
+	r := &relayClient{auth: &shared, ctx: context.Background(), stats: &VolgaStats{}, authWait: time.Second,
+		onAuthRejected: func() { shared.Store(&volgaAuth{Token: "fresh", RequestPath: "test"}) },
+		httpClient: &http.Client{Transport: roundTripFunc(func(req *http.Request) (*http.Response, error) {
+			requests.Add(1)
+			code := 401
+			if req.Header.Get("Authorization") == "Bearer fresh" {
+				code = 204
+			}
+			return &http.Response{StatusCode: code, Body: io.NopCloser(strings.NewReader("")), Header: make(http.Header)}, nil
+		})}}
+	if err := r.deliver([][]byte{{1, 2, 3}}); err != nil {
+		t.Fatal(err)
+	}
+	if requests.Load() != 2 {
+		t.Fatal("rejected batch not retried exactly once")
+	}
+}
