new file mode 100644
index 0000000..2a1a2e5
--- /dev/null
+++ b/internal/sockstest/server.go
@@ -0,0 +1,117 @@
+// Package sockstest is a loopback-only SOCKS5 fixture used by integration tests.
+package sockstest
+
+import (
+	"encoding/binary"
+	"io"
+	"net"
+	"sync"
+	"sync/atomic"
+	"testing"
+)
+
+type Server struct {
+	Address     string
+	TCP, UDP    atomic.Int64
+	mu          sync.Mutex
+	connections []net.Conn
+	RejectUDP   bool
+}
+
+func Start(t *testing.T, rejectUDP bool) *Server {
+	t.Helper()
+	l, err := net.Listen("tcp", "127.0.0.1:0")
+	if err != nil {
+		t.Fatal(err)
+	}
+	s := &Server{Address: l.Addr().String(), RejectUDP: rejectUDP}
+	t.Cleanup(func() {
+		l.Close()
+		s.mu.Lock()
+		defer s.mu.Unlock()
+		for _, c := range s.connections {
+			c.Close()
+		}
+	})
+	go func() {
+		for {
+			c, err := l.Accept()
+			if err != nil {
+				return
+			}
+			s.mu.Lock()
+			s.connections = append(s.connections, c)
+			s.mu.Unlock()
+			go s.serve(c)
+		}
+	}()
+	return s
+}
+
+func (s *Server) serve(c net.Conn) {
+	defer c.Close()
+	var greeting [3]byte
+	if _, err := io.ReadFull(c, greeting[:]); err != nil {
+		return
+	}
+	if greeting != [3]byte{5, 1, 0} {
+		return
+	}
+	c.Write([]byte{5, 0})
+	var req [4]byte
+	if _, err := io.ReadFull(c, req[:]); err != nil {
+		return
+	}
+	n := 0
+	switch req[3] {
+	case 1:
+		n = 4
+	case 4:
+		n = 16
+	case 3:
+		var b [1]byte
+		if _, err := io.ReadFull(c, b[:]); err != nil {
+			return
+		}
+		n = int(b[0])
+	default:
+		return
+	}
+	if _, err := io.CopyN(io.Discard, c, int64(n+2)); err != nil {
+		return
+	}
+	if req[1] == 1 {
+		s.TCP.Add(1)
+		c.Write([]byte{5, 0, 0, 1, 127, 0, 0, 1, 0, 1})
+		io.Copy(c, c)
+		return
+	}
+	if req[1] != 3 {
+		return
+	}
+	s.UDP.Add(1)
+	if s.RejectUDP {
+		c.Write([]byte{5, 7, 0, 1, 0, 0, 0, 0, 0, 0})
+		return
+	}
+	u, err := net.ListenUDP("udp", &net.UDPAddr{IP: net.IPv4(127, 0, 0, 1)})
+	if err != nil {
+		return
+	}
+	defer u.Close()
+	port := u.LocalAddr().(*net.UDPAddr).Port
+	reply := []byte{5, 0, 0, 1, 0, 0, 0, 0, 0, 0}
+	binary.BigEndian.PutUint16(reply[8:], uint16(port))
+	c.Write(reply)
+	go func() {
+		b := make([]byte, 65535)
+		for {
+			n, a, e := u.ReadFromUDP(b)
+			if e != nil {
+				return
+			}
+			u.WriteToUDP(b[:n], a)
+		}
+	}()
+	io.Copy(io.Discard, c)
+}
