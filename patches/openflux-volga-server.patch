diff --git a/tunnel/udp_egress.go b/tunnel/udp_egress.go
new file mode 100644
index 0000000..8fb6401
--- /dev/null
+++ b/tunnel/udp_egress.go
@@ -0,0 +1,68 @@
+package tunnel
+
+import (
+	"context"
+	"fmt"
+	"gvisor.dev/gvisor/pkg/tcpip/adapters/gonet"
+	"gvisor.dev/gvisor/pkg/tcpip/transport/udp"
+	"gvisor.dev/gvisor/pkg/waiter"
+	"net"
+	"openflux/utils"
+	"time"
+)
+
+func (t *TCPTunnel) dialEgress(network, destination string) (net.Conn, error) {
+	ctx, cancel := context.WithTimeout(context.Background(), 10*time.Second)
+	defer cancel()
+	if t.egress != nil {
+		return t.egress.DialContext(ctx, network, destination)
+	}
+	return (&net.Dialer{}).DialContext(ctx, network, destination)
+}
+
+func (t *TCPTunnel) handleExitUDP(r *udp.ForwarderRequest) bool {
+	select {
+	case t.udpSlots <- struct{}{}:
+	default:
+		return true
+	}
+	id := r.ID()
+	var wq waiter.Queue
+	ep, err := r.CreateEndpoint(&wq)
+	if err != nil {
+		<-t.udpSlots
+		return true
+	}
+	local := gonet.NewUDPConn(&wq, ep)
+	go func() {
+		defer func() { local.Close(); <-t.udpSlots }()
+		remote, err := t.dialEgress("udp", fmt.Sprintf("%s:%d", id.LocalAddress, id.LocalPort))
+		if err != nil {
+			utils.Debugf("[EXIT] UDP upstream unavailable: %v", err)
+			return
+		}
+		defer remote.Close()
+		done := make(chan struct{})
+		go func() { defer close(done); copyDatagrams(local, remote); local.Close(); remote.Close() }()
+		copyDatagrams(remote, local)
+		local.Close()
+		remote.Close()
+		<-done
+	}()
+	return true
+}
+
+func copyDatagrams(dst, src net.Conn) {
+	b := make([]byte, 65535)
+	for {
+		src.SetReadDeadline(time.Now().Add(90 * time.Second))
+		n, err := src.Read(b)
+		if err != nil {
+			return
+		}
+		dst.SetWriteDeadline(time.Now().Add(10 * time.Second))
+		if _, err := dst.Write(b[:n]); err != nil {
+			return
+		}
+	}
+}
