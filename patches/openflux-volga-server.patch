+func TestSOCKSUnavailableNoDirectFallback(t *testing.T) {
+	l, err := net.Listen("tcp", "127.0.0.1:0")
+	if err != nil {
+		t.Fatal(err)
+	}
+	a := l.Addr().String()
+	l.Close()
+	p, _ := New(a)
+	for _, network := range []string{"tcp", "udp"} {
+		if c, err := p.DialContext(context.Background(), network, "127.0.0.1:53"); err == nil {
+			c.Close()
+			t.Fatalf("%s bypassed unavailable gateway", network)
+		}
+	}
+}
