@@ -0,0 +1,82 @@
+package yandex
+
+import (
+	"openflux/transport"
+	"os"
+	"strings"
+	"testing"
+	"time"
+)
+
+func TestLiveVolga(t *testing.T) {
+	path := os.Getenv("OPENFLUX_TEST_DOCUMENT_FILE")
+	if path == "" {
+		t.Skip("explicit test document required")
+	}
+	b, err := os.ReadFile(path)
+	if err != nil {
+		t.Fatal("cannot read private document file")
+	}
+	v := NewYandexVolgaTransport(strings.TrimSpace(string(b)), transport.DefaultConfig())
+	if path := os.Getenv("OPENFLUX_TEST_COOKIES_FILE"); path != "" {
+		if err := v.LoadCookieFile(path); err != nil {
+			t.Fatal("cannot load private cookies")
+		}
+	}
+	defer v.Stop()
+	if err := v.Start(); err != nil {
+		t.Fatal(err)
+	}
+	deadline := time.Now().Add(20 * time.Second)
+	for !v.IsConnected() && time.Now().Before(deadline) {
+		time.Sleep(100 * time.Millisecond)
+	}
+	if !v.IsConnected() {
+		t.Fatal("authorization succeeded but WebSocket did not connect")
+	}
+	if err := v.relay.deliver([][]byte{{0}}); err != nil {
+		t.Fatal(err)
+	}
+	time.Sleep(time.Second)
+	if v.stats.HTTPReqsFailed.Load() > 0 {
+		t.Fatal("Volga relay rejected test keepalive")
+	}
+	if v.stats.PacketsSent.Load() == 0 {
+		t.Fatal("Volga relay did not accept test keepalive")
+	}
+}
+
+func TestLiveVolgaSessionRotation(t *testing.T) {
+	path := os.Getenv("OPENFLUX_TEST_DOCUMENT_FILE")
+	if path == "" {
+		t.Skip("explicit document required")
+	}
+	b, err := os.ReadFile(path)
+	if err != nil {
+		t.Fatal("private document unavailable")
+	}
+	v := NewYandexVolgaTransport(strings.TrimSpace(string(b)), transport.DefaultConfig())
+	if p := os.Getenv("OPENFLUX_TEST_COOKIES_FILE"); p != "" {
+		if err := v.LoadCookieFile(p); err != nil {
+			t.Fatal("private cookies unavailable")
+		}
+	}
+	// Accelerate only the test's rotation trigger; production remains 30 minutes.
+	v.config.MaxSessionAge = 3 * time.Second
+	defer v.Stop()
+	if err := v.Start(); err != nil {
+		t.Fatal(err)
+	}
+	first := v.auth.Load()
+	deadline := time.Now().Add(20 * time.Second)
+	for time.Now().Before(deadline) {
+		if v.IsConnected() && v.auth.Load() != first && v.stats.WSReconnects.Load() > 0 {
+			if err := v.relay.deliver([][]byte{{0}}); err != nil {
+				t.Fatal(err)
+			}
+			return
+		}
+		time.Sleep(100 * time.Millisecond)
+	}
+	t.Fatal("session rotation failed to restore a live relay")
+}
diff --git a/transport/yandex/relay_stop_test.go b/transport/yandex/relay_stop_test.go
new file mode 100644
index 0000000..3313f1b
--- /dev/null
+++ b/transport/yandex/relay_stop_test.go
@@ -0,0 +1,23 @@
+package yandex
+
+import (
+	"net/http"
+	"sync/atomic"
+	"testing"
+)
+
+// Manager.Stop stops each transport after Session.Stop already did; the
+// second Stop, and a Send racing with Stop, must not panic on the closed
+// queues.
+func TestRelayStopTwiceAndSendAfterStop(t *testing.T) {
+	cfg := DefaultVolgaConfig()
+	var auth atomic.Pointer[volgaAuth]
+	auth.Store(&volgaAuth{Session: &http.Client{}})
+	r := newRelayClient(&auth, cfg, &VolgaStats{})
+	r.Start()
+	r.Stop()
+	r.Stop()
+	if err := r.Send([]byte{1, 2, 3}); err == nil {
+		t.Fatal("Send after Stop must fail")
+	}
+}
