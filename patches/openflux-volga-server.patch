new file mode 100644
index 0000000..e6fa7ca
--- /dev/null
+++ b/cmd/volga-check/main.go
@@ -0,0 +1,43 @@
+// volga-check validates authentication and a WebSocket without starting an exit.
+package main
+
+import (
+ "flag"
+ "fmt"
+ "os"
+ "strings"
+ "time"
+ "openflux/transport"
+ "openflux/transport/yandex"
+)
+
+func check(url, cookies string) error {
+ v := yandex.NewYandexVolgaTransport(url, transport.DefaultConfig())
+ if cookies != "" {
+  if err := v.LoadCookieFile(cookies); err != nil { return fmt.Errorf("cannot read private cookies file") }
+ }
+ defer v.Stop()
+ if err := v.Start(); err != nil { return err }
+ deadline := time.Now().Add(20*time.Second)
+ for time.Now().Before(deadline) {
+  if v.IsConnected() { return nil }
+  time.Sleep(100*time.Millisecond)
+ }
+ return fmt.Errorf("WebSocket did not connect within 20 seconds")
+}
+
+func main() {
+ path := flag.String("url-file", "", "Private document URL file")
+ cookies := flag.String("cookies-file", "", "Private Netscape cookies file")
+ flag.Parse()
+ data, err := os.ReadFile(*path)
+ if err != nil || len(data)>32768 { fmt.Fprintln(os.Stderr,"Cannot read document file"); os.Exit(1) }
+ urls := strings.Split(strings.TrimSpace(string(data)),",")
+ if len(urls)<1 || len(urls)>4 { fmt.Fprintln(os.Stderr,"Expected 1..4 documents"); os.Exit(1) }
+ for i,u := range urls {
+  if err:=check(strings.TrimSpace(u),*cookies); err!=nil {
+   fmt.Fprintf(os.Stderr,"Document %d: %v\n",i+1,err);os.Exit(1)
+  }
+  fmt.Printf("Document %d: authentication and WebSocket OK\n",i+1)
+ }
+}
