+func TestSOCKSUDPPreservesEmptyDatagram(t *testing.T) {
+	s := sockstest.Start(t, false)
+	p, _ := New(s.Address)
+	c, err := p.DialContext(context.Background(), "udp", "198.18.0.1:53")
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer c.Close()
+	c.SetDeadline(time.Now().Add(time.Second))
+	if n, err := c.Write(nil); err != nil || n != 0 {
+		t.Fatal("empty datagram write", n, err)
+	}
+	if n, err := c.Read(make([]byte, 100)); err != nil || n != 0 {
+		t.Fatal("empty datagram read", n, err)
+	}
+}
