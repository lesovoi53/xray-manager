+func TestSOCKSUDPControlClosureClosesDatagrams(t *testing.T) {
+	s := sockstest.Start(t, false)
+	p, _ := New(s.Address)
+	c, err := p.DialContext(context.Background(), "udp", "198.18.0.1:53")
+	if err != nil {
+		t.Fatal(err)
+	}
+	u := c.(*udpConn)
+	defer u.Close()
+	u.control.Close()
+	u.SetReadDeadline(time.Now().Add(time.Second))
+	if _, err := u.Read(make([]byte, 100)); err == nil {
+		t.Fatal("UDP outlived control connection")
+	}
+}
